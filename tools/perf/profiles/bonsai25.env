# Bonsai 2.5 27B Uncensored Q2_0-mtp on XTX, production-like topka settings (2026-11-25)
MODEL=$HOME/models/bonsai25/Ternary-Bonsai-2.5-27B-Uncensored-Q2_0-mtp.gguf
SRV_ARGS="-ngl 999 -fa on -ctk q4_0 -ctv q4_0 -c 262144 -np 1 --jinja --no-webui"
SPEC_ARGS="--spec-type draft-mtp --spec-draft-n-max 2 -ctkd q4_0 -ctvd q4_0 --spec-draft-vocab $HOME/models/draft/draft_vocab_qwen38.txt --spec-draft-vocab-n 65536"
RUN_ENV="GGML_HIP_PM4=1 GGML_HIP_PM4_WA=2 GGML_HIP_PM4_GUARD=1 HSA_USE_SVM=0 GGML_HIP_FA_D256_VAR=83 LLAMA_SPEC_LOOKUP=3 LLAMA_SPEC_LOOKUP_W=16 LLAMA_GPU_VERIFY=1 LLAMA_SPEC_COUPLED=1 LLAMA_SERVER_YIELD_FAST=2 GGML_HIP_PM4_MIN_DISPATCH=16 GGML_HIP_PM4_LAZY_EXEC=1 LLAMA_SERVER_CACHE_SHARE_MIN=1024"
TBO_FILTER="MUL_MAT:type_a=q2_0 MUL_MAT_VEC_FUSION:type=q2_0 RMS_NORM: MUL_MAT:type_a=f32"
CORPUS=$HOME/qwen-opt/xtxbench/corpus.txt
