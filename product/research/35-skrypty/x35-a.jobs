e1-n4a|600|~/qwen-opt/xtxlab|export GGML_HIP_PM4=1 GGML_HIP_PM4_WA=2 GGML_HIP_PM4_GUARD=1 HSA_USE_SVM=0; DRAFT_N=4 bash x_arm.sh e1-n4a reason,sweep
