{
  "name": "enigma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/server/main.ts",
    "dev:ui": "vite dev --port 11501",
    "build:ui": "vite build",
    "build": "bun run build:ui && bun tools/build.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:ui": "svelte-check --tsconfig ./src/ui/tsconfig.json",
    "test": "bun test",
    "license:issue": "bun tools/license-issue.ts",
    "engines:pin": "bun tools/engines-pin.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/bun": "1.3.1",
    "svelte": "5.56.1",
    "svelte-check": "4.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
