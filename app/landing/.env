# Build-time public config (committed; no secrets here). Secrets go to .env.local (git-ignored), see AUTH.md.
# Auth backend: none | authjs | supabase
PUBLIC_AUTH_PROVIDER=none
# Supabase project (only for PUBLIC_AUTH_PROVIDER=supabase; both values are public by design)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
