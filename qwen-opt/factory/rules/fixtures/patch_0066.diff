+        const bool enabled_rb = !env_rb || atoi(env_rb) != 0;
+        if (enabled && !grmr && (!rbudget || enabled_rb) && !has_logit_bias && params.mirostat == 0 && params.n_probs == 0) {
             int32_t idx = 0; // index of cnstr's sampler in the chain (no logit-bias sampler in front of it here)
             for (const auto & cnstr : params.samplers) {
                 if (cnstr == COMMON_SAMPLER_TYPE_TOP_K) {
@@ -785,7 +790,9 @@ llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_co
     auto & chain = gsmpl->chain;
     auto & cur_p = gsmpl->cur_p; // initialized by set_logits
 
-    if (gsmpl->fast_top_k <= 0 || !gsmpl->set_logits_top_k(ctx, idx)) {
+    // [LLAMA_SAMPLER_FAST_RBUDGET] a FORCING reasoning budget sets all but the forced token to -inf: full candidates
+    const bool rbudget_forcing = rbudget && common_reasoning_budget_get_state(rbudget) == REASONING_BUDGET_FORCING;
+    if (gsmpl->fast_top_k <= 0 || rbudget_forcing || !gsmpl->set_logits_top_k(ctx, idx)) {
         gsmpl->set_logits(ctx, idx);
     }
 
