+// single-token MoE routing: FFN norm (rms_norm * w) -> F32 router -> gating, top-k, normalized weights, the norm
+// output also feeding the expert MUL_MAT_ID (norm, router and top-k fused into one launch by the HIP backend,
+// GGML_HIP_NORM_ROUTER)
+struct test_norm_router_topk : public test_case {
+    const int64_t       n_embd;
+    const int           n_expert;
+    const int           n_expert_used;
+    const bool          bias_probs;
+    const MoeGatingFunc gating_func;
+    ggml_tensor * normed {};
+    ggml_tensor * selected_experts {};
+    ggml_tensor * weights {};
+    ggml_tensor * up {};
+
+    test_norm_router_topk(int64_t n_embd = 2048, int n_expert = 64, int n_expert_used = 4, bool bias_probs = true,
+                          MoeGatingFunc gating_func = GATING_FUNC_SIGMOID)
+        : n_embd(n_embd), n_expert(n_expert), n_expert_used(n_expert_used), bias_probs(bias_probs), gating_func(gating_func) {}
+
+    std::string vars() override { return VARS_TO_STR5(n_embd, n_expert, n_expert_used, bias_probs, gating_func); }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "NORM_ROUTER_TOPK";
+    }
+
+    // the expert matmul runs on q8_1 activations (as in test_moe_down_reduce)
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, 1);
+        ggml_set_name(x, "x");
+        ggml_tensor * norm_w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+        ggml_set_name(norm_w, "norm_w");
+        normed = ggml_mul(ctx, ggml_rms_norm(ctx, x, 1e-5f), norm_w);
+        ggml_set_name(normed, "normed");
+
+        ggml_tensor * router = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_expert);
+        ggml_set_name(router, "router");
+        ggml_tensor * logits = ggml_mul_mat(ctx, router, normed); // [n_expert, 1]
+        ggml_set_name(logits, "logits");
+        ggml_tensor * probs = gating_func == GATING_FUNC_SIGMOID ? ggml_sigmoid(ctx, logits) : ggml_soft_max(ctx, logits);
+        ggml_set_name(probs, "probs");
+        ggml_tensor * selection_probs = probs;
+        if (bias_probs) {
+            ggml_tensor * exp_probs_b = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_expert);
+            ggml_set_name(exp_probs_b, "exp_probs_b");
+            selection_probs = ggml_add(ctx, probs, exp_probs_b);
+            ggml_set_name(selection_probs, "selection_probs");
+        }
+        selected_experts = ggml_argsort_top_k(ctx, selection_probs, n_expert_used); // [n_expert_used, 1]
+        ggml_set_name(selected_experts, "selected_experts");
+        weights = ggml_get_rows(ctx, ggml_reshape_3d(ctx, probs, 1, n_expert, 1), selected_experts);
+        weights = ggml_reshape_2d(ctx, weights, n_expert_used, 1);
+        ggml_tensor * weights_sum = ggml_sum_rows(ctx, weights);
+        weights_sum = ggml_clamp(ctx, weights_sum, 6.103515625e-5, INFINITY);
+        weights = ggml_div(ctx, weights, weights_sum);
+        weights = ggml_reshape_3d(ctx, weights, 1, n_expert_used, 1);
+        ggml_set_name(weights, "weights");
+        // the routing nodes first, then the expert matmul, as in a model graph
+        if (mode == MODE_TEST) {
+            ggml_build_forward_expand(gf, weights);
+        }
+
+        ggml_tensor * as = ggml_new_tensor_3d(ctx, GGML_TYPE_Q5_K, n_embd, 256, n_expert);
+        ggml_set_name(as, "as");
+        up = ggml_mul_mat_id(ctx, as, ggml_reshape_3d(ctx, normed, n_embd, 1, 1), selected_experts); // [256, n_used, 1]
+        ggml_set_name(up, "up");
+        ggml_tensor * out = ggml_mul(ctx, up, weights);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    std::vector<ggml_tensor *> fusion_test_nodes() override { return { normed, selected_experts, weights, up }; }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "router") == 0) {
+                init_tensor_uniform(t, -0.05f, 0.05f); // logits of a few units: no saturated sigmoid ties
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+
+    // the experts in any order (see test_topk_moe)
+    double err(const float * a, const float * b, size_t n) override {
+        std::vector<float> a2(a, a + n);
+        std::vector<float> b2(b, b + n);
+        std::sort(a2.begin(), a2.end());
+        std::sort(b2.begin(), b2.end());
+        return nmse(a2.data(), b2.data(), n);
+    }
+};
+
