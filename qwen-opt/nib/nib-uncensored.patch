+        const auto & a = ad.layers[l];
+        PhysLayerWeights & L = weights_.layers[l];
+        L.lora_wo_a = upload(a.wo_a);
+        L.lora_wo_b = upload(a.wo_b);
+        L.lora_dn_a = upload(a.dn_a);
+        L.lora_dn_b = upload(a.dn_b);
+        L.lora_dn_b_stride = a.dn_b_shared ? 0 : N_EMBD;
+        shared += a.dn_b_shared ? 1 : 0;
+    }
+    weights_.lora_emb_a = upload(ad.emb_a);
+    weights_.lora_emb_b = upload(ad.emb_b);
+    std::printf("[lora] %s ('%s', scale %.3g): attn_output + ffn_down_exps x %d layers (every loop visit) "
+                "+ token_embd, %d/%d layers share one expert B, %.1f MiB\n",
+                cfg_.lora_path.c_str(), ad.name.c_str(), ad.scale, N_LAYER_PHYS, shared, N_LAYER_PHYS,
+                (double)bytes / (1024.0 * 1024.0));
+    std::fflush(stdout);
+}
