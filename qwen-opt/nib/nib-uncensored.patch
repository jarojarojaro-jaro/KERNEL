diff --git a/src/lora_adapter.cpp b/src/lora_adapter.cpp
new file mode 100644
index 0000000..f53c64e
--- /dev/null
+++ b/src/lora_adapter.cpp
@@ -0,0 +1,263 @@
+#include "lora_adapter.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <stdexcept>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace inkling {
+
+namespace {
+
+enum : uint32_t {
+    GGUF_T_UINT8 = 0, GGUF_T_INT8 = 1, GGUF_T_UINT16 = 2, GGUF_T_INT16 = 3,
+    GGUF_T_UINT32 = 4, GGUF_T_INT32 = 5, GGUF_T_FLOAT32 = 6, GGUF_T_BOOL = 7,
+    GGUF_T_STRING = 8, GGUF_T_ARRAY = 9, GGUF_T_UINT64 = 10, GGUF_T_INT64 = 11,
+    GGUF_T_FLOAT64 = 12,
+};
+
+enum : uint32_t { GGML_F32 = 0, GGML_F16 = 1, GGML_Q8_0 = 8, GGML_NVFP4 = 40 };
+
+struct Cursor {
+    const uint8_t * p;
+    const uint8_t * end;
+    void need(size_t n) const {
+        if (static_cast<size_t>(end - p) < n) throw std::runtime_error("gguf: truncated file");
+    }
+    template <class T> T get() {
+        need(sizeof(T));
+        T v;
+        std::memcpy(&v, p, sizeof(T));
+        p += sizeof(T);
+        return v;
+    }
+    std::string str() {
+        const uint64_t n = get<uint64_t>();
+        need(static_cast<size_t>(n));
+        std::string s(reinterpret_cast<const char *>(p), static_cast<size_t>(n));
+        p += n;
+        return s;
+    }
+};
+
+size_t scalar_size(uint32_t t) {
+    static const size_t sz[13] = {1, 1, 2, 2, 4, 4, 4, 1, 0, 0, 8, 8, 8};
+    if (t >= 13 || sz[t] == 0) throw std::runtime_error("gguf: unsupported metadata type");
+    return sz[t];
+}
+
+double scalar_value(Cursor & c, uint32_t t) {
+    switch (t) {
+        case GGUF_T_UINT8:   return c.get<uint8_t>();
+        case GGUF_T_INT8:    return c.get<int8_t>();
+        case GGUF_T_UINT16:  return c.get<uint16_t>();
+        case GGUF_T_INT16:   return c.get<int16_t>();
+        case GGUF_T_UINT32:  return c.get<uint32_t>();
+        case GGUF_T_INT32:   return c.get<int32_t>();
+        case GGUF_T_FLOAT32: return c.get<float>();
+        case GGUF_T_BOOL:    return c.get<uint8_t>();
+        case GGUF_T_UINT64:  return (double) c.get<uint64_t>();
+        case GGUF_T_INT64:   return (double) c.get<int64_t>();
+        case GGUF_T_FLOAT64: return c.get<double>();
+        default: throw std::runtime_error("gguf: unsupported scalar type");
+    }
+}
+
+size_t raw_bytes(size_t n, uint32_t type, const std::string & name) {
+    switch (type) {
+        case GGML_F32:   return n * 4;
+        case GGML_F16:   return n * 2;
+        case GGML_Q8_0:  return (n / 32) * 34;
+        case GGML_NVFP4: return (n / 64) * 36;
+        default:
+            throw std::runtime_error("gguf: tensor " + name + " has unsupported type " + std::to_string(type));
+    }
+}
+
+} // namespace
+
+size_t GgufView::Tensor::nelem() const {
+    size_t n = 1;
+    for (uint64_t d : dims) n *= static_cast<size_t>(d);
+    return n;
+}
+
+GgufView::GgufView(const std::string & path) : path_(path) {
+    fd_ = ::open(path.c_str(), O_RDONLY);
+    if (fd_ < 0) throw std::runtime_error("cannot open " + path);
+    struct stat st {};
+    if (::fstat(fd_, &st) != 0 || st.st_size <= 0) {
+        ::close(fd_);
+        throw std::runtime_error("cannot stat " + path);
+    }
+    size_ = static_cast<size_t>(st.st_size);
+    map_ = ::mmap(nullptr, size_, PROT_READ, MAP_PRIVATE, fd_, 0);
+    if (map_ == MAP_FAILED) {
+        ::close(fd_);
+        throw std::runtime_error("mmap failed for " + path);
+    }
+    try {
+        const uint8_t * base = static_cast<const uint8_t *>(map_);
+        Cursor c{base, base + size_};
+        c.need(4);
+        if (std::memcmp(c.p, "GGUF", 4) != 0) throw std::runtime_error(path + " is not a GGUF file");
+        c.p += 4;
+        if (c.get<uint32_t>() != 3) throw std::runtime_error(path + ": need GGUF v3");
+        const uint64_t n_tensors = c.get<uint64_t>();
+        const uint64_t n_kv = c.get<uint64_t>();
+        uint32_t alignment = 32;
+        for (uint64_t i = 0; i < n_kv; ++i) {
+            const std::string key = c.str();
+            const uint32_t t = c.get<uint32_t>();
+            if (t == GGUF_T_STRING) {
+                strs_[key] = c.str();
+            } else if (t == GGUF_T_ARRAY) {
+                const uint32_t et = c.get<uint32_t>();
+                const uint64_t n = c.get<uint64_t>();
+                if (et == GGUF_T_STRING) {
+                    for (uint64_t j = 0; j < n; ++j) c.str();
+                } else {
+                    const size_t bytes = static_cast<size_t>(n) * scalar_size(et);
+                    c.need(bytes);
+                    c.p += bytes;
+                }
+            } else {
+                const double v = scalar_value(c, t);
+                nums_[key] = v;
+                if (key == "general.alignment") alignment = static_cast<uint32_t>(v);
+            }
+        }
+        std::vector<Tensor> list;
+        list.reserve(static_cast<size_t>(n_tensors));
+        std::vector<uint64_t> offsets;
+        for (uint64_t i = 0; i < n_tensors; ++i) {
+            Tensor t;
+            t.name = c.str();
+            const uint32_t nd = c.get<uint32_t>();
+            t.dims.resize(nd);
+            for (uint32_t d = 0; d < nd; ++d) t.dims[d] = c.get<uint64_t>();
+            t.type = c.get<uint32_t>();
+            offsets.push_back(c.get<uint64_t>());
+            list.push_back(std::move(t));
+        }
+        const size_t pos = static_cast<size_t>(c.p - base);
+        const size_t data_start = (pos + alignment - 1) & ~static_cast<size_t>(alignment - 1);
+        for (size_t i = 0; i < list.size(); ++i) {
+            Tensor & t = list[i];
+            t.nbytes = raw_bytes(t.nelem(), t.type, t.name);
+            const size_t at = data_start + static_cast<size_t>(offsets[i]);
+            if (at + t.nbytes > size_) throw std::runtime_error("gguf: tensor out of bounds: " + t.name);
+            t.data = base + at;
+            const std::string name = t.name;
+            tensors_.emplace(name, std::move(t));
+        }
+    } catch (...) {
+        ::munmap(map_, size_);
+        ::close(fd_);
+        throw;
+    }
+}
+
+GgufView::~GgufView() {
+    if (map_ != nullptr && map_ != MAP_FAILED) ::munmap(map_, size_);
+    if (fd_ >= 0) ::close(fd_);
+}
+
+const GgufView::Tensor * GgufView::find(const std::string & name) const {
+    const auto it = tensors_.find(name);
+    return it == tensors_.end() ? nullptr : &it->second;
+}
+
+const GgufView::Tensor & GgufView::get(const std::string & name) const {
+    const Tensor * t = find(name);
+    if (t == nullptr) throw std::runtime_error(path_ + ": missing tensor " + name);
+    return *t;
+}
+
+bool GgufView::num(const std::string & key, double & out) const {
+    const auto it = nums_.find(key);
+    if (it == nums_.end()) return false;
+    out = it->second;
+    return true;
+}
+
+bool GgufView::str(const std::string & key, std::string & out) const {
+    const auto it = strs_.find(key);
+    if (it == strs_.end()) return false;
+    out = it->second;
+    return true;
+}
+
+namespace {
+
+std::vector<float> f32_tensor(const GgufView & g, const std::string & name,
+                              const std::vector<uint64_t> & dims) {
+    const GgufView::Tensor & t = g.get(name);
+    if (t.type != GGML_F32) throw std::runtime_error("LoRA tensor " + name + " is not F32");
+    if (t.dims != dims) {
+        std::string want, have;
+        for (uint64_t d : dims) want += std::to_string(d) + " ";
+        for (uint64_t d : t.dims) have += std::to_string(d) + " ";
+        throw std::runtime_error("LoRA tensor " + name + " has shape [ " + have + "], expected [ " + want +
+                                 "] (only rank-1 inkling2_loop adapters are supported)");
+    }
+    std::vector<float> v(t.nelem());
+    std::memcpy(v.data(), t.data, v.size() * sizeof(float));
+    for (float x : v) {
+        if (!std::isfinite(x)) throw std::runtime_error("LoRA tensor " + name + " has a non-finite value");
+    }
+    return v;
+}
+
+} // namespace
+
+LoraAdapterHost load_lora_adapter(const std::string & path) {
+    GgufView g(path);
+    std::string s;
+    if (!g.str("general.type", s) || s != "adapter") throw std::runtime_error(path + ": general.type is not 'adapter'");
+    if (!g.str("adapter.type", s) || s != "lora") throw std::runtime_error(path + ": adapter.type is not 'lora'");
+    if (!g.str("general.architecture", s) || s != "inkling2_loop") {
+        throw std::runtime_error(path + ": adapter architecture '" + s + "' is not inkling2_loop");
+    }
+    LoraAdapterHost a;
+    a.path = path;
+    g.str("general.name", a.name);
+    double alpha = 0.0;
+    g.num("adapter.lora_alpha", alpha);
+    // llama.cpp: scale = alpha / rank (alpha == 0 -> 1); every tensor here is rank 1.
+    a.scale = (alpha != 0.0) ? static_cast<float>(alpha) : 1.0f;
+
+    const size_t expected = static_cast<size_t>(N_LAYER_PHYS) * 4 + 2;
+    if (g.tensors().size() != expected) {
+        throw std::runtime_error(path + ": expected " + std::to_string(expected) + " LoRA tensors (attn_output + "
+                                 "ffn_down_exps per layer + token_embd), found " + std::to_string(g.tensors().size()));
+    }
+    auto scaled = [&](std::vector<float> v) {
+        if (a.scale != 1.0f) for (float & x : v) x *= a.scale;
+        return v;
+    };
+    for (int l = 0; l < N_LAYER_PHYS; ++l) {
+        const std::string p = "blk." + std::to_string(l) + ".";
+        LoraAdapterHost::Layer & L = a.layers[l];
+        L.wo_a = f32_tensor(g, p + "attn_output.weight.lora_a", {N_Q, 1});
+        L.wo_b = scaled(f32_tensor(g, p + "attn_output.weight.lora_b", {1, N_EMBD}));
+        L.dn_a = f32_tensor(g, p + "ffn_down_exps.weight.lora_a", {N_FF_EXP, 1, N_EXPERT});
+        std::vector<float> b = scaled(f32_tensor(g, p + "ffn_down_exps.weight.lora_b", {1, N_EMBD, N_EXPERT}));
+        bool shared = true;
+        for (int e = 1; e < N_EXPERT && shared; ++e) {
+            shared = std::memcmp(b.data(), b.data() + (size_t) e * N_EMBD, N_EMBD * sizeof(float)) == 0;
+        }
+        L.dn_b_shared = shared;
+        if (shared) b.resize(N_EMBD);
+        L.dn_b = std::move(b);
+    }
+    a.emb_a = f32_tensor(g, "token_embd.weight.lora_a", {1, VOCAB_PADDED});
+    a.emb_b = scaled(f32_tensor(g, "token_embd.weight.lora_b", {1, N_EMBD}));
+    return a;
+}
+
+} // namespace inkling
diff --git a/src/lora_adapter.hpp b/src/lora_adapter.hpp
new file mode 100644
index 0000000..d3aa8bc
--- /dev/null
+++ b/src/lora_adapter.hpp
@@ -0,0 +1,74 @@
+#pragma once
+
+// Rank-1 LoRA adapters for Inkling 2 Mini (AtomicChat "Uncensored": a refusal
+// direction abliterated out of every residual writer).  The adapter GGUF holds,
+// per physical layer, blk.N.attn_output.weight.lora_{a,b} and
+// blk.N.ffn_down_exps.weight.lora_{a,b} (one pair per expert), plus
+// token_embd.weight.lora_{a,b}.  The engine applies W' = W + scale * B A at run
+// time in every writer epilogue (y += B (A x)); see include/lora.h.
+
+#include "inkling_engine.h"
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace inkling {
+
+// Read-only mmap view of a GGUF v3 file: scalar metadata + tensor directory.
+class GgufView {
+public:
+    struct Tensor {
+        std::string           name;
+        std::vector<uint64_t> dims;    // ne[0..], ne0 innermost
+        uint32_t              type = 0;
+        size_t                nbytes = 0;
+        const uint8_t *       data = nullptr;
+        size_t nelem() const;
+    };
+
+    explicit GgufView(const std::string & path);   // throws std::runtime_error
+    ~GgufView();
+    GgufView(const GgufView &) = delete;
+    GgufView & operator=(const GgufView &) = delete;
+
+    const Tensor * find(const std::string & name) const;
+    const Tensor & get(const std::string & name) const;   // throws if missing
+    const std::unordered_map<std::string, Tensor> & tensors() const { return tensors_; }
+    // Scalar metadata (numbers as double, strings verbatim); arrays are skipped.
+    bool num(const std::string & key, double & out) const;
+    bool str(const std::string & key, std::string & out) const;
+    const std::string & path() const { return path_; }
+
+private:
+    std::string path_;
+    void * map_ = nullptr;
+    size_t size_ = 0;
+    int fd_ = -1;
+    std::unordered_map<std::string, Tensor> tensors_;
+    std::unordered_map<std::string, double> nums_;
+    std::unordered_map<std::string, std::string> strs_;
+};
+
+// Host copy of a rank-1 adapter, B already multiplied by scale = alpha / rank.
+struct LoraAdapterHost {
+    std::string path;
+    std::string name;
+    float scale = 1.0f;
+    struct Layer {
+        std::vector<float> wo_a;   // [N_Q]
+        std::vector<float> wo_b;   // [N_EMBD]
+        std::vector<float> dn_a;   // [N_EXPERT][N_FF_EXP]
+        std::vector<float> dn_b;   // [N_EXPERT][N_EMBD], or [N_EMBD] when every expert shares B
+        bool dn_b_shared = false;
+    };
+    Layer layers[N_LAYER_PHYS];
+    std::vector<float> emb_a;      // [VOCAB_PADDED]
+    std::vector<float> emb_b;      // [N_EMBD]
+};
+
+// Loads and validates an inkling2_loop rank-1 LoRA GGUF (throws std::runtime_error).
+LoraAdapterHost load_lora_adapter(const std::string & path);
+
+} // namespace inkling
