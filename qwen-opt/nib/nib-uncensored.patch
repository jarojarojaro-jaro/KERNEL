index 0000000..1e02c02
--- /dev/null
+++ b/tests/lora_check.cpp
@@ -0,0 +1,348 @@
+// nib-lora-check: CPU-only check of the --lora (rank-1 LoRA / abliteration) math.
+//
+//   nib-lora-check <model.gguf> <lora.gguf>
+//
+// 1. Adapter structure: B unit-norm, the same direction for attn_output and every
+//    expert of ffn_down_exps, A = -B^T W (sign + scale convention, NVFP4 scale2
+//    included) against this pack's dequantised attn_output, ffn_down_exps and
+//    token_embd rows.
+// 2. Kernel arithmetic: the exact float operations of the GPU epilogues
+//    (include/lora.h helpers + a replica of the wo block reduction) against an
+//    FP64 reference of y + B (A x), and the fused-partials order against the
+//    canonical one (bit-identical).
+// 3. Effect: the component of the writer output along B before/after the LoRA.
+// Exit code 0 = every check inside its bound.
+
+#include "lora.h"
+#include "lora_adapter.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace inkling;
+
+namespace {
+
+float half_to_f32(uint16_t h) {
+    const uint32_t s = (uint32_t)(h & 0x8000u) << 16;
+    uint32_t e = (h >> 10) & 0x1Fu, m = h & 0x3FFu, bits;
+    if (e == 0) {
+        if (m == 0) {
+            bits = s;
+        } else {
+            int ex = -1;
+            do { ++ex; m <<= 1; } while ((m & 0x400u) == 0);
+            bits = s | ((uint32_t)(127 - 15 - ex) << 23) | ((m & 0x3FFu) << 13);
+        }
+    } else if (e == 0x1F) {
+        bits = s | 0x7F800000u | (m << 13);
+    } else {
+        bits = s | ((e - 15u + 127u) << 23) | (m << 13);
+    }
+    float f;
+    std::memcpy(&f, &bits, 4);
+    return f;
+}
+
+float ue4m3_to_f32(uint8_t x) {   // ggml_ue4m3_to_fp32 (NVFP4 convention: raw * 0.5)
+    if (x == 0 || x == 0x7F) return 0.0f;
+    const int exp = (x >> 3) & 0xF, man = x & 0x7;
+    const float raw = exp == 0 ? std::ldexp((float)man, -9) : std::ldexp(1.0f + (float)man / 8.0f, exp - 7);
+    return raw * 0.5f;
+}
+
+const int8_t kFp4[16] = {0, 1, 2, 3, 4, 6, 8, 12, 0, -1, -2, -3, -4, -6, -8, -12};
+
+// GGML Q8_0 row `row` of a [K, rows] tensor.
+void deq_q8_row(const uint8_t * raw, size_t row, int K, float * out) {
+    const uint8_t * p = raw + row * (size_t)(K / 32) * 34;
+    for (int b = 0; b < K / 32; ++b, p += 34) {
+        uint16_t hd;
+        std::memcpy(&hd, p, 2);
+        const float d = half_to_f32(hd);
+        for (int j = 0; j < 32; ++j) out[b * 32 + j] = d * (float)(int8_t)p[2 + j];
+    }
+}
+
+// GGML NVFP4 row (64-weight blocks: 4 ue4m3 sub-scales + 32 nibble bytes) times scale2.
+// order 0: byte j of sub-block s holds elements s*16 + j (lo) and s*16 + 8 + j (hi);
+// order 1: elements s*16 + 2j (lo) and s*16 + 2j + 1 (hi).
+void deq_nvfp4_row(const uint8_t * raw, size_t row, int K, float s2, int order, float * out) {
+    const uint8_t * p = raw + row * (size_t)(K / 64) * 36;
+    for (int b = 0; b < K / 64; ++b, p += 36) {
+        for (int s = 0; s < 4; ++s) {
+            const float d = ue4m3_to_f32(p[s]) * s2;
+            for (int j = 0; j < 8; ++j) {
+                const uint8_t q = p[4 + s * 8 + j];
+                const int lo = order == 0 ? s * 16 + j : s * 16 + 2 * j;
+                const int hi = order == 0 ? s * 16 + 8 + j : s * 16 + 2 * j + 1;
+                out[b * 64 + lo] = (float)kFp4[q & 0xF] * d;
+                out[b * 64 + hi] = (float)kFp4[q >> 4] * d;
+            }
+        }
+    }
+}
+
+struct Cmp {
+    double rel = 0.0;     // |a - v| / |v|
+    double ratio = 0.0;   // (a . v) / (v . v)
+};
+
+Cmp compare(const float * a, const std::vector<double> & v) {
+    double d2 = 0.0, v2 = 0.0, av = 0.0;
+    for (size_t i = 0; i < v.size(); ++i) {
+        d2 += (a[i] - v[i]) * (a[i] - v[i]);
+        v2 += v[i] * v[i];
+        av += a[i] * v[i];
+    }
+    return {std::sqrt(d2 / v2), av / v2};
+}
+
+uint64_t g_rng = 0x9E3779B97F4A7C15ull;
+float rnd() {   // ~N(0, 1) (Irwin-Hall of 4)
+    double s = 0.0;
+    for (int i = 0; i < 4; ++i) {
+        g_rng = g_rng * 6364136223846793005ull + 1442695040888963407ull;
+        s += (double)(g_rng >> 11) / 9007199254740992.0;
+    }
+    return (float)((s - 2.0) * std::sqrt(3.0));
+}
+
+// Replica of kernels_lora.hip lora_wo_dot: 256 threads, thread t owns float4
+// t, t + 256, t + 512 (sequential fmaf over x, y, z, w), xor butterfly per
+// wave32, the 8 wave sums added in order.
+float wo_dot_replica(const float * a, const float * x) {
+    float p[256];
+    for (int t = 0; t < 256; ++t) {
+        float acc = 0.0f;
+        for (int i = 0; i < 3; ++i) {
+            const int q = 4 * (t + 256 * i);
+            for (int c = 0; c < 4; ++c) acc = std::fmaf(a[q + c], x[q + c], acc);
+        }
+        p[t] = acc;
+    }
+    float s = 0.0f;
+    for (int w = 0; w < 8; ++w) {
+        float v[32];
+        for (int l = 0; l < 32; ++l) v[l] = p[w * 32 + l];
+        for (int off = 16; off > 0; off >>= 1) {
+            float nv[32];
+            for (int l = 0; l < 32; ++l) nv[l] = v[l] + v[l ^ off];
+            std::memcpy(v, nv, sizeof(v));
+        }
+        s = (w == 0) ? v[0] : s + v[0];
+    }
+    return s;
+}
+
+int g_fail = 0;
+void gate(bool ok, const char * what) {
+    if (!ok) {
+        ++g_fail;
+        std::printf("  FAIL: %s\n", what);
+    }
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        std::fprintf(stderr, "usage: %s <Inkling-2-Mini-NVFP4-Mixed.gguf> <lora.gguf>\n", argv[0]);
+        return 2;
+    }
+    try {
+        const LoraAdapterHost ad = load_lora_adapter(argv[2]);
+        const GgufView model(argv[1]);
+        std::printf("adapter '%s' scale=%.3f\n", ad.name.c_str(), ad.scale);
+
+        // ---- 1. structure + A = -B^T W ------------------------------------
+        int nvfp4_order = -1;
+        std::vector<float> row(N_Q);
+        double worst_wo = 0.0, worst_dn = 0.0, worst_ratio = 0.0;
+        for (int l = 0; l < N_LAYER_PHYS; ++l) {
+            const auto & L = ad.layers[l];
+            double n2 = 0.0, dd = 0.0;
+            for (int i = 0; i < N_EMBD; ++i) {
+                n2 += (double)L.wo_b[i] * L.wo_b[i];
+                const float bd = L.dn_b[i];   // expert 0 (or the shared row)
+                dd = std::max(dd, (double)std::fabs(bd - L.wo_b[i]));
+            }
+            const std::string p = "blk." + std::to_string(l) + ".";
+            // attn_output: [K = N_Q, rows = N_EMBD] Q8_0
+            const auto & two = model.get(p + "attn_output.weight");
+            std::vector<double> v(N_Q, 0.0);
+            for (int r = 0; r < N_EMBD; ++r) {
+                deq_q8_row(two.data, r, N_Q, row.data());
+                const double br = L.wo_b[r];
+                for (int k = 0; k < N_Q; ++k) v[k] -= br * row[k];
+            }
+            const Cmp cw = compare(L.wo_a.data(), v);
+            // ffn_down_exps: 4 experts, [K = N_FF_EXP, rows = N_EMBD, N_EXPERT]
+            const auto & tdn = model.get(p + "ffn_down_exps.weight");
+            const bool nv = tdn.type == 40;
+            std::vector<float> s2(N_EXPERT, 1.0f);
+            if (nv) std::memcpy(s2.data(), model.get(p + "ffn_down_exps.scale").data, N_EXPERT * sizeof(float));
+            double rel_dn = 0.0, ratio_dn = 0.0;
+            const int experts[4] = {0, 41, 86, 127};
+            for (int e : experts) {
+                const float * be = L.dn_b.data() + (L.dn_b_shared ? 0 : (size_t)e * N_EMBD);
+                Cmp best{1e30, 0.0};
+                for (int order = 0; order < (nv ? 2 : 1); ++order) {
+                    if (nv && nvfp4_order >= 0 && order != nvfp4_order) continue;
+                    std::vector<double> ve(N_FF_EXP, 0.0);
+                    for (int r = 0; r < N_EMBD; ++r) {
+                        const size_t gr = (size_t)e * N_EMBD + r;
+                        if (nv) deq_nvfp4_row(tdn.data, gr, N_FF_EXP, s2[e], order, row.data());
+                        else    deq_q8_row(tdn.data, gr, N_FF_EXP, row.data());
+                        for (int k = 0; k < N_FF_EXP; ++k) ve[k] -= (double)be[r] * row[k];
+                    }
+                    const Cmp c = compare(L.dn_a.data() + (size_t)e * N_FF_EXP, ve);
+                    if (nv && nvfp4_order < 0) {
+                        std::printf("  [nvfp4 nibble order %d] blk.%d expert %d: rel=%.4f ratio=%.4f\n",
+                                    order, l, e, c.rel, c.ratio);
+                    }
+                    if (c.rel < best.rel) {
+                        best = c;
+                        if (nv && nvfp4_order < 0 && order == 1) nvfp4_order = 1;
+                    }
+                }
+                if (nv && nvfp4_order < 0) nvfp4_order = 0;
+                rel_dn = std::max(rel_dn, best.rel);
+                ratio_dn = std::max(ratio_dn, std::fabs(best.ratio - 1.0));
+            }
+            std::printf("blk.%-2d |B|=%.6f B_dn==B_wo:%s(max %.2g, shared=%d)  wo: rel=%.4f ratio=%.4f  "
+                        "down(%s): rel<=%.4f |ratio-1|<=%.4f\n",
+                        l, std::sqrt(n2), dd < 1e-6 ? "yes" : "NO", dd, (int)L.dn_b_shared, cw.rel, cw.ratio,
+                        nv ? "nvfp4" : "q8_0", rel_dn, ratio_dn);
+            gate(std::fabs(std::sqrt(n2) - 1.0) < 1e-3, "B is not unit-norm");
+            worst_wo = std::max(worst_wo, cw.rel);
+            worst_dn = std::max(worst_dn, rel_dn);
+            worst_ratio = std::max({worst_ratio, std::fabs(cw.ratio - 1.0), ratio_dn});
+        }
+        // token_embd: [K = N_EMBD, rows = VOCAB_PADDED] Q8_0, A[t] = -B . E[t]
+        {
+            const auto & te = model.get("token_embd.weight");
+            std::vector<double> v;
+            std::vector<float> a;
+            std::vector<float> e(N_EMBD);
+            for (int t = 1000; t < 1256; ++t) {
+                deq_q8_row(te.data, t, N_EMBD, e.data());
+                double d = 0.0;
+                for (int i = 0; i < N_EMBD; ++i) d += (double)ad.emb_b[i] * e[i];
+                v.push_back(-d);
+                a.push_back(ad.emb_a[t]);
+            }
+            const Cmp c = compare(a.data(), v);
+            std::printf("token_embd rows 1000..1255: rel=%.4f ratio=%.4f\n", c.rel, c.ratio);
+            worst_ratio = std::max(worst_ratio, std::fabs(c.ratio - 1.0));
+            gate(c.rel < 0.05, "token_embd A != -B.E");
+        }
+        std::printf("A = -B^T W: worst rel wo=%.4f down=%.4f, worst |ratio-1|=%.4f (nvfp4 nibble order %d)\n",
+                    worst_wo, worst_dn, worst_ratio, nvfp4_order);
+        gate(worst_wo < 0.05, "attn_output A != -B^T W");
+        gate(worst_dn < 0.25, "ffn_down_exps A != -B^T W (scale2 / sign convention)");
+        gate(worst_ratio < 0.05, "A is not -B^T W at scale 1");
+
+        // ---- 2 + 3. kernel arithmetic + effect, layer 0 --------------------
+        {
+            const auto & L = ad.layers[0];
+            const auto & two = model.get("blk.0.attn_output.weight");
+            std::vector<float> x(N_Q);
+            for (float & f : x) f = 0.05f * rnd();
+            std::vector<float> yf(N_EMBD);
+            std::vector<double> yref(N_EMBD);
+            double ax = 0.0;
+            for (int k = 0; k < N_Q; ++k) ax += (double)L.wo_a[k] * x[k];
+            double err = 0.0, ymax = 0.0, pb = 0.0, pa = 0.0, n0 = 0.0, n1 = 0.0;
+            const float s = wo_dot_replica(L.wo_a.data(), x.data());
+            for (int r = 0; r < N_EMBD; ++r) {
+                deq_q8_row(two.data, r, N_Q, row.data());
+                double y = 0.0;
+                for (int k = 0; k < N_Q; ++k) y += (double)row[k] * x[k];
+                yf[r] = (float)y;
+                yref[r] = y + (double)L.wo_b[r] * ax;
+                const float x3 = std::fmaf(L.wo_b[r], s, yf[r]);       // sconv_post_res_one
+                err = std::max(err, std::fabs(x3 - yref[r]));
+                ymax = std::max(ymax, std::fabs(yref[r]));
+                pb += (double)L.wo_b[r] * y;   n0 += y * y;
+                pa += (double)L.wo_b[r] * x3;  n1 += (double)x3 * x3;
+            }
+            std::printf("wo kernel math : s=%.6g (fp64 %.6g)  max|x3-ref|/max|ref| = %.3g  "
+                        "B-component %.4f -> %.4f of |y|\n",
+                        s, ax, err / ymax, pb / std::sqrt(n0), pa / std::sqrt(n1));
+            gate(err / ymax < 1e-5, "wo epilogue math");
+            gate(std::fabs(pa / std::sqrt(n1)) < 0.1 * std::fabs(pb / std::sqrt(n0)) + 1e-3,
+                 "wo LoRA does not remove the B component");
+        }
+        {
+            const auto & L = ad.layers[0];
+            const auto & tdn = model.get("blk.0.ffn_down_exps.weight");
+            std::vector<float> s2(N_EXPERT, 1.0f);
+            std::memcpy(s2.data(), model.get("blk.0.ffn_down_exps.scale").data, N_EXPERT * sizeof(float));
+            const int32_t ids[TOP_K] = {3, 17, 40, 64, 77, 90, 101, 127};
+            float w[TOP_K], wsum = 0.0f;
+            for (float & f : w) { f = 0.1f + std::fabs(rnd()); wsum += f; }
+            for (float & f : w) f *= EXPERT_W_SCALE / wsum;
+            std::vector<float> act((size_t)TOP_K * N_FF_EXP);
+            for (float & f : act) f = 0.2f * rnd();
+            float s[TOP_K], ws[TOP_K], s_fused[TOP_K];
+            for (int k = 0; k < TOP_K; ++k) {
+                const float * ae = L.dn_a.data() + (size_t)ids[k] * N_FF_EXP;
+                const float * hk = act.data() + (size_t)k * N_FF_EXP;
+                s[k] = lora_moe_s_ref(ae, hk);   // lora_moe_s kernel
+                // fused kernel: block c copies its 48 act values to LDS, thread 0 runs the chunk
+                float part[LORA_MOE_NCHUNK];
+                for (int c = 0; c < LORA_MOE_NCHUNK; ++c) {
+                    float lds[LORA_MOE_CHUNK];
+                    std::memcpy(lds, hk + c * LORA_MOE_CHUNK, sizeof(lds));
+                    part[c] = lora_chunk_dot(ae + c * LORA_MOE_CHUNK, lds);
+                }
+                s_fused[k] = part[0];
+                for (int c = 1; c < LORA_MOE_NCHUNK; ++c) s_fused[k] += part[c];
+                ws[k] = lora_moe_ws(ids[k], w[k], s[k]);
+            }
+            gate(std::memcmp(s, s_fused, sizeof(s)) == 0, "fused-partials s != canonical s (bitwise)");
+            const int bstride = L.dn_b_shared ? 0 : N_EMBD;
+            double err = 0.0, ymax = 0.0, pb = 0.0, pa = 0.0, n0 = 0.0, n1 = 0.0;
+            std::vector<std::vector<float>> slot(TOP_K, std::vector<float>(N_EMBD));
+            for (int k = 0; k < TOP_K; ++k) {
+                for (int r = 0; r < N_EMBD; ++r) {
+                    deq_nvfp4_row(tdn.data, (size_t)ids[k] * N_EMBD + r, N_FF_EXP, s2[ids[k]],
+                                  nvfp4_order < 0 ? 0 : nvfp4_order, row.data());
+                    double y = 0.0;
+                    for (int j = 0; j < N_FF_EXP; ++j) y += (double)row[j] * act[(size_t)k * N_FF_EXP + j];
+                    slot[k][r] = (float)y * w[k];
+                }
+            }
+            for (int r = 0; r < N_EMBD; ++r) {
+                double ref = 0.0, base = 0.0;
+                for (int k = 0; k < TOP_K; ++k) {
+                    const float * ae = L.dn_a.data() + (size_t)ids[k] * N_FF_EXP;
+                    double sa = 0.0;
+                    for (int j = 0; j < N_FF_EXP; ++j) sa += (double)ae[j] * act[(size_t)k * N_FF_EXP + j];
+                    base += slot[k][r];
+                    ref += slot[k][r] + (double)w[k] * sa * L.dn_b[(size_t)ids[k] * bstride + r];
+                }
+                const float sum = ((slot[0][r] + slot[1][r]) + (slot[2][r] + slot[3][r])) +
+                                  ((slot[4][r] + slot[5][r]) + (slot[6][r] + slot[7][r]));
+                const float x3 = sum + lora_moe_delta(ws, ids, L.dn_b.data(), bstride, r);
+                err = std::max(err, std::fabs(x3 - ref));
+                ymax = std::max(ymax, std::fabs(ref));
+                pb += (double)L.dn_b[r] * base; n0 += base * base;
+                pa += (double)L.dn_b[r] * x3;   n1 += (double)x3 * x3;
+            }
+            std::printf("moe kernel math: max|x3-ref|/max|ref| = %.3g  B-component %.4f -> %.4f of |y|\n",
+                        err / ymax, pb / std::sqrt(n0), pa / std::sqrt(n1));
+            gate(err / ymax < 1e-5, "moe epilogue math");
+        }
+    } catch (const std::exception & ex) {
+        std::fprintf(stderr, "nib-lora-check: %s\n", ex.what());
+        return 2;
+    }
+    std::printf("%s (%d failed checks)\n", g_fail == 0 ? "PASS" : "FAIL", g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
