+        {"--moe-dn-v3",      cfg_.moe_dn_v3 < 0},
+        {"--fdot2-moe",      cfg_.fdot2_moe == 0},
+        {"--moe-q8-fused",   cfg_.moe_q8_fused == 0},
+        {"--fdot2-q8moe",    cfg_.fdot2_q8moe == 0},
+    };
+    for (const Knob & k : knobs) {
+        if (!k.stock) {
+            throw std::runtime_error(std::string(k.flag) + " selects a kernel without the LoRA term (keep the default)");
+        }
+    }
+    const LoraAdapterHost ad = load_lora_adapter(cfg_.lora_path);
+    size_t bytes = 0;
+    auto upload = [&](const std::vector<float> & v) {
+        void * p = nullptr;
+        const size_t n = v.size() * sizeof(float);
+        HIP_CHECK(hipMalloc(&p, n));
+        HIP_CHECK(hipMemcpy(p, v.data(), n, hipMemcpyHostToDevice));
+        weights_.gpu_allocs.push_back(p);
+        weights_.total_vram_bytes += n;
+        bytes += n;
+        return static_cast<float *>(p);
+    };
+    int shared = 0;
