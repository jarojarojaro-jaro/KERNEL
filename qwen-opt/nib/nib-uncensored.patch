diff --git a/include/lora.h b/include/lora.h
new file mode 100644
index 0000000..a0d6c77
--- /dev/null
+++ b/include/lora.h
@@ -0,0 +1,104 @@
+#pragma once
+
+// Rank-1 LoRA (W' = W + B A, B pre-scaled by alpha / rank) on Inkling 2 Mini's
+// residual writers, applied at run time inside the existing epilogues:
+//
+//   attn_output   : x3[r] = fmaf(B[r], s, x3[r]),            s = A . fa_out (3072)
+//   ffn_down_exps : x3[r] = sum8[r] + delta[r],
+//                   delta[r] = sum_k fmaf(w_k * s_k, B_{e_k}[r], .), s_k = A_{e_k} . act_k (1152)
+//   token_embd    : e[r]  = fmaf(B[r], A[tok], e[r])          (before tok_norm)
+//
+// x3 is the raw pre-conv value of the 4-tap post short conv, so the LoRA term is
+// part of everything downstream (conv, residual, short-conv history, verify
+// rollback rows), exactly as if W itself had been changed.  w_k is the routed
+// expert weight (topk_w, i.e. without the NVFP4 per-expert scale2: A was taken
+// against the dequantised BF16 weights).
+//
+// Every MoE path computes s_k in ONE canonical order (24 chunks of 48: each
+// chunk a sequential fmaf chain, the chunks summed in order) and every path
+// adds delta to the same tree sum, so the m-row verify / batched paths stay
+// bit-identical to the single-token decode (selftest A/B/C).
+
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+
+#include "inkling_engine.h"
+
+namespace inkling {
+
+static constexpr int LORA_MOE_CHUNK   = 48;
+static constexpr int LORA_MOE_NCHUNK  = N_FF_EXP / LORA_MOE_CHUNK;   // 24
+static constexpr int LORA_MOE_PARTS   = TOP_K * LORA_MOE_NCHUNK;     // 192 (= fused MoE grid)
+static_assert(N_FF_EXP % LORA_MOE_CHUNK == 0, "chunking");
+
+// attn_output of one physical layer.
+struct LoraWo {
+    const float * a = nullptr;   // [N_Q]
+    const float * b = nullptr;   // [N_EMBD]
+    float *       s = nullptr;   // [rows] s[t] = A . x[t] (launch_lora_wo_s; read by the wo epilogues)
+};
+
+// ffn_down_exps of one physical layer, plus the per-visit scratch.
+struct LoraMoe {
+    const float * a = nullptr;   // [N_EXPERT][N_FF_EXP]
+    const float * b = nullptr;   // [N_EXPERT][N_EMBD] (b_stride = N_EMBD) or [N_EMBD] (b_stride = 0)
+    int     b_stride = 0;
+    float * s = nullptr;         // [rows][TOP_K]  s_k = A_{e_k} . act_k
+    float * part = nullptr;      // [LORA_MOE_PARTS] fused-kernel chunk partials
+};
+
+__host__ __device__ inline float lora_chunk_dot(const float * a, const float * h) {
+    float p = 0.0f;
+    for (int i = 0; i < LORA_MOE_CHUNK; ++i) {
+        p = fmaf(a[i], h[i], p);
+    }
+    return p;
+}
+
+// Canonical s = A_e . act (24 chunk partials summed in order).
+__host__ __device__ inline float lora_moe_s_ref(const float * a_e, const float * act) {
+    float s = lora_chunk_dot(a_e, act);
+    for (int c = 1; c < LORA_MOE_NCHUNK; ++c) {
+        s += lora_chunk_dot(a_e + c * LORA_MOE_CHUNK, act + c * LORA_MOE_CHUNK);
+    }
+    return s;
+}
+
+// Routed weight times s for slot k (0 for an invalid expert id, like coef).
+__host__ __device__ inline float lora_moe_ws(int32_t e, float w, float s) {
+    return ((unsigned) e < (unsigned) N_EXPERT) ? w * s : 0.0f;
+}
+
+// delta[r] for one token: ws[k] / ids[k] of its 8 slots.
+__host__ __device__ inline float lora_moe_delta(const float * ws, const int32_t * ids,
+                                                const float * b, int b_stride, int r) {
+    float d = 0.0f;
+    for (int k = 0; k < TOP_K; ++k) {
+        const int32_t e = ids[k];
+        const int ex = ((unsigned) e < (unsigned) N_EXPERT) ? e : 0;
+        d = fmaf(ws[k], b[(size_t) ex * b_stride + r], d);
+    }
+    return d;
+}
+
+// A launcher reached a fallback that has no LoRA term: refuse rather than
+// silently run the stock (censored) math.
+inline void lora_require(bool ok, const char * where) {
+    if (!ok) {
+        std::fprintf(stderr, "[lora] %s has no --lora support\n", where);
+        std::abort();
+    }
+}
+
+// ---- kernels_lora.hip -------------------------------------------------------
+// s[t] = A . x[t * xstride + 0..N_Q) into lw.s[t] for t < m (deterministic block reduction).
+void launch_lora_wo_s(const LoraWo & lw, const float * x, int xstride, int m, hipStream_t stream);
+// Prefill: y[t * ystride + r] = fmaf(B[r], A . x[t], y[...]) in place, t < m.
+void launch_lora_wo_apply(const LoraWo & lw, const float * x, int xstride, float * y, int ystride,
+                          int m, hipStream_t stream);
+// s[t * TOP_K + k] = canonical A_{ids[t][k]} . act[(t * TOP_K + k) * N_FF_EXP ...], t < m.
+void launch_lora_moe_s(const LoraMoe & lm, const float * act, const int32_t * topk_ids, int m,
+                       hipStream_t stream);
+
+} // namespace inkling
