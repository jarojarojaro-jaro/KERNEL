index 0000000..4a4aa04
--- /dev/null
+++ b/src/kernels_lora.hip
@@ -0,0 +1,119 @@
+// ============================================================================
+// kernels_lora.hip -- the small stand-alone pieces of the --lora path
+// (include/lora.h): the attn_output scalar s = A . fa_out (decode / verify /
+// batch rows, consumed by the wo epilogues), the prefill in-place wo update,
+// and the canonical MoE scalars s_k for the paths whose gate_up and down are
+// separate launches (Q8 decode, m-row verify, multi-slot batch).
+// ============================================================================
+
+#include "lora.h"
+
+#include <hip/hip_runtime.h>
+
+namespace inkling {
+namespace {
+
+constexpr int LORA_WO_THREADS = 256;
+static_assert(N_Q == 3 * 4 * LORA_WO_THREADS, "lora_wo_dot: 3 float4 per thread");
+
+// A . x for one row, the same order in every caller (tests/lora_check.cpp
+// replicates it): thread t owns float4 t, t + 256, t + 512 (sequential fmaf),
+// xor butterfly per wave32, the 8 wave sums added in order.  Every thread
+// returns the result.
+__device__ __forceinline__ float lora_wo_dot(const float * __restrict__ a, const float * __restrict__ x) {
+    __shared__ float s_w[LORA_WO_THREADS / 32];
+    const int t = threadIdx.x;
+    const float4 * a4 = reinterpret_cast<const float4 *>(a);
+    const float4 * x4 = reinterpret_cast<const float4 *>(x);
+    float p = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        const float4 av = a4[t + LORA_WO_THREADS * i];
+        const float4 xv = x4[t + LORA_WO_THREADS * i];
+        p = fmaf(av.x, xv.x, p);
+        p = fmaf(av.y, xv.y, p);
+        p = fmaf(av.z, xv.z, p);
+        p = fmaf(av.w, xv.w, p);
+    }
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        p += __shfl_xor(p, off, 32);
+    }
+    if ((t & 31) == 0) {
+        s_w[t >> 5] = p;
+    }
+    __syncthreads();
+    float s = s_w[0];
+#pragma unroll
+    for (int w = 1; w < LORA_WO_THREADS / 32; ++w) {
+        s += s_w[w];
+    }
+    return s;
+}
+
+__global__ void __launch_bounds__(LORA_WO_THREADS)
+lora_wo_s_kernel(const float * __restrict__ a, const float * __restrict__ x, int xstride,
+                 float * __restrict__ s) {
+    const int row = blockIdx.x;
+    const float v = lora_wo_dot(a, x + (size_t) row * xstride);
+    if (threadIdx.x == 0) {
+        s[row] = v;
+    }
+}
+
+__global__ void __launch_bounds__(LORA_WO_THREADS)
+lora_wo_apply_kernel(const float * __restrict__ a, const float * __restrict__ b,
+                     const float * __restrict__ x, int xstride, float * __restrict__ y, int ystride) {
+    const int row = blockIdx.x;
+    const float s = lora_wo_dot(a, x + (size_t) row * xstride);
+    float * yr = y + (size_t) row * ystride;
+    for (int r = threadIdx.x; r < N_EMBD; r += LORA_WO_THREADS) {
+        yr[r] = fmaf(b[r], s, yr[r]);
+    }
+}
+
+// One wave32 per (row, slot): lane c < 24 runs chunk c, lane 0 sums the chunks
+// in order (== lora_moe_s_ref, == the fused MoE kernel's partials).
+__global__ void __launch_bounds__(32)
+lora_moe_s_kernel(const float * __restrict__ a, const float * __restrict__ act,
+                  const int32_t * __restrict__ topk_ids, float * __restrict__ s) {
+    const int p    = blockIdx.x;            // row * TOP_K + slot
+    const int lane = threadIdx.x;
+    const int32_t e = topk_ids[p];
+    const int ex = ((unsigned) e < (unsigned) N_EXPERT) ? e : 0;
+    float part = 0.0f;
+    if (lane < LORA_MOE_NCHUNK) {
+        part = lora_chunk_dot(a + (size_t) ex * N_FF_EXP + lane * LORA_MOE_CHUNK,
+                              act + (size_t) p * N_FF_EXP + lane * LORA_MOE_CHUNK);
+    }
+    float sum = __shfl(part, 0, 32);
+#pragma unroll
+    for (int c = 1; c < LORA_MOE_NCHUNK; ++c) {
+        const float v = __shfl(part, c, 32);
+        sum += v;
+    }
+    if (lane == 0) {
+        s[p] = sum;
+    }
+}
+
+} // namespace
+
+void launch_lora_wo_s(const LoraWo & lw, const float * x, int xstride, int m, hipStream_t stream) {
+    if (m <= 0) return;
+    lora_wo_s_kernel<<<m, LORA_WO_THREADS, 0, stream>>>(lw.a, x, xstride, lw.s);
+}
+
+void launch_lora_wo_apply(const LoraWo & lw, const float * x, int xstride, float * y, int ystride,
+                          int m, hipStream_t stream) {
+    if (m <= 0) return;
+    lora_wo_apply_kernel<<<m, LORA_WO_THREADS, 0, stream>>>(lw.a, lw.b, x, xstride, y, ystride);
+}
+
+void launch_lora_moe_s(const LoraMoe & lm, const float * act, const int32_t * topk_ids, int m,
+                       hipStream_t stream) {
+    if (m <= 0) return;
+    lora_moe_s_kernel<<<m * TOP_K, 32, 0, stream>>>(lm.a, act, topk_ids, lm.s);
+}
+
+} // namespace inkling
