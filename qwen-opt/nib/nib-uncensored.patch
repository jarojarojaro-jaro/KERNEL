+constexpr int LORA_PF_THREADS = 256;
+
+__global__ void __launch_bounds__(LORA_PF_THREADS)
+moe_lora_prefill_kernel(const int32_t * __restrict__ tok_slots, const int32_t * __restrict__ topk_ids,
