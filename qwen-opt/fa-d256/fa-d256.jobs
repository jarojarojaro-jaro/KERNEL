# fa-d256 (2026-11-08, XtxFaPrefill; report 68a #1/#3, 68d §5.1/§5.3, 68c #1): PR #31746 port + lossless variants of the
# FA D=256 prompt kernel, one binary (~/wt/fa-d256), env GGML_HIP_FA_D256_VAR. Build inside the job (Main's OK), then
# ISA stats -> gate -> microbench -> md5 -> pick the best bit-identical variant -> llama-bench ABBA at depth ->
# production arm pair (long md5, spec_sweep, 255k fill) -> restore :8080. ~3 h with the build.
fa-stop8080|200|~/qwen-opt/fa-d256|./chat8080.sh stop
fa-build|5400|~/qwen-opt/fa-d256|./build.sh
fa-isa|120|~/qwen-opt/fa-d256|[ -f BUILD_OK ] && ./isa.sh
fa-gate|3600|~/qwen-opt/fa-d256|./gate.sh
fa-micro|2400|~/qwen-opt/fa-d256|./micro.sh
fa-md5|3000|~/qwen-opt/fa-d256|./md5.sh
fa-select|60|~/qwen-opt/fa-d256|python3 ./select.py
fa-bench|2700|~/qwen-opt/fa-d256|./bench.sh
fa-armA|2400|~/qwen-opt/fa-d256|./arm.sh A 0
fa-armB|2400|~/qwen-opt/fa-d256|./arm.sh B BEST
fa-restore8080|400|~/qwen-opt/fa-d256|./chat8080.sh restore
