diff --git a/ggml/src/ggml-cuda/fwht.cuh b/ggml/src/ggml-cuda/fwht.cuh
index d936874..e26e783 100644
--- a/ggml/src/ggml-cuda/fwht.cuh
+++ b/ggml/src/ggml-cuda/fwht.cuh
@@ -51,6 +51,90 @@ static __device__ __forceinline__ void fwht_row_warp(const T * src, float * dst,
     }
 }
 
+// In-register block FWHT over N floats held as NE = N/NT per thread, element i*NT + tid in reg[i].
+// B < N runs independent width-B transforms over consecutive B-element segments in ascending stride order.
+template <int N, int NT, int B = N>
+static __device__ __forceinline__ void ggml_cuda_fwht_block_butterfly(float * reg, float * s, const int tid, const int lane) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int NE        = N / NT;
+    static_assert(NE >= 1 && N % NT == 0 && NT % warp_size == 0, "bad FWHT block shape");
+    static_assert(B <= N && N % B == 0 && B >= warp_size, "bad FWHT segment width");
+
+    // stages within a warp: partner differs in the lane bits
+#ifdef GGML_CUDA_DPP_REDUCE
+    static_assert(warp_size == 32, "DPP butterfly requires wave32");
+#define FWHT_DPP_STAGE(H)                                                  \
+    if constexpr ((H) < B) {                                               \
+        _Pragma("unroll")                                                  \
+        for (int j = 0; j < NE; j++) {                                     \
+            const float val  = reg[j];                                     \
+            const float val2 = ggml_cuda_xor_dpp<(H)>(val);                \
+            reg[j] = (lane & (H)) == 0 ? val + val2 : val2 - val;          \
+        }                                                                  \
+    }
+    FWHT_DPP_STAGE(1)
+    FWHT_DPP_STAGE(2)
+    FWHT_DPP_STAGE(4)
+    FWHT_DPP_STAGE(8)
+    FWHT_DPP_STAGE(16)
+#undef FWHT_DPP_STAGE
+#else
+#pragma unroll
+    for (int h = 1; h < warp_size && h < B; h *= 2) {
+#pragma unroll
+        for (int j = 0; j < NE; j++) {
+            const float val  = reg[j];
+            const float val2 = __shfl_xor_sync(0xFFFFFFFF, val, h, warp_size);
+            reg[j] = (lane & h) == 0 ? val + val2 : val2 - val;
+        }
+    }
+#endif // GGML_CUDA_DPP_REDUCE
+
+    // stages across warps: partner differs in the thread-index bits above the lane
+#pragma unroll
+    for (int h = warp_size; h < NT && h < B; h *= 2) {
+#pragma unroll
+        for (int j = 0; j < NE; j++) {
+            s[j * NT + tid] = reg[j];
+        }
+        __syncthreads();
+#pragma unroll
+        for (int j = 0; j < NE; j++) {
+            const float val  = reg[j];
+            const float val2 = s[j * NT + (tid ^ h)];
+            reg[j] = (tid & h) == 0 ? val + val2 : val2 - val;
+        }
+        __syncthreads();
+    }
+
+    // stages above the block width: partner is another register of the same thread
+#pragma unroll
+    for (int h = NT; h < B; h *= 2) {
+        const int step = h / NT;
+#pragma unroll
+        for (int j = 0; j < NE; j += 2 * step) {
+#pragma unroll
+            for (int k = 0; k < step; k++) {
+                const float x = reg[j + k];
+                const float y = reg[j + k + step];
+                reg[j + k]        = x + y;
+                reg[j + k + step] = x - y;
+            }
+        }
+    }
+}
+
+// Threads per block for one-block-per-transform FWHT kernels at width n.
+// Uses wider blocks (min(n/2, 1024)) for small batch counts; stages run in the same order so output is bit-identical.
+static inline int ggml_cuda_fwht_block_threads(const int n, const int64_t n_transforms) {
+    static const int wide_override = getenv("GGML_CUDA_FWHT_NT") ? atoi(getenv("GGML_CUDA_FWHT_NT")) : 0;
+    if (n_transforms > 64 || n < 512) {
+        return 256;
+    }
+    const int nt = wide_override > 0 ? wide_override : (n / 2 < 1024 ? n / 2 : 1024);
+    return (nt == 512 || nt == 1024) && nt <= n ? nt : 256;
+}
+
 bool ggml_cuda_op_mul_mat_use_fwht(const struct ggml_tensor * op);
 
 // Returns whether the Fast Walsh-Hadamard transform could be used.
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
