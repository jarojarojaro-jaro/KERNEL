 }
 
+static bool ggml_cuda_bz_fwht_q8_enabled() {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_BZ_FWHT_Q8");
+    return enabled;
+}
+
+static bool ggml_cuda_bz_norm_fwht_enabled() {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_BZ_NORM_FWHT");
+    return enabled;
+}
+
+struct ggml_cuda_fwht_q8_uses {
+    const ggml_tensor * aliases[8] = {};
+    int     n_aliases    = 0;
+    int64_t K            = 0;
+    int64_t ncols        = 0;
+    int     last_use_idx = -1;
+};
+
+// Every use of the Hadamard output at node i_mm (directly or through contiguous full-tensor reshape views)
+// must be src1 of a quantized MUL_MAT that routes to ggml_cuda_mul_mat_vec_q with matching [K, ncols].
+static bool ggml_cuda_fwht_q8_find_uses(const ggml_cgraph * cgraph, const int i_mm, const int cc, ggml_cuda_fwht_q8_uses & u) {
+    const ggml_tensor * mm = cgraph->nodes[i_mm];
+    u = ggml_cuda_fwht_q8_uses();
+    u.aliases[0] = mm;
+    u.n_aliases  = 1;
+    int uses_expected = ggml_node_get_use_count(cgraph, i_mm);
+    int uses_found    = 0;
+    for (int j = i_mm + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * t = cgraph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = t->src[s];
+            if (!src) {
+                continue;
+            }
+            bool is_alias = false;
+            for (int a = 0; a < u.n_aliases; ++a) {
+                if (src == u.aliases[a]) {
+                    is_alias = true;
+                    break;
+                }
+            }
+            if (!is_alias) {
+                continue;
+            }
+            uses_found++;
+            if (t->op == GGML_OP_RESHAPE && (t->view_src == mm || t->view_src == src) && t->data == mm->data &&
+                    ggml_nelements(t) == ggml_nelements(mm) && ggml_is_contiguous(t)) {
+                if (u.n_aliases == 8 || (t->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                    return false;
+                }
+                u.aliases[u.n_aliases++] = t;
+                uses_expected += ggml_node_get_use_count(cgraph, j);
+                continue;
+            }
+            const ggml_tensor * w  = t->src[0];
+            const ggml_type     ct = w ? w->type : GGML_TYPE_COUNT;
+            if (t->op != GGML_OP_MUL_MAT || s != 1 || !ggml_is_quantized(ct) ||
+                    ggml_get_op_params_i32(t, 1) == GGML_HINT_SRC0_IS_HADAMARD ||
+                    t->type != GGML_TYPE_F32 || src->type != GGML_TYPE_F32 || !ggml_is_contiguous(src) ||
+                    src->ne[2] != 1 || src->ne[3] != 1 ||
+                    (u.K != 0 && (src->ne[0] != u.K || src->ne[1] != u.ncols)) ||
+                    !ggml_cuda_should_use_mmvq(ct, cc, src->ne[1])) {
+                return false;
+            }
+            if (w->buffer && ggml_backend_buffer_get_usage(w->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+                    ggml_nbytes(w) != ggml_backend_buffer_get_alloc_size(w->buffer, w) && w->view_src) {
+                return false;
+            }
+            u.K            = src->ne[0];
+            u.ncols        = src->ne[1];
+            u.last_use_idx = j;
+        }
+        if (uses_found > 0 && uses_found == uses_expected) {
+            break;
+        }
+    }
+    return uses_found > 0 && uses_found == uses_expected && u.K != 0;
+}
+
+// [GGML_HIP_BZ_FWHT_Q8] Fuse [MUL(signs) -> RESHAPE ->] MUL_MAT(Hadamard) + quantize_q8_1 into one launch
+// whose q8_1 rows are shared by all downstream MMVQ consumers (e.g. q/k/v, wqkv/wqkv_gate, gate/up).
+// Returns the number of nodes consumed (3 or 1) or 0 to fall through.
+static int ggml_cuda_try_fwht_q8(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int node_idx) {
+    if (!ggml_cuda_bz_fwht_q8_enabled() || ctx.curr_stream_no != 0 ||
+            !ctx.stream_context().concurrent_events.empty()) {
+        return 0;
+    }
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+
+    const ggml_tensor * x     = nullptr;
+    const ggml_tensor * signs = nullptr;
+    ggml_tensor *       mm    = nullptr;
+    int consumed = 0;
+    int i_mm     = -1;
+
+    if (ggml_can_fuse_subgraph(cgraph, node_idx, { GGML_OP_MUL, GGML_OP_RESHAPE, GGML_OP_MUL_MAT }, { node_idx + 2 })) {
+        const ggml_tensor * mul     = cgraph->nodes[node_idx];
+        const ggml_tensor * reshape = cgraph->nodes[node_idx + 1];
+        mm    = cgraph->nodes[node_idx + 2];
+        x     = mul->src[0];
+        signs = mul->src[1];
+        const bool pattern_ok = x && signs && mm->src[0] && mm->src[0]->type == GGML_TYPE_F32 &&
+            ggml_get_op_params_i32(mm, 1) == GGML_HINT_SRC0_IS_HADAMARD &&
+            mm->src[1] == reshape && reshape->src[0] == mul &&
+            signs->ne[1] == 1 && signs->ne[2] == 1 && signs->ne[3] == 1 &&
+            signs->type == GGML_TYPE_F32 && mul->type == x->type &&
+            ggml_is_contiguous(x) && ggml_is_contiguous(signs) &&
+            signs->ne[0] == x->ne[0] && signs->ne[0] % mm->src[0]->ne[0] == 0;
+        if (!pattern_ok) {
+            return 0;
+        }
+        consumed = 3;
+        i_mm     = node_idx + 2;
+    } else {
+        mm = cgraph->nodes[node_idx];
+        if (mm->op != GGML_OP_MUL_MAT || !mm->src[0] || mm->src[0]->type != GGML_TYPE_F32 ||
+                ggml_get_op_params_i32(mm, 1) != GGML_HINT_SRC0_IS_HADAMARD) {
+            return 0;
+        }
+        x = mm->src[1];
+        if (!x || !ggml_is_contiguous(x) || !ggml_are_same_shape(x, mm)) {
+            return 0;
+        }
+        consumed = 1;
+        i_mm     = node_idx;
+    }
+
+    const int n = (int) mm->src[0]->ne[0];
+    if (mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) || (mm->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            (x->type != GGML_TYPE_F32 && x->type != GGML_TYPE_F16) || ggml_nelements(mm) != ggml_nelements(x)) {
+        return 0;
+    }
+    if (signs && x->type != GGML_TYPE_F32) {
+        return 0;
+    }
+
+    ggml_cuda_fwht_q8_uses u;
+    if (!ggml_cuda_fwht_q8_find_uses(cgraph, i_mm, cc, u)) {
+        return 0;
+    }
+    const int64_t K          = u.K;
+    const int64_t ncols      = u.ncols;
+    const int64_t ne0_padded = GGML_PAD(K, MATRIX_ROW_PADDING);
+    if (K % n != 0 || !ggml_cuda_fwht_quantize_supported(n, K) || (signs && signs->ne[0] != K) || ne0_padded % n != 0) {
+        return 0;
+    }
+
+    const bool out_aliases_in = ggml_cuda_tensors_overlap(x, mm) || (signs && ggml_cuda_tensors_overlap(signs, mm));
+    const size_t q8_bytes = (size_t) (ncols * ne0_padded) * sizeof(block_q8_1) / QK8_1;
+    void * out = mm->data;
+    if (out_aliases_in || q8_bytes > ggml_nbytes(mm)) {
+        out = ctx.fwht_q8().alloc_scratch_slot(node_idx, u.last_use_idx, q8_bytes, ctx.stream());
+        if (out == nullptr) {
+            return 0;
+        }
+    }
+
+    fwht_quantize_row_q8_1_cuda(x->data, x->type, signs ? (const float *) signs->data : nullptr, n,
+                                out, K, ne0_padded, ncols, ctx.stream());
+
+    ggml_backend_cuda_context::ggml_cuda_fwht_q8 e;
+    e.ne0   = ne0_padded;
+    e.ncols = ncols;
+    e.data  = out;
+    for (int a = 0; a < u.n_aliases; ++a) {
+        ctx.fwht_q8().set(u.aliases[a], e);
+    }
+    return consumed;
+}
+
+struct ggml_cuda_norm_fwht_q8_plan {
+    ggml_cuda_fwht_q8_uses uses;
+    void * out = nullptr;
+};
+
+static bool ggml_cuda_norm_fwht_q8_prepare(
+        ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, const int node_idx, const int i_mm,
+        const int64_t n, const ggml_tensor * const * srcs, const int n_srcs,
+        const bool mm_data_safe_for_q8, ggml_cuda_norm_fwht_q8_plan & plan) {
+    if (!ggml_cuda_bz_fwht_q8_enabled()) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    const ggml_tensor * mm = cgraph->nodes[i_mm];
+    if (mm->flags & GGML_TENSOR_FLAG_OUTPUT) {
+        return false;
+    }
+    ggml_cuda_fwht_q8_uses & u = plan.uses;
+    if (!ggml_cuda_fwht_q8_find_uses(cgraph, i_mm, cc, u) ||
+            u.K != n || u.K * u.ncols != ggml_nelements(mm) || GGML_PAD(u.K, MATRIX_ROW_PADDING) != u.K) {
+        return false;
+    }
+    bool can_use_mm_data = mm_data_safe_for_q8;
+    if (can_use_mm_data && u.ncols > 1) {
+        // multi-row q8_1 writes packed rows that can clobber earlier input rows in other blocks
+        for (int k = 0; k < n_srcs; ++k) {
+            if (ggml_cuda_tensors_overlap(mm, srcs[k])) {
+                can_use_mm_data = false;
+                break;
+            }
+        }
+    }
+    const size_t q8_bytes = (size_t) (u.ncols * u.K) * sizeof(block_q8_1) / QK8_1;
+    if (can_use_mm_data && q8_bytes <= ggml_nbytes(mm)) {
+        plan.out = mm->data;
+        return true;
+    }
+    plan.out = ctx.fwht_q8().alloc_scratch_slot(node_idx, u.last_use_idx, q8_bytes, ctx.stream());
+    return plan.out != nullptr;
+}
+
+// [GGML_HIP_BZ_NORM_FWHT] Fuse [ADD ->] RMS_NORM -> MUL(weight) [... intervening ...] -> MUL(signs) -> RESHAPE -> MUL_MAT(Hadamard)
+// (+ optional direct q8_1 output when GGML_HIP_BZ_FWHT_Q8=1) into one launch.
+// Returns nodes_to_skip for ggml_cuda_try_fuse, or 0 to fall through.
+static int ggml_cuda_try_norm_fwht(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    if (!ggml_cuda_bz_norm_fwht_enabled() || cuda_ctx->curr_stream_no != 0 ||
+            !cuda_ctx->stream_context().concurrent_events.empty()) {
+        return 0;
+    }
+
+    auto bad_exact_alias = [](const ggml_tensor * dst, const ggml_tensor * src) {
+        return ggml_cuda_tensors_overlap(dst, src) &&
+               !(dst->data == src->data && ggml_nbytes(dst) == ggml_nbytes(src));
+    };
+
+    ggml_tensor * node     = cgraph->nodes[i];
+    ggml_tensor * add      = nullptr;
+    ggml_tensor * rms_norm = nullptr;
+    ggml_tensor * mul_w    = nullptr;
+    const ggml_tensor * a  = nullptr;
+    const ggml_tensor * b  = nullptr;
+    int i_rms  = -1;
+    int i_mulw = -1;
+
+    if (node->op == GGML_OP_ADD) {
+        if (i + 5 >= cgraph->n_nodes) {
+            return 0;
+        }
+        add      = node;
+        i_rms    = i + 1;
+        i_mulw   = i + 2;
+        rms_norm = cgraph->nodes[i_rms];
+        mul_w    = cgraph->nodes[i_mulw];
+        a        = add->src[0];
+        b        = add->src[1];
+        if (rms_norm->op != GGML_OP_RMS_NORM || rms_norm->src[0] != add ||
+                !a || !b || a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 ||
+                !ggml_are_same_shape(a, b) || !ggml_are_same_shape(a, add) ||
+                !ggml_is_contiguous(a) || !ggml_is_contiguous(b) || !ggml_is_contiguous(add) ||
+                bad_exact_alias(add, a) || bad_exact_alias(add, b)) {
+            return 0;
+        }
+    } else if (node->op == GGML_OP_RMS_NORM) {
+        if (i + 4 >= cgraph->n_nodes) {
+            return 0;
+        }
+        i_rms    = i;
+        i_mulw   = i + 1;
+        rms_norm = node;
+        mul_w    = cgraph->nodes[i_mulw];
+        a        = rms_norm->src[0];
+        if (!a || a->type != GGML_TYPE_F32 || !ggml_is_contiguous(a)) {
+            return 0;
+        }
+    } else {
+        return 0;
+    }
+
+    const ggml_tensor * x_ref = add ? (const ggml_tensor *) add : a;
+    const int64_t ncols = x_ref->ne[0];
+    if (mul_w->op != GGML_OP_MUL || (mul_w->src[0] != rms_norm && mul_w->src[1] != rms_norm) ||
+            rms_norm->type != GGML_TYPE_F32 || mul_w->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(rms_norm) || !ggml_is_contiguous(mul_w) ||
+            !ggml_are_same_shape(x_ref, rms_norm) || !ggml_are_same_shape(rms_norm, mul_w) ||
+            ggml_node_get_use_count(cgraph, i_rms) != 1 || (rms_norm->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            !ggml_cuda_add_rms_norm_fwht_supported((int) ncols, 512)) {
+        return 0;
+    }
+
+    const ggml_tensor * weight = mul_w->src[0] == rms_norm ? mul_w->src[1] : mul_w->src[0];
+    if (!weight || weight->op != GGML_OP_NONE || weight->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(weight) || weight->ne[0] != ncols || ggml_nrows(weight) != 1) {
+        return 0;
+    }
+
+    const bool need_normed = (mul_w->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+                             ggml_node_get_use_count(cgraph, i_mulw) > 1;
+    if ((add && ggml_cuda_tensors_overlap(weight, add)) ||
+            (need_normed && (ggml_cuda_tensors_overlap(weight, mul_w) ||
+                             bad_exact_alias(mul_w, a) || (b && bad_exact_alias(mul_w, b)) ||
+                             (add && ggml_cuda_tensors_overlap(mul_w, add))))) {
+        return 0;
+    }
+
+    // Look ahead for MUL(mul_w, signs) -> RESHAPE -> MUL_MAT(Hadamard)
+    int j = -1;
+    const int k_max = std::min(cgraph->n_nodes - 3, i_mulw + 16);
+    for (int k = i_mulw + 1; k <= k_max; ++k) {
+        const ggml_tensor * t0 = cgraph->nodes[k];
+        const ggml_tensor * t1 = cgraph->nodes[k + 1];
+        const ggml_tensor * t2 = cgraph->nodes[k + 2];
+        if (t0->op == GGML_OP_MUL && t0->src[0] == mul_w && t0->src[1] && t0->src[1]->op == GGML_OP_NONE &&
+                t1->op == GGML_OP_RESHAPE && t1->src[0] == t0 &&
+                t2->op == GGML_OP_MUL_MAT && t2->src[1] == t1 && t2->src[0] && t2->src[0]->type == GGML_TYPE_F32 &&
+                ggml_get_op_params_i32(t2, 1) == GGML_HINT_SRC0_IS_HADAMARD) {
+            j = k;
+            break;
+        }
+    }
+    if (j < 0) {
+        return 0;
+    }
+
+    ggml_tensor * mul_s   = cgraph->nodes[j];
+    ggml_tensor * reshape = cgraph->nodes[j + 1];
+    ggml_tensor * mm      = cgraph->nodes[j + 2];
+    const ggml_tensor * signs = mul_s->src[1];
+    if (mul_s->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul_s, mul_w) ||
+            signs->type != GGML_TYPE_F32 || !ggml_is_contiguous(signs) ||
+            signs->ne[0] != ncols || ggml_nrows(signs) != 1 ||
+            mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) || mm->ne[0] != mm->src[0]->ne[0] ||
+            !ggml_cuda_add_rms_norm_fwht_supported((int) ncols, (int) mm->src[0]->ne[0]) ||
+            ggml_nelements(mm) != ggml_nelements(x_ref) ||
+            (mul_s->flags & GGML_TENSOR_FLAG_OUTPUT) || (reshape->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            !(mul_s->flags & GGML_TENSOR_FLAG_COMPUTE) || !(mm->flags & GGML_TENSOR_FLAG_COMPUTE) ||
+            ggml_node_get_use_count(cgraph, j) != 1 || ggml_node_get_use_count(cgraph, j + 1) != 1 ||
+            (add && ggml_cuda_tensors_overlap(signs, add)) ||
+            (need_normed && ggml_cuda_tensors_overlap(signs, mul_w))) {
+        return 0;
+    }
+
+    const bool has_intervening = j > i_mulw + 1;
+    bool mm_overlaps_intervening = false;
+    for (int k = i_mulw + 1; k < j; ++k) {
+        const ggml_tensor * t = cgraph->nodes[k];
+        if (!ggml_cuda_is_view_or_noop(t)) {
+            if (ggml_cuda_tensors_overlap(t, mul_w)) {
+                return 0;
+            }
+            if (ggml_cuda_tensors_overlap(mm, t)) {
+                mm_overlaps_intervening = true;
+            }
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * ts = t->src[s];
+            if (!ts || ts == mul_w || ts == rms_norm || ts == add) {
+                continue;
+            }
+            if (ggml_cuda_tensors_overlap(mm, ts)) {
+                mm_overlaps_intervening = true;
+            }
+        }
+    }
+
+    const bool mm_base_safe = !mm_overlaps_intervening &&
+        !ggml_cuda_tensors_overlap(mm, weight) && !ggml_cuda_tensors_overlap(mm, signs) &&
+        (!add || !ggml_cuda_tensors_overlap(mm, add)) &&
+        (!need_normed || !ggml_cuda_tensors_overlap(mm, mul_w));
+    const bool mm_q8_safe = mm_base_safe &&
+        (!has_intervening || (!ggml_cuda_tensors_overlap(mm, a) && (!b || !ggml_cuda_tensors_overlap(mm, b))));
+    const bool mm_f32_safe = mm_base_safe &&
+        (has_intervening ? (!ggml_cuda_tensors_overlap(mm, a) && (!b || !ggml_cuda_tensors_overlap(mm, b)))
+                         : (!bad_exact_alias(mm, a) && (!b || !bad_exact_alias(mm, b))));
+
+    const ggml_tensor * srcs[2] = { a, b };
+    const int n_srcs = b ? 2 : 1;
+    ggml_cuda_norm_fwht_q8_plan plan;
+    const bool use_q8 = ggml_cuda_norm_fwht_q8_prepare(*cuda_ctx, cgraph, i, j + 2, ncols, srcs, n_srcs, mm_q8_safe, plan);
+    if (!use_q8 && !mm_f32_safe) {
+        return 0;
+    }
+
+    ggml_tensor * normed_out = need_normed ? mul_w : nullptr;
+    if (use_q8) {
+        ggml_cuda_op_add_rms_norm_fwht_fused(*cuda_ctx, add, rms_norm, weight, signs, normed_out, mm, plan.out);
+        ggml_backend_cuda_context::ggml_cuda_fwht_q8 e;
+        e.ne0   = plan.uses.K;
+        e.ncols = plan.uses.ncols;
+        e.data  = plan.out;
+        for (int a_idx = 0; a_idx < plan.uses.n_aliases; ++a_idx) {
+            cuda_ctx->fwht_q8().set(plan.uses.aliases[a_idx], e);
+        }
+    } else {
+        ggml_cuda_op_add_rms_norm_fwht_fused(*cuda_ctx, add, rms_norm, weight, signs, normed_out, mm, nullptr);
+    }
+
+    if (!has_intervening) {
+        return (j + 2) - i;
+    }
+    if (!use_q8 || plan.out == mm->data) {
+        cuda_ctx->mmvq_q8_cache_invalidate_if_written(mm);
+    }
+    cuda_ctx->nodes_done_ahead.push_back(mul_s);
+    cuda_ctx->nodes_done_ahead.push_back(mm);
+    return i_mulw - i;
+}
