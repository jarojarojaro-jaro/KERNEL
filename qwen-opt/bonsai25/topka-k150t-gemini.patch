+bool ggml_cuda_add_rms_norm_fwht_supported(const int ncols, const int blk) {
+    return (ncols == 1024 || ncols == 2048 || ncols == 4096 || ncols == 5120) &&
+           (blk == 512 || blk == 1024 || blk == 2048 || blk == 4096) && ncols % blk == 0;
