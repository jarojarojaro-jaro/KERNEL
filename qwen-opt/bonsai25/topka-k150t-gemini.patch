index 78aae3f..fc43742 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1669,6 +1669,70 @@ struct ggml_backend_cuda_context {
     // start of every graph evaluation.
     std::vector<const ggml_tensor *> nodes_done_ahead;
 
+    // [GGML_HIP_BZ_FWHT_Q8] Hadamard transform outputs quantized directly to block_q8_1 for MMVQ consumers
+    // (shared across q/k/v, wqkv/wqkv_gate, gate/up). Stored in mm->data when non-aliasing, else in a fixed
+    // pre-allocated scratch slot (allocated once outside stream capture so HIP graphs and PM4 tapes keep fixed pointers).
+    struct ggml_cuda_fwht_q8 {
+        int64_t ne0   = 0;
+        int64_t ncols = 0;
+        void *  data  = nullptr;
+    };
+
+    struct ggml_cuda_fwht_q8_state {
+        static constexpr int    n_slots   = 4;
+        static constexpr size_t slot_size = 2u << 20; // 2 MiB per slot
+
+        std::unordered_map<const ggml_tensor *, ggml_cuda_fwht_q8> entries;
+        void * scratch_buf = nullptr;
+        int    slot_free_after[n_slots] = { -1, -1, -1, -1 };
+        int    next_slot = 0;
+
+        void reset() {
+            entries.clear();
+            for (int s = 0; s < n_slots; ++s) {
+                slot_free_after[s] = -1;
+            }
+            next_slot = 0;
+        }
+
+        const ggml_cuda_fwht_q8 * find(const ggml_tensor * t) const {
+            if (entries.empty()) {
+                return nullptr;
+            }
+            const auto it = entries.find(t);
+            return it == entries.end() ? nullptr : &it->second;
+        }
+
+        void set(const ggml_tensor * t, const ggml_cuda_fwht_q8 & e) {
+            entries[t] = e;
+        }
+
+        void * alloc_scratch_slot(const int node_idx, const int last_use_idx, const size_t bytes, cudaStream_t stream) {
+            if (bytes > slot_size) {
+                return nullptr;
+            }
+            if (scratch_buf == nullptr) {
+                cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+                CUDA_CHECK(cudaStreamIsCapturing(stream, &capture_status));
+                if (capture_status != cudaStreamCaptureStatusNone) {
+                    return nullptr;
+                }
+                CUDA_CHECK(cudaMalloc(&scratch_buf, (size_t) n_slots * slot_size));
+            }
+            for (int k = 0; k < n_slots; ++k) {
+                const int s = (next_slot + k) % n_slots;
+                if (slot_free_after[s] < node_idx) {
+                    slot_free_after[s] = last_use_idx;
+                    next_slot = (s + 1) % n_slots;
+                    return (char *) scratch_buf + (size_t) s * slot_size;
+                }
+            }
+            return nullptr;
+        }
+    } fwht_q8_state;
+
+    ggml_cuda_fwht_q8_state & fwht_q8() { return fwht_q8_state; }
+
     // Zeroed device counters for kernels whose last block to finish (atomic ticket) runs a follow-up step; such a
     // kernel leaves the counters it used zeroed. n_tickets of them, allocated outside of stream capture
     // (ggml_cuda_tickets in ggml-cuda.cu).
