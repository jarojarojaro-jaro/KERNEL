+// [Residual ADD +] RMS_NORM + MUL(weight) + MUL(signs) + FWHT (+ optional q8_1 quantization), one row per block.
+// Bit-identical to [ADD +] rms_norm_f32<1024, true> followed by signed fwht_cuda_block [+ quantize_q8_1].
+// All loads of a and b finish before the block reduce barrier, so a single-row q8_1 output may safely alias a or b.
+template <int N, int B, bool has_add, bool q8>
+static __global__ void __launch_bounds__(1024, 1) add_rms_norm_fwht_f32(
+        const float * a, const float * b, const float * weight, const float * signs,
+        float * sum, float * normed, void * dst_ptr, const float eps, const float fwht_scale) {
+    constexpr int NT = 1024;
+    constexpr int NE = N / NT;
+    static_assert(N % NT == 0, "transform width must be a multiple of the block");
+
+    __shared__ float s_sum[NT / WARP_SIZE];
+    __shared__ float s_fwht[N];
+
+    if constexpr (N == 5120) {
+        ggml_cuda_pdl_lc();
+    }
+
+    const int64_t row  = blockIdx.x;
+    const int     tid  = threadIdx.x;
+    const int     lane = tid % ggml_cuda_get_physical_warp_size();
+    a += row * N;
+    if constexpr (has_add) {
+        b   += row * N;
+        sum += row * N;
+    }
+    if (normed) {
+        normed += row * N;
+    }
+
+    if constexpr (N == 5120) {
+        ggml_cuda_pdl_sync();
+    }
+
+    float reg[NE];
+    float tmp = 0.0f;
+#pragma unroll
+    for (int i = 0; i < NE; ++i) {
+        const int col = i * NT + tid;
+        float xi;
+        if constexpr (has_add) {
+            xi = __fadd_rn(a[col], b[col]);
+            sum[col] = xi;
+        } else {
+            xi = a[col];
+        }
+        reg[i] = xi;
+        tmp = fmaf(xi, xi, tmp);
+    }
+
+#ifdef GGML_CUDA_DPP_REDUCE
+    tmp = warp_reduce_sum_dpp<WARP_SIZE>(tmp);
+    if (tid % WARP_SIZE == 0) {
+        s_sum[tid / WARP_SIZE] = tmp;
+    }
+    __syncthreads();
+    tmp = warp_reduce_sum_dpp<WARP_SIZE>(s_sum[tid % WARP_SIZE]);
+#else
+    tmp = block_reduce<block_reduce_method::SUM, NT>(tmp, s_sum);
+#endif
+    const float scale = rsqrtf(ggml_cuda_no_contract(tmp / N) + eps);
+
+#pragma unroll
+    for (int i = 0; i < NE; ++i) {
+        const int col = i * NT + tid;
+        float v = scale * reg[i] * weight[col];
+        if (normed) {
+            normed[col] = v;
+        }
+        reg[i] = (v * signs[col]) * fwht_scale;
