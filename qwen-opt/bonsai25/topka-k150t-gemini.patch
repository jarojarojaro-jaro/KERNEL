+// Hadamard transform (optional signs, width N) + q8_1 quantization in one launch.
+// Same ascending-stride butterfly as fwht_cuda_block and same per-32 quantizer as quantize_q8_1.
+template <int N, int NT, typename T, bool has_signs>
+__launch_bounds__(NT, 1)
+static __global__ void fwht_quantize_q8_1(
+        const T * x_ptr, const float * signs, void * vy_ptr,
+        const int64_t ne00, const int64_t ne0, const uint32_t ne1, const uint3 ne2, const float scale) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int NE        = N / NT;
+    static_assert(NE >= 1 && N % NT == 0 && NT % warp_size == 0 && NT % QK8_1 == 0, "bad fused FWHT shape");
+    static_assert(warp_size % QK8_1 == 0, "a 32-block must not span two warps");
+
+    __shared__ float s[N];
+
+    ggml_cuda_pdl_lc();
+
+    const int64_t blk = blockIdx.x;
+    const int64_t i3  = fastdiv(blockIdx.z, ne2);
+    const int64_t i2  = blockIdx.z - i3 * ne2.z;
+    const int64_t i1  = blockIdx.y;
+    const int64_t row = (i3 * ne2.z + i2) * ne1 + i1;
+
+    const int tid  = threadIdx.x;
+    const int lane = tid % warp_size;
+
+    const int64_t base = blk * N;
+
+    float reg[NE];
+    ggml_cuda_pdl_sync();
+    if (base < ne00) {
+        const T *     src       = x_ptr + row * ne00 + base;
+        const float * signs_row = has_signs ? signs + base : nullptr;
+#pragma unroll
+        for (int i = 0; i < NE; ++i) {
+            float v = ggml_cuda_cast<float>(src[i * NT + tid]);
+            if constexpr (has_signs) {
+                v *= signs_row[i * NT + tid];
+            }
+            reg[i] = v * scale;
+        }
+        ggml_cuda_fwht_block_butterfly<N, NT>(reg, s, tid, lane);
+    } else {
+#pragma unroll
+        for (int i = 0; i < NE; ++i) {
+            reg[i] = 0.0f;
+        }
+    }
+
+    block_q8_1 * GGML_CUDA_RESTRICT y = (block_q8_1 *) vy_ptr;
+    const int iqs = tid % QK8_1;
+
+#pragma unroll
+    for (int i = 0; i < NE; ++i) {
+        const int64_t i0 = base + i * NT + tid;
+        const int64_t ib = (row * ne0 + i0) / QK8_1;
+        quantize_q8_1_group<true>(reg[i], y + ib, iqs);
+    }
+}
+
+template <int N, int NT, typename T>
+static void fwht_quantize_launch_nt(
+        const T * x, const float * signs, void * vy,
+        const int64_t ne00, const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3,
+        const float scale, cudaStream_t stream) {
+    const uint3 ne2_fastdiv = init_fastdiv_values(ne2);
+    const dim3 num_blocks((unsigned) (ne0 / N), (unsigned) ne1, (unsigned) (ne2 * ne3));
+    const dim3 block_size(NT, 1, 1);
+    const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(num_blocks, block_size, 0, stream);
+    if (signs) {
+        ggml_cuda_kernel_launch(fwht_quantize_q8_1<N, NT, T, true>,  lp, x, signs, vy, ne00, ne0, (uint32_t) ne1, ne2_fastdiv, scale);
+    } else {
+        ggml_cuda_kernel_launch(fwht_quantize_q8_1<N, NT, T, false>, lp, x, signs, vy, ne00, ne0, (uint32_t) ne1, ne2_fastdiv, scale);
+    }
+}
+
+template <int N, typename T>
+static void fwht_quantize_launch_layout(
+        const T * x, const float * signs, void * vy,
+        const int64_t ne00, const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3,
+        const float scale, cudaStream_t stream) {
+    const int nt = ggml_cuda_fwht_block_threads(N, ne1 * ne2 * ne3);
+    if constexpr (N >= 1024) {
+        if (nt == 1024) {
+            fwht_quantize_launch_nt<N, 1024, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream);
+            return;
+        }
+    }
+    if constexpr (N >= 512) {
+        if (nt == 512) {
+            fwht_quantize_launch_nt<N, 512, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream);
+            return;
+        }
+    }
+    fwht_quantize_launch_nt<N, (N < 256 ? N : 256), T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream);
+}
+
+template <typename T>
+static void fwht_quantize_launch(
+        const T * x, const float * signs, void * vy, const int n,
+        const int64_t ne00, const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3,
+        const float scale, cudaStream_t stream) {
+    switch (n) {
+        case   64: fwht_quantize_launch_layout<  64, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream); break;
+        case  128: fwht_quantize_launch_layout< 128, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream); break;
+        case  256: fwht_quantize_launch_layout< 256, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream); break;
+        case  512: fwht_quantize_launch_layout< 512, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream); break;
+        case 1024: fwht_quantize_launch_layout<1024, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream); break;
+        case 2048: fwht_quantize_launch_layout<2048, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream); break;
+        case 4096: fwht_quantize_launch_layout<4096, T>(x, signs, vy, ne00, ne0, ne1, ne2, ne3, scale, stream); break;
+        default: GGML_ABORT("fused FWHT quantizer: unsupported transform width %d", n);
+    }
+}
+
+bool ggml_cuda_fwht_quantize_supported(const int n, const int64_t ne00) {
+    switch (n) {
+        case 64: case 128: case 256: case 512: case 1024: case 2048: case 4096:
+            break;
+        default:
+            return false;
+    }
+    return ne00 % n == 0 && ne00 % QK8_1 == 0;
+}
+
+void fwht_quantize_row_q8_1_cuda(
+        const void * x, const ggml_type x_type, const float * signs, const int n, void * vy,
+        const int64_t ne00, const int64_t ne0, const int64_t ncols, cudaStream_t stream) {
+    GGML_ASSERT(ggml_cuda_fwht_quantize_supported(n, ne00));
+    GGML_ASSERT(ne0 % n == 0 && ne0 >= ne00);
+    const float scale = 1.0f / sqrtf((float) n);
+    if (x_type == GGML_TYPE_F16) {
+        fwht_quantize_launch<half>((const half *) x, signs, vy, n, ne00, ne0, ncols, 1, 1, scale, stream);
+    } else {
+        GGML_ASSERT(x_type == GGML_TYPE_F32);
+        fwht_quantize_launch<float>((const float *) x, signs, vy, n, ne00, ne0, ncols, 1, 1, scale, stream);
+    }
+}
