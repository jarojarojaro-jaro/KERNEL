+// PTQ1_0, contiguous: 8 threads per 128-weight block (4 x qs[0..15] words, 2 x qs[16..23] words, qh), the
+// decoded block goes through shared memory so that the global stores are contiguous
+template <typename dst_t>
+static __device__ __forceinline__ void dequantize_ptq1_0_qs4(const uint32_t packed, const float d, dst_t * y, const int base, const int stride) {
+    uint32_t v_lo = ggml_cuda_byte_perm<0x4140>(packed, 0);
+    uint32_t v_hi = ggml_cuda_byte_perm<0x4342>(packed, 0);
+#pragma unroll
+    for (int t = 0; t < 5; ++t) {
+        const uint32_t w_lo = v_lo * 3;
+        const uint32_t w_hi = v_hi * 3;
+        v_lo = w_lo & 0x00FF00FF;
+        v_hi = w_hi & 0x00FF00FF;
+        const uint32_t q = ggml_cuda_byte_perm<0x7531>(w_lo, w_hi); // four digits in {0, 1, 2}
+#pragma unroll
+        for (int b = 0; b < 4; ++b) {
+            y[base + t*stride + b] = ggml_cuda_cast<dst_t>(d * (float) ((int) ((q >> (8*b)) & 0xFF) - 1));
+        }
+    }
+}
