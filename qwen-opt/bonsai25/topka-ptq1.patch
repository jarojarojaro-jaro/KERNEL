+// dp4a with unsigned bytes in a and signed bytes in b. The PTQ1_0 kernels feed the raw base-3 digits {0,1,2}
+// and subtract the exact integer activation sum once per 32-block instead of biasing every word.
+static __device__ __forceinline__ int ggml_cuda_dp4a_us(const unsigned int a, const int b, int c) {
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA) && __CUDA_ARCH__ >= GGML_CUDA_CC_DP4A
+    asm("dp4a.u32.s32 %0, %1, %2, %3;" : "=r"(c) : "r"(a), "r"(b), "r"(c));
+    return c;
+#elif defined(GGML_USE_HIP) && (defined(RDNA3) || defined(RDNA4))
+    // v_dot4_i32_iu8 with per-operand signedness: a unsigned, b signed
+    return __builtin_amdgcn_sudot4(false, (int) a, true, b, c, false);
+#else
+    const uint8_t * a8 = (const uint8_t *) &a;
+    const int8_t  * b8 = (const int8_t *)  &b;
+    return c + (int) a8[0]*b8[0] + (int) a8[1]*b8[1] + (int) a8[2]*b8[2] + (int) a8[3]*b8[3];
+#endif
+}
+
+// CUDA __byte_perm(x, y, s) for a constant nibble selector s (all nibbles 0..7). On AMD v_perm_b32 takes one
+// selector byte per output byte and numbers the bytes of its first source 4..7, so x and y swap places.
+template <uint32_t s>
+static __device__ __forceinline__ uint32_t ggml_cuda_byte_perm(const uint32_t x, const uint32_t y) {
+#if defined(GGML_USE_HIP)
+    constexpr uint32_t sel = (s & 7) | ((s >> 4) & 7) << 8 | ((s >> 8) & 7) << 16 | ((s >> 12) & 7) << 24;
+    return __builtin_amdgcn_perm(y, x, sel);
+#else
+    return __byte_perm(x, y, s);
+#endif
+}
