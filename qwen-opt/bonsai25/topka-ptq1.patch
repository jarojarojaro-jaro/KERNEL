+template <typename dst_t>
+static __global__ void dequantize_block_ptq1_0(const block_ptq1_0 * __restrict__ x, dst_t * __restrict__ y, const int64_t nb) {
+    constexpr int threads_per_quant_block     = 8;
+    constexpr int quant_blocks_per_cuda_block = CUDA_DEQUANTIZE_BLOCK_SIZE / threads_per_quant_block;
+    __shared__ dst_t dequantized[quant_blocks_per_cuda_block * QK_PTQ1_0];
+
+    const int64_t ib0  = int64_t(blockIdx.x) * quant_blocks_per_cuda_block;
+    const int64_t ib   = ib0 + threadIdx.x / threads_per_quant_block;
+    const int     lane = threadIdx.x % threads_per_quant_block;
+
+    if (ib < nb) {
+        const block_ptq1_0 * bq = x + ib;
+        const float d = __half2float(bq->d);
+        dst_t * out = dequantized + (threadIdx.x / threads_per_quant_block) * QK_PTQ1_0;
+        if (lane < 4) {
+            dequantize_ptq1_0_qs4(((const uint32_t *) bq->qs)[lane], d, out, 4*lane, 16);
+        } else if (lane < 6) {
+            const int g = lane - 4;
+            dequantize_ptq1_0_qs4(((const uint32_t *) (bq->qs + 16))[g], d, out, 80 + 4*g, 8);
+        } else if (lane == 6) {
+            uint32_t v = (uint32_t) bq->qh[0] | ((uint32_t) bq->qh[1] << 16);
+#pragma unroll
+            for (int t = 0; t < 4; ++t) {
+                const uint32_t w = v * 3;
+                v = w & 0x00FF00FF;
+                out[120 + 2*t + 0] = ggml_cuda_cast<dst_t>(d * (float) ((int) ((w >>  8) & 0xFF) - 1));
+                out[120 + 2*t + 1] = ggml_cuda_cast<dst_t>(d * (float) ((int) ((w >> 24) & 0xFF) - 1));
+            }
+        }
+    }
+
+    __syncthreads();
+    const int64_t nblocks   = nb - ib0 < quant_blocks_per_cuda_block ? nb - ib0 : quant_blocks_per_cuda_block;
+    const int     nelements = (int) nblocks * QK_PTQ1_0;
+    for (int i = threadIdx.x; i < nelements; i += CUDA_DEQUANTIZE_BLOCK_SIZE) {
+        y[ib0 * QK_PTQ1_0 + i] = dequantized[i];
+    }
+}
