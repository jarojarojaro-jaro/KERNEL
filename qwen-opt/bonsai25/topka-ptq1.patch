index 000000000..8d0168c96
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-ptq1_0.cuh
@@ -0,0 +1,558 @@
+// PTQ1_0 mat-vec (1-8 activation columns, plain 2D weights) on a planar-transposed q8_1 activation layout.
+// Ported from the PrismML fork (mmvq-ptq1_0.cuh, dedicated "PT" kernel) with its HIP port (RDNA3/RDNA4).
+//
+// The stock mmvq path hands each thread one 128-weight PTQ1_0 block and walks the activations as 32 scattered
+// 4-byte loads per column out of 36-byte block_q8_1 structs. Here the activations are stored so that the 128
+// quants a thread needs are 8 aligned 16-byte pieces, one per plane, and the 4 (d, isum) scales are one more
+// 16-byte piece. Adjacent threads read adjacent 16-byte pieces of the same plane.
+//
+// PT layout, per activation column (all sizes for the padded row length, nblk = padded_row / 128):
+//   plane t (t = 0..7):   nblk * 16 bytes, byte b of block kb is the quant of element kb*128 + t*16 + b
+//   plane 8:              nblk * 16 bytes, block kb holds 4 half2 (d, exact integer sum of the 32 quants
+//                         as the raw bits of a short), one per 32-element sub-block
+// Column stride is 9 * nblk * 16 = padded_row * 9/8 bytes, exactly the block_q8_1 stride, so the q8_1
+// buffer sizes and the column strides in block_q8_1 units stay valid.
+//
+// Work items of a CTA are (row group, K block) pairs of rows_per_cta rows flattened into one index space; each
+// thread writes one fp32 partial per (row, column, K block) to shared memory, the epilogue sums them in a fixed
+// order. Only kernel launches: no allocation, no synchronization, safe for graph capture and PM4 replay.
+#pragma once
+
+#include "common.cuh"
+#include "unary.cuh"
+#include "vecdotq.cuh"
+
+#define PTQ1_0_PT_THREADS      128
+#define PTQ1_0_PT_MAX_ROWS     16
+#define PTQ1_0_PT_MAX_COLS     8    // MMVQ_MAX_BATCH_SIZE
+#define PTQ1_0_PT_SMEM_FLOATS  4096 // 16 KiB target when choosing rows per CTA; the launch may request more for one item
+#define PTQ1_0_PT_ROWS_1       1    // rows per item at one column on AMD (gfx1100: 82-88 VGPRs instead of 157 with 4)
+#define PTQ1_0_PT_ROWS_34      4
+
+static_assert(MATRIX_ROW_PADDING % QK_PTQ1_0 == 0, "PT planes need whole PTQ1_0 blocks per padded row");
+
+// number of 128-element blocks in a row padded to MATRIX_ROW_PADDING
+static __host__ __device__ __forceinline__ int ptq1_0_pt_nblk(const int ncols_x) {
+    return ((ncols_x + MATRIX_ROW_PADDING - 1) / MATRIX_ROW_PADDING) * (MATRIX_ROW_PADDING / QK_PTQ1_0);
+}
+
+// ---------------------------------------------------------------------------
+// activation quantization into the PT layout: same per-32 q8_1 quantization as quantize_q8_1, the integer sum of
+// the quants instead of the float sum
+// ---------------------------------------------------------------------------
+#define PTQ1_0_PT_QUANTIZE_BLOCK_SIZE 256
+static_assert(MATRIX_ROW_PADDING % PTQ1_0_PT_QUANTIZE_BLOCK_SIZE == 0, "Risk of out-of-bounds access.");
+
+__launch_bounds__(PTQ1_0_PT_QUANTIZE_BLOCK_SIZE, 1)
+static __global__ void quantize_q8_1_ptq1_0_pt(
+        const float * __restrict__ x, void * __restrict__ vy,
+        const int64_t ne00, const int64_t s01, const int64_t s02, const int64_t s03,
+        const int64_t ne0, const uint32_t ne1, const uint3 ne2) {
+    const int64_t i0 = (int64_t)blockDim.x*blockIdx.x + threadIdx.x;
+
+    if (i0 >= ne0) {
+        return;
+    }
+
+    const int64_t i3 = fastdiv(blockIdx.z, ne2);
+    const int64_t i2 = blockIdx.z - i3*ne2.z;
+    const int64_t i1 = blockIdx.y;
+
+    const float xi = i0 < ne00 ? x[i3*s03 + i2*s02 + i1*s01 + i0] : 0.0f;
+    float amax = fabsf(xi);
+    amax = warp_reduce_max<QK8_1>(amax);
+
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+
+    const int64_t col  = (i3*ne2.z + i2) * ne1 + i1;
+    char *        ycol = (char *) vy + col * (ne0 * 9 / 8); // same column stride as block_q8_1
+    const int64_t nblk = ne0 / QK_PTQ1_0;
+    const int64_t kb   = i0 / QK_PTQ1_0;
+    const int     e    = i0 % QK_PTQ1_0;
+    ycol[((e / 16)*nblk + kb) * 16 + (e % 16)] = q;
+
+    int isum = q;
+    isum = warp_reduce_sum<QK8_1>(isum);
+
+    if (i0 % QK8_1 != 0) {
+        return;
+    }
+
+    // |isum| <= 32*127 fits int16; keep the raw bits in the half slot (read back with __half_as_short)
+    half2 * ds = (half2 *) (ycol + 8*nblk*16) + kb*4 + e / QK8_1;
+    *ds = make_half2(__float2half(d), __short_as_half((short) isum));
+}
+
+// x: F32 [ne00, ne1, ne2, ne3] with strides s01, s02, s03 (elements); ne0 = ne00 padded to MATRIX_ROW_PADDING
+static void quantize_row_q8_1_ptq1_0_pt_cuda(
+        const float * x, void * vy, const int64_t ne00, const int64_t s01, const int64_t s02, const int64_t s03,
+        const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3, cudaStream_t stream) {
+    GGML_ASSERT(ne0 % MATRIX_ROW_PADDING == 0);
+    const uint3 ne2_fastdiv = init_fastdiv_values(ne2);
+    const int64_t block_num_x = (ne0 + PTQ1_0_PT_QUANTIZE_BLOCK_SIZE - 1) / PTQ1_0_PT_QUANTIZE_BLOCK_SIZE;
+    const dim3 num_blocks(block_num_x, ne1, ne2*ne3);
+    const dim3 block_size(PTQ1_0_PT_QUANTIZE_BLOCK_SIZE, 1, 1);
+    quantize_q8_1_ptq1_0_pt<<<num_blocks, block_size, 0, stream>>>(x, vy, ne00, s01, s02, s03, ne0, (uint32_t) ne1, ne2_fastdiv);
+}
+
+// ---------------------------------------------------------------------------
+// the dot products
+// ---------------------------------------------------------------------------
+
+static __device__ __forceinline__ int ptq1_0_int4_at(const int4 & v, const int k) {
+    switch (k & 3) {
+        case 0:  return v.x;
+        case 1:  return v.y;
+        case 2:  return v.z;
+        default: return v.w;
+    }
+}
+
+// one base-3 digit step on four bytes held as two 16-bit-lane words: returns the raw digits (0, 1, 2) as four
+// unsigned bytes and advances the remainders. The digit bias is not applied here: the dot product uses the
+// digits as-is with a mixed-sign dp4a and subtracts the exact integer activation sum of the 32-block once.
+static __device__ __forceinline__ uint32_t ptq1_0_trit_step(uint32_t & vlo, uint32_t & vhi) {
+    const uint32_t wlo = vlo * 3;
+    const uint32_t whi = vhi * 3;
+    vlo = wlo & 0x00FF00FF;
+    vhi = whi & 0x00FF00FF;
+    return ggml_cuda_byte_perm<0x7531>(wlo, whi);
+}
+
+// Dot products of nrows PTQ1_0 blocks with the same block index of ncols activation columns. bq[i] points at the
+// weight block of row i, ycol[j] at the PT column base of column j, kbx is the block index along K.
+// The integer sum of each 32-element sub-block k is folded into the fp32 accumulator as soon as the sub-block is
+// complete, in the order k = 0..3: acc = sum_k d8_k * (sumi_k - isum_k), exact in int32, so the result is the
+// same as with biased weight digits.
+template <int ncols, int nrows>
+static __device__ __forceinline__ void ptq1_0_pt_block_dot(
+        const block_ptq1_0 * const (&bq)[nrows],
+        const char * const (&ycol)[ncols],
+        const int kbx, const int nblk,
+        float (&result)[ncols][nrows]) {
+    int4 dsraw[ncols];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        dsraw[j] = *((const int4 *) ycol[j] + 8*nblk + kbx);
+    }
+
+    int   sumi[ncols][nrows];
+    float acc[ncols][nrows];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+        for (int i = 0; i < nrows; ++i) {
+            sumi[j][i] = 0;
+            acc[j][i]  = 0.0f;
+        }
+    }
+
+    auto fold = [&](const int k) {
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            const half2 ds   = ((const half2 *) &dsraw[j])[k];
+            const float d8   = __low2float(ds);
+            const int   isum = __half_as_short(__high2half(ds)); // exact sum of the 32 quantized activations
+#pragma unroll
+            for (int i = 0; i < nrows; ++i) {
+                acc[j][i] = __fmaf_rn(d8, (float) (sumi[j][i] - isum), acc[j][i]);
+                sumi[j][i] = 0;
+            }
+        }
+    };
+
+    // qs[0..15]: four groups of four bytes, five trits each: element 16*t + 4*g + b, plane t holds words 4*t .. 4*t+3
+    uint32_t vlo[nrows][4];
+    uint32_t vhi[nrows][4];
+#pragma unroll
+    for (int i = 0; i < nrows; ++i) {
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            const uint32_t packed = get_int_b4(bq[i]->qs, g);
+            vlo[i][g] = ggml_cuda_byte_perm<0x4140>(packed, 0);
+            vhi[i][g] = ggml_cuda_byte_perm<0x4342>(packed, 0);
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < 5; ++t) {
+        int4 u[ncols];
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            u[j] = *((const int4 *) ycol[j] + t*nblk + kbx);
+        }
+#pragma unroll
+        for (int i = 0; i < nrows; ++i) {
+#pragma unroll
+            for (int g = 0; g < 4; ++g) {
+                const uint32_t q = ptq1_0_trit_step(vlo[i][g], vhi[i][g]);
+#pragma unroll
+                for (int j = 0; j < ncols; ++j) {
+                    sumi[j][i] = ggml_cuda_dp4a_us(q, ptq1_0_int4_at(u[j], g), sumi[j][i]);
+                }
+            }
+        }
+        if (t == 1) {
+            fold(0); // elements 0..31 done
+        }
+        if (t == 3) {
+            fold(1); // elements 32..63 done
+        }
+    }
+
+    // qs[16..23]: two groups of four bytes, five trits each: element 80 + 8*t + 4*g + b,
+    // words 20..29 live in planes 5, 6 and the lower half of 7
+    uint32_t vlo2[nrows][2];
+    uint32_t vhi2[nrows][2];
+#pragma unroll
+    for (int i = 0; i < nrows; ++i) {
+#pragma unroll
+        for (int g = 0; g < 2; ++g) {
+            const uint32_t packed = get_int_b4(bq[i]->qs + 16, g);
+            vlo2[i][g] = ggml_cuda_byte_perm<0x4140>(packed, 0);
+            vhi2[i][g] = ggml_cuda_byte_perm<0x4342>(packed, 0);
+        }
+    }
+    int4 u2[ncols];
+#pragma unroll
+    for (int t = 0; t < 5; ++t) {
+        if (t % 2 == 0) {
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+                u2[j] = *((const int4 *) ycol[j] + (5 + t/2)*nblk + kbx);
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < nrows; ++i) {
+#pragma unroll
+            for (int g = 0; g < 2; ++g) {
+                const uint32_t q = ptq1_0_trit_step(vlo2[i][g], vhi2[i][g]);
+                const int w = 20 + 2*t + g; // word index within the 128-element block
+#pragma unroll
+                for (int j = 0; j < ncols; ++j) {
+                    sumi[j][i] = ggml_cuda_dp4a_us(q, ptq1_0_int4_at(u2[j], w & 3), sumi[j][i]);
+                }
+            }
+        }
+        if (t == 1) {
+            fold(2); // elements 64..95 done (words 16..23)
+        }
+    }
+
+    // qh[0..1] and d are the 7th 32-bit word of the 28-byte block (blocks are 4-byte aligned): one dword load.
+    // qh: two bytes, four trits each, interleaved: element 120 + 2*t + h -> words 30, 31, the upper half of
+    // plane 7 that u2 still holds
+    uint32_t w6[nrows];
+#pragma unroll
+    for (int i = 0; i < nrows; ++i) {
+        w6[i] = get_int_b4(bq[i], 6);
+    }
+#pragma unroll
+    for (int i = 0; i < nrows; ++i) {
+        uint32_t v = ggml_cuda_byte_perm<0x4140>(w6[i], 0);
+#pragma unroll
+        for (int t = 0; t < 4; t += 2) {
+            const uint32_t w0 = v * 3;
+            v                 = w0 & 0x00FF00FF;
+            const uint32_t w1 = v * 3;
+            v                 = w1 & 0x00FF00FF;
+            const uint32_t q  = ggml_cuda_byte_perm<0x7531>(w0, w1);
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+                sumi[j][i] = ggml_cuda_dp4a_us(q, ptq1_0_int4_at(u2[j], 2 + t/2), sumi[j][i]);
+            }
+        }
+    }
+    fold(3); // elements 96..127 done
+
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+        for (int i = 0; i < nrows; ++i) {
+            result[j][i] = __fmul_rn(__half2float(__ushort_as_half((unsigned short) (w6[i] >> 16))), acc[j][i]);
+        }
+    }
+}
+
+// rows_per_cta: fill whole 128-thread iterations where possible, within the shared memory budget
+static __host__ int ptq1_0_pt_rows_per_cta(const int blocks_per_row, const int ncols_dst, const int rows_per_item) {
+    int rmax = PTQ1_0_PT_SMEM_FLOATS / (ncols_dst * (blocks_per_row + 1));
+    rmax = rmax < rows_per_item ? rows_per_item : (rmax > PTQ1_0_PT_MAX_ROWS ? PTQ1_0_PT_MAX_ROWS : rmax);
+    rmax -= rmax % rows_per_item;
+    int best = rows_per_item;
+    double best_util = 0.0;
+    for (int r = rows_per_item; r <= rmax; r += rows_per_item) {
+        const int items = (r / rows_per_item) * blocks_per_row;
+        const int iters = (items + PTQ1_0_PT_THREADS - 1) / PTQ1_0_PT_THREADS;
+        const double util = (double) items / (double) (iters * PTQ1_0_PT_THREADS);
+        if (util > best_util + 1e-9) {
+            best_util = util;
+            best = r;
+        }
+        if (util > 0.999) {
+            break;
+        }
+    }
+    return best;
+}
+
+// rows per item of the launch: one row at one column on AMD (GGML_HIP_PTQ1_PT_ROWS1=4: the four-row tile)
+static constexpr __host__ __device__ int ptq1_0_pt_rows_per_item(const int ncols_dst) {
+    return ncols_dst <= 2 ? 4 : (ncols_dst <= 4 ? PTQ1_0_PT_ROWS_34 : 2);
+}
+
+static __host__ int ptq1_0_pt_rows_per_item_for_cc(const int ncols_dst, const int cc) {
+    if (ncols_dst == 1 && GGML_CUDA_CC_IS_AMD(cc)) {
+        static const bool four = getenv("GGML_HIP_PTQ1_PT_ROWS1") != nullptr && atoi(getenv("GGML_HIP_PTQ1_PT_ROWS1")) == 4;
+        return four ? ptq1_0_pt_rows_per_item(1) : PTQ1_0_PT_ROWS_1;
+    }
+    return ptq1_0_pt_rows_per_item(ncols_dst);
+}
+
+// bytes the launch requests: one fp32 partial per (column, row, K block + 1 pad) for the CTA, twice that with
+// gate fusion. The +1 is the odd stride the epilogue uses to avoid bank conflicts.
+static __host__ size_t ptq1_0_pt_smem_bytes(const int blocks_per_row, const int ncols_dst, const int rows_per_item, const bool has_gate) {
+    const int rows_per_cta = ptq1_0_pt_rows_per_cta(blocks_per_row, ncols_dst, rows_per_item);
+    return (size_t) ncols_dst * rows_per_cta * (blocks_per_row + 1) * sizeof(float) * (has_gate ? 2 : 1);
+}
+
+// GGML_CUDA_BATCH_INVARIANT=1: warp-per-(row, column) epilogue, the same bits for a column at any column count
+static bool ptq1_0_pt_batch_invariant() {
+    static const bool invariant = [] {
+        const char * env = getenv("GGML_CUDA_BATCH_INVARIANT");
+        return env != nullptr && atoi(env) != 0;
+    }();
+    return invariant;
+}
+
+static __device__ __forceinline__ float ptq1_0_pt_glu(const ggml_glu_op op, const float result, const float gate_value, const float limit) {
+    switch (op) {
+        case GGML_GLU_OP_SWIGLU:       return result * ggml_cuda_op_silu_single(gate_value);
+        case GGML_GLU_OP_GEGLU:        return result * ggml_cuda_op_gelu_single(gate_value);
+        case GGML_GLU_OP_SWIGLU_OAI:   return ggml_cuda_op_swiglu_oai_single(gate_value, result);
+        case GGML_GLU_OP_SWIGLU_CLAMP: return ggml_cuda_op_swiglu_clamp_single(gate_value, result, limit);
+        default:                       return result * gate_value;
+    }
+}
+
+template <int ncols, int ROWS, bool has_fusion, bool has_gate>
+__launch_bounds__(PTQ1_0_PT_THREADS, (ncols <= 2 ? 4 : (ncols <= 4 ? 3 : 2)))
+static __global__ void mul_mat_vec_ptq1_0_pt(
+        const void * __restrict__ vx, const void * __restrict__ vy, const ggml_cuda_mm_fusion_args_device fusion,
+        float * __restrict__ dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        const int rows_per_cta, const uint3 bpr_fd, const uint3 rpc_fd, const bool invariant) {
+    extern __shared__ float ptq1_0_partials[];       // [ncols][rows_per_cta][bprp], then the gate partials
+    const int bpr  = ncols_x / QK_PTQ1_0;            // K blocks per row
+    const int bprp = bpr + 1;                        // partials row stride: odd, bank-conflict-free epilogue reads
+    float * partials = ptq1_0_partials;
+    [[maybe_unused]] float * partials_gate = partials + ncols*rows_per_cta*bprp;
+
+    const int nblk = ptq1_0_pt_nblk(ncols_x);        // plane stride of the PT layout
+    const int row0 = rows_per_cta * blockIdx.x;
+    const int tid  = threadIdx.x;
+
+    // rows this CTA really owns (the last CTA may be short); clamped item rows read the last real row
+    const int n_rows_cta = min(rows_per_cta, nrows_x - row0);
+
+    const char * ycol[ncols];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        ycol[j] = (const char *) ((const block_q8_1 *) vy + j*stride_col_y);
+    }
+
+    const int n_items = (rows_per_cta / ROWS) * bpr;
+    for (int idx = tid; idx < n_items; idx += PTQ1_0_PT_THREADS) {
+        const int rg  = fastdiv((uint32_t) idx, bpr_fd); // row group within the CTA
+        const int kbx = idx - rg*bpr;
+
+        const block_ptq1_0 * bq[ROWS];
+#pragma unroll
+        for (int i = 0; i < ROWS; ++i) {
+            int r = rg*ROWS + i;
+            r = r < n_rows_cta ? r : n_rows_cta - 1; // clamp the tail, that result is not written
+            bq[i] = (const block_ptq1_0 *) vx + (int64_t) (row0 + r)*stride_row_x + kbx;
+        }
+        float dots[ncols][ROWS];
+        ptq1_0_pt_block_dot<ncols, ROWS>(bq, ycol, kbx, nblk, dots);
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+            for (int i = 0; i < ROWS; ++i) {
+                partials[(j*rows_per_cta + rg*ROWS + i)*bprp + kbx] = dots[j][i];
+            }
+        }
+        if constexpr (has_gate) {
+            const block_ptq1_0 * bg[ROWS];
+#pragma unroll
+            for (int i = 0; i < ROWS; ++i) {
+                int r = rg*ROWS + i;
+                r = r < n_rows_cta ? r : n_rows_cta - 1;
+                bg[i] = (const block_ptq1_0 *) fusion.gate + (int64_t) (row0 + r)*stride_row_x + kbx;
+            }
+            ptq1_0_pt_block_dot<ncols, ROWS>(bg, ycol, kbx, nblk, dots);
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+                for (int i = 0; i < ROWS; ++i) {
+                    partials_gate[(j*rows_per_cta + rg*ROWS + i)*bprp + kbx] = dots[j][i];
+                }
+            }
+        }
+    }
+
+    __syncthreads();
+
+    auto epilogue = [&](const int j, const int row, const float sum, const float sum_gate) {
+        float result = sum;
+        if constexpr (has_fusion) {
+            if (fusion.x_bias) {
+                result += ((const float *) fusion.x_bias)[j*stride_col_dst + row];
+            }
+            if constexpr (has_gate) {
+                float gate_value = sum_gate;
+                if (fusion.gate_bias) {
+                    gate_value += ((const float *) fusion.gate_bias)[j*stride_col_dst + row];
+                }
+                result = ptq1_0_pt_glu(fusion.glu_op, result, gate_value, fusion.glu_limit);
+            }
+        }
+        dst[j*stride_col_dst + row] = result;
+    };
+
+    if (invariant) {
+        // warp per (row, column): lane-strided sum + butterfly, the same bits at any column count
+        const int warp = tid / WARP_SIZE;
+        const int lane = tid % WARP_SIZE;
+        for (int w = warp; w < rows_per_cta*ncols; w += PTQ1_0_PT_THREADS / WARP_SIZE) {
+            const int j   = w / rows_per_cta;
+            const int r   = w - j*rows_per_cta;
+            const int row = row0 + r;
+
+            float sum = 0.0f;
+            float sum_gate = 0.0f;
+            for (int kbx = lane; kbx < bpr; kbx += WARP_SIZE) {
+                sum += partials[(j*rows_per_cta + r)*bprp + kbx];
+                if constexpr (has_gate) {
+                    sum_gate += partials_gate[(j*rows_per_cta + r)*bprp + kbx];
+                }
+            }
+            sum = warp_reduce_sum<WARP_SIZE>(sum);
+            if constexpr (has_gate) {
+                sum_gate = warp_reduce_sum<WARP_SIZE>(sum_gate);
+            }
+            if (lane == 0 && row < nrows_x) {
+                epilogue(j, row, sum, sum_gate);
+            }
+        }
+        return;
+    }
+
+    // one thread per (row, column): four interleaved accumulators (k mod 4), then (s0+s1)+(s2+s3)
+    for (int p = tid; p < rows_per_cta*ncols; p += PTQ1_0_PT_THREADS) {
+        const int j   = fastdiv((uint32_t) p, rpc_fd); // column
+        const int r   = p - j*rows_per_cta;             // row within the CTA
+        const int row = row0 + r;
+        const float * src = partials + (j*rows_per_cta + r)*bprp;
+        [[maybe_unused]] const float * srcg = partials_gate + (j*rows_per_cta + r)*bprp;
+
+        float s0 = 0.0f, s1 = 0.0f, s2 = 0.0f, s3 = 0.0f;
+        float g0 = 0.0f, g1 = 0.0f, g2 = 0.0f, g3 = 0.0f;
+        int kbx = 0;
+        for (; kbx + 4 <= bpr; kbx += 4) {
+            s0 += src[kbx + 0]; s1 += src[kbx + 1]; s2 += src[kbx + 2]; s3 += src[kbx + 3];
+            if constexpr (has_gate) {
+                g0 += srcg[kbx + 0]; g1 += srcg[kbx + 1]; g2 += srcg[kbx + 2]; g3 += srcg[kbx + 3];
+            }
+        }
+        for (; kbx < bpr; ++kbx) {
+            s0 += src[kbx];
+            if constexpr (has_gate) {
+                g0 += srcg[kbx];
+            }
+        }
+        if (row < nrows_x) {
+            epilogue(j, row, (s0 + s1) + (s2 + s3), (g0 + g1) + (g2 + g3));
+        }
+    }
+}
+
+template <int ncols, int ROWS>
+static void mul_mat_vec_ptq1_0_pt_launch(
+        const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        cudaStream_t stream) {
+    const int bpr = ncols_x / QK_PTQ1_0;
+    const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr;
+    const bool has_gate   = fusion.gate != nullptr;
+
+    const int rows_per_cta = ptq1_0_pt_rows_per_cta(bpr, ncols, ROWS);
+    const uint3 bpr_fd = init_fastdiv_values((uint32_t) bpr);
+    const uint3 rpc_fd = init_fastdiv_values((uint32_t) rows_per_cta);
+    const dim3 block_nums((nrows_x + rows_per_cta - 1) / rows_per_cta, 1, 1);
+    const dim3 block_dims(PTQ1_0_PT_THREADS, 1, 1);
+    const size_t smem = ptq1_0_pt_smem_bytes(bpr, ncols, ROWS, has_gate);
+    const bool invariant = ptq1_0_pt_batch_invariant();
+
+#define PTQ1_0_PT_LAUNCH(FUS, GATE)                                                                                  \
+    mul_mat_vec_ptq1_0_pt<ncols, ROWS, FUS, GATE><<<block_nums, block_dims, smem, stream>>>(                         \
+        vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, rows_per_cta, bpr_fd, rpc_fd, \
+        invariant)
+
+    if constexpr (ncols == 1) {
+        if (has_gate) {
+            PTQ1_0_PT_LAUNCH(true, true);
+            return;
+        }
+        if (has_fusion) {
+            PTQ1_0_PT_LAUNCH(true, false);
+            return;
+        }
+    } else {
+        GGML_ASSERT(!has_fusion && "PTQ1_0 PT kernel: fusion only at one column");
+    }
+    PTQ1_0_PT_LAUNCH(false, false);
+#undef PTQ1_0_PT_LAUNCH
+}
+
+// true when the kernel takes a plain 2D call of this shape: K a multiple of 128, 1-8 columns, partials within the
+// device's shared memory per block
+static bool ptq1_0_pt_supported(const int device, const int64_t ncols_x, const int64_t ncols_dst, const bool has_gate) {
+    if (ncols_x % QK_PTQ1_0 != 0 || ncols_dst < 1 || ncols_dst > PTQ1_0_PT_MAX_COLS) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[device].cc;
+    const size_t smem = ptq1_0_pt_smem_bytes((int) (ncols_x / QK_PTQ1_0), (int) ncols_dst,
+            ptq1_0_pt_rows_per_item_for_cc((int) ncols_dst, cc), has_gate);
+    return smem <= ggml_cuda_info().devices[device].smpb;
+}
+
+static void mul_mat_vec_ptq1_0_pt_switch(
+        const int device, const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int ncols_dst,
+        const int stride_row_x, const int stride_col_y, const int stride_col_dst, cudaStream_t stream) {
+    const int cc = ggml_cuda_info().devices[device].cc;
+    switch (ncols_dst) {
+        case 1:
+            if (ptq1_0_pt_rows_per_item_for_cc(1, cc) == PTQ1_0_PT_ROWS_1) {
+                mul_mat_vec_ptq1_0_pt_launch<1, PTQ1_0_PT_ROWS_1>(
+                        vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream);
+            } else {
+                mul_mat_vec_ptq1_0_pt_launch<1, ptq1_0_pt_rows_per_item(1)>(
+                        vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream);
+            }
+            break;
+#define PTQ1_0_PT_CASE(N) case N: mul_mat_vec_ptq1_0_pt_launch<N, ptq1_0_pt_rows_per_item(N)>( \
+            vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break
+        PTQ1_0_PT_CASE(2);
+        PTQ1_0_PT_CASE(3);
+        PTQ1_0_PT_CASE(4);
+        PTQ1_0_PT_CASE(5);
+        PTQ1_0_PT_CASE(6);
+        PTQ1_0_PT_CASE(7);
+        PTQ1_0_PT_CASE(8);
+#undef PTQ1_0_PT_CASE
+        default:
+            GGML_ABORT("PTQ1_0 PT kernel: unsupported column count %d", ncols_dst);
+    }
+}
