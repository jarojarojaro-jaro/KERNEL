+#ifdef GGML_CUDA_DPP_REDUCE
+// Two-barrier 32x32 wave32 DPP FWHT for B=1024 with NT=512 (16 warps, 2 rows per warp).
+// Bit-identical to ggml_cuda_fwht_block_butterfly<1024, 512, 1024>: stages h=1..16 run on rows,
+// then transposed stages h=32..512 run in-warp via DPP; padded LDS stride 33 avoids bank conflicts.
+static __device__ __forceinline__ void ggml_cuda_fwht_1024_nt512_dpp(
+        float reg[2], float (*s0)[33], float (*s1)[33], const int warp, const int lane) {
+    static_assert(ggml_cuda_get_physical_warp_size() == 32, "DPP FWHT requires wave32");
+#define FWHT_DPP_STEP(V, H)                                              \
+    do {                                                                 \
+        const float _v  = (V);                                           \
+        const float _v2 = ggml_cuda_xor_dpp<(H)>(_v);                    \
+        (V) = (lane & (H)) == 0 ? _v + _v2 : _v2 - _v;                   \
+    } while (0)
+#define FWHT_DPP_32(V)                                                   \
+    do {                                                                 \
+        FWHT_DPP_STEP(V,  1);                                            \
+        FWHT_DPP_STEP(V,  2);                                            \
+        FWHT_DPP_STEP(V,  4);                                            \
+        FWHT_DPP_STEP(V,  8);                                            \
+        FWHT_DPP_STEP(V, 16);                                            \
+    } while (0)
+
+    FWHT_DPP_32(reg[0]);
+    FWHT_DPP_32(reg[1]);
+
+    s0[warp][lane]      = reg[0];
+    s0[warp + 16][lane] = reg[1];
+    __syncthreads();
+
+    float col0 = s0[lane][warp];
+    float col1 = s0[lane][warp + 16];
+
+    FWHT_DPP_32(col0);
+    FWHT_DPP_32(col1);
+
+    s1[lane][warp]      = col0;
+    s1[lane][warp + 16] = col1;
+    __syncthreads();
+
+    reg[0] = s1[warp][lane];
+    reg[1] = s1[warp + 16][lane];
+
+#undef FWHT_DPP_32
+#undef FWHT_DPP_STEP
+}
+
+// Two-barrier 16x32 wave32 DPP FWHT for B=512 with NT=512 (16 warps, 1 row per warp).
+// Padded stride 34 maps lane<16 and lane>=16 to even/odd banks so the transpose is bank-conflict free.
+static __device__ __forceinline__ void ggml_cuda_fwht_512_nt512_dpp(
+        float & reg0, float (*s0)[34], float (*s1)[34], const int warp, const int lane) {
+    static_assert(ggml_cuda_get_physical_warp_size() == 32, "DPP FWHT requires wave32");
+#define FWHT_DPP_STEP(V, H)                                              \
+    do {                                                                 \
+        const float _v  = (V);                                           \
+        const float _v2 = ggml_cuda_xor_dpp<(H)>(_v);                    \
+        (V) = (lane & (H)) == 0 ? _v + _v2 : _v2 - _v;                   \
+    } while (0)
+
+    FWHT_DPP_STEP(reg0,  1);
+    FWHT_DPP_STEP(reg0,  2);
+    FWHT_DPP_STEP(reg0,  4);
+    FWHT_DPP_STEP(reg0,  8);
+    FWHT_DPP_STEP(reg0, 16);
+
+    s0[warp][lane] = reg0;
+    __syncthreads();
+
+    const int r = lane & 15;
+    const int c = warp * 2 + (lane >> 4);
+    float col = s0[r][c];
+
+    // h=1,2,4,8 stay within each 16-lane half, so both columns in the warp transform independently
+    FWHT_DPP_STEP(col, 1);
+    FWHT_DPP_STEP(col, 2);
+    FWHT_DPP_STEP(col, 4);
+    FWHT_DPP_STEP(col, 8);
+
+    s1[r][c] = col;
+    __syncthreads();
+
+    reg0 = s1[warp][lane];
+
+#undef FWHT_DPP_STEP
+}
+#endif // GGML_CUDA_DPP_REDUCE
