+
+template <typename T, typename type_acc>
+static void gdn_ab_mmvf_launch(
+        const T * w_alpha, const T * w_beta, const float * y, const float * dt, const float * ssm_a,
+        float * gate, float * beta, const int ncols2, const int stride_row, const int stride_col_y2,
+        const int n_heads, const int n_tokens, const ggml_cuda_gdn_conv_args * conv, cudaStream_t stream) {
+    static_assert(MMVF_MAX_BATCH_SIZE == 8, "update the n_tokens dispatch");
+    if (conv != nullptr) {
+        GGML_ASSERT(conv->d_conv == 4 && conv->nr % 256 == 0);
+        const int n_conv_blocks = (int) (conv->nr / 256);
+        const ggml_cuda_kernel_launch_params lp(dim3((unsigned) (n_conv_blocks + 2 * n_heads), 1, 1), dim3(256, 1, 1), 0, stream);
+#define GDN_CONV_AB_F_LAUNCH(N)                                                                                \
+    ggml_cuda_kernel_launch(gdn_conv_ab_f<T, type_acc, N>, lp,                                                 \
+        conv->src, conv->w, conv->bias, conv->w_nb1, conv->dst, conv->dst_nb1, conv->n_t, n_conv_blocks,       \
+        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols2, stride_row, stride_col_y2, n_heads)
+        switch (n_tokens) {
+            case 1: GDN_CONV_AB_F_LAUNCH(1); break;
+            case 2: GDN_CONV_AB_F_LAUNCH(2); break;
+            case 3: GDN_CONV_AB_F_LAUNCH(3); break;
+            case 4: GDN_CONV_AB_F_LAUNCH(4); break;
+            case 5: GDN_CONV_AB_F_LAUNCH(5); break;
+            case 6: GDN_CONV_AB_F_LAUNCH(6); break;
+            case 7: GDN_CONV_AB_F_LAUNCH(7); break;
+            case 8: GDN_CONV_AB_F_LAUNCH(8); break;
+            default: GGML_ABORT("unsupported GDN token count");
+        }
+#undef GDN_CONV_AB_F_LAUNCH
+        return;
+    }
+
+    const ggml_cuda_kernel_launch_params lp(dim3((unsigned) n_heads, 2, 1), dim3(256, 1, 1), 0, stream);
+#define GDN_AB_F_LAUNCH(N)                                                                                     \
+    ggml_cuda_kernel_launch(mul_mat_vec_f_gdn_ab<T, type_acc, N>, lp,                                          \
+        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols2, stride_row, stride_col_y2, n_heads)
+    switch (n_tokens) {
+        case 1: GDN_AB_F_LAUNCH(1); break;
+        case 2: GDN_AB_F_LAUNCH(2); break;
+        case 3: GDN_AB_F_LAUNCH(3); break;
+        case 4: GDN_AB_F_LAUNCH(4); break;
+        case 5: GDN_AB_F_LAUNCH(5); break;
+        case 6: GDN_AB_F_LAUNCH(6); break;
+        case 7: GDN_AB_F_LAUNCH(7); break;
+        case 8: GDN_AB_F_LAUNCH(8); break;
+        default: GGML_ABORT("unsupported GDN token count");
+    }
+#undef GDN_AB_F_LAUNCH
+}
+
+void ggml_cuda_gdn_ab_mmvf(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * w_alpha, const ggml_tensor * w_beta,
+        const ggml_tensor * x, const ggml_tensor * dt, const ggml_tensor * ssm_a,
+        ggml_tensor * gate, ggml_tensor * beta, const enum ggml_prec op_prec, const ggml_cuda_gdn_conv_args * conv) {
+    const ggml_type type = w_alpha->type;
+    GGML_ASSERT(w_beta->type == type && ggml_cuda_gdn_ab_mmvf_supported(type));
+    GGML_ASSERT(ggml_are_same_shape(w_alpha, w_beta) && w_alpha->nb[1] == w_beta->nb[1]);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && x->ne[0] == w_alpha->ne[0] && x->ne[2] == 1 && x->ne[3] == 1 &&
+                x->ne[1] >= 1 && x->ne[1] <= MMVF_MAX_BATCH_SIZE);
+    GGML_ASSERT(w_alpha->ne[0] % 2 == 0 && x->nb[1] % (2 * sizeof(float)) == 0);
+
+    const size_t ts = ggml_type_size(type);
+    const int ncols2        = (int) (w_alpha->ne[0] / 2);
+    const int n_heads       = (int) w_alpha->ne[1];
+    const int n_tokens      = (int) x->ne[1];
+    const int stride_row    = (int) (w_alpha->nb[1] / ts);
+    const int stride_col_y2 = (int) (x->nb[1] / (2 * sizeof(float)));
+
+    const float * yd = (const float *) x->data;
+    const float * dd = (const float *) dt->data;
+    const float * ad = (const float *) ssm_a->data;
+    float *       gd = (float *) gate->data;
+    float *       bd = (float *) beta->data;
+    cudaStream_t  stream = ctx.stream();
+
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const enum ggml_prec prec = fast_fp16_available(cc) ? op_prec : GGML_PREC_F32;
+
+    switch (type) {
+        case GGML_TYPE_F32:
+            gdn_ab_mmvf_launch<float, float>(
+                (const float *) w_alpha->data, (const float *) w_beta->data, yd, dd, ad, gd, bd,
+                ncols2, stride_row, stride_col_y2, n_heads, n_tokens, conv, stream);
+            break;
+        case GGML_TYPE_F16:
+            if (prec == GGML_PREC_DEFAULT) {
+                gdn_ab_mmvf_launch<half, half>(
+                    (const half *) w_alpha->data, (const half *) w_beta->data, yd, dd, ad, gd, bd,
+                    ncols2, stride_row, stride_col_y2, n_heads, n_tokens, conv, stream);
+            } else {
+                gdn_ab_mmvf_launch<half, float>(
+                    (const half *) w_alpha->data, (const half *) w_beta->data, yd, dd, ad, gd, bd,
+                    ncols2, stride_row, stride_col_y2, n_heads, n_tokens, conv, stream);
+            }
+            break;
+        case GGML_TYPE_BF16:
+            gdn_ab_mmvf_launch<nv_bfloat16, float>(
+                (const nv_bfloat16 *) w_alpha->data, (const nv_bfloat16 *) w_beta->data, yd, dd, ad, gd, bd,
+                ncols2, stride_row, stride_col_y2, n_heads, n_tokens, conv, stream);
+            break;
+        default:
+            GGML_ABORT("unsupported type: %s", ggml_type_name(type));
+    }
+}
