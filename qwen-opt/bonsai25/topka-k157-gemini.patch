+// Thin F32 MMVF (few rows, wide K): 512 threads (16 warps/block -> 4 warps/SIMD32 on 48 WGP),
+// 128-bit float4 loads when 16B-aligned, DPP warp reduce and a single __syncthreads() across all ncols_dst.
+template <int ncols_dst, int block_size, bool use_float4>
+__launch_bounds__(block_size, 2)
+static __global__ void mul_mat_vec_f_f32_thin(
+        const float * __restrict__ x_ptr, const float * __restrict__ y_ptr, float * __restrict__ dst_ptr,
+        const int ncols_vec, const int stride_row_vec, const int stride_col_y_vec, const int stride_col_dst) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps    = block_size / warp_size;
+    static_assert(block_size % warp_size == 0 && nwarps <= warp_size, "bad thin MMVF block shape");
+
+    const int row  = blockIdx.x;
+    const int tid  = threadIdx.x;
+    const int lane = tid % warp_size;
+    const int warp = tid / warp_size;
+
+    ggml_cuda_pdl_sync();
+
+    float sumf[ncols_dst] = { 0.0f };
+    if constexpr (use_float4) {
+        const float4 * __restrict__ x4 = (const float4 *) x_ptr + (int64_t) row * stride_row_vec;
+        const float4 * __restrict__ y4 = (const float4 *) y_ptr;
+        for (int col4 = tid; col4 < ncols_vec; col4 += block_size) {
+            const float4 tx = x4[col4];
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+                const float4 ty = y4[(int64_t) j * stride_col_y_vec + col4];
+                ggml_cuda_mad(sumf[j], tx.x, ty.x);
+                ggml_cuda_mad(sumf[j], tx.y, ty.y);
+                ggml_cuda_mad(sumf[j], tx.z, ty.z);
+                ggml_cuda_mad(sumf[j], tx.w, ty.w);
+            }
+        }
+    } else {
+        const float2 * __restrict__ x2 = (const float2 *) x_ptr + (int64_t) row * stride_row_vec;
+        const float2 * __restrict__ y2 = (const float2 *) y_ptr;
+        for (int col2 = tid; col2 < ncols_vec; col2 += block_size) {
+            const float2 tx = x2[col2];
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+                const float2 ty = y2[(int64_t) j * stride_col_y_vec + col2];
+                ggml_cuda_mad(sumf[j], tx.x, ty.x);
+                ggml_cuda_mad(sumf[j], tx.y, ty.y);
+            }
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+    __shared__ float s_buf[ncols_dst][nwarps];
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+        sumf[j] = warp_reduce_sum_dpp<warp_size>(sumf[j]);
+        if (lane == 0) {
+            s_buf[j][warp] = sumf[j];
+        }
+    }
+    __syncthreads();
+
+    if (warp == 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+            float val = lane < nwarps ? s_buf[j][lane] : 0.0f;
+            val = warp_reduce_sum_dpp<warp_size>(val);
+            if (lane == 0) {
+                dst_ptr[(int64_t) j * stride_col_dst + row] = val;
+            }
+        }
+    }
+}
+
+// One 256-thread block of fused GDN alpha/beta projection + activation tail:
+//   alpha: gate[t*n_heads + h] = softplus(W_alpha[h] . x[t] + dt[h]) * ssm_a[h]
+//   beta:  beta[t*n_heads + h] = sigmoid(W_beta[h] . x[t])
+// Uses the same col2 += 256 float2 loop and 32->8->32 reduction order as mul_mat_vec_f<..., 256> (bit-identical).
+template <typename T, typename type_acc, int n_tokens, int block_size = 256>
+static __device__ __forceinline__ void mul_mat_vec_f_gdn_ab_block(
+        const int h, const bool is_beta, const int tid,
+        const T * __restrict__ w_alpha, const T * __restrict__ w_beta, const float * __restrict__ y_ptr,
+        const float * __restrict__ dt, const float * __restrict__ ssm_a,
+        float * __restrict__ gate, float * __restrict__ beta,
+        const int ncols2, const int stride_row, const int stride_col_y2, const int n_heads) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps    = block_size / warp_size;
+    static_assert(block_size % warp_size == 0 && nwarps <= warp_size, "bad GDN ab block shape");
+
+    const T * __restrict__ x = (is_beta ? w_beta : w_alpha) + (int64_t) h * stride_row;
+    const float2 * __restrict__ y2 = (const float2 *) y_ptr;
+
+    float sumf[n_tokens] = { 0.0f };
+    if constexpr (std::is_same_v<T, float>) {
+        const float2 * __restrict__ x2 = (const float2 *) x;
+        for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+            const float2 tmpx = x2[col2];
+#pragma unroll
+            for (int j = 0; j < n_tokens; ++j) {
+                const float2 tmpy = y2[(int64_t) j * stride_col_y2 + col2];
+                ggml_cuda_mad(sumf[j], tmpx.x, tmpy.x);
+                ggml_cuda_mad(sumf[j], tmpx.y, tmpy.y);
+            }
+        }
+    } else if constexpr (std::is_same_v<T, half>) {
+        const half2 * __restrict__ x2 = (const half2 *) x;
+        if constexpr (std::is_same_v<type_acc, float>) {
+            for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+                const float2 tmpx = __half22float2(x2[col2]);
+#pragma unroll
+                for (int j = 0; j < n_tokens; ++j) {
+                    const float2 tmpy = y2[(int64_t) j * stride_col_y2 + col2];
+                    ggml_cuda_mad(sumf[j], tmpx.x, tmpy.x);
+                    ggml_cuda_mad(sumf[j], tmpx.y, tmpy.y);
+                }
+            }
+        } else {
+#ifdef FP16_AVAILABLE
+            half2 sumh2[n_tokens] = {{ 0.0f, 0.0f }};
+            for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+                const half2 tmpx = x2[col2];
+#pragma unroll
+                for (int j = 0; j < n_tokens; ++j) {
+                    const float2 tmpy = y2[(int64_t) j * stride_col_y2 + col2];
+                    sumh2[j] += tmpx * make_half2(tmpy.x, tmpy.y);
+                }
+            }
+#pragma unroll
+            for (int j = 0; j < n_tokens; ++j) {
+                sumf[j] = __low2float(sumh2[j]) + __high2float(sumh2[j]);
+            }
+#else
+            NO_DEVICE_CODE;
+#endif
+        }
+    } else if constexpr (std::is_same_v<T, nv_bfloat16>) {
+#if defined(GGML_USE_HIP)
+        const int * __restrict__ x2 = (const int *) x;
+        for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+            const int tmpx = x2[col2];
+            const float tmpx0 = ggml_cuda_cast<float>(reinterpret_cast<const nv_bfloat16 *>(&tmpx)[0]);
+            const float tmpx1 = ggml_cuda_cast<float>(reinterpret_cast<const nv_bfloat16 *>(&tmpx)[1]);
+#pragma unroll
+            for (int j = 0; j < n_tokens; ++j) {
+                const float2 tmpy = y2[(int64_t) j * stride_col_y2 + col2];
+                ggml_cuda_mad(sumf[j], tmpx0, tmpy.x);
+                ggml_cuda_mad(sumf[j], tmpx1, tmpy.y);
+            }
+        }
+#else
+        const nv_bfloat162 * __restrict__ x2 = (const nv_bfloat162 *) x;
+        for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+            const nv_bfloat162 tmpx = x2[col2];
+#pragma unroll
+            for (int j = 0; j < n_tokens; ++j) {
+                const float2 tmpy = y2[(int64_t) j * stride_col_y2 + col2];
+                ggml_cuda_mad(sumf[j], tmpx.x, tmpy.x);
+                ggml_cuda_mad(sumf[j], tmpx.y, tmpy.y);
+            }
+        }
+#endif
+    } else {
+        static_assert(std::is_same_v<T, void>, "unsupported type");
+    }
+
+    __shared__ float s_buf[n_tokens][nwarps];
+    const int lane = tid % warp_size;
+    const int warp = tid / warp_size;
+#pragma unroll
+    for (int j = 0; j < n_tokens; ++j) {
+        sumf[j] = warp_reduce_sum_dpp<warp_size>(sumf[j]);
+        if (lane == 0) {
+            s_buf[j][warp] = sumf[j];
+        }
+    }
+    __syncthreads();
+
+    if (warp == 0) {
+#pragma unroll
+        for (int j = 0; j < n_tokens; ++j) {
+            float val = lane < nwarps ? s_buf[j][lane] : 0.0f;
+            val = warp_reduce_sum_dpp<warp_size>(val);
+            if (lane == 0) {
+                const int i = j * n_heads + h;
+                if (is_beta) {
+                    beta[i] = 1.0f / (1.0f + expf(-val));
+                } else {
+                    const float a  = ggml_cuda_no_contract(val + dt[h]);
+                    const float sp = (a > 20.0f) ? a : logf(1.0f + expf(a));
+                    gate[i] = sp * ssm_a[h];
+                }
+            }
+        }
+    }
+}
+
+template <typename T, typename type_acc, int n_tokens>
+__launch_bounds__(256, 2)
+static __global__ void mul_mat_vec_f_gdn_ab(
+        const T * __restrict__ w_alpha, const T * __restrict__ w_beta, const float * __restrict__ y,
+        const float * __restrict__ dt, const float * __restrict__ ssm_a,
+        float * __restrict__ gate, float * __restrict__ beta,
+        const int ncols2, const int stride_row, const int stride_col_y2, const int n_heads) {
+    ggml_cuda_pdl_sync();
+    mul_mat_vec_f_gdn_ab_block<T, type_acc, n_tokens, 256>(
+        blockIdx.x, blockIdx.y != 0, threadIdx.x,
+        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols2, stride_row, stride_col_y2, n_heads);
+}
+
+// Fused SSM_CONV (+SILU, d_conv=4, 256 channels/block) and F32/F16/BF16 GDN alpha/beta projections in one grid.
+template <typename T, typename type_acc, int n_tokens>
+__launch_bounds__(256, 2)
+static __global__ void gdn_conv_ab_f(
+        const ggml_cuda_ssm_conv_fused_src conv_src, const float * __restrict__ conv_w, const float * __restrict__ conv_bias,
+        const int conv_w_nb1, float * conv_dst, const int conv_dst_nb1, const int conv_n_t, const int n_conv_blocks,
+        const T * __restrict__ w_alpha, const T * __restrict__ w_beta, const float * __restrict__ y,
+        const float * __restrict__ dt, const float * __restrict__ ssm_a,
+        float * __restrict__ gate, float * __restrict__ beta,
+        const int ncols2, const int stride_row, const int stride_col_y2, const int n_heads) {
+    if constexpr (ggml_cuda_get_physical_warp_size() != 32) {
+        NO_DEVICE_CODE;
+    } else {
+        ggml_cuda_pdl_sync();
+        if ((int) blockIdx.x < n_conv_blocks) {
+            ssm_conv_fused_f32_block<true, 256, 4>(
+                blockIdx.x, conv_src, conv_w, conv_bias, conv_w_nb1, conv_dst, conv_dst_nb1, conv_n_t);
+            return;
+        }
+        const int b = blockIdx.x - n_conv_blocks;
+        mul_mat_vec_f_gdn_ab_block<T, type_acc, n_tokens, 256>(
+            b % n_heads, b >= n_heads, threadIdx.x,
+            w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols2, stride_row, stride_col_y2, n_heads);
+    }
+}
