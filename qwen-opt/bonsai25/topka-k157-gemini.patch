+static __global__ void add_softplus_mul_f32_kernel(
+        const float * x, const float * __restrict__ dt, const float * __restrict__ ssm_a,
+        float * dst, const int64_t ne, const uint3 m_fd) {
+    ggml_cuda_pdl_lc();
+    const int64_t i = int64_t(blockDim.x) * blockIdx.x + threadIdx.x;
+    if (i >= ne) {
+        return;
+    }
+    const uint32_t h = fastmodulo((uint32_t) i, m_fd);
+    ggml_cuda_pdl_sync();
+    const float a  = ggml_cuda_no_contract(x[i] + dt[h]);
+    const float sp = op_softplus(a);
+    dst[i] = sp * ssm_a[h];
+}
+
+void ggml_cuda_op_add_softplus_mul(ggml_backend_cuda_context & ctx, const ggml_tensor * x, const ggml_tensor * dt,
+                                   const ggml_tensor * ssm_a, ggml_tensor * dst) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && dt->type == GGML_TYPE_F32 &&
+                ssm_a->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(dt) &&
+                ggml_is_contiguous(ssm_a) && ggml_is_contiguous(dst));
+    const int64_t ne = ggml_nelements(dst);
+    const int64_t m  = x->ne[0];
+    GGML_ASSERT(ne <= UINT32_MAX && ggml_nelements(dt) == m && ggml_nelements(ssm_a) == m);
+
+    const uint3 m_fd = init_fastdiv_values((uint32_t) m);
+    const int64_t num_blocks = (ne + CUDA_NEG_BLOCK_SIZE - 1) / CUDA_NEG_BLOCK_SIZE;
+    const ggml_cuda_kernel_launch_params lp((dim3) num_blocks, CUDA_NEG_BLOCK_SIZE, 0, ctx.stream());
+    ggml_cuda_kernel_launch(add_softplus_mul_f32_kernel, lp,
+        (const float *) x->data, (const float *) dt->data, (const float *) ssm_a->data, (float *) dst->data, ne, m_fd);
+}
