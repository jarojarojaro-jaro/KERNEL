+// Multi-block [ADD +] RMS_NORM + MUL(weight) + MUL(signs) + FWHT (+ optional q8_1), one 512-thread block per B-wide segment.
+// Repeats the row RMS reduction in every segment block in the exact 32-warp order of rms_norm_f32<1024> (bit-identical),
+// then runs one segment FWHT in 2 LDS barriers via wave32 DPP. Outputs must not alias a or b.
+template <int N, int B, bool has_add, bool q8>
+static __global__ void __launch_bounds__(512, 2) add_rms_norm_fwht_mb_f32(
+        const float * a, const float * b, const float * weight, const float * signs,
+        float * sum, float * normed, void * dst_ptr, const float eps, const float fwht_scale) {
+    constexpr int NT      = 512;
+    constexpr int NE_ORIG = N / 1024;
+    static_assert(N % 1024 == 0 && (B == 512 || B == 1024) && N > B, "bad multi-block FWHT shape");
+
+    __shared__ float s_sum[32];
+#ifdef GGML_CUDA_DPP_REDUCE
+    __shared__ float s0[B == 1024 ? 32 : 16][B == 1024 ? 33 : 34];
+    __shared__ float s1[B == 1024 ? 32 : 16][B == 1024 ? 33 : 34];
+#else
+    __shared__ float s_fwht[B];
+#endif
+
+    if constexpr (N == 5120) {
+        ggml_cuda_pdl_lc();
+    }
+
+    const int     seg  = blockIdx.x;
+    const int64_t row  = blockIdx.y;
+    const int     tid  = threadIdx.x;
+    const int     warp = tid / 32;
+    const int     lane = tid % 32;
+
+    a += row * N;
+    if constexpr (has_add) {
+        b   += row * N;
+        sum += row * N;
+    }
+    if (normed) {
+        normed += row * N;
+    }
+
+    if constexpr (N == 5120) {
+        ggml_cuda_pdl_sync();
+    }
+
+    if constexpr (B == 1024) {
+        const int ow0 = warp;
+        const int ow1 = warp + 16;
+        float acc0 = 0.0f;
+        float acc1 = 0.0f;
+        float reg[2];
+#pragma unroll
+        for (int i = 0; i < NE_ORIG; ++i) {
+            const int col0 = i * 1024 + ow0 * 32 + lane;
+            const int col1 = i * 1024 + ow1 * 32 + lane;
+            float x0, x1;
+            if constexpr (has_add) {
+                x0 = __fadd_rn(a[col0], b[col0]);
+                x1 = __fadd_rn(a[col1], b[col1]);
+            } else {
+                x0 = a[col0];
+                x1 = a[col1];
+            }
+            acc0 = fmaf(x0, x0, acc0);
+            acc1 = fmaf(x1, x1, acc1);
+            if (i == seg) {
+                reg[0] = x0;
+                reg[1] = x1;
+                if constexpr (has_add) {
+                    sum[col0] = x0;
+                    sum[col1] = x1;
+                }
+            }
+        }
+
+        acc0 = warp_reduce_sum_dpp<32>(acc0);
+        acc1 = warp_reduce_sum_dpp<32>(acc1);
+        if (lane == 0) {
+            s_sum[ow0] = acc0;
+            s_sum[ow1] = acc1;
+        }
+        __syncthreads();
+        const float total = warp_reduce_sum_dpp<32>(s_sum[lane]);
+        const float scale = rsqrtf(ggml_cuda_no_contract(total / N) + eps);
+
+        const int base = seg * 1024;
+#pragma unroll
+        for (int j = 0; j < 2; ++j) {
+            const int col = base + (j * 16 + warp) * 32 + lane;
+            const float v = scale * reg[j] * weight[col];
+            if (normed) {
+                normed[col] = v;
+            }
+            reg[j] = (v * signs[col]) * fwht_scale;
+        }
+
+#ifdef GGML_CUDA_DPP_REDUCE
+        ggml_cuda_fwht_1024_nt512_dpp(reg, s0, s1, warp, lane);
+#else
+        ggml_cuda_fwht_block_butterfly<1024, NT, 1024>(reg, s_fwht, tid, lane);
+#endif
+
+        if constexpr (!q8) {
+            float * dst = (float *) dst_ptr + row * N + base;
+            dst[tid]      = reg[0];
+            dst[tid + NT] = reg[1];
+        } else {
+            block_q8_1 * ycol = (block_q8_1 *) dst_ptr + row * (N / QK8_1) + seg * (1024 / QK8_1);
+            quantize_q8_1_group<true>(reg[0], ycol + warp,      lane);
+            quantize_q8_1_group<true>(reg[1], ycol + warp + 16, lane);
+        }
+    } else {
+        const int i_seg    = seg >> 1;
+        const int half_seg = seg & 1;
+        const int ow0      = half_seg * 16 + warp;
+        const int ow1      = (1 - half_seg) * 16 + warp;
+        float acc0 = 0.0f;
+        float acc1 = 0.0f;
+        float reg0 = 0.0f;
+#pragma unroll
+        for (int i = 0; i < NE_ORIG; ++i) {
+            const int col0 = i * 1024 + ow0 * 32 + lane;
+            const int col1 = i * 1024 + ow1 * 32 + lane;
+            float x0, x1;
+            if constexpr (has_add) {
+                x0 = __fadd_rn(a[col0], b[col0]);
+                x1 = __fadd_rn(a[col1], b[col1]);
+            } else {
+                x0 = a[col0];
+                x1 = a[col1];
+            }
+            acc0 = fmaf(x0, x0, acc0);
+            acc1 = fmaf(x1, x1, acc1);
+            if (i == i_seg) {
+                reg0 = x0;
+                if constexpr (has_add) {
+                    sum[col0] = x0;
+                }
+            }
+        }
+
+        acc0 = warp_reduce_sum_dpp<32>(acc0);
+        acc1 = warp_reduce_sum_dpp<32>(acc1);
+        if (lane == 0) {
+            s_sum[ow0] = acc0;
+            s_sum[ow1] = acc1;
+        }
+        __syncthreads();
+        const float total = warp_reduce_sum_dpp<32>(s_sum[lane]);
+        const float scale = rsqrtf(ggml_cuda_no_contract(total / N) + eps);
+
+        const int base = seg * 512;
+        const int col  = base + tid;
+        const float v  = scale * reg0 * weight[col];
+        if (normed) {
+            normed[col] = v;
+        }
+        reg0 = (v * signs[col]) * fwht_scale;
+
+#ifdef GGML_CUDA_DPP_REDUCE
+        ggml_cuda_fwht_512_nt512_dpp(reg0, s0, s1, warp, lane);
+#else
+        float reg[1] = { reg0 };
+        ggml_cuda_fwht_block_butterfly<512, NT, 512>(reg, s_fwht, tid, lane);
+        reg0 = reg[0];
+#endif
+
+        if constexpr (!q8) {
+            float * dst = (float *) dst_ptr + row * N + base;
