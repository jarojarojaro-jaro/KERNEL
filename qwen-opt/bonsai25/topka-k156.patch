+// [GGML_HIP_K156] RDNA3 Q2_0 (Bonsai) mat-vec at 1-3 columns, the big_rows instance of mul_mat_vec_q for Q2_0: a wave
+// computes GGML_HIP_K156_ROWS (2, 4 = default, 8) rows instead of one (1-column launch) or two, so a K iteration has 4x
+// the weight bytes in flight, and every lane takes one 32-value chunk (8 bytes of 2-bit codes + the block scale) per
+// row with one 64-bit and one 16-bit load. The activations of the chunk are loaded once per lane for all rows and
+// transposed (v_perm), so that the code planes (q >> 2i) & 0x03030303 dot them directly with dp4a: no per-value table
+// lookup; the code offset (codes 0..3 = values -1..2) is the exact integer sum of the chunk's activations, subtracted
+// once per chunk. Same fusion epilogue as the table's launch (gate/GLU, bias/residual, q8_1 copy, pair launches).
+// GGML_HIP_K156=0: the table's launch.
+static int mmvq_k156_rows() {
+    static const int rows = [] {
+        if (!ggml_cuda_env_switch("GGML_HIP_K156")) {
+            return 0;
+        }
+        const char * env = getenv("GGML_HIP_K156_ROWS");
+        const int r = env ? atoi(env) : 4;
+        return r == 2 || r == 8 ? r : 4;
+    }();
+    return rows;
+}
+
+// 4x4 byte transpose: a[i] byte m = byte i of y[m] (y[m] holds activations 4m..4m+3, so a[i] holds 4m + i, m = 0..3,
+// the values of code plane i of a 16-value weight dword)
+static __device__ __forceinline__ void mmvq_q2_0_transpose(const int4 y, int * a) {
+#if defined(GGML_USE_HIP)
+    const uint32_t t0 = __builtin_amdgcn_perm(y.y, y.x, 0x05010400); // y0.b0 y1.b0 y0.b1 y1.b1
+    const uint32_t t1 = __builtin_amdgcn_perm(y.y, y.x, 0x07030602); // y0.b2 y1.b2 y0.b3 y1.b3
+    const uint32_t t2 = __builtin_amdgcn_perm(y.w, y.z, 0x05010400); // y2.b0 y3.b0 y2.b1 y3.b1
+    const uint32_t t3 = __builtin_amdgcn_perm(y.w, y.z, 0x07030602); // y2.b2 y3.b2 y2.b3 y3.b3
+    a[0] = __builtin_amdgcn_perm(t2, t0, 0x05040100);
+    a[1] = __builtin_amdgcn_perm(t2, t0, 0x07060302);
+    a[2] = __builtin_amdgcn_perm(t3, t1, 0x05040100);
+    a[3] = __builtin_amdgcn_perm(t3, t1, 0x07060302);
+#else
+    GGML_UNUSED(y);
+    a[0] = a[1] = a[2] = a[3] = 0;
+    NO_DEVICE_CODE;
+#endif
+}
