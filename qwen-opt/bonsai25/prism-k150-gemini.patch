From bdac0f508346e42c863315e561149557bae86523 Mon Sep 17 00:00:00 2001
From: gemini <g@l>
Date: Wed, 25 Nov 2026 01:41:06 +0100
Subject: [PATCH] K-150 (Gemini): HIP fusions FWHT+q8, norm+fwht, GDN conv,
 mmvf pair, single graph, sync trim, MTP graph cache; env GGML_HIP_K150_*

---
 ggml/src/ggml-cuda/ggml-cuda.cu | 85 +++++++++++++++++++++++++++------
 src/llama-context.cpp           | 76 ++++++++++++++++++++++++-----
 2 files changed, 134 insertions(+), 27 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 3190763..babd8b7 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -154,6 +154,38 @@ static bool ggml_cuda_env_set(const char * name) {
     return getenv(name) != nullptr;
 }
 
+static bool ggml_cuda_k150_env_on(const char * name) {
+    const char * env = getenv(name);
+    return env == nullptr || std::atoi(env) != 0;
+}
+
+static bool ggml_cuda_k150_fwht_q8_enabled() {
+    static const bool enabled = ggml_cuda_k150_env_on("GGML_HIP_K150_FWHT_Q8");
+    return enabled;
+}
+
+static bool ggml_cuda_k150_norm_fwht_enabled() {
+    static const bool enabled = ggml_cuda_k150_env_on("GGML_HIP_K150_NORM_FWHT");
+    return enabled;
+}
+
+static bool ggml_cuda_k150_gdn_conv_enabled() {
+    static const bool enabled = ggml_cuda_k150_env_on("GGML_HIP_K150_GDN_CONV");
+    return enabled;
+}
+
+static bool ggml_cuda_k150_mmvf_pair_enabled() {
+    static const bool enabled = ggml_cuda_k150_env_on("GGML_HIP_K150_MMVF_PAIR");
+    return enabled;
+}
+
+#if defined(GGML_USE_HIP) && defined(USE_CUDA_GRAPH)
+static bool ggml_cuda_k150_single_graph_enabled() {
+    static const bool enabled = ggml_cuda_k150_env_on("GGML_HIP_K150_SINGLE_GRAPH");
+    return enabled;
+}
+#endif
+
 static bool ggml_cuda_unified_memory_enabled() {
     static const bool enabled = ggml_cuda_env_flag("GGML_CUDA_ENABLE_UNIFIED_MEMORY");
     return enabled;
