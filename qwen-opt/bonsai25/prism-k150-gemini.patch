+    const bool hip_fwht_q8 = GGML_CUDA_CC_IS_AMD(cc) && ggml_cuda_k150_fwht_q8_enabled();
+    if (!hip_fwht_q8 && (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_TURING)) {
         return 0; // the PTQ1_0 mmvq predicate below is only meaningful there
     }
 
@@ -3418,7 +3460,7 @@ static int ggml_cuda_try_fwht_q8(ggml_backend_cuda_context & ctx, const ggml_cgr
     // x is only known to be contiguous with the same element count as the consumers' src1 [K, ncols];
