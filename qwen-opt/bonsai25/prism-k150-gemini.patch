-    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_TURING) {
+    const bool hip_fwht_q8 = GGML_CUDA_CC_IS_AMD(cc) && ggml_cuda_k150_fwht_q8_enabled();
+    if (!hip_fwht_q8 && (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_TURING)) {
         return false;
     }
     const ggml_tensor * mm = cgraph->nodes[i_mm];
@@ -5149,7 +5194,8 @@ static bool ggml_cuda_norm_fwht_q8_prepare(const ggml_cgraph * cgraph, const int
         }
     }
     ggml_cuda_fwht_q8_uses & u = plan.uses;
-    if (!ggml_cuda_fwht_q8_find_uses(cgraph, i_mm, cc, true, u) || u.wtype != GGML_TYPE_PQ2_0 || u.K != n ||
+    if (!ggml_cuda_fwht_q8_find_uses(cgraph, i_mm, cc, true, u, hip_fwht_q8) ||
