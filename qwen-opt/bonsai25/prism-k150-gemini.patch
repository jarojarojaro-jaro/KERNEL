@@ -3169,7 +3209,8 @@ static bool ggml_cuda_fwht_q8_find_uses(const ggml_cgraph * cgraph, const int i_
                 continue;
             }
             const ggml_type ct = t->src[0] ? t->src[0]->type : GGML_TYPE_COUNT;
-            const bool type_ok = ct == GGML_TYPE_PTQ1_0 || (accept_pq2 && ct == GGML_TYPE_PQ2_0);
+            const bool type_ok = ct == GGML_TYPE_PTQ1_0 || (accept_pq2 && ct == GGML_TYPE_PQ2_0) ||
+                                 (accept_q2 && ct == GGML_TYPE_Q2_0);
