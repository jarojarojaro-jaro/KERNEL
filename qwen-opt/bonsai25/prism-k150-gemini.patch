+        const bool arf_arch_ok = GGML_CUDA_CC_IS_NVIDIA(arf_cc) ||
+                                 (GGML_CUDA_CC_IS_AMD(arf_cc) && ggml_cuda_k150_norm_fwht_enabled());
+        if (!arf_disabled && arf_arch_ok &&
                 rms_norm->op == GGML_OP_RMS_NORM && mul_w->op == GGML_OP_MUL && mul_s->op == GGML_OP_MUL &&
                 reshape->op == GGML_OP_RESHAPE && mm->op == GGML_OP_MUL_MAT &&
                 rms_norm->src[0] == node && (mul_w->src[0] == rms_norm || mul_w->src[1] == rms_norm) &&
@@ -5469,7 +5518,9 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         const ggml_tensor * x = node->src[0];
         const int64_t ncols = node->ne[0];
         const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
-        if (!rf_disabled && GGML_CUDA_CC_IS_NVIDIA(cc) && mul_w->op == GGML_OP_MUL &&
+        const bool rf_arch_ok = GGML_CUDA_CC_IS_NVIDIA(cc) ||
+                                (GGML_CUDA_CC_IS_AMD(cc) && ggml_cuda_k150_norm_fwht_enabled());
+        if (!rf_disabled && rf_arch_ok && mul_w->op == GGML_OP_MUL &&
                 (mul_w->src[0] == node || mul_w->src[1] == node) && x && x->type == GGML_TYPE_F32 &&
                 node->type == GGML_TYPE_F32 && mul_w->type == GGML_TYPE_F32 && ggml_is_contiguous(x) &&
                 ggml_is_contiguous(node) && ggml_is_contiguous(mul_w) && ggml_are_same_shape(x, node) &&
@@ -5558,9 +5609,11 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         ggml_tensor * rms_norm = cgraph->nodes[i + 1];
         ggml_tensor * mul = cgraph->nodes[i + 2];
         const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+        const bool arn_arch_ok = GGML_CUDA_CC_IS_NVIDIA(cc) ||
+                                 (GGML_CUDA_CC_IS_AMD(cc) && ggml_cuda_k150_norm_fwht_enabled());
         const ggml_op ops[] = { GGML_OP_ADD, GGML_OP_RMS_NORM, GGML_OP_MUL };
         const int out_nodes[] = { i, i + 2 };
-        if (GGML_CUDA_CC_IS_NVIDIA(cc) && rms_norm->op == GGML_OP_RMS_NORM &&
+        if (arn_arch_ok && rms_norm->op == GGML_OP_RMS_NORM &&
                 mul->op == GGML_OP_MUL && (mul->src[0] == rms_norm || mul->src[1] == rms_norm) &&
                 rms_norm->src[0] == node && node->src[0] && node->src[1] &&
                 node->type == GGML_TYPE_F32 && node->src[0]->type == GGML_TYPE_F32 &&
@@ -6500,10 +6553,12 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         return 2;
     }
 
-    if (node->op == GGML_OP_MUL_MAT && ggml_cuda_gdn_fusion_enabled() &&
-            GGML_CUDA_CC_IS_NVIDIA(ggml_cuda_info().devices[cuda_ctx->device].cc)) {
-        if (const int n = ggml_cuda_try_mmvf_pair(*cuda_ctx, cgraph, i)) {
-            return n;
+    if (node->op == GGML_OP_MUL_MAT && ggml_cuda_gdn_fusion_enabled()) {
+        const int cc_pair = ggml_cuda_info().devices[cuda_ctx->device].cc;
+        if (GGML_CUDA_CC_IS_NVIDIA(cc_pair) || (GGML_CUDA_CC_IS_AMD(cc_pair) && ggml_cuda_k150_mmvf_pair_enabled())) {
+            if (const int n = ggml_cuda_try_mmvf_pair(*cuda_ctx, cgraph, i)) {
+                return n;
+            }
         }
     }
 
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index d8ff830..5e4b763 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -950,10 +950,37 @@ bool llama_sycl_present() {
     return v;
 }
 
+static bool llama_rocm_present() {
+    static const bool v = [] {
+        ggml_backend_reg_t reg = ggml_backend_reg_by_name("ROCm");
+        return reg != nullptr && ggml_backend_reg_dev_count(reg) > 0;
+    }();
+    return v;
+}
+
+static bool llama_hip_k150_env_on(const char * name) {
+    const char * e = getenv(name);
+    return e == nullptr || atoi(e) != 0;
+}
+
+static bool llama_hip_k150_mtp_graph_cache_enabled() {
+    static const bool v = llama_rocm_present() && llama_hip_k150_env_on("GGML_HIP_K150_MTP_GRAPH_CACHE");
+    return v;
+}
+
 int llama_sync_trim() {
     static const int v = [] {
         const char * e = getenv("LLAMA_SYNC_TRIM");
-        return e ? atoi(e) : (llama_sycl_present() ? 3 : 0);
+        if (e) {
+            return atoi(e);
+        }
+        if (llama_sycl_present()) {
+            return 3;
+        }
+        if (llama_rocm_present() && llama_hip_k150_env_on("GGML_HIP_K150_SYNC_TRIM")) {
+            return 3;
+        }
+        return 0;
     }();
     return v;
 }
@@ -1077,6 +1104,15 @@ bool llama_context::memory_update(bool optimize) {
             }
         }
         gf_res_prev_active = nullptr;
+        for (auto & [k, e] : mtp_chain_cache) {
+            GGML_UNUSED(k);
+            for (auto & r : e.res) {
+                if (r) {
+                    r->reset();
+                }
+            }
+            e.active = nullptr;
+        }
 
         if (!mctx->apply()) {
             LLAMA_LOG_ERROR("%s: failed to apply memory update\n", __func__);
@@ -1626,6 +1662,8 @@ llama_context::mtp_chain_entry * llama_context::mtp_chain_entry_for(uint32_t n_t
     mtp_chain_entry e;
     e.sched.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(), backend_ptrs.size(), max_nodes, false,
                                          cparams.op_offload));
+    ggml_backend_sched_set_copy_callback(e.sched.get(), sched_copy_experts, this);
+    ggml_backend_sched_set_realloc_callback(e.sched.get(), sched_graph_realloc, this);
     for (auto & res : e.res) { res.reset(new llm_graph_result(max_nodes)); }
     return &(mtp_chain_cache[key] = std::move(e));
 }
@@ -2452,17 +2490,34 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
 
         ggml_status status;
 
-        // ARC-LAB: a chained MTP draft runs on the cached scheduler + graph of its batch shape (mtp_chain_cache)
-        mtp_chain_entry * chain_e = cparams.mtp_chain_n > 0 ? mtp_chain_entry_for(ubatch.n_tokens) : nullptr;
-        if (chain_e) {
-            std::swap(sched,       chain_e->sched);
-            std::swap(gf_res_prev, chain_e->res);
-            std::swap(gf_res_prev_active, chain_e->active);
-        }
+        // cache small MTP draft graphs per batch shape so alternating catch-up+anchor and 1-token steps reuse sched + cgraph
+        const bool use_mtp_cache = cparams.mtp_chain_n > 0 ||
+            (cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP && n_outputs > 0 &&
+             ubatch.n_tokens <= 8 && !cparams.pipeline_parallel &&
+             llama_hip_k150_mtp_graph_cache_enabled());
+        mtp_chain_entry * chain_e = use_mtp_cache ? mtp_chain_entry_for(ubatch.n_tokens) : nullptr;
+        struct mtp_cache_guard {
+            llama_context * ctx;
+            mtp_chain_entry * e;
+            mtp_cache_guard(llama_context * c, mtp_chain_entry * entry) : ctx(c), e(entry) {
+                if (e) {
+                    std::swap(ctx->sched, e->sched);
+                    std::swap(ctx->gf_res_prev, e->res);
+                    std::swap(ctx->gf_res_prev_active, e->active);
+                }
+            }
+            ~mtp_cache_guard() {
+                if (e) {
+                    std::swap(ctx->sched, e->sched);
+                    std::swap(ctx->gf_res_prev, e->res);
+                    std::swap(ctx->gf_res_prev_active, e->active);
+                }
+            }
+        } chain_guard(this, chain_e);
 
         const auto * res = process_ubatch(ubatch, ctx_type_to_graph_type(cparams.ctx_type), mctx.get(), status);
 
-        if (chain_e) {
+        if (cparams.mtp_chain_n > 0 && chain_e) {
             // the per-step argmax rows, mapped to tokens in get_mtp_chain_ids()
             if (res && res->t_mtp_chain_ids) {
                 // one copy of all the ids (LLAMA_MTP_CHAIN_TIGHT bit 16)
@@ -2482,9 +2537,6 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
                 }
                 mtp_chain_n_out = (uint32_t) res->t_mtp_chain.size();
             }
-            std::swap(sched,       chain_e->sched);
-            std::swap(gf_res_prev, chain_e->res);
-            std::swap(gf_res_prev_active, chain_e->active);
         }
 
         if (!res) {
