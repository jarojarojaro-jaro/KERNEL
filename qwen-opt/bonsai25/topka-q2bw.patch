diff --git a/tests/test-mmvq-bw.cpp b/tests/test-mmvq-bw.cpp
new file mode 100644
index 000000000..7c01a3636
--- /dev/null
+++ b/tests/test-mmvq-bw.cpp
@@ -0,0 +1,393 @@
+// Full-step quantized mat-vec bandwidth (GGML_HIP_Q2BW): every weight matrix of a Bonsai 2.5 27B (Qwen3.8-27B hybrid)
+// decode step as its own tensor (~7.2 GB of Q2_0, far past the 96 MB Infinity Cache of an RX 7900 XTX, so nothing is
+// served from cache between steps), run as one graph per step with the model's matmul pattern: GDN qkv + z + ssm_out,
+// attention q/k/v/o, the FFN gate/up + SWIGLU (fused gate/up launch) and down, residual ADDs (fused bias epilogues) and
+// the vocab head. Also the FFN, the projections and the head alone. Prints ms and GB/s of weights per graph for every
+// variant (sets of runtime switches, flipped through GGML_HIP_RUNTIME_SWITCH_FILE, rounds interleaved), and checks the
+// step's outputs of every variant bitwise against the first variant.
+//
+// usage: test-mmvq-bw [-b ROCm0] [-n ncols] [-r rounds] [-i iters] [-l layers] [-t q2_0] [-g all|step] VARIANT...
+//   VARIANT: base | NAME=VAL[,NAME=VAL...]   e.g. base GGML_HIP_Q2BW=1 GGML_HIP_Q2BW=1,GGML_HIP_Q2BW_NT=1
+//   -g step: the step graph only (2 warm-up + iters runs per variant and round)
+// Kernel-only GB/s: run one variant with -g step under rocprofv3 --kernel-trace --stats and divide the step bytes times
+// the number of runs by the mat-vec kernel time (qwen-opt/bonsai25/bw-prof.sh).
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cinttypes>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <random>
+#include <string>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+namespace {
+
+constexpr int64_t N_EMBD  = 5120;
+constexpr int64_t N_FF    = 17408;
+constexpr int64_t N_QKV   = 10240; // GDN qkv
+constexpr int64_t N_Z     = 6144;  // GDN gate (z)
+constexpr int64_t N_INNER = 6144;  // GDN inner / attention output width
+constexpr int64_t N_Q     = 12288; // attention q (+ gate)
+constexpr int64_t N_KV    = 1024;
+constexpr int64_t N_VOCAB = 248320;
+
+struct layer_w {
+    bool          attn;
+    ggml_tensor * a = nullptr; // GDN qkv | attn q
+    ggml_tensor * b = nullptr; // GDN z   | attn k
+    ggml_tensor * c = nullptr; //         | attn v
+    ggml_tensor * o = nullptr; // ssm_out | attn_output
+    ggml_tensor * gate = nullptr;
+    ggml_tensor * up   = nullptr;
+    ggml_tensor * down = nullptr;
+};
+
+enum graph_kind { G_STEP, G_FFN, G_PROJ, G_HEAD, G_COUNT };
+const char * graph_name[G_COUNT] = { "step", "ffn", "proj", "head" };
+
+struct bench_graph {
+    ggml_context *            ctx   = nullptr;
+    ggml_cgraph *             gf    = nullptr;
+    ggml_gallocr_t            alloc = nullptr;
+    ggml_tensor *             x     = nullptr;
+    ggml_tensor *             hid   = nullptr;
+    std::vector<ggml_tensor *> outs;
+    double                    bytes = 0.0; // weight bytes read per run
+};
+
+uint64_t fnv1a(const uint8_t * p, size_t n, uint64_t h = 1469598103934665603ull) {
+    for (size_t i = 0; i < n; ++i) {
+        h = (h ^ p[i]) * 1099511628211ull;
+    }
+    return h;
+}
+
+void usage(const char * argv0) {
+    fprintf(stderr, "usage: %s [-b backend] [-n ncols] [-r rounds] [-i iters] [-l layers] [-t type] [-g all|step] VARIANT...\n", argv0);
+    fprintf(stderr, "  VARIANT: base | NAME=VAL[,NAME=VAL...] (runtime switches)\n");
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    std::string backend_name = "ROCm0";
+    int64_t     ncols  = 1;
+    int         rounds = 3;
+    int         iters  = 10;
+    int         n_layer = 64;
+    ggml_type   wtype  = GGML_TYPE_Q2_0;
+    bool        step_only = false;
+    std::vector<std::string> variants;
+    for (int i = 1; i < argc; ++i) {
+        const std::string a = argv[i];
+        const bool has_val = i + 1 < argc;
+        if (a == "-b" && has_val) {
+            backend_name = argv[++i];
+        } else if (a == "-n" && has_val) {
+            ncols = atoi(argv[++i]);
+        } else if (a == "-r" && has_val) {
+            rounds = atoi(argv[++i]);
+        } else if (a == "-i" && has_val) {
+            iters = atoi(argv[++i]);
+        } else if (a == "-g" && has_val) {
+            step_only = std::string(argv[++i]) == "step";
+        } else if (a == "-l" && has_val) {
+            n_layer = atoi(argv[++i]);
+        } else if (a == "-t" && has_val) {
+            const std::string t = argv[++i];
+            wtype = GGML_TYPE_COUNT;
+            for (int k = 0; k < GGML_TYPE_COUNT; ++k) {
+                const char * nm = ggml_type_name((ggml_type) k);
+                if (nm && t == nm) {
+                    wtype = (ggml_type) k;
+                }
+            }
+            if (wtype == GGML_TYPE_COUNT) {
+                fprintf(stderr, "unknown type %s\n", t.c_str());
+                return 1;
+            }
+        } else if (a == "-h" || a == "--help") {
+            usage(argv[0]);
+            return 0;
+        } else if (!a.empty() && a[0] != '-') {
+            variants.push_back(a);
+        } else {
+            usage(argv[0]);
+            return 1;
+        }
+    }
+    if (variants.empty()) {
+        variants.push_back("base");
+    }
+
+    // the runtime switch file (read by the HIP backend on every graph_compute, at most every 20 ms)
+    std::string sw_path;
+    if (const char * p = getenv("GGML_HIP_RUNTIME_SWITCH_FILE")) {
+        sw_path = p;
+    } else {
+        sw_path = "/tmp/test-mmvq-bw." + std::to_string(getpid()) + ".sw";
+        setenv("GGML_HIP_RUNTIME_SWITCH_FILE", sw_path.c_str(), 1);
+    }
+    int sw_serial = 0;
+    const auto set_variant = [&](const std::string & v) {
+        std::ofstream f(sw_path, std::ios::trunc);
+        f << "# test-mmvq-bw " << ++sw_serial << "\n";
+        if (v != "base") {
+            std::string s = v;
+            std::replace(s.begin(), s.end(), ',', '\n');
+            f << s << "\n";
+        }
+        f.close();
+        std::this_thread::sleep_for(std::chrono::milliseconds(40));
+    };
+    set_variant("base");
+
+    ggml_backend_load_all();
+    ggml_backend_dev_t dev = ggml_backend_dev_by_name(backend_name.c_str());
+    if (!dev) {
+        fprintf(stderr, "backend %s not found\n", backend_name.c_str());
+        return 1;
+    }
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    if (!backend) {
+        fprintf(stderr, "backend %s init failed\n", backend_name.c_str());
+        return 1;
+    }
+
+    // ---- weights: one tensor per matrix, every layer its own
+    const int n_w = n_layer*7 + 1;
+    ggml_init_params wp = { size_t(n_w + 8)*ggml_tensor_overhead(), nullptr, true };
+    ggml_context * ctx_w = ggml_init(wp);
+    std::vector<layer_w> layers(n_layer);
+    const auto mk = [&](int64_t k, int64_t m, const std::string & name) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx_w, wtype, k, m);
+        ggml_set_name(t, name.c_str());
+        return t;
+    };
+    for (int il = 0; il < n_layer; ++il) {
+        layer_w & L = layers[il];
+        const std::string p = "blk." + std::to_string(il) + ".";
+        L.attn = il % 4 == 3; // full_attention_interval 4: 48 GDN + 16 attention layers
+        if (L.attn) {
+            L.a = mk(N_EMBD, N_Q,  p + "attn_q");
+            L.b = mk(N_EMBD, N_KV, p + "attn_k");
+            L.c = mk(N_EMBD, N_KV, p + "attn_v");
+            L.o = mk(N_INNER, N_EMBD, p + "attn_output");
+        } else {
+            L.a = mk(N_EMBD, N_QKV, p + "attn_qkv");
+            L.b = mk(N_EMBD, N_Z,   p + "attn_gate");
+            L.o = mk(N_INNER, N_EMBD, p + "ssm_out");
+        }
+        L.gate = mk(N_EMBD, N_FF, p + "ffn_gate");
+        L.up   = mk(N_EMBD, N_FF, p + "ffn_up");
+        L.down = mk(N_FF, N_EMBD, p + "ffn_down");
+    }
+    ggml_tensor * head = mk(N_EMBD, N_VOCAB, "output");
+    ggml_backend_buffer_t wbuf = ggml_backend_alloc_ctx_tensors(ctx_w, backend);
+    if (!wbuf) {
+        fprintf(stderr, "weight allocation failed\n");
+        return 1;
+    }
+
+    // fill: a pattern of quantized random rows (scale ~ 1/sqrt(K) keeps the residual stream bounded), each tensor
+    // starting at a different block so that no two matrices are the same bytes
+    {
+        std::mt19937 rng(1234);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        const int64_t k_pat = 1024, rows_pat = 4096;
+        std::vector<float> f(k_pat*rows_pat);
+        for (float & v : f) {
+            v = nd(rng) * 0.03f;
+        }
+        const size_t row_sz = ggml_row_size(wtype, k_pat);
+        std::vector<uint8_t> pat(row_sz*rows_pat);
+        ggml_quantize_chunk(wtype, f.data(), pat.data(), 0, rows_pat, k_pat, nullptr);
+        const size_t bs = ggml_type_size(wtype);
+        const size_t nblk_pat = pat.size() / bs;
+        const size_t chunk = (64u << 20) / bs * bs;
+        std::vector<uint8_t> stage(chunk);
+        size_t seed = 0;
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx_w); t; t = ggml_get_next_tensor(ctx_w, t)) {
+            const size_t nbytes = ggml_nbytes(t);
+            size_t blk = (seed++ * 7919) % nblk_pat;
+            for (size_t off = 0; off < nbytes; off += chunk) {
+                const size_t len = std::min(chunk, nbytes - off);
+                for (size_t o = 0; o < len; ) { // whole blocks of the pattern from block blk on, wrapping around
+                    const size_t n = std::min(len - o, (nblk_pat - blk)*bs);
+                    memcpy(stage.data() + o, pat.data() + blk*bs, n);
+                    o  += n;
+                    blk = (blk + n/bs) % nblk_pat;
+                }
+                ggml_backend_tensor_set(t, stage.data(), off, len);
+            }
+        }
+    }
+
+    // ---- graphs
+    const auto build = [&](graph_kind kind) {
+        bench_graph g;
+        ggml_init_params gp = { size_t(4096)*ggml_tensor_overhead() + ggml_graph_overhead_custom(8192, false), nullptr, true };
+        g.ctx = ggml_init(gp);
+        g.gf  = ggml_new_graph_custom(g.ctx, 8192, false);
+        g.x   = ggml_new_tensor_2d(g.ctx, GGML_TYPE_F32, N_EMBD, ncols);
+        g.hid = ggml_new_tensor_2d(g.ctx, GGML_TYPE_F32, N_INNER, ncols);
+        ggml_set_input(g.x);
+        ggml_set_input(g.hid);
+        const auto out = [&](ggml_tensor * t) {
+            ggml_set_output(t);
+            ggml_build_forward_expand(g.gf, t);
+            g.outs.push_back(t);
+        };
+        const auto mm = [&](ggml_tensor * w, ggml_tensor * y) {
+            g.bytes += ggml_nbytes(w);
+            return ggml_mul_mat(g.ctx, w, y);
+        };
+        ggml_tensor * x = g.x;
+        for (int il = 0; il < n_layer; ++il) {
+            const layer_w & L = layers[il];
+            if (kind == G_STEP || kind == G_PROJ) {
+                out(mm(L.a, x));
+                out(mm(L.b, x));
+                if (L.attn) {
+                    out(mm(L.c, x));
+                }
+                x = ggml_add(g.ctx, mm(L.o, g.hid), x);
+                out(x);
+            }
+            if (kind == G_STEP || kind == G_FFN) {
+                ggml_tensor * gt = mm(L.gate, x);
+                ggml_tensor * up = mm(L.up, x);
+                ggml_tensor * a  = ggml_swiglu_split(g.ctx, gt, up);
+                x = ggml_add(g.ctx, mm(L.down, a), x);
+                out(x);
+            }
+        }
+        if (kind == G_STEP || kind == G_HEAD) {
+            out(mm(head, x));
+        }
+        g.alloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend));
+        if (!ggml_gallocr_alloc_graph(g.alloc, g.gf)) {
+            fprintf(stderr, "graph allocation failed\n");
+            exit(1);
+        }
+        std::mt19937 rng(42);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        std::vector<float> xv(N_EMBD*ncols), hv(N_INNER*ncols);
+        for (float & v : xv) { v = nd(rng); }
+        for (float & v : hv) { v = nd(rng); }
+        ggml_backend_tensor_set(g.x, xv.data(), 0, ggml_nbytes(g.x));
+        if (g.hid->buffer) { // not part of the FFN and head graphs
+            ggml_backend_tensor_set(g.hid, hv.data(), 0, ggml_nbytes(g.hid));
+        }
+        return g;
+    };
+    std::vector<bench_graph> graphs;
+    for (int k = 0; k < G_COUNT; ++k) {
+        graphs.push_back(build((graph_kind) k));
+    }
+
+    printf("test-mmvq-bw: %s, type %s, ncols %" PRId64 ", %d layers, %d rounds x %d iters; weight MB per run:",
+           backend_name.c_str(), ggml_type_name(wtype), ncols, n_layer, rounds, iters);
+    for (int k = 0; k < G_COUNT; ++k) {
+        printf(" %s %.1f", graph_name[k], graphs[k].bytes/1e6);
+    }
+    printf("\n");
+
+    const auto run = [&](bench_graph & g, int n) {
+        const auto t0 = std::chrono::steady_clock::now();
+        for (int i = 0; i < n; ++i) {
+            if (ggml_backend_graph_compute(backend, g.gf) != GGML_STATUS_SUCCESS) {
+                fprintf(stderr, "graph compute failed\n");
+                exit(1);
+            }
+        }
+        const auto t1 = std::chrono::steady_clock::now();
+        return std::chrono::duration<double, std::milli>(t1 - t0).count() / n;
+    };
+    const auto hashes = [&](bench_graph & g) {
+        std::vector<uint64_t> h;
+        std::vector<uint8_t> buf;
+        for (ggml_tensor * t : g.outs) {
+            buf.resize(ggml_nbytes(t));
+            ggml_backend_tensor_get(t, buf.data(), 0, buf.size());
+            h.push_back(fnv1a(buf.data(), buf.size()));
+        }
+        return h;
+    };
+
+    const size_t nv = variants.size();
+    std::vector<std::vector<std::vector<double>>> ms(nv, std::vector<std::vector<double>>(G_COUNT));
+    std::vector<std::string> parity(nv, "ref");
+    std::vector<uint64_t> ref;
+    for (int r = 0; r < rounds; ++r) {
+        for (size_t v = 0; v < nv; ++v) {
+            set_variant(variants[v]);
+            for (int k = 0; k < G_COUNT; ++k) {
+                if (step_only && k != G_STEP) {
+                    continue;
+                }
+                run(graphs[k], 2); // warm-up: switch poll, graph capture
+                ms[v][k].push_back(run(graphs[k], k == G_STEP ? iters : 2*iters));
+            }
+            if (r == 0) {
+                const std::vector<uint64_t> h = hashes(graphs[G_STEP]);
+                if (v == 0) {
+                    ref = h;
+                } else {
+                    size_t ndiff = 0;
+                    std::string first;
+                    for (size_t i = 0; i < h.size(); ++i) {
+                        if (h[i] != ref[i]) {
+                            if (ndiff++ == 0) {
+                                first = ggml_get_name(graphs[G_STEP].outs[i])[0] ? ggml_get_name(graphs[G_STEP].outs[i])
+                                                                                    : ("out#" + std::to_string(i));
+                                first += " (" + std::string(ggml_op_desc(graphs[G_STEP].outs[i])) + " #" + std::to_string(i) + ")";
+                            }
+                        }
+                    }
+                    parity[v] = ndiff == 0 ? "bitwise" : "DIFF " + std::to_string(ndiff) + "/" + std::to_string(h.size()) +
+                                                            " first " + first;
+                }
+            }
+        }
+    }
+    set_variant("base");
+
+    printf("%-60s %9s %8s %9s %9s %9s  %s\n", "variant", "step ms", "GB/s", "ffn GB/s", "proj GB/s", "head GB/s", "parity");
+    for (size_t v = 0; v < nv; ++v) {
+        double gbs[G_COUNT];
+        double step_ms = 0.0;
+        for (int k = 0; k < G_COUNT; ++k) {
+            std::vector<double> s = ms[v][k];
+            std::sort(s.begin(), s.end());
+            gbs[k] = s.empty() ? 0.0 : graphs[k].bytes/s[s.size()/2]/1e6;
+            if (k == G_STEP) {
+                step_ms = s[s.size()/2];
+            }
+        }
+        printf("%-60s %9.3f %8.1f %9.1f %9.1f %9.1f  %s\n", variants[v].c_str(), step_ms, gbs[G_STEP], gbs[G_FFN],
+               gbs[G_PROJ], gbs[G_HEAD], parity[v].c_str());
+    }
+
+    for (bench_graph & g : graphs) {
+        ggml_gallocr_free(g.alloc);
+        ggml_free(g.ctx);
+    }
+    ggml_backend_buffer_free(wbuf);
+    ggml_free(ctx_w);
+    ggml_backend_free(backend);
+    if (!getenv("TEST_MMVQ_BW_KEEP_SWITCH_FILE") && sw_path.find("/tmp/test-mmvq-bw.") == 0) {
+        unlink(sw_path.c_str());
+    }
+    return 0;
+}
