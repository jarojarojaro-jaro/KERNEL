diff --git a/ggml/src/ggml-cuda/mmvq-q2bw.cu b/ggml/src/ggml-cuda/mmvq-q2bw.cu
new file mode 100644
index 000000000..5faf81d22
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-q2bw.cu
@@ -0,0 +1,111 @@
+#include "mmvq-q2bw.cuh"
+
+#include <algorithm>
+
+// [GGML_HIP_Q2BW] host entry: switches, applicability, instance choice (see mmvq-q2bw.cuh)
+bool ggml_cuda_mmvq_q2bw(const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int ncols_dst, const int stride_row_x, const int stride_col_y,
+        const int stride_col_dst, cudaStream_t stream) {
+    if (GGML_CUDA_RT_SWITCH("GGML_HIP_Q2BW", 0) == 0) {
+        return false;
+    }
+    const int nmax = std::min(3, GGML_CUDA_RT_SWITCH("GGML_HIP_Q2BW_N", 3));
+    if (ncols_dst < 1 || ncols_dst > nmax || ncols_x % QK2_0 != 0) {
+        return false;
+    }
+    // the epilogues of the table's launch this kernel reproduces: gate/GLU (one column), bias, pair, q8_1 copy
+    if (fusion.shared_up != nullptr || fusion.x_scale != nullptr || fusion.gate_scale != nullptr ||
+        (ncols_dst > 1 && (fusion.gate != nullptr || fusion.q8_out != nullptr))) {
+        return false;
+    }
+    // 32-bit byte offsets within a matrix
+    const uint64_t row_bytes = uint64_t(stride_row_x)*sizeof(block_q2_0);
+    if (uint64_t(nrows_x)*row_bytes >= (uint64_t(1) << 32) ||
+        (fusion.pair_x != nullptr && uint64_t(fusion.pair_nrows)*row_bytes >= (uint64_t(1) << 32))) {
+        return false;
+    }
+
+    const bool gate = fusion.gate != nullptr;
+    const int  cpol = mmvq_q2bw_cpol(GGML_CUDA_RT_SWITCH("GGML_HIP_Q2BW_NT", 0));
+    const int  u_sw = GGML_CUDA_RT_SWITCH("GGML_HIP_Q2BW_U", 2);
+    const int  r_sw = GGML_CUDA_RT_SWITCH("GGML_HIP_Q2BW_R", 1);
+    int  U   = u_sw >= 4 ? 4 : u_sw >= 2 ? 2 : 1;
+    int  R   = r_sw >= 4 ? 4 : r_sw >= 2 ? 2 : 1;
+    int  wpb = std::clamp(GGML_CUDA_RT_SWITCH("GGML_HIP_Q2BW_WPB", 4), 1, MMVQ_Q2BW_MAX_WPB);
+    bool W   = GGML_CUDA_RT_SWITCH("GGML_HIP_Q2BW_W", 0) != 0;
+    if (W) {
+        // the batch loads read whole 16-byte slots of a row: 16-byte aligned rows that end on a slot boundary
+        const uint32_t nb = ncols_x / QK2_0;
+        const auto a16 = [](const void * p) { return p == nullptr || (uintptr_t) p % 16 == 0; };
+        W = row_bytes % 16 == 0 && (nb*sizeof(block_q2_0)) % 16 == 0 && a16(vx) && a16(fusion.gate) && a16(fusion.pair_x);
+    }
+    if (W && !mmvq_q2bw_instance(ncols_dst, gate, 1, 1, true, cpol)) {
+        W = false;
+    }
+    if (!mmvq_q2bw_instance(ncols_dst, gate, 1, 1, W, cpol)) {
+        return false; // e.g. 2-3 columns with GGML_HIP_Q2BW_NT=2|3
+    }
+    // past the register budget: fewer K iterations per batch first, then fewer rows per wave
+    while (!mmvq_q2bw_instance(ncols_dst, gate, U, R, W, cpol)) {
+        if (U > 1) {
+            U /= 2;
+        } else {
+            R /= 2;
+        }
+    }
+
+    mmvq_q2bw_args a;
+    a.vx             = vx;
+    a.vy             = vy;
+    a.fusion         = fusion;
+    a.dst            = dst;
+    a.nb             = ncols_x / QK2_0;
+    a.nrows          = nrows_x;
+    a.stride_row_x   = stride_row_x;
+    a.stride_col_y   = stride_col_y;
+    a.stride_col_dst = stride_col_dst;
+    a.U              = U;
+    a.R              = R;
+    a.wpb            = wpb;
+    a.W              = W;
+    a.stream         = stream;
+
+    // as mmvq_fusion_any: any epilogue input makes the table's launch take its fused instance
+    const int fus = gate ? MMVQ_Q2BW_GATE :
+        (fusion.x_bias != nullptr || fusion.gate_bias != nullptr || fusion.pair_x != nullptr) ? MMVQ_Q2BW_EPI : MMVQ_Q2BW_PLAIN;
+
+#define MMVQ_Q2BW_CPOL(nc, f)                                                          \
+    switch (cpol) {                                                                    \
+        case 0: ggml_cuda_mmvq_q2bw_launch<nc, f, 0>(a); break;                        \
+        case 6: ggml_cuda_mmvq_q2bw_launch<nc, f, 6>(a); break;                        \
+        case 2: ggml_cuda_mmvq_q2bw_launch<nc, f, 2>(a); break;                        \
+        default: ggml_cuda_mmvq_q2bw_launch<nc, f, 4>(a); break;                       \
+    }
+    switch (ncols_dst) {
+        case 1:
+            if (fus == MMVQ_Q2BW_GATE) {
+                MMVQ_Q2BW_CPOL(1, MMVQ_Q2BW_GATE);
+            } else if (fus == MMVQ_Q2BW_EPI) {
+                MMVQ_Q2BW_CPOL(1, MMVQ_Q2BW_EPI);
+            } else {
+                MMVQ_Q2BW_CPOL(1, MMVQ_Q2BW_PLAIN);
+            }
+            break;
+        case 2:
+            if (fus == MMVQ_Q2BW_EPI) {
+                MMVQ_Q2BW_CPOL(2, MMVQ_Q2BW_EPI);
+            } else {
+                MMVQ_Q2BW_CPOL(2, MMVQ_Q2BW_PLAIN);
+            }
+            break;
+        default:
+            if (fus == MMVQ_Q2BW_EPI) {
+                MMVQ_Q2BW_CPOL(3, MMVQ_Q2BW_EPI);
+            } else {
+                MMVQ_Q2BW_CPOL(3, MMVQ_Q2BW_PLAIN);
+            }
+            break;
+    }
+#undef MMVQ_Q2BW_CPOL
+    return true;
+}
diff --git a/ggml/src/ggml-cuda/mmvq-q2bw.cuh b/ggml/src/ggml-cuda/mmvq-q2bw.cuh
new file mode 100644
index 000000000..080184e78
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-q2bw.cuh
@@ -0,0 +1,72 @@
+#pragma once
+
+#include "common.cuh"
+
+// [GGML_HIP_Q2BW] RDNA3 Q2_0 (Bonsai) mat-vec at 1-3 src1 columns, a weight-streaming variant of the table's launch
+// (mul_mat_vec_q<Q2_0, n>, one wave per row, one 288-byte K segment of the row in flight per wave). Every row keeps the
+// table's lanes and per-lane order of partial sums (lane l: 32-value chunks l, l + 32, ...; the same fma per chunk;
+// the same butterfly and fusion epilogue), so the results are bitwise those of the table's launch. Knobs (runtime
+// switches, read per graph build; GGML_HIP_Q2BW=0, the default, keeps the table's launch):
+//   GGML_HIP_Q2BW=1        on (columns 1..GGML_HIP_Q2BW_N, default 3)
+//   GGML_HIP_Q2BW_U=1|2|4  K iterations per weight load batch; the next batch is loaded before this one is dotted
+//                          (register ring of two batches): U*R*(2 with a fused gate) segments in flight per wave
+//   GGML_HIP_Q2BW_R=1|2|4  rows per wave (the activation loads shared by the rows)
+//   GGML_HIP_Q2BW_WPB=1..8 waves per block (each wave its own rows; the table's launch: 1)
+//   GGML_HIP_Q2BW_NT=0..3  weight load cache policy: 0 default, 1 nontemporal (slc dlc: L0/L1 hit-evict, L2 stream,
+//                          MALL no-alloc), 2 slc only, 3 dlc only (MALL no-alloc)
+//   GGML_HIP_Q2BW_W=1      128-bit weight loads: the wave loads each batch of a row as contiguous int4 per lane and
+//                          redistributes it through LDS (needs 16-byte aligned rows)
+// Combinations past the register budget take a smaller U (see ggml_cuda_mmvq_q2bw).
+
+enum mmvq_q2bw_fusion {
+    MMVQ_Q2BW_PLAIN = 0, // no epilogue
+    MMVQ_Q2BW_EPI   = 1, // fusion epilogue without a gate (bias/residual, pair launches)
+    MMVQ_Q2BW_GATE  = 2, // gate + GLU (+ biases, q8_1 copy of dst)
+};
+
+static constexpr int MMVQ_Q2BW_MAX_WPB = 8;
+
+// cache policy bits of the GGML_HIP_Q2BW_NT values (gfx11 buffer loads: 2 = SLC, 4 = DLC)
+static constexpr int mmvq_q2bw_cpol(const int nt) {
+    return nt == 1 ? 6 : nt == 2 ? 2 : nt == 3 ? 4 : 0;
+}
+
+// the instantiated (columns, gate, U, R, W, cache policy) combinations: the weight register ring (two batches of
+// U*R*ng segments, 3 VGPRs each, 4*ceil(18*U/32) with W) and the activations of a batch (9*U*ncols VGPRs) stay within
+// ~110 VGPRs; 2-3 columns: no W, default / nontemporal policy only
+static constexpr __host__ __device__ bool mmvq_q2bw_instance(const int ncols, const bool gate, const int U, const int R,
+                                                             const bool W, const int cpol) {
+    const int ng = gate ? 2 : 1;
+    if ((U != 1 && U != 2 && U != 4) || (R != 1 && R != 2 && R != 4)) {
+        return false;
+    }
+    if (ncols == 1) {
+        return U*R*ng <= 8 && (!W || cpol == 0 || cpol == 6);
+    }
+    return !gate && !W && U <= 2 && U*R <= 4 && (cpol == 0 || cpol == 6);
+}
+
+struct mmvq_q2bw_args {
+    const void * vx;
+    const void * vy;                       // q8_1 activations
+    ggml_cuda_mm_fusion_args_device fusion;
+    float * dst;
+    uint32_t nb;                           // Q2_0 blocks per row
+    uint32_t nrows;                        // rows of vx (pair launches: the second matrix has fusion.pair_nrows)
+    uint32_t stride_row_x;                 // in blocks
+    uint32_t stride_col_y;                 // in q8_1 blocks
+    uint32_t stride_col_dst;
+    int U;
+    int R;
+    int wpb;
+    bool W;
+    cudaStream_t stream;
+};
+
+// instantiated per cache policy in mmvq-q2bw-nt*.cu
+template <int ncols_dst, int fus, int cpol>
+void ggml_cuda_mmvq_q2bw_launch(const mmvq_q2bw_args & args);
+
+// true: launched (the caller skips the table's launch)
+bool ggml_cuda_mmvq_q2bw(const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        int ncols_x, int nrows_x, int ncols_dst, int stride_row_x, int stride_col_y, int stride_col_dst, cudaStream_t stream);
