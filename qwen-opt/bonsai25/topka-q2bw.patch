diff --git a/ggml/src/ggml-cuda/mmvq-ld.cuh b/ggml/src/ggml-cuda/mmvq-ld.cuh
new file mode 100644
index 000000000..33edc542d
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-ld.cuh
@@ -0,0 +1,75 @@
+#pragma once
+
+#include "common.cuh"
+
+// Byte-offset loads for the multi path: a block-uniform source (row of x / column of y) plus a 32-bit per-thread
+// byte offset. On RDNA3 the sources are raw buffer resources in SGPRs, so every load is `buffer_load voffset, srsrc,
+// soffset` and the loop only advances the shared 32-bit offsets; with plain pointers the compiler hoists one 64-bit
+// VGPR base per (row, field) and spends a 64-bit add per load. `align` is what the caller can guarantee (RDNA does
+// unaligned loads natively, the pointer fallback honors it).
+#if defined(GGML_USE_HIP) && defined(RDNA3)
+#define MMVQ_BUFFER_LOADS
+#endif
+
+struct mmvq_src {
+    const char * p; // p + soff = base; used by the pointer path and the types without a byte-offset loader
+#ifdef MMVQ_BUFFER_LOADS
+    __amdgpu_buffer_rsrc_t rsrc;
+    uint32_t soff;
+#endif
+};
+
+static __device__ __forceinline__ mmvq_src mmvq_make_src(const void * base, const uint32_t soff = 0) {
+    mmvq_src s;
+    s.p = (const char *) base + soff;
+#ifdef MMVQ_BUFFER_LOADS
+    // raw buffer (stride 0), no effective range limit, RDNA3 dword3 (as in composable_kernel for gfx11)
+    s.rsrc = __builtin_amdgcn_make_buffer_rsrc(const_cast<void *>(base), 0, -1, 0x31004000);
+    s.soff = soff;
+#endif
+    return s;
+}
+
+// cpol: buffer load cache policy bits (gfx11: 1 = GLC, 2 = SLC, 4 = DLC), ignored by the pointer fallback
+template <typename T, int align, int cpol = 0>
+static __device__ __forceinline__ T mmvq_ld(const mmvq_src & s, const uint32_t off) {
+    T v;
+#ifdef MMVQ_BUFFER_LOADS
+    static_assert(sizeof(T) == 2 || sizeof(T) == 4 || sizeof(T) == 8 || sizeof(T) == 16, "mmvq_ld: unsupported size");
+    if constexpr (sizeof(T) == 2) {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b16(s.rsrc, off, s.soff, cpol);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    } else if constexpr (sizeof(T) == 4) {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b32(s.rsrc, off, s.soff, cpol);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    } else if constexpr (sizeof(T) == 8) {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b64(s.rsrc, off, s.soff, cpol);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    } else {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b128(s.rsrc, off, s.soff, cpol);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    }
+#else
+    __builtin_memcpy(&v, __builtin_assume_aligned(s.p + off, align), sizeof(T));
+#endif
+    return v;
+}
+
+template <int n, int align, int cpol = 0>
+static __device__ __forceinline__ void mmvq_ld_ints(const mmvq_src & s, const uint32_t off, int (&v)[n]) {
+#pragma unroll
+    for (int i = 0; i < n; i += 4) {
+        if (n - i >= 4) {
+            const int4 t = mmvq_ld<int4, align, cpol>(s, off + 4*i);
+            v[i + 0] = t.x; v[i + 1] = t.y; v[i + 2] = t.z; v[i + 3] = t.w;
+        } else if (n - i == 2) {
+            const int2 t = mmvq_ld<int2, align, cpol>(s, off + 4*i);
+            v[i + 0] = t.x; v[i + 1] = t.y;
+        } else {
+#pragma unroll
+            for (int k = i; k < n; ++k) {
+                v[k] = mmvq_ld<int, align, cpol>(s, off + 4*k);
+            }
+        }
+    }
+}
diff --git a/ggml/src/ggml-cuda/mmvq-q2bw-impl.cuh b/ggml/src/ggml-cuda/mmvq-q2bw-impl.cuh
new file mode 100644
index 000000000..a0a838961
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-q2bw-impl.cuh
@@ -0,0 +1,425 @@
+#pragma once
+
+// [GGML_HIP_Q2BW] kernel and launcher (see mmvq-q2bw.cuh); included by the per-cache-policy instance files only
+
+#include "mmvq-ld.cuh"
+#include "mmvq-q2bw.cuh"
+#include "unary.cuh"
+
+// 4x4 byte transpose: a[i] byte m = byte i of y[m] (y[m] holds activations 4m..4m+3, so a[i] holds 4m + i, m = 0..3,
+// the values of code plane i of a 16-value weight dword)
+static __device__ __forceinline__ void mmvq_q2bw_transpose(const int4 y, int * a) {
+#if defined(GGML_USE_HIP)
+    const uint32_t t0 = __builtin_amdgcn_perm(y.y, y.x, 0x05010400); // y0.b0 y1.b0 y0.b1 y1.b1
+    const uint32_t t1 = __builtin_amdgcn_perm(y.y, y.x, 0x07030602); // y0.b2 y1.b2 y0.b3 y1.b3
+    const uint32_t t2 = __builtin_amdgcn_perm(y.w, y.z, 0x05010400); // y2.b0 y3.b0 y2.b1 y3.b1
+    const uint32_t t3 = __builtin_amdgcn_perm(y.w, y.z, 0x07030602); // y2.b2 y3.b2 y2.b3 y3.b3
+    a[0] = __builtin_amdgcn_perm(t2, t0, 0x05040100);
+    a[1] = __builtin_amdgcn_perm(t2, t0, 0x07060302);
+    a[2] = __builtin_amdgcn_perm(t3, t1, 0x05040100);
+    a[3] = __builtin_amdgcn_perm(t3, t1, 0x07060302);
+#else
+    GGML_UNUSED(y);
+    a[0] = a[1] = a[2] = a[3] = 0;
+#endif
+}
+
+// the 32-value chunk of a lane in one K iteration: its 8 code bytes (byte m: values 4m..4m+3, low bits first) and the
+// scale of its Q2_0 block
+struct mmvq_q2bw_x {
+    int2 q;
+    half d;
+};
+
+// One wave computes R rows (R*ncols_dst results; with a gate R more); lane l takes the 32-value chunks l, l + 32, ... of
+// each row (block l/2 + 16*it, half l%2), exactly as one wave of the table's launch does for its row. The wave walks
+// K in batches of U iterations: batch b+1's weights are loaded (after batch b's activations) before batch b is dotted.
+#if defined(GGML_USE_HIP)
+#define MMVQ_Q2BW_LAUNCH_BOUNDS __attribute__((amdgpu_flat_work_group_size(1, 32*MMVQ_Q2BW_MAX_WPB)))
+#else
+#define MMVQ_Q2BW_LAUNCH_BOUNDS __launch_bounds__(32*MMVQ_Q2BW_MAX_WPB, 1)
+#endif
+template <int ncols_dst, int fus, int cpol, int U, int R, bool W>
+MMVQ_Q2BW_LAUNCH_BOUNDS
+static __global__ void mul_mat_vec_q2_0_bw(
+        const void * __restrict__ vx, const void * __restrict__ vy, const ggml_cuda_mm_fusion_args_device fusion,
+        float * __restrict__ dst, const uint32_t nb, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint32_t stride_col_y, uint32_t stride_col_dst, const uint32_t ngroups0) {
+#if defined(GGML_USE_HIP) && defined(RDNA3)
+    constexpr bool has_fusion = fus != MMVQ_Q2BW_PLAIN;
+    constexpr bool has_gate   = fus == MMVQ_Q2BW_GATE;
+    constexpr int  NG         = has_gate ? 2 : 1;
+    constexpr uint32_t bsx    = sizeof(block_q2_0);
+    constexpr uint32_t bsy    = sizeof(block_q8_1);
+    constexpr uint32_t seg    = 16*bsx;           // bytes of a row per K iteration of the wave (32 chunks of 32 values)
+    constexpr int      NW     = (U*seg/16 + 31)/32; // W: int4 loads per lane per (matrix, row) and batch
+    constexpr uint32_t lds_row = U*seg + 16;      // W: LDS bytes per (matrix, row): one batch + read-ahead pad
+    static_assert(sizeof(block_q2_0) == 18 && QK2_0 == 2*QK8_1, "Q2BW: block_q2_0 layout");
+
+    const int      lane = threadIdx.x % 32;
+    const uint32_t wave = __builtin_amdgcn_readfirstlane(threadIdx.x / 32);
+    uint32_t grp = blockIdx.x*(blockDim.x/32) + wave;
+
+    const char * x     = (const char *) vx;
+    uint32_t     nrows = nrows_x;
+    if constexpr (has_fusion) {
+        // pair launch: the row groups past the first matrix compute the second one (same K and src1)
+        if (fusion.pair_x != nullptr && grp >= ngroups0) {
+            grp           -= ngroups0;
+            x              = (const char *) fusion.pair_x;
+            dst            = fusion.pair_dst;
+            stride_col_dst = fusion.pair_nrows;
+            nrows          = fusion.pair_nrows;
+        }
+    }
+    const uint32_t row0 = grp*R;
+    if (row0 >= nrows) {
+        return;
+    }
+
+    [[maybe_unused]] float x_biases[ncols_dst]    = { 0.0f };
+    [[maybe_unused]] float gate_biases[ncols_dst] = { 0.0f };
+    if constexpr (has_fusion) {
+        if (lane < R && row0 + lane < nrows) {
+            if (fusion.x_bias != nullptr) {
+#pragma unroll
+                for (int j = 0; j < ncols_dst; ++j) {
+                    x_biases[j] = ((const float *) fusion.x_bias)[j*stride_col_dst + row0 + lane];
+                }
+            }
+            if (has_gate && fusion.gate_bias != nullptr) {
+#pragma unroll
+                for (int j = 0; j < ncols_dst; ++j) {
+                    gate_biases[j] = ((const float *) fusion.gate_bias)[j*stride_col_dst + row0 + lane];
+                }
+            }
+        }
+    }
+
+    // rows past the end of the matrix re-read the last one, their results are not stored
+    mmvq_src xs[NG][R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        const uint32_t roff = min(row0 + r, nrows - 1)*stride_row_x*bsx;
+        xs[0][r] = mmvq_make_src(x, roff);
+        if constexpr (has_gate) {
+            xs[1][r] = mmvq_make_src(fusion.gate, roff);
+        }
+    }
+    mmvq_src ys[ncols_dst];
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+        ys[j] = mmvq_make_src(vy, j*stride_col_y*bsy);
+    }
+
+    const uint32_t bl    = lane / 2;      // block of the lane within a K iteration
+    const uint32_t h     = lane % 2;      // half of the block
+    const uint32_t niter = (nb + 15)/16;  // K iterations of the wave (the last one may leave lanes idle)
+
+    float acc[NG][ncols_dst][R] = {{{0.0f}}};
+
+    // Activations of a batch, loaded before the next batch's weights so that waiting for them does not wait for those.
+    // Every load of the K loop is unconditional (iterations past the end re-read the row's last block, a cache hit):
+    // loads under a branch leave the number of later loads unknown and the waits fall back to the last load.
+    struct ybatch {
+        int4  y0[U][ncols_dst];
+        int4  y1[U][ncols_dst];
+        float d8[U][ncols_dst];
+    };
+    const auto load_y = [&](ybatch & yb, const uint32_t it0) {
+#pragma unroll
+        for (int u = 0; u < U; ++u) {
+            const uint32_t kb = min(bl + 16*(it0 + u), nb - 1);
+            const uint32_t yo = (2*kb + h)*bsy;
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+                yb.d8[u][j] = __low2float(mmvq_ld<half2, 4>(ys[j], yo));
+                yb.y0[u][j] = mmvq_ld<int4, 4>(ys[j], yo + 4);
+                yb.y1[u][j] = mmvq_ld<int4, 4>(ys[j], yo + 20);
+            }
+        }
+    };
+
+    // dot of one K iteration: the chunk of every (matrix, row) against the activations of every column
+    const auto dot_iter = [&](const mmvq_q2bw_x (&xw)[NG][R], const ybatch & yb, const int u, const uint32_t it) {
+        // chunks past the end of the row (lanes of the last iteration, iterations of the last batch) add d*d8 = +0:
+        // acc + 0*sumi == acc bitwise (acc starts at +0 and an fma never makes it -0), and no select on a loaded value
+        // (the compiler turns that into a branch around the loads, which then wait behind the next batch's)
+        const int keep = bl + 16*it < nb ? -1 : 0;
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+            int a[8];
+            mmvq_q2bw_transpose(yb.y0[u][j], a);
+            mmvq_q2bw_transpose(yb.y1[u][j], a + 4);
+            // exact integer sum of the chunk's activations: the code offset (codes 0..3 = values -1..2)
+            int sumy = 0;
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y0[u][j].x, sumy);
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y0[u][j].y, sumy);
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y0[u][j].z, sumy);
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y0[u][j].w, sumy);
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y1[u][j].x, sumy);
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y1[u][j].y, sumy);
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y1[u][j].z, sumy);
+            sumy = ggml_cuda_dp4a(0x01010101, yb.y1[u][j].w, sumy);
+#pragma unroll
+            for (int m = 0; m < NG; ++m) {
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+                    int sumi = 0;
+#pragma unroll
+                    for (int i = 0; i < 4; ++i) {
+                        sumi = ggml_cuda_dp4a(((uint32_t) xw[m][r].q.x >> 2*i) & 0x03030303, a[i],     sumi);
+                        sumi = ggml_cuda_dp4a(((uint32_t) xw[m][r].q.y >> 2*i) & 0x03030303, a[4 + i], sumi);
+                    }
+                    // the table's launch: acc += (d*d8) * sumi, contracted to one fma
+                    const float dd = __int_as_float(__float_as_int(__half2float(xw[m][r].d) * yb.d8[u][j]) & keep);
+                    acc[m][j][r] = __builtin_fmaf(dd, (float) (sumi - sumy), acc[m][j][r]);
+                }
+            }
+        }
+    };
+
+    // The K loop: batches of U iterations in two register buffers, two batches per trip (no buffer is ever copied: a
+    // copy waits for its loads). Every trip's prefetch is consumed by the next batch: with an exit between the two
+    // batches the compiler sank the second prefetch past the exit test, into the next trip, right before its use.
+    const auto run_ring = [&](auto & step, auto & xa, auto & xb) {
+        uint32_t it0 = 0;
+        for (; it0 + U < niter; it0 += 2*U) {
+            step(xa, xb, it0);
+            step(xb, xa, it0 + U);
+        }
+        if (it0 < niter) {
+            step(xa, xb, it0); // the last batch (its prefetch is dead)
+        }
+    };
+    if constexpr (!W) {
+        // per-lane loads: the chunk's 8 code bytes and its block scale
+        using xbatch = mmvq_q2bw_x[U][NG][R];
+        const auto load_x = [&](xbatch & xb, const uint32_t it0) {
+#pragma unroll
+            for (int u = 0; u < U; ++u) {
+                const uint32_t kb = min(bl + 16*(it0 + u), nb - 1);
+#pragma unroll
+                for (int m = 0; m < NG; ++m) {
+#pragma unroll
+                    for (int r = 0; r < R; ++r) {
+                        xb[u][m][r].q = mmvq_ld<int2, 2, cpol>(xs[m][r], kb*bsx + 2 + 8*h);
+                        xb[u][m][r].d = mmvq_ld<half, 2, cpol>(xs[m][r], kb*bsx);
+                    }
+                }
+            }
+        };
+        const auto step = [&](xbatch & cur, xbatch & nxt, const uint32_t it0) {
+            ybatch yb;
+            // issue order: this batch's activations, then the next batch's weights (the waits count loads in order);
+            // sched barriers keep the scheduler from interleaving them
+            load_y(yb, it0);
+            __builtin_amdgcn_sched_barrier(0);
+            load_x(nxt, it0 + U);
+            __builtin_amdgcn_sched_barrier(0);
+            // no branch around the dots of iterations past the end (dot_iter masks them): their activation loads would
+            // sink into it, behind the next batch's weight loads
+#pragma unroll
+            for (int u = 0; u < U; ++u) {
+                dot_iter(cur[u], yb, u, it0 + u);
+            }
+        };
+        xbatch xa;
+        xbatch xb;
+        load_x(xa, 0);
+        run_ring(step, xa, xb);
+    } else {
+        // 128-bit loads: lane s of the wave loads bytes 16*s .. 16*s + 15 of the batch (U iterations, U*seg bytes) of
+        // each (matrix, row), the batch goes through this wave's LDS slice and every lane reads its chunks back
+        extern __shared__ int4 mmvq_q2bw_lds[];
+        char * lw = (char *) mmvq_q2bw_lds + wave*(NG*R*lds_row);
+        const uint32_t row_bytes = nb*bsx;
+        using xbatch = int4[NG][R][NW];
+        const auto load_x = [&](xbatch & xb, const uint32_t it0) {
+#pragma unroll
+            for (int m = 0; m < NG; ++m) {
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+#pragma unroll
+                    for (int s = 0; s < NW; ++s) {
+                        // slots past the batch or the row re-read the row's last 16 bytes
+                        const uint32_t o = min(it0*seg + 16*(lane + 32*s), row_bytes - 16);
+                        xb[m][r][s] = mmvq_ld<int4, 16, cpol>(xs[m][r], o);
+                    }
+                }
+            }
+        };
+        const auto step = [&](xbatch & cur, xbatch & nxt, const uint32_t it0) {
+            ybatch yb;
+            load_y(yb, it0);
+            __builtin_amdgcn_sched_barrier(0); // issue order as in the per-lane path
+            load_x(nxt, it0 + U);
+            __builtin_amdgcn_sched_barrier(0);
+            // LDS slice reuse: the previous batch's reads are done (one wave, LDS operations in order)
+            __builtin_amdgcn_wave_barrier();
+#pragma unroll
+            for (int m = 0; m < NG; ++m) {
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+#pragma unroll
+                    for (int s = 0; s < NW; ++s) {
+                        const uint32_t slot = lane + 32*s;
+                        if (slot < U*seg/16) {
+                            *(int4 *) (lw + (m*R + r)*lds_row + 16*slot) = cur[m][r][s];
+                        }
+                    }
+                }
+            }
+            __builtin_amdgcn_fence(__ATOMIC_RELEASE, "wavefront");
+            __builtin_amdgcn_wave_barrier();
+            __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "wavefront");
+#pragma unroll
+            for (int u = 0; u < U; ++u) {
+                mmvq_q2bw_x xw[NG][R];
+                const uint32_t oq = u*seg + bl*bsx + 2 + 8*h; // even: the code bytes start at a 2-byte boundary
+                const uint32_t sh = 8*(oq & 2);
+#pragma unroll
+                for (int m = 0; m < NG; ++m) {
+#pragma unroll
+                    for (int r = 0; r < R; ++r) {
+                        const char     * lr = lw + (m*R + r)*lds_row;
+                        const uint32_t * l4 = (const uint32_t *) (lr + (oq & ~3u));
+                        const uint32_t w0 = l4[0];
+                        const uint32_t w1 = l4[1];
+                        const uint32_t w2 = l4[2];
+                        xw[m][r].q.x = __builtin_amdgcn_alignbit(w1, w0, sh);
+                        xw[m][r].q.y = __builtin_amdgcn_alignbit(w2, w1, sh);
+                        xw[m][r].d   = *(const half *) (lr + u*seg + bl*bsx);
+                    }
+                }
+                dot_iter(xw, yb, u, it0 + u); // past the end: masked in dot_iter (no branch, see the per-lane path)
+            }
+        };
+        xbatch xa;
+        xbatch xb;
+        load_x(xa, 0);
+        run_ring(step, xa, xb);
+    }
+
+    // epilogue of the table's launch (one wave, rows_per_cuda_block = R)
+    dst += row0;
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            float tmp = warp_reduce_sum<32>(acc[0][j][r]);
+            [[maybe_unused]] float tmp_gate = 0.0f;
+            if constexpr (has_gate) {
+                tmp_gate = warp_reduce_sum<32>(acc[NG - 1][j][r]);
+            }
+            if (lane == r && row0 + r < nrows) {
+                float result = tmp;
+                if constexpr (has_fusion) {
+                    result += x_biases[j];
+                }
+                if constexpr (has_gate) {
+                    float gate_value = tmp_gate + gate_biases[j];
+                    switch (fusion.glu_op) {
+                        case GGML_GLU_OP_SWIGLU:
+                            result *= ggml_cuda_op_silu_single(gate_value);
+                            break;
+                        case GGML_GLU_OP_GEGLU:
+                            result *= ggml_cuda_op_gelu_single(gate_value);
+                            break;
+                        case GGML_GLU_OP_SWIGLU_OAI:
+                            result = ggml_cuda_op_swiglu_oai_single(gate_value, result);
+                            break;
+                        case GGML_GLU_OP_SWIGLU_CLAMP:
+                            result = ggml_cuda_op_swiglu_clamp_single(gate_value, result, fusion.glu_limit);
+                            break;
+                        default:
+                            result = result * gate_value;
+                            break;
+                    }
+                }
+                dst[j*stride_col_dst + r] = result;
+            }
+        }
+    }
+
+    if constexpr (has_fusion && ncols_dst == 1) {
+        // [GGML_HIP_GATE_UP_Q8] the q8_1 copy of dst, as the table's launch: the wave that completes the 32 rows of a
+        // group (ticket per group, R rows per wave, R divides 32) quantizes them
+        if (fusion.q8_out != nullptr) {
+            const uint32_t group = row0 / QK8_1;
+            __threadfence();
+            unsigned int t = 0;
+            if (lane == 0) {
+                t = atomicAdd(fusion.q8_tickets + group, (unsigned int) R);
+            }
+            t = __shfl_sync(0xFFFFFFFF, t, 0, 32);
+            if (t == QK8_1 - R) {
+                if (lane == 0) {
+                    fusion.q8_tickets[group] = 0;
+                }
+                __threadfence();
+                const float * dst_group = dst - (int64_t) row0 + (int64_t) group*QK8_1; // dst points at row0 here
+                quantize_q8_1_group(dst_group[lane], fusion.q8_out + group, lane);
+            }
+        }
+    }
+#else
+    GGML_UNUSED_VARS(vx, vy, fusion, dst, nb, nrows_x, stride_row_x, stride_col_y, stride_col_dst, ngroups0);
+    NO_DEVICE_CODE;
+#endif // defined(GGML_USE_HIP) && defined(RDNA3)
+}
+
+template <int ncols_dst, int fus, int cpol, int U, int R, bool W>
+static void mmvq_q2bw_launch_one(const mmvq_q2bw_args & a) {
+    constexpr int NG = fus == MMVQ_Q2BW_GATE ? 2 : 1;
+    const uint32_t ngroups0 = (a.nrows + R - 1)/R;
+    uint32_t ngroups = ngroups0;
+    if (a.fusion.pair_x != nullptr) {
+        ngroups += (a.fusion.pair_nrows + R - 1)/R;
+    }
+    const uint32_t nblocks = (ngroups + a.wpb - 1)/a.wpb;
+    const size_t   lds     = W ? size_t(a.wpb)*NG*R*(U*16*sizeof(block_q2_0) + 16) : 0;
+    const ggml_cuda_kernel_launch_params params(dim3(nblocks, 1, 1), dim3(32*a.wpb, 1, 1), lds, a.stream);
+    ggml_cuda_kernel_launch(mul_mat_vec_q2_0_bw<ncols_dst, fus, cpol, U, R, W>, params,
+        a.vx, a.vy, a.fusion, a.dst, a.nb, a.nrows, a.stride_row_x, a.stride_col_y, a.stride_col_dst, ngroups0);
+}
+
+// args.U, args.R, args.W name an instance (mmvq_q2bw_instance), see ggml_cuda_mmvq_q2bw
+template <int ncols_dst, int fus, int cpol>
+void ggml_cuda_mmvq_q2bw_launch(const mmvq_q2bw_args & a) {
+    constexpr bool gate = fus == MMVQ_Q2BW_GATE;
+    bool done = false;
+    const auto try_one = [&](auto U_tag, auto R_tag, auto W_tag) {
+        constexpr int  U = decltype(U_tag)::value;
+        constexpr int  R = decltype(R_tag)::value;
+        constexpr bool W = decltype(W_tag)::value;
+        if constexpr (mmvq_q2bw_instance(ncols_dst, gate, U, R, W, cpol)) {
+            if (!done && a.U == U && a.R == R && a.W == W) {
+                mmvq_q2bw_launch_one<ncols_dst, fus, cpol, U, R, W>(a);
+                done = true;
+            }
+        }
+    };
+    const auto try_r = [&](auto U_tag, auto W_tag) {
+        try_one(U_tag, std::integral_constant<int, 1>{}, W_tag);
+        try_one(U_tag, std::integral_constant<int, 2>{}, W_tag);
+        try_one(U_tag, std::integral_constant<int, 4>{}, W_tag);
+    };
+    const auto try_u = [&](auto W_tag) {
+        try_r(std::integral_constant<int, 1>{}, W_tag);
+        try_r(std::integral_constant<int, 2>{}, W_tag);
+        try_r(std::integral_constant<int, 4>{}, W_tag);
+    };
+    try_u(std::false_type{});
+    try_u(std::true_type{});
+    GGML_ASSERT(done && "Q2BW: no kernel instance for these knobs");
+}
+
+#define MMVQ_Q2BW_INSTANCES(cpol)                                                         \
+    template void ggml_cuda_mmvq_q2bw_launch<1, MMVQ_Q2BW_PLAIN, cpol>(const mmvq_q2bw_args &); \
+    template void ggml_cuda_mmvq_q2bw_launch<1, MMVQ_Q2BW_EPI,   cpol>(const mmvq_q2bw_args &); \
+    template void ggml_cuda_mmvq_q2bw_launch<1, MMVQ_Q2BW_GATE,  cpol>(const mmvq_q2bw_args &); \
+    template void ggml_cuda_mmvq_q2bw_launch<2, MMVQ_Q2BW_PLAIN, cpol>(const mmvq_q2bw_args &); \
+    template void ggml_cuda_mmvq_q2bw_launch<2, MMVQ_Q2BW_EPI,   cpol>(const mmvq_q2bw_args &); \
+    template void ggml_cuda_mmvq_q2bw_launch<3, MMVQ_Q2BW_PLAIN, cpol>(const mmvq_q2bw_args &); \
+    template void ggml_cuda_mmvq_q2bw_launch<3, MMVQ_Q2BW_EPI,   cpol>(const mmvq_q2bw_args &)
