+/* fused Hadamard MUL_MAT (FWHT) + unary + mul */
+
+// dst[e] = op(gate[e]) * y[e] with y = the normalized FWHT of x in rows of N (the Hadamard MUL_MAT, see
+// ggml_cuda_op_mul_mat_use_fwht), as fwht_cuda followed by unary_gated_op_kernel compute it. One warp per FWHT row;
+// gate has rows of nc values with row stride s_gate. q8: when not null, the q8_1 copy of dst is written there too.
+template <int N, float (*op)(float)>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void fwht_unary_mul_kernel(const float * x, const float * gate, float * dst, const int64_t n_rows,
+                                             const int64_t nc, const int64_t s_gate, const float scale, block_q8_1 * q8) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int el_w      = N / warp_size;
+
+    const int64_t r = (int64_t) blockIdx.x * blockDim.y + threadIdx.y;
+    if (r >= n_rows) {
+        return;
+    }
+    const int lane = threadIdx.x;
+
+    ggml_cuda_pdl_sync();
+    float reg[el_w];
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        reg[i] = x[r * N + i * warp_size + lane] * scale;
+    }
+
+    fwht_warp_reg<N>(reg, lane);
+
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        const int64_t e = r * N + i * warp_size + lane;
+        const float   v = op(gate[(e / nc) * s_gate + e % nc]) * reg[i];
+        dst[e] = v;
+        if (q8 != nullptr) {
+            quantize_q8_1_group(v, q8 + e / QK8_1, e % QK8_1);
+        }
+    }
+}
+
+template <float (*op)(float)>
+static void fwht_unary_mul_cuda(const float * x, const float * gate, float * dst, const int n, const int64_t n_rows,
+                                const int64_t nc, const int64_t s_gate, block_q8_1 * q8, cudaStream_t stream) {
+    const int     warp_size      = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const int     rows_per_block = 4;
+    const float   scale          = 1 / sqrtf(n); // as ggml_cuda_op_fwht
+    const dim3    grid_dims((n_rows + rows_per_block - 1) / rows_per_block, 1, 1);
+    const dim3    block_dims(warp_size, rows_per_block, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, stream);
+    switch (n) {
+        case 64:
+            ggml_cuda_kernel_launch(fwht_unary_mul_kernel<64, op>, launch_params, x, gate, dst, n_rows, nc, s_gate, scale, q8);
+            break;
+        case 128:
+            ggml_cuda_kernel_launch(fwht_unary_mul_kernel<128, op>, launch_params, x, gate, dst, n_rows, nc, s_gate, scale, q8);
+            break;
+        case 256:
+            ggml_cuda_kernel_launch(fwht_unary_mul_kernel<256, op>, launch_params, x, gate, dst, n_rows, nc, s_gate, scale, q8);
+            break;
+        default:
+            GGML_ABORT("unsupported FWHT size");
+    }
+}
+
+bool ggml_cuda_fwht_unary_mul_supported(const ggml_tensor * fwht, const ggml_tensor * unary_node, const ggml_tensor * mul_node,
+                                        const ggml_tensor * other) {
+    const ggml_tensor * x    = fwht->src[1];
+    const ggml_tensor * gate = unary_node->src[0];
+    const int64_t       n    = x->ne[0];
+    const ggml_unary_op uop  = ggml_get_unary_op(unary_node);
+    return (uop == GGML_UNARY_OP_SILU || uop == GGML_UNARY_OP_SIGMOID || uop == GGML_UNARY_OP_SOFTPLUS) &&
+           (n == 64 || n == 128 || n == 256) && x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) &&
+           ggml_is_contiguous(fwht) && gate->type == GGML_TYPE_F32 && unary_node->type == GGML_TYPE_F32 &&
+           mul_node->type == GGML_TYPE_F32 && ggml_is_contiguous_1(gate) && gate->nb[0] == sizeof(float) &&
+           ggml_are_same_shape(gate, other) && ggml_are_same_shape(other, mul_node) && ggml_is_contiguous(mul_node) &&
+           ggml_nelements(mul_node) == ggml_nelements(fwht);
+}
+
+void ggml_cuda_op_fwht_unary_mul(ggml_backend_cuda_context & ctx, const ggml_tensor * fwht, const ggml_tensor * unary_node,
+                                 ggml_tensor * mul_node, block_q8_1 * q8) {
+    const ggml_tensor * x    = fwht->src[1];
+    const ggml_tensor * gate = unary_node->src[0];
+    const float *       x_d  = (const float *) x->data;
+    const float *       g_d  = (const float *) gate->data;
+    float *             d_d  = (float *) mul_node->data;
+    const int           n    = x->ne[0];
+    const int64_t       rows = ggml_nrows(x);
+    const int64_t       nc   = gate->ne[0];
+    const int64_t       s_g  = gate->nb[1] / sizeof(float);
+    cudaStream_t        stream = ctx.stream();
+
+    switch (ggml_get_unary_op(unary_node)) {
+        case GGML_UNARY_OP_SILU:
