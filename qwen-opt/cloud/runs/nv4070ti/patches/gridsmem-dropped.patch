+// [GGML_CUDA_MMVQ_GRID_SMEM] index tables of the grid-based i-quants. Every lookup has one index per lane, so a load
+// from global memory splits into one wavefront per distinct 128-byte line (up to 32 for the 8 KB tables); from shared
+// memory it is one wavefront plus bank conflicts. Same entries -> same values, bit-identical results.
+static constexpr __host__ __device__ bool mmvq_grid_smem_type(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_IQ2_XXS:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ3_XXS:
+        case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static constexpr __host__ __device__ int mmvq_grid_smem_bytes(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_IQ2_XXS: return 256*8;
+        case GGML_TYPE_IQ2_XS:  return 512*8;
+        case GGML_TYPE_IQ2_S:   return 1024*8;
+        case GGML_TYPE_IQ3_XXS: return 256*4;
+        case GGML_TYPE_IQ3_S:   return 512*4;
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:   return NGRID_IQ1S*4;
+        default:                return 0;
+    }
+}
