+bool common_state_huge_enabled() {
+#if defined(__linux__)
+    static const bool enabled = [] {
+        const char * env = getenv("LLAMA_SERVER_CACHE_HUGE");
+        return env != nullptr && atoi(env) != 0;
+    }();
+    return enabled;
+#else
+    return false;
+#endif
+}
+
+#if defined(__linux__)
+static constexpr size_t COMMON_STATE_HUGE_MIN = 2u << 20;
+#endif
+
+void * common_state_alloc(size_t size) {
+#if defined(__linux__)
+    if (size >= COMMON_STATE_HUGE_MIN && common_state_huge_enabled()) {
+        // anonymous mappings of 2 MiB and more are 2 MiB aligned by the kernel (THP), madvise makes them huge pages
+        void * ptr = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (ptr == MAP_FAILED) {
+            throw std::bad_alloc();
+        }
+        madvise(ptr, size, MADV_HUGEPAGE);
+        return ptr;
+    }
+#endif
+    return ::operator new(size);
+}
+
+void common_state_free(void * ptr, size_t size) {
+#if defined(__linux__)
+    if (size >= COMMON_STATE_HUGE_MIN && common_state_huge_enabled()) {
+        munmap(ptr, size);
+        return;
+    }
+#endif
+    ::operator delete(ptr);
+}
