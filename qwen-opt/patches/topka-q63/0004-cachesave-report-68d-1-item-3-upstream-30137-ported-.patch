+// LLAMA_SERVER_CACHE_HUGE=1: state buffers of 2 MiB and more are anonymous mappings advised MADV_HUGEPAGE
+// (transparent huge pages), so filling a multi-GiB prompt cache entry takes 2 MiB instead of 4 KiB page faults;
+// otherwise operator new. Allocation only, the contents are the same.
+bool   common_state_huge_enabled();
+void * common_state_alloc(size_t size);
+void   common_state_free(void * ptr, size_t size);
+
+// leave default-inserted elements uninitialized; callers must fill them before use
+template <typename T>
+struct common_no_init_allocator : std::allocator<T> {
+    template <typename U> struct rebind { using other = common_no_init_allocator<U>; };
+
+    common_no_init_allocator() = default;
+    template <typename U> common_no_init_allocator(const common_no_init_allocator<U> &) {}
+
+    T *  allocate(size_t n)          { return (T *) common_state_alloc(n * sizeof(T)); }
+    void deallocate(T * p, size_t n) { common_state_free(p, n * sizeof(T)); }
+
+    template <typename U> void construct(U * p) { ::new ((void *) p) U; }
+};
+
+// sequence state data, filled by llama_state_seq_get_data_ext()
+using common_state_data = std::vector<uint8_t, common_no_init_allocator<uint8_t>>;
