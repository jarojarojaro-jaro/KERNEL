From 4dc11c95298e7739f4356ba8e69a99b59c62b10b Mon Sep 17 00:00:00 2001
From: jarojarojaro-jaro <miki.jaroszek@gmail.com>
Date: Sat, 7 Nov 2026 22:25:43 +0000
Subject: [PATCH] mmq Q6_K gfx11: scales loaded as one int per row per half-k01
 (GGML_HIP_Q6K_WIDE, 66-SYNTEZA item 4)

---
 ggml/src/ggml-cuda/mmq-vec-dot.cuh | 54 ++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/ggml/src/ggml-cuda/mmq-vec-dot.cuh b/ggml/src/ggml-cuda/mmq-vec-dot.cuh
index 6f70ba90e..2a5ed9fc9 100644
--- a/ggml/src/ggml-cuda/mmq-vec-dot.cuh
+++ b/ggml/src/ggml-cuda/mmq-vec-dot.cuh
@@ -1151,6 +1151,59 @@ template <ggml_type type, int J, bool fallback> static __device__ __forceinline_
 
     const int i0 = (threadIdx.y / ntx) * rows_per_warp;
 
+#if defined(GGML_HIP_Q6K_WIDE) && defined(RDNA3)
+    // [GGML_HIP_Q6K_WIDE] gfx11: the k01 loop is split into two halves of 16; at the start of a half the 4 int8
+    // scales of each row are loaded once as one int (was: one ds_load_i8 per k01, n, l) and the byte is extracted
+    // in registers. Product order unchanged -> bitwise identical.
+    // Both loops stay rolled: unrolling k01 (fully or by 2) pushes the J=64/128 kernels to 256 VGPRs with
+    // 100-870 scratch ops (ISA check 2026-11-07); rolled, the kernel keeps the baseline 222 VGPRs and no spills.
+#pragma unroll 1
+    for (int h = 0; h < MMQ_TILE_NE_K/16; ++h) {
+        int scH[ntx][tile_C::ne];
+#pragma unroll
+        for (int n = 0; n < ntx; ++n) {
+#pragma unroll
+            for (int l = 0; l < tile_C::ne; ++l) {
+                const int i = i0 + n*tile_C::I + tile_C::get_i(l);
+                scH[n][l] = x_sc[i*sram_stride + k00/16 + h];
+            }
+        }
+
+#pragma unroll 1
+        for (int kk = 0; kk < 4; ++kk) {
+            const int k01 = 16*h + 4*kk;
+            const int k0  = k00 + k01;
+
+            tile_A A[ntx];
+#pragma unroll
+            for (int n = 0; n < ntx; ++n) {
+                load_ldmatrix(A[n], x_qs + (i0 + n*tile_A::I)*sram_stride + k0, sram_stride);
+            }
+
+#pragma unroll
+            for (int j0 = 0; j0 < J; j0 += ntx*tile_C::J) {
+                tile_B B;
+                load_ldmatrix(B, y_qs + j0*MMQ_TILE_Y_K + k01, MMQ_TILE_Y_K);
+
+                const int j = j0 + tile_C::get_j(0);
+                const float dB = y_df[j*MMQ_TILE_Y_K + k01/QI8_1];
+
+#pragma unroll
+                for (int n = 0; n < ntx; ++n) {
+                    tile_C C;
+                    mma(C, A[n], B);
+
+#pragma unroll
+                    for (int l = 0; l < tile_C::ne; ++l) {
+                        const int    i  = i0 + n*tile_C::I + tile_C::get_i(l);
+                        const int8_t sc = (int8_t) (scH[n][l] >> (8*kk));
+                        sum[(j0/tile_C::J + n)*tile_C::ne + l] += C.x[l] * sc * x_df[i*sram_stride] * dB;
+                    }
+                }
+            }
+        }
+    }
+#else
     for (int k01 = 0; k01 < MMQ_TILE_NE_K; k01 += 4) {
         const int k0 = k00 + k01;
 
@@ -1182,6 +1235,7 @@ template <ggml_type type, int J, bool fallback> static __device__ __forceinline_
             }
         }
     }
+#endif // defined(GGML_HIP_Q6K_WIDE) && defined(RDNA3)
 #elif defined(TURING_MMA_AVAILABLE)
 
     typedef tile<16, 4, int> tile_A;
-- 
