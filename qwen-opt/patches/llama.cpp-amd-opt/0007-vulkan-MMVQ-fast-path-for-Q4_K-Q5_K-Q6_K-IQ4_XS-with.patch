@@ -24,11 +29,14 @@ layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
 uint a_offset, b_offset, d_offset;
 
+#ifndef MMVQ_CHUNK
 int32_t cache_b_qs[K_PER_ITER / 4];
 vec2 cache_b_ds;
+#endif
 
 #include "mul_mat_vecq_funcs.glsl"
 
+#ifndef MMVQ_CHUNK
 void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
     [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
         // Preload data_b block
@@ -73,7 +81,160 @@ void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const
         }
     }
 }
+#endif
+
+#ifdef MMVQ_CHUNK
+// Each thread owns one MMVQ_CHUNK-value chunk of every superblock it visits, so all chunk-dependent
+// indices, shifts and scale positions are loop invariant, and the weights of a row are unpacked once
+// and reused for all NUM_COLS columns. The thread -> data mapping and the per-thread accumulation
+// order match the generic iter() path, so results are bit-identical to it.
+void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
+    const uint tid = gl_LocalInvocationID.x;
+
+    get_offsets(a_offset, b_offset, d_offset);
+    b_offset /= QUANT_K_Q8_1;
+
+    const uint nb = p.ncols / QUANT_K;
+    const uint chunks_per_block = QUANT_K / MMVQ_CHUNK;
+    const uint chunk = tid % chunks_per_block;
+    const uint sb_step = BLOCK_SIZE / chunks_per_block;
+
+    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+            temp[j][n] = FLOAT_TYPE(0.0f);
+        }
+    }
+
+    // q8_1 block holding this chunk in superblock 0, per column
+    uint b_base[NUM_COLS];
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        b_base[j] = (j*p.batch_stride_b) / QUANT_K_Q8_1 + b_offset + (chunk * MMVQ_CHUNK) / QUANT_K_Q8_1;
+    }
+    const uint b_qs_off = ((chunk * MMVQ_CHUNK) % QUANT_K_Q8_1) / 4;
+
+#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
+    const uint is = chunk / 2;                       // 32-value sub-block
+    const uint qs_idx = (is / 2) * 8 + (chunk % 2) * 4;
+    const uint qs_shift = (is % 2) * 4;
+#if defined(DATA_A_Q5_K)
+    const uint qh_idx = (chunk % 2) * 4;
+    // move bit `is` of every qh byte to bit 4
+    const uint qh_rshift = is > 4 ? is - 4 : 0;
+    const uint qh_lshift = is < 4 ? 4 - is : 0;
+#endif
+    // 6-bit scale/min of sub-block `is` (see get_scale_min_k4)
+    const bool sc_lo = is < 4;
+    const uint sc_shift = 8 * (is % 4);
+    const uint sc_bits = sc_lo ? 6 : 4;
+    const uint sc_hi_bits = sc_lo ? 0 : 2;
+    const uint m_shift = sc_lo ? sc_shift : sc_shift + 4;
+#elif defined(DATA_A_Q6_K)
+    const uint g = (chunk % 8) / 2;
+    const uint ql_idx = ((chunk / 8) * 64 + (g % 2) * 32 + (chunk % 2) * 16) / 2;
+    const uint ql_shift = 4 * (g / 2);
+    const uint qh_idx = ((chunk / 8) * 32 + (chunk % 2) * 16) / 2;
+    const uint qh_shift = 2 * g;
+#else // DATA_A_IQ4_XS
+    const uint qs_idx = 4 * chunk;                   // chunk = 32-value sub-block
+#endif
+
+    uint row_base[NUM_ROWS];
+    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+        row_base[n] = a_offset + (first_row + n) * nb;
+    }
+
+    for (uint i = tid / chunks_per_block; i < nb; i += sb_step) {
+        ivec4 bq[NUM_COLS][MMVQ_CHUNK / 16];
+        vec2 bds[NUM_COLS];
+        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+            const uint b_idx = b_base[j] + i * (QUANT_K / QUANT_K_Q8_1);
+            const uint b_outer = b_idx / 4;
+            const uint b_inner = b_idx % 4;
+            bds[j] = vec2(data_b[b_outer].ds[b_inner]);
+#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
+            // this thread covers half of the 32-value block: half of its sum
+            bds[j].y *= 0.5;
+#endif
+            [[unroll]] for (uint h = 0; h < MMVQ_CHUNK / 16; ++h) {
+                bq[j][h] = ivec4(data_b[b_outer].qs[b_inner * 8 + b_qs_off + 4 * h    ],
+                                 data_b[b_outer].qs[b_inner * 8 + b_qs_off + 4 * h + 1],
+                                 data_b[b_outer].qs[b_inner * 8 + b_qs_off + 4 * h + 2],
+                                 data_b[b_outer].qs[b_inner * 8 + b_qs_off + 4 * h + 3]);
+            }
+        }
+
+        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
+            const uint ib = row_base[n] + i;
+#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
+            const vec2 dm = vec2(data_a_packed32[ib].dm);
+            const uint s0 = data_a_packed32[ib].scales[0];
+            const uint s1 = data_a_packed32[ib].scales[1];
+            const uint s2 = data_a_packed32[ib].scales[2];
+            const uint sc = bitfieldExtract(sc_lo ? s0 : s2, int(sc_shift), int(sc_bits)) |
+                            (bitfieldExtract(s0, int(sc_shift + 6), int(sc_hi_bits)) << 4);
+            const uint mn = bitfieldExtract(sc_lo ? s1 : s2, int(m_shift), int(sc_bits)) |
+                            (bitfieldExtract(s1, int(sc_shift + 6), int(sc_hi_bits)) << 4);
+            const float dsc = dm.x * float(sc);
+            const float dmn = dm.y * float(mn);
+
+            const uvec4 qs = uvec4(data_a_packed32[ib].qs[qs_idx    ], data_a_packed32[ib].qs[qs_idx + 1],
+                                   data_a_packed32[ib].qs[qs_idx + 2], data_a_packed32[ib].qs[qs_idx + 3]);
+            uvec4 q = (qs >> qs_shift) & 0x0F0F0F0F;
+#if defined(DATA_A_Q5_K)
+            const uvec4 qh = uvec4(data_a_packed32[ib].qh[qh_idx    ], data_a_packed32[ib].qh[qh_idx + 1],
+                                   data_a_packed32[ib].qh[qh_idx + 2], data_a_packed32[ib].qh[qh_idx + 3]);
+            q |= ((qh >> qh_rshift) << qh_lshift) & 0x10101010;
+#endif
+            const ivec4 qa[1] = { ivec4(q) };
+#elif defined(DATA_A_Q6_K)
+            const float dsc = float(data_a[ib].d) * float(data_a[ib].scales[chunk]);
+            const uvec4 ql = uvec4(
+                uint(data_a_packed16[ib].ql[ql_idx    ]) | (uint(data_a_packed16[ib].ql[ql_idx + 1]) << 16),
+                uint(data_a_packed16[ib].ql[ql_idx + 2]) | (uint(data_a_packed16[ib].ql[ql_idx + 3]) << 16),
+                uint(data_a_packed16[ib].ql[ql_idx + 4]) | (uint(data_a_packed16[ib].ql[ql_idx + 5]) << 16),
+                uint(data_a_packed16[ib].ql[ql_idx + 6]) | (uint(data_a_packed16[ib].ql[ql_idx + 7]) << 16));
+            const uvec4 qh = uvec4(
+                uint(data_a_packed16[ib].qh[qh_idx    ]) | (uint(data_a_packed16[ib].qh[qh_idx + 1]) << 16),
+                uint(data_a_packed16[ib].qh[qh_idx + 2]) | (uint(data_a_packed16[ib].qh[qh_idx + 3]) << 16),
+                uint(data_a_packed16[ib].qh[qh_idx + 4]) | (uint(data_a_packed16[ib].qh[qh_idx + 5]) << 16),
+                uint(data_a_packed16[ib].qh[qh_idx + 6]) | (uint(data_a_packed16[ib].qh[qh_idx + 7]) << 16));
+            const uvec4 q = ((ql >> ql_shift) & 0x0F0F0F0F) | (((qh >> qh_shift) & 0x03030303) << 4);
+            // subtract 32 from every byte without borrows between bytes
+            const ivec4 qa[1] = { ivec4(((q ^ 0x80808080) - 0x20202020) ^ 0x80808080) };
+#else // DATA_A_IQ4_XS
+            const uint sl = bitfieldExtract(data_a_packed32[ib].scales_l, int(4 * chunk), 4);
+            const uint sh = bitfieldExtract(uint(data_a_packed32[ib].scales_h), int(2 * chunk), 2);
+            const float dsc = float(data_a_packed32[ib].d) * float(int(sl | (sh << 4)) - 32);
+            // low nibbles are values 0..15, high nibbles values 16..31 of the sub-block
+            ivec4 qa[2];
+            [[unroll]] for (uint l = 0; l < 4; ++l) {
+                const i32vec2 v = iq4nl_to_i8x8(data_a_packed32[ib].qs[qs_idx + l]);
+                qa[0][l] = v.x;
+                qa[1][l] = v.y;
+            }
+#endif
+
+            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+                int32_t q_sum = 0;
+                [[unroll]] for (uint h = 0; h < MMVQ_CHUNK / 16; ++h) {
+                    q_sum += dotPacked4x8EXT(qa[h].x, bq[j][h].x);
+                    q_sum += dotPacked4x8EXT(qa[h].y, bq[j][h].y);
+                    q_sum += dotPacked4x8EXT(qa[h].z, bq[j][h].z);
+                    q_sum += dotPacked4x8EXT(qa[h].w, bq[j][h].w);
+                }
+#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
+                temp[j][n] += FLOAT_TYPE(float(q_sum) * (dsc * bds[j].x) - dmn * bds[j].y);
+#else
+                temp[j][n] += FLOAT_TYPE(float(q_sum) * (dsc * bds[j].x));
+#endif
+            }
+        }
+    }
 
+    reduce_result(temp, d_offset, first_row, num_rows, tid);
+}
+#else
 void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
     const uint tid = gl_LocalInvocationID.x;
 
@@ -122,6 +283,7 @@ void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
 
     reduce_result(temp, d_offset, first_row, num_rows, tid);
 }
+#endif
 
 void main() {
     const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
index 03c348bf9..6db7e399f 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
@@ -310,166 +310,6 @@ FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
 }
 #endif
 
-#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
-// 4-byte loads for Q4_K blocks (144 bytes) and Q5_K blocks (176 bytes)
-i32vec4 repack4(uint ib, uint iqs) {
-    const uint ib_k = ib / 8;
-    const uint iqs_k = (ib % 8) * 8 + iqs;
-
-    const uint qs_idx = (iqs_k / 16) * 8 + (iqs_k % 8);
-    const uint qs_shift = ((iqs_k % 16) / 8) * 4;
-
-#if defined(DATA_A_Q4_K)
-    const uint32_t vals0 = (data_a_packed32[ib_k].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F;
-    const uint32_t vals1 = (data_a_packed32[ib_k].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F;
-    const uint32_t vals2 = (data_a_packed32[ib_k].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F;
-    const uint32_t vals3 = (data_a_packed32[ib_k].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F;
-
-    return i32vec4(vals0, vals1, vals2, vals3);
-#else // defined(DATA_A_Q5_K)
-    const uint qh_idx = iqs;
-    const uint qh_shift = iqs_k / 8;
-
-    return i32vec4(((data_a_packed32[ib_k].qs[qs_idx    ] >> qs_shift) & 0x0F0F0F0F) |
-                  (((data_a_packed32[ib_k].qh[qh_idx    ] >> qh_shift) & 0x01010101) << 4),
-                   ((data_a_packed32[ib_k].qs[qs_idx + 1] >> qs_shift) & 0x0F0F0F0F) |
-                  (((data_a_packed32[ib_k].qh[qh_idx + 1] >> qh_shift) & 0x01010101) << 4),
-                   ((data_a_packed32[ib_k].qs[qs_idx + 2] >> qs_shift) & 0x0F0F0F0F) |
-                  (((data_a_packed32[ib_k].qh[qh_idx + 2] >> qh_shift) & 0x01010101) << 4),
-                   ((data_a_packed32[ib_k].qs[qs_idx + 3] >> qs_shift) & 0x0F0F0F0F) |
-                  (((data_a_packed32[ib_k].qh[qh_idx + 3] >> qh_shift) & 0x01010101) << 4));
-#endif
-}
-
-vec2 get_dm_scale(uint ib, uint iqs) {
-    const uint ib_k = ib / 8;
-    const uint iqs_k = (ib % 8) * 8 + iqs;
-    const uint is = iqs_k / 8;
-
-    const uvec3 scales = uvec3(data_a_packed32[ib_k].scales[0],
-                               data_a_packed32[ib_k].scales[1],
-                               data_a_packed32[ib_k].scales[2]);
-    const uint scalesoffs = (is & 3) * 8;
-
-    const uint scidx0 = (is < 4) ? 0 : 2;
-    const uint scidxshift0 = scalesoffs;
-    const uint scidxshift1 = (is < 4) ? scalesoffs : scalesoffs + 2;
-    const uint mbidx0 = (is < 4) ? 1 : 2;
-    const uint mbidxshift0 = (is < 4) ? scalesoffs : scalesoffs + 4;
-    const uint mbidxshift1 = (is < 4) ? scalesoffs : scalesoffs + 2;
-
-    const uint8_t sc    = uint8_t(((scales[scidx0] >> scidxshift0) & 0xF) | ((scales[0] >> scidxshift1) & 0x30));
-    const uint8_t mbyte = uint8_t(((scales[mbidx0] >> mbidxshift0) & 0xF) | ((scales[1] >> mbidxshift1) & 0x30));
-    u8vec2 scale_dm = u8vec2(sc, mbyte);
