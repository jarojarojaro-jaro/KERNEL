-
-    const uint ql_idx = (iqs_k / 32) * 16 + iqs_k % 16;
-    const uint ql_shift = ((iqs_k % 32) / 16) * 4;
-
-    const uint qh_idx = (iqs_k / 32) * 8 + iqs;
