@@ -12,11 +12,16 @@
 
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
-#if defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K)
+// values of a 256-value superblock handled per thread per iteration, see compute_outputs below
+#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K) || defined(DATA_A_Q6_K)
+#define MMVQ_CHUNK 16
+#elif defined(DATA_A_IQ4_XS)
