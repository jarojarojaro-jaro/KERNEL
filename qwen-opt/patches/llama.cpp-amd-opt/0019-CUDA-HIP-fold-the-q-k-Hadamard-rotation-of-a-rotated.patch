+                (mul->src[0] == node || mul->src[1] == node) && reshape->src[0] == rope && mm->src[1] == reshape &&
+                ggml_cuda_should_fuse_rms_norm_mul_rope(node, mul, rope) && ggml_is_contiguous(rope) &&
+                ggml_cuda_op_mul_mat_use_fwht(mm) && mm->src[0]->ne[0] == n &&
+                (n == 64 || n == 128 || n == 256 || n == 512)) {
+            const int out_nodes[] = { i + 4 };
+            // the kernel reads a row of x completely before it writes that row of the output
+            if (ggml_cuda_check_fusion_memory_ranges(cgraph, i, (int) ops.size(), out_nodes, 1, false, node->src[0])) {
+                ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, mul, rope, nullptr, mm);
