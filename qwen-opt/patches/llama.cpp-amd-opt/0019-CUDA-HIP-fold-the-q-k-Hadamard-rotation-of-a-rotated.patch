diff --git a/ggml/src/ggml-cuda/fwht.cuh b/ggml/src/ggml-cuda/fwht.cuh
index e7ad53475..d936874b6 100644
--- a/ggml/src/ggml-cuda/fwht.cuh
+++ b/ggml/src/ggml-cuda/fwht.cuh
@@ -1,4 +1,55 @@
+#pragma once
+
 #include "common.cuh"
+#include "convert.cuh"
+
+// Normalized FWHT of one row of N values by one warp: dst[i] = scale * (H_N src)[i].
+// Shared by fwht_cuda and kernels that apply the transform to a row they just produced (same arithmetic).
+template <int N, typename T>
+static __device__ __forceinline__ void fwht_row_warp(const T * src, float * dst, const float scale, const int lane) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    static_assert(N % warp_size == 0, "FWHT row must be a multiple of the warp size");
+
+    static constexpr int el_w = N / warp_size;
+    float reg[el_w];
+
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        reg[i] = ggml_cuda_cast<float>(src[i * warp_size + lane]) * scale;
+    }
+
+#pragma unroll
+    for (int h = 1; h < warp_size; h *= 2) {
+#pragma unroll
+        for (int j = 0; j < el_w; j++) {
+            const float val  = reg[j];
+            const float val2 = __shfl_xor_sync(0xFFFFFFFF, val, h, warp_size);
+
+            reg[j] = (lane & h) == 0 ? val + val2 : val2 - val;
+        }
+    }
+
+#pragma unroll
+    for (int h = warp_size; h < N; h *= 2) {
+        const int step = h / warp_size;
+#pragma unroll
+        for (int j = 0; j < el_w; j += 2 * step) {
+#pragma unroll
+            for (int k = 0; k < step; k++) {
+                const float x = reg[j + k];
+                const float y = reg[j + k + step];
+
+                reg[j + k]        = x + y;
+                reg[j + k + step] = x - y;
+            }
+        }
+    }
+
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        dst[i * warp_size + lane] = reg[i];
+    }
+}
 
 bool ggml_cuda_op_mul_mat_use_fwht(const struct ggml_tensor * op);
 
