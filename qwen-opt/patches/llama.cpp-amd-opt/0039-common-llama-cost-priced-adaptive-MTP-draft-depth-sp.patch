+    // one decode of the draft chain: n greedy levels from token id with hidden state h at position pos; appends the
+    // drafts and their draft-head probabilities, h_out gets the h_nextn of the last level
+    bool draft_chain_segment(llama_seq_id seq_id, llama_token id, const float * h, llama_pos pos, int32_t n,
+                             std::vector<llama_token> & ids, std::vector<double> & conf, std::vector<float> & h_out) {
+        auto * ctx_dft = params.ctx_dft;
+
+        batch.clear();
+        for (int32_t j = 0; j < n; ++j) {
+            // rows j > 0 only carry their position: the graph feeds pass j from pass j-1
+            const int32_t idx = batch.add(id, pos + j, seq_id, false);
+            batch.set_embd(idx, { h, 1, (size_t) n_embd });
+        }
+
+        llama_set_mtp_draft_chain(ctx_dft, true);
+        const int32_t ret = llama_process(ctx_dft, LLAMA_PROCESS_TYPE_DECODE, batch.get());
+        llama_set_mtp_draft_chain(ctx_dft, false);
+
+        if (ret != 0) {
+            SPC_ERR("llama_process (draft chain) returned %d\n", ret);
+            return false;
+        }
+
+        int32_t n_out  = 0;
+        int32_t n_conf = 0;
+        const llama_token * out = llama_get_mtp_draft_tokens(ctx_dft, &n_out);
+        const float       * p   = llama_get_mtp_draft_conf(ctx_dft, &n_conf);
+        const float       * hl  = llama_get_mtp_draft_h(ctx_dft);
+        GGML_ASSERT(n_out == n && n_conf == n && hl != nullptr);
+
+        ids.insert(ids.end(), out, out + n);
+        conf.insert(conf.end(), p, p + n);
+        h_out.assign(hl, hl + n_embd);
+
+        return true;
+    }
+
+    // greedy chain drafts of a depth priced by cost (see common_spec_depth_policy)
+    void draft_adaptive(llama_seq_id seq_id, common_speculative_draft_params & dp) {
+        depth.begin_step(ggml_time_us());
+
+        const int32_t n_lim = dp.n_max > 0 ? std::min(dp.n_max, depth.n_max) : depth.n_max;
+
+        std::vector<llama_token> ids;
+        std::vector<double>      conf; // draft-head probabilities
+        std::vector<double>      c;    // P(the first k drafts are accepted)
+        std::vector<float>       h = pending_h[seq_id];
+        std::vector<float>       h_next;
+
+        llama_token id = dp.id_last;
+        int32_t     d  = 0;
+        while (d + depth.seg <= n_lim) {
+            const int64_t t0 = ggml_time_us();
+            if (!draft_chain_segment(seq_id, id, h.data(), dp.pos0 + d, depth.seg, ids, conf, h_next)) {
+                break;
+            }
+            // (the first segment also waits for the MTP catch-up of the last verify)
+            if (d > 0) {
+                const double ms = (ggml_time_us() - t0) / 1000.0;
+                depth.seg_ms += common_spec_depth_policy::alpha * (ms - depth.seg_ms);
+            }
+
+            d += depth.seg;
+            depth.calibrate(conf, c);
+
+            if (!depth.more(c, d, n_lim)) {
+                break;
+            }
+            id = ids.back();
+            std::swap(h, h_next);
+        }
+
+        int32_t k = 0;
+        depth.best_keep(c, d, k);
+
+        dp.result->insert(dp.result->end(), ids.begin(), ids.begin() + k);
+        depth.end_draft(ggml_time_us(), k, std::move(conf));
+
+        if (depth.n_steps % 256 == 0) {
+            std::string hist;
+            for (size_t w = 1; w < depth.n_width.size(); ++w) {
+                hist += string_format(" %zu:%" PRId64, w, depth.n_width[w]);
+            }
+            std::string cal;
+            for (int b = 0; b < common_spec_depth_policy::n_bins; ++b) {
+                cal += " |";
+                for (int db = 0; db < common_spec_depth_policy::n_dbk; ++db) {
+                    cal += string_format(" %.2f/%.0f", depth.cal_acc[db][b] / std::max(1e-9, depth.cal_cnt[db][b]), depth.cal_cnt[db][b]);
+                }
+            }
+            SPC_INF("adaptive depth: %.3f tok/ms (%.2f tok, %.2f ms/step), segment %.2f ms, verify scale %.2f, width change %.2f ms, "
+                    "verify widths%s, acceptance by probability bin (depth 1, 2-4, 5+)%s\n", depth.rate(), depth.tok_ema, depth.ms_ema,
+                    depth.seg_ms, depth.v_scale, depth.sw_ms, hist.c_str(), cal.c_str());
+        }
+    }
+
+    // startup: verify time of each width (target decodes of 1 .. n_max + 1 tokens) and of one draft segment, fastest
+    // of the timed runs, on empty memories
+    void time_costs() {
+        auto * ctx_tgt = params.ctx_tgt;
+        auto * ctx_dft = params.ctx_dft;
+
+        const llama_token tok    = 1000;
+        const int         n_runs = 7;
+
+        common_batch b(ctx_tgt);
+        std::string tab;
+        for (int32_t w = 1; w <= depth.n_max + 1; ++w) {
+            double best = 1e30;
+            for (int r = 0; r <= n_runs; ++r) {
+                llama_memory_clear(llama_get_memory(ctx_tgt), true);
+                b.clear();
+                for (int32_t i = 0; i < w; ++i) {
+                    b.add(tok, i, 0, true);
+                }
+                const int64_t t0 = ggml_time_us();
+                if (llama_process(ctx_tgt, LLAMA_PROCESS_TYPE_DECODE, b.get()) != 0) {
+                    SPC_ERR("%s\n", "verify timing decode failed");
+                    break;
+                }
+                llama_synchronize(ctx_tgt);
+                if (r > 0) {
+                    best = std::min(best, (ggml_time_us() - t0) / 1000.0);
+                }
+            }
+            depth.v_tab[w] = best < 1e30 ? best : 0.0;
+            tab += string_format(" %d:%.2f", w, depth.v_tab[w]);
+        }
+        llama_memory_clear(llama_get_memory(ctx_tgt), true);
+
+        std::vector<float>       h(n_embd, 0.0f);
+        std::vector<float>       h_out;
+        std::vector<llama_token> ids;
