+// Cost-priced adaptive depth of the MTP draft chain (--spec-draft-adaptive).
+//
+// The chain drafts in segments of `seg` greedy levels (one chain graph decode each; a segment continues from the last
+// draft token and h_nextn, so the drafts are those of one longer chain) and returns the draft-head probability of every
+// draft. A draft at depth k is worth c_k = P(the first k drafts are accepted) = prod_{j<=k} q_j, where q_j is the
+// acceptance of draft j given the drafts before it were accepted, learned live per bin of its draft-head probability
+// (the head is overconfident) and depth. Time is priced at the current rate R (tokens per ms, live EMA of whole
+// steps): the kept depth k maximizes sum_{j<=k} c_j - R*v(k+1), with v(w) the verify time of w tokens (timed at
+// startup, then the live time of each width, plus a live cost of switching the verify graph to another width), and
+// one more segment is drafted while its extrapolated value exceeds R times the live draft time of a segment.
+struct common_spec_depth_policy {
+    int32_t seg   = 4; // levels per chain segment
+    int32_t n_max = 4; // maximum depth
+    float   power = 2.0f; // prior of the calibration: q = p^power
+
+    std::vector<double> v_tab; // [n_max + 2] startup verify ms per width (fastest of the runs)
+    std::vector<double> v_ema; // live verify ms per width, after a step of the same width (0 = not seen)
+    double v_scale = 1.0;      // EMA of live / startup verify time
+    double sw_ms   = 0.0;      // EMA of the extra verify time after a width change
+    double seg_ms  = 0.0;      // EMA of the draft time of one segment
+    double tok_ema = 3.0;      // EMA of tokens per step
+    double ms_ema  = 30.0;     // EMA of ms per step
+
+    // conditional acceptance by depth bucket (1, 2-4, 5+) and draft-head probability bin: decayed counts
+    static constexpr int n_bins = 10;
+    static constexpr int n_dbk  = 3;
+    double cal_acc[n_dbk][n_bins] = {};
+    double cal_cnt[n_dbk][n_bins] = {};
+
+    // the last step
+    std::vector<double> conf;      // draft-head probabilities of the kept drafts
+    int32_t width      = 0;        // its verify width
+    int32_t width_prev = 0;        // the verify width of the step before
+    int32_t n_tok      = 1;        // tokens it produced
+    int64_t t_beg      = 0;        // draft() start of the last step
+    int64_t t_end      = 0;        // draft() end of the last step (0: no verify pending)
+    bool    step_done  = false;    // the last step's verify and accept() have run
+
+    int64_t n_steps = 0;
+    std::vector<int64_t> n_width;  // histogram of the verify widths
+
+    static constexpr double alpha  = 0.1;  // EMA weight of the live times and rates
+    static constexpr double lambda = 0.99; // decay of a calibration cell per observation
+    static constexpr double prior  = 3.0;  // pseudo-observations of the calibration prior
+
+    void init(int32_t seg_, int32_t n_max_, float power_) {
+        seg   = seg_;
+        n_max = n_max_;
+        power = power_;
+        v_tab.assign(n_max + 2, 0.0);
+        v_ema.assign(n_max + 2, 0.0);
+        n_width.assign(n_max + 2, 0);
+    }
+
+    static int bin(double p) {
+        static const double edges[n_bins - 1] = { 0.3, 0.5, 0.65, 0.75, 0.85, 0.9, 0.95, 0.98, 0.995 };
+        int b = 0;
+        while (b < n_bins - 1 && p >= edges[b]) {
+            ++b;
+        }
+        return b;
+    }
+
+    static int dbk(size_t j) {
+        return j == 0 ? 0 : (j < 4 ? 1 : 2);
+    }
+
+    // P(draft j is accepted | the drafts before it were) for its draft-head probability p
+    double q(size_t j, double p) const {
+        const int d = dbk(j);
+        const int b = bin(p);
+        return (cal_acc[d][b] + prior * std::pow(p, (double) power)) / (cal_cnt[d][b] + prior);
+    }
+
+    double rate() const {
+        return tok_ema / ms_ema;
+    }
+
+    // verify time of width w, without the cost of a width change
+    double verify_ms(int32_t w) const {
+        double v = 0.0;
+        // never cheaper than a narrower width
+        for (int32_t i = 1; i <= w; ++i) {
+            v = std::max(v, v_ema[i] > 0.0 ? v_ema[i] : v_tab[i] * v_scale);
+        }
+        return v;
+    }
+
+    double verify_cost(int32_t w) const {
+        return verify_ms(w) + (width != 0 && w != width ? sw_ms : 0.0);
+    }
+
+    // P(the first k drafts are accepted) for the draft-head probabilities p[0..k)
+    void calibrate(const std::vector<double> & p, std::vector<double> & c) const {
+        c.resize(p.size());
+        double prod = 1.0;
+        for (size_t k = 0; k < p.size(); ++k) {
+            prod *= q(k, p[k]);
+            c[k]  = prod;
+        }
+    }
+
+    // the best number of drafts to keep out of the calibrated c[0..d), and its value sum_{j<=k} c_j - R*v(k+1)
+    double best_keep(const std::vector<double> & c, int32_t d, int32_t & k_best) const {
+        const double R = rate();
+        double s = 0.0;
+        double u_best = -R * verify_cost(1);
+        k_best = 0;
+        for (int32_t k = 1; k <= d; ++k) {
+            s += c[k - 1];
+            const double u = s - R * verify_cost(k + 1);
+            if (u > u_best) {
+                u_best = u;
+                k_best = k;
+            }
+        }
+        return u_best;
+    }
+
+    // after drafting c[0..d) (the last segment from depth d - seg): is one more segment worth its draft time?
+    bool more(const std::vector<double> & c, int32_t d, int32_t n_lim) const {
+        if (d + seg > n_lim) {
+            return false;
+        }
+        int32_t k = 0;
+        const double u_stop = best_keep(c, d, k);
+        const double R  = rate();
+        const double c0 = d > seg ? c[d - seg - 1] : 1.0;
+        const double cd = c[d - 1];
+        if (cd <= 0.0 || c0 <= 0.0) {
+            return false;
+        }
+        // the next levels continue the segment's mean conditional acceptance
+        const double a = std::min(1.0, std::pow(cd / c0, 1.0 / seg));
+        double s = 0.0;
+        for (int32_t j = 0; j < d; ++j) {
+            s += c[j];
+        }
+        double u_more = -1e30;
+        double cj = cd;
+        for (int32_t m = 1; m <= seg; ++m) {
+            cj *= a;
+            s  += cj;
+            u_more = std::max(u_more, s - R * verify_cost(d + m + 1));
+        }
+        return u_more - R * seg_ms > u_stop;
+    }
+
+    // draft() of a new step starts
+    void begin_step(int64_t t) {
+        if (step_done && t_beg > 0) {
+            const double ms = (t - t_beg) / 1000.0;
+            // a longer gap is a new request (or prompt processing), not a step
+            if (ms < 4.0 * ms_ema) {
+                ms_ema  += alpha * (ms - ms_ema);
+                tok_ema += alpha * (n_tok - tok_ema);
+            }
+        }
+        t_beg     = t;
+        t_end     = 0;
+        step_done = false;
+    }
+
+    void end_draft(int64_t t, int32_t k, std::vector<double> && p) {
+        conf       = std::move(p);
+        conf.resize(k);
+        width_prev = width;
+        width      = k + 1;
+        n_tok      = 1;
+        t_end      = t;
+        n_steps++;
+        n_width[width]++;
+    }
+
+    // the verify of the drafts (and the MTP catch-up) is done
+    void end_verify(int64_t t) {
+        if (t_end == 0) {
+            return;
+        }
+        const double ms = (t - t_end) / 1000.0;
+        t_end = 0;
+        if (width_prev == width) {
+            v_ema[width] = v_ema[width] > 0.0 ? v_ema[width] + alpha * (ms - v_ema[width]) : ms;
+            if (v_tab[width] > 0.0) {
+                v_scale += alpha * (ms / v_tab[width] - v_scale);
+            }
+        } else if (width_prev != 0) {
+            sw_ms += alpha * (std::max(0.0, ms - verify_ms(width)) - sw_ms);
+        }
+        step_done = true;
+    }
+
+    void accept(int32_t n_accepted) {
+        n_tok = n_accepted + 1;
+        // draft j is observed when the drafts before it were accepted
+        for (size_t j = 0; j < conf.size() && (int32_t) j <= n_accepted; ++j) {
+            const int d = dbk(j);
+            const int b = bin(conf[j]);
+            cal_acc[d][b] = lambda * cal_acc[d][b] + ((int32_t) j < n_accepted ? 1.0 : 0.0);
+            cal_cnt[d][b] = lambda * cal_cnt[d][b] + 1.0;
+        }
+    }
+};
+
