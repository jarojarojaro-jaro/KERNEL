diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index 38197285c..58a7815d0 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -367,6 +367,17 @@ extern "C" {
     // Set a callback to be called when the inputs weights of a split are being copied
     GGML_API void                 ggml_backend_sched_set_copy_callback(ggml_backend_sched_t sched, ggml_backend_sched_copy_callback callback, void * user_data);
 
+    // Upload host-resident split inputs with set_tensor_async on the split backend's stream instead of a blocking copy
+    // (two stream synchronizations per input). The input data is read by the device later, so the caller must call
+    // ggml_backend_sched_wait_inputs() before writing input tensors again. Only used without pipeline parallelism.
+    GGML_API void                 ggml_backend_sched_set_async_inputs(ggml_backend_sched_t sched, bool enable);
+    // Wait until the uploads of the last graph_compute have read their host data (no-op if none are pending)
+    GGML_API void                 ggml_backend_sched_wait_inputs(ggml_backend_sched_t sched);
+    // Write input data of a device-resident graph input: with async inputs enabled it is copied to pinned staging
+    // memory of the scheduler and uploaded on the backend's stream (ordered before the next graph_compute),
+    // otherwise this is ggml_backend_tensor_set. The staging memory is reused after ggml_backend_sched_wait_inputs().
+    GGML_API void                 ggml_backend_sched_set_tensor_async(ggml_backend_sched_t sched, struct ggml_tensor * tensor, const void * data, size_t offset, size_t size);
+
