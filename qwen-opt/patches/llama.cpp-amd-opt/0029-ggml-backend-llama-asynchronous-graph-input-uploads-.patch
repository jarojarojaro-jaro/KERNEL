@@ -1808,12 +1816,34 @@ static bool ggml_backend_sched_is_host_weight(const struct ggml_tensor * t) {
         ggml_backend_buffer_is_host(t->buffer);
 }
 
+// upload a host-resident input on the split backend's stream without blocking [ggml_backend_sched_set_async_inputs]
+// the stream orders the copy after the previous use of input_cpy and before this split's graph
+static bool ggml_backend_sched_copy_input_async(ggml_backend_sched_t sched, int split_backend_id, struct ggml_tensor * input, struct ggml_tensor * input_cpy) {
+    ggml_backend_t split_backend = sched->backends[split_backend_id];
+    if (!sched->async_inputs || sched->n_copies != 1 || sched->input_events[split_backend_id] == NULL ||
+        split_backend->iface.set_tensor_async == NULL || input->buffer == NULL || !ggml_backend_buffer_is_host(input->buffer) ||
+        ggml_backend_sched_is_host_weight(input) || input_cpy->buffer == NULL || ggml_backend_buffer_is_host(input_cpy->buffer)) {
+        return false;
+    }
+    if (!(input->flags & GGML_TENSOR_FLAG_INPUT)) {
+        // output of a previous split on a host backend
+        ggml_backend_synchronize(ggml_backend_sched_get_tensor_backend(sched, input));
+    }
+    ggml_backend_tensor_set_async(split_backend, input_cpy, input->data, 0, ggml_nbytes(input));
+    sched->input_pending[split_backend_id] = true;
+    return true;
+}
+
 static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggml_backend_sched_split * split, struct ggml_tensor * input) {
     const int split_backend_id = split->backend_id;
     ggml_backend_t split_backend = sched->backends[split_backend_id];
     ggml_backend_t input_backend = ggml_backend_sched_get_tensor_backend(sched, input);
     struct ggml_tensor * input_cpy = tensor_copy(input, split_backend_id, sched->cur_copy);
 
+    if (ggml_backend_sched_copy_input_async(sched, split_backend_id, input, input_cpy)) {
+        return;
+    }
+
     if (input->flags & GGML_TENSOR_FLAG_INPUT) {
         // inputs from the user must be copied immediately to prevent the user overwriting the data before the copy is done
         if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
@@ -1856,6 +1886,9 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
 
     int prev_backend_id = -1;
 
+    // host splits below may overwrite host memory that the previous uploads still read
+    ggml_backend_sched_wait_inputs(sched);
+
     for (int split_id = 0; split_id < sched->n_splits; split_id++) {
         struct ggml_backend_sched_split * split = &splits[split_id];
         int split_backend_id = split->backend_id;
@@ -1883,6 +1916,11 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 ggml_backend_sched_copy_input(sched, split, split->inputs[input_id]);
             }
         }
+        if (sched->input_pending[split_backend_id]) {
+            ggml_backend_event_record(sched->input_events[split_backend_id], split_backend);
+            sched->input_pending[split_backend_id]  = false;
+            sched->input_recorded[split_backend_id] = true;
+        }
 
         if (!sched->callback_eval) {
             enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &split->graph);
@@ -2010,10 +2048,15 @@ void ggml_backend_sched_free(ggml_backend_sched_t sched) {
     if (sched == NULL) {
         return;
     }
+    ggml_backend_sched_wait_inputs(sched);
     for (int b = 0; b < sched->n_backends; b++) {
         for (int c = 0; c < sched->n_copies; c++) {
             ggml_backend_event_free(sched->events[b][c]);
         }
+        if (sched->input_events[b] != NULL) {
+            ggml_backend_event_free(sched->input_events[b]);
+        }
+        ggml_backend_buffer_free(sched->input_staging[b]);
     }
     ggml_gallocr_free(sched->galloc);
     ggml_free(sched->ctx);
@@ -2037,6 +2080,8 @@ void ggml_backend_sched_free(ggml_backend_sched_t sched) {
 
 void ggml_backend_sched_reset(ggml_backend_sched_t sched) {
     GGML_ASSERT(sched);
+    // the tensors of the next graph may alias host memory that pending uploads still read
+    ggml_backend_sched_wait_inputs(sched);
     // reset state for the next run
     if (!sched->is_reset) {
         ggml_hash_set_reset(&sched->hash_set);
@@ -2083,6 +2128,8 @@ bool ggml_backend_sched_alloc_graph(ggml_backend_sched_t sched, struct ggml_cgra
     GGML_ASSERT((int)sched->hash_set.size >= graph->n_nodes + graph->n_leafs);
     GGML_ASSERT(!sched->is_alloc);
 
+    ggml_backend_sched_wait_inputs(sched);
+
     sched->cur_copy = sched->next_copy;
     sched->next_copy = (sched->next_copy + 1) % sched->n_copies;
 
@@ -2123,6 +2170,9 @@ void ggml_backend_sched_synchronize(ggml_backend_sched_t sched) {
     for (int i = 0; i < sched->n_backends; i++) {
         ggml_backend_synchronize(sched->backends[i]);
     }
+    for (int i = 0; i < sched->n_backends; i++) {
+        sched->input_recorded[i] = false;
+    }
     if (!sched->is_alloc) {
         // if the graph is not already allocated, always use copy 0 after a synchronization
         // this ensures that during generation the same copy is used every time,
@@ -2143,6 +2193,79 @@ void ggml_backend_sched_set_copy_callback(ggml_backend_sched_t sched, ggml_backe
     sched->callback_copy_user_data = user_data;
 }
 
+void ggml_backend_sched_set_async_inputs(ggml_backend_sched_t sched, bool enable) {
+    GGML_ASSERT(sched);
+    ggml_backend_sched_wait_inputs(sched);
+    sched->async_inputs = enable;
+    if (!enable) {
+        return;
+    }
+    for (int b = 0; b < sched->n_backends; b++) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[b]);
+        if (sched->input_events[b] == NULL && sched->backends[b]->iface.set_tensor_async != NULL &&
+            dev != NULL && dev->iface.event_new != NULL) {
+            sched->input_events[b] = ggml_backend_event_new(dev);
+        }
+    }
+}
+
+void ggml_backend_sched_wait_inputs(ggml_backend_sched_t sched) {
+    GGML_ASSERT(sched);
+    for (int b = 0; b < sched->n_backends; b++) {
+        if (sched->input_recorded[b]) {
+            ggml_backend_event_synchronize(sched->input_events[b]);
+            sched->input_recorded[b] = false;
+        }
+        if (!sched->input_pending[b]) {
+            sched->input_staging_off[b] = 0;
+        }
+    }
+}
+
+void ggml_backend_sched_set_tensor_async(ggml_backend_sched_t sched, struct ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+    GGML_ASSERT(sched);
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    GGML_ASSERT(buf != NULL && "tensor buffer not set");
+
+    int b = -1;
+    if (sched->async_inputs && sched->n_copies == 1 && size > 0 && !ggml_backend_buffer_is_host(buf)) {
+        for (int i = 0; i < sched->n_backends; i++) {
+            if (sched->input_events[i] != NULL && ggml_backend_supports_buft(sched->backends[i], ggml_backend_buffer_get_type(buf))) {
+                b = i;
+                break;
+            }
+        }
+    }
+    if (b < 0) {
+        ggml_backend_tensor_set(tensor, data, offset, size);
+        return;
+    }
+
+    ggml_backend_t backend = sched->backends[b];
+    const size_t need = GGML_PAD(size, 256);
+    const size_t cap  = sched->input_staging[b] ? ggml_backend_buffer_get_size(sched->input_staging[b]) : 0;
+    if (sched->input_staging_off[b] + need > cap) {
+        // grow: staged data of earlier calls may still be in flight, finish it before the buffer is replaced
+        ggml_backend_synchronize(backend);
+        const size_t new_cap = std::max<size_t>(1u << 20, 2*(sched->input_staging_off[b] + need));
+        sched->input_staging_off[b] = 0;
+        ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+        ggml_backend_buffer_free(sched->input_staging[b]);
+        sched->input_staging[b] = host_buft ? ggml_backend_buft_alloc_buffer(host_buft, new_cap) : NULL;
+        if (sched->input_staging[b] == NULL) {
+            ggml_backend_tensor_set(tensor, data, offset, size);
+            return;
+        }
+    }
+
+    char * dst = (char *) ggml_backend_buffer_get_base(sched->input_staging[b]) + sched->input_staging_off[b];
+    memcpy(dst, data, size);
+    sched->input_staging_off[b] += need;
+
+    ggml_backend_tensor_set_async(backend, tensor, dst, offset, size);
+    sched->input_pending[b] = true;
+}
+
 int ggml_backend_sched_get_n_splits(ggml_backend_sched_t sched) {
     GGML_ASSERT(sched);
     return sched->n_splits;
