+    bool input_recorded[GGML_SCHED_MAX_BACKENDS];               // event recorded, not yet waited for
+    ggml_backend_buffer_t input_staging[GGML_SCHED_MAX_BACKENDS];     // pinned host memory of ggml_backend_sched_set_tensor_async
+    size_t                input_staging_off[GGML_SCHED_MAX_BACKENDS]; // bytes of input_staging in use since the last wait
+
