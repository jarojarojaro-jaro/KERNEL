diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index cb17cf202..0d55d9d74 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -533,6 +533,17 @@ static __device__ __forceinline__ float warp_reduce_max(float x) {
     return x;
 }
 
+// Returns x unchanged but opaque to the optimizer: a product passed through it cannot be contracted with a later add
+// into an fma. For kernels that must reproduce the rounding of another kernel where that contraction did not happen.
+static __device__ __forceinline__ float ggml_cuda_no_contract(float x) {
+#if defined(GGML_USE_HIP)
+    asm volatile("" : "+v"(x));
+#else
+    asm volatile("" : "+f"(x));
+#endif // defined(GGML_USE_HIP)
+    return x;
+}
