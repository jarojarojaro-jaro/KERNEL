+// silu(z) * (rms_norm(x) * w): the gated output norm of a delta-net layer, which backends may run as one kernel
+struct test_rms_norm_gate : public test_case {
+    const std::array<int64_t, 4> ne;
+    const bool z_view; // z reaches the SILU through a reshape (as in qwen35)
+    const float eps;
+
+    test_rms_norm_gate(std::array<int64_t, 4> ne, bool z_view = false, float eps = 1e-6f) : ne(ne), z_view(z_view), eps(eps) {}
+
+    std::string vars() override {
+        return VARS_TO_STR3(ne, z_view, eps);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "RMS_NORM_GATE";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_tensor * z = z_view ? ggml_reshape_4d(ctx, ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne[0]*ne[1], ne[2]*ne[3]), ne[0], ne[1], ne[2], ne[3])
+                                 : ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_tensor * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne[0]);
+        ggml_tensor * n = ggml_mul(ctx, ggml_rms_norm(ctx, x, eps), w);
+        ggml_tensor * out = ggml_mul(ctx, n, ggml_silu(ctx, z));
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
