index d9526c8fb..9c83f8708 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4835,6 +4835,33 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         return 2;
     }
 
+    // gated output norm of a GDN layer: silu(z) * (rms_norm(x) * w) (+ its q8_1 copy) in one launch; the reshape of z
+    // may sit between the MUL and the SILU
+    static const bool norm_gate = ggml_cuda_env_switch("GGML_HIP_NORM_GATE");
+    if (norm_gate && node->op == GGML_OP_RMS_NORM) {
+        int k = i + 2;
+        while (k < cgraph->n_nodes && k < i + 5 && ggml_cuda_is_view_or_noop(cgraph->nodes[k])) {
+            ++k;
+        }
+        const int idxs[4] = { i, i + 1, k, k + 1 };
+        const ggml_op ops[4] = { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_UNARY, GGML_OP_MUL };
+        const int outs[1] = { k + 1 };
+        if (k + 1 < cgraph->n_nodes && ggml_can_fuse_subgraph_ext(cgraph, idxs, 4, ops, outs, 1)) {
+            const ggml_tensor * mw = cgraph->nodes[i + 1];
+            const ggml_tensor * un = cgraph->nodes[k];
+            ggml_tensor *       gm = cgraph->nodes[k + 1];
+            const ggml_tensor * w  = mw->src[0] == node ? mw->src[1] : mw->src[1] == node ? mw->src[0] : nullptr;
+            if (w && ggml_get_unary_op(un) == GGML_UNARY_OP_SILU &&
+                    ((gm->src[0] == mw && gm->src[1] == un) || (gm->src[0] == un && gm->src[1] == mw)) &&
+                    ggml_are_same_shape(mw, node) &&
+                    ggml_cuda_rms_norm_mul_silu_gate_supported(node, w, un->src[0], gm)) {
+                ggml_cuda_op_rms_norm_mul_silu_gate(*cuda_ctx, node, w, un->src[0], gm,
+                                                    ggml_cuda_q8_1_producer_target(cuda_ctx, cgraph, k + 1));
+                return k + 1 - i;
+            }
+        }
+    }
+
     if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
         block_q8_1 * q8 = node->src[0]->ne[0] % QK8_1 == 0 ? ggml_cuda_q8_1_producer_target(cuda_ctx, cgraph, i + 1) : nullptr;
         ggml_cuda_op_rms_norm_fused(*cuda_ctx, node, cgraph->nodes[i + 1], q8);
