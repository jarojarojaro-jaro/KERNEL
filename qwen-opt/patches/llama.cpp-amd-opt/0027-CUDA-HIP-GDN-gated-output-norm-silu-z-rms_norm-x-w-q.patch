--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -1,4 +1,5 @@
 #include "norm.cuh"
+#include "unary.cuh"
 #include <cstdint>
 
 template <int block_size>
@@ -287,6 +288,79 @@ static bool rms_norm_mul_unrolled_enabled() {
     return enabled;
 }
 
+// The gated output norm of a GDN layer: dst = silu(z) * (rms_norm(x) * w) over rows of NCOLS (<= 256) columns, with
+// the q8_1 copy of dst. One thread per column, one block per row. Bitwise equal to rms_norm_f32<256, true> followed
+// by unary_gated_op_kernel<op_silu>: the 256-thread kernel sums x^2 of thread t < NCOLS, adds zeros for the rest
+// (warp sums of zeros and zero sentinels in the cross-warp butterfly), which is the same set of pairings.
+template <int NCOLS>
+__launch_bounds__(NCOLS, 1)
+static __global__ void rms_norm_mul_silu_gate_f32(const float * x, const float * w, const float * z, float * dst,
+                                                  const float eps, block_q8_1 * q8) {
+    static_assert(NCOLS % WARP_SIZE == 0 && NCOLS <= 256, "one column per thread, at most the 8 warps of rms_norm_f32<256>");
+    ggml_cuda_pdl_lc();
+    const int     col = threadIdx.x;
+    const int64_t i   = int64_t(blockIdx.x)*NCOLS + col;
+
+    ggml_cuda_pdl_sync();
+    const float xi = x[i];
+    const float wi = w[col];
+    const float zi = z[i];
+
+    // fma(xi, xi, 0) of the rms_norm_f32 loop, kept out of the first add of the reduction
+    float tmp = ggml_cuda_no_contract(xi * xi);
+    tmp = warp_reduce_sum_dpp(tmp);
+    if constexpr (NCOLS > WARP_SIZE) {
+        __shared__ float s_sum[NCOLS/WARP_SIZE];
+        const int lane_id = col % WARP_SIZE;
+        if (lane_id == 0) {
+            s_sum[col / WARP_SIZE] = tmp;
+        }
+        __syncthreads();
+        tmp = warp_reduce_sum_dpp(lane_id < NCOLS/WARP_SIZE ? s_sum[lane_id] : 0.0f);
+    }
+
+    const float mean   = tmp / NCOLS;
+    const float scale  = rsqrtf(mean + eps);
+    const float normed = ggml_cuda_no_contract(scale * xi * wi);
+    const float v      = ggml_cuda_no_contract(ggml_cuda_op_silu_single(zi) * normed);
+    dst[i] = v;
+    if (q8 != nullptr) {
+        quantize_q8_1_group<true>(v, q8 + i/QK8_1, i % QK8_1);
+    }
+}
+
+bool ggml_cuda_rms_norm_mul_silu_gate_supported(const ggml_tensor * rms_norm, const ggml_tensor * w, const ggml_tensor * z,
+                                                const ggml_tensor * dst) {
+    const ggml_tensor * x = rms_norm->src[0];
+    const int64_t ncols = x->ne[0];
+    return (ncols == 32 || ncols == 64 || ncols == 128 || ncols == 256) &&
+           x->type == GGML_TYPE_F32 && w->type == GGML_TYPE_F32 && z->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+           ggml_is_contiguous(x) && ggml_is_contiguous(z) && ggml_is_contiguous(dst) && ggml_is_contiguous(w) &&
+           ggml_nelements(w) == ncols && ggml_are_same_shape(x, z) && ggml_are_same_shape(x, dst) &&
+           ggml_nrows(x) <= INT32_MAX;
+}
+
+void ggml_cuda_op_rms_norm_mul_silu_gate(ggml_backend_cuda_context & ctx, const ggml_tensor * rms_norm, const ggml_tensor * w,
+                                         const ggml_tensor * z, ggml_tensor * dst, block_q8_1 * q8) {
+    GGML_ASSERT(ggml_cuda_rms_norm_mul_silu_gate_supported(rms_norm, w, z, dst));
+    float eps = 0.0f;
+    memcpy(&eps, rms_norm->op_params, sizeof(float));
+    const ggml_tensor * x = rms_norm->src[0];
+    const dim3 blocks((unsigned) ggml_nrows(x));
+    const float * x_d = (const float *) x->data;
+    const float * w_d = (const float *) w->data;
+    const float * z_d = (const float *) z->data;
+    float       * d_d = (float *) dst->data;
+    cudaStream_t stream = ctx.stream();
+    switch (x->ne[0]) {
+        case  32: rms_norm_mul_silu_gate_f32< 32><<<blocks,  32, 0, stream>>>(x_d, w_d, z_d, d_d, eps, q8); break;
+        case  64: rms_norm_mul_silu_gate_f32< 64><<<blocks,  64, 0, stream>>>(x_d, w_d, z_d, d_d, eps, q8); break;
+        case 128: rms_norm_mul_silu_gate_f32<128><<<blocks, 128, 0, stream>>>(x_d, w_d, z_d, d_d, eps, q8); break;
+        case 256: rms_norm_mul_silu_gate_f32<256><<<blocks, 256, 0, stream>>>(x_d, w_d, z_d, d_d, eps, q8); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
+
