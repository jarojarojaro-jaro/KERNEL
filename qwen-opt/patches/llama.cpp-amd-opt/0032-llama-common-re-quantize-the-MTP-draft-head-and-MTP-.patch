From 343c2fbbb259ba5d6d3e56d87693fa19a2f15699 Mon Sep 17 00:00:00 2001
From: jarojarojaro-jaro <miki.jaroszek@gmail.com>
Date: Tue, 13 Oct 2026 16:33:38 +0000
Subject: [PATCH 32/52] llama/common: re-quantize the MTP draft head and MTP
 block at load time (--spec-draft-head-type, --spec-mtp-type)

llama_model_requant_mtp() converts the reduced draft head of llama_model_set_draft_head_vocab and/or the
matrices of the NextN block (attention, FFN, eh_proj) into new tensors of another quantization type and points
the MTP graph at them; the main model weights are untouched, so verification is unaffected.
---
 common/arg.cpp         |  31 ++++++++++
 common/common.h        |   3 +
 common/speculative.cpp |   8 +++
 include/llama.h        |   7 +++
 src/llama-model.cpp    | 129 +++++++++++++++++++++++++++++++++++++++++
 src/llama-model.h      |   2 +
 6 files changed, 180 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index fb4e5efd0..61ccfe199 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -330,6 +330,21 @@ static std::string get_all_kv_cache_types() {
     return msg.str();
 }
 
+// a quantized ggml type by its name (case-insensitive, e.g. q4_K, iq4_xs)
+static ggml_type quant_type_from_str(const std::string & s) {
+    auto lower = [](std::string v) {
+        std::transform(v.begin(), v.end(), v.begin(), [](unsigned char c) { return (char) std::tolower(c); });
+        return v;
+    };
+    for (int i = 0; i < GGML_TYPE_COUNT; ++i) {
+        const char * name = ggml_type_name((ggml_type) i);
+        if (name && ggml_is_quantized((ggml_type) i) && lower(name) == lower(s)) {
+            return (ggml_type) i;
+        }
+    }
+    throw std::runtime_error("Unsupported quantization type: " + s);
+}
+
 static bool parse_bool_value(const std::string & value) {
     if (is_truthy(value)) {
         return true;
@@ -4236,6 +4251,22 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.speculative.draft.vocab_n = value;
         }
     ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}).set_env("LLAMA_ARG_SPEC_DRAFT_VOCAB_N"));
+    add_opt(common_arg(
+        {"--spec-draft-head-type"}, "TYPE",
+        "MTP: re-quantize the reduced draft head of --spec-draft-vocab at load time, e.g. q4_K: cheaper draft\n"
+        "passes, verification and the main model weights unaffected (default: keep the head's type)",
+        [](common_params & params, const std::string & value) {
+            params.speculative.draft.head_type = quant_type_from_str(value);
+        }
+    ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}).set_env("LLAMA_ARG_SPEC_DRAFT_HEAD_TYPE"));
+    add_opt(common_arg(
+        {"--spec-mtp-type"}, "TYPE",
+        "MTP: re-quantize the matrices of the MTP block (attention, FFN, eh_proj) at load time, e.g. q4_K:\n"
+        "cheaper draft passes, verification and the main model weights unaffected (default: keep the file's types)",
+        [](common_params & params, const std::string & value) {
+            params.speculative.draft.mtp_type = quant_type_from_str(value);
+        }
+    ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}).set_env("LLAMA_ARG_SPEC_MTP_TYPE"));
     add_opt(common_arg(
         {"--spec-draft-backend-sampling"},
         {"--no-spec-draft-backend-sampling"},
