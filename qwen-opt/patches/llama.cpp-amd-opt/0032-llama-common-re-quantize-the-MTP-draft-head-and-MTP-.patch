+    // re-quantized MTP draft weights (requant_mtp), one context/buffer per tensor
+    std::vector<std::pair<ggml_context_ptr, ggml_backend_buffer_ptr>> mtp_requant;
 
     buft_list_t cpu_buft_list;
     std::map<ggml_backend_dev_t, buft_list_t> gpu_buft_list;
@@ -3116,6 +3120,131 @@ bool llama_model_set_draft_head_vocab(llama_model * model, const llama_token * i
     return model->set_draft_head_vocab(ids, n_ids);
 }
 
+// a copy of the matrix src converted to type, in a new buffer of the same buffer type (nullptr on failure)
+static ggml_tensor * llama_requant_tensor(const ggml_tensor * src, ggml_type type,
+        std::vector<std::pair<ggml_context_ptr, ggml_backend_buffer_ptr>> & out) {
+    const auto * traits_src = ggml_get_type_traits(src->type);
+    const int64_t n_per_row = src->ne[0];
+    const int64_t n_rows    = ggml_nrows(src);
+    if (!ggml_is_contiguous(src) || traits_src->to_float == nullptr || n_per_row % ggml_blck_size(type) != 0) {
+        return nullptr;
+    }
+
+    ggml_init_params ip = { ggml_tensor_overhead(), nullptr, /*no_alloc =*/ true };
+    ggml_context_ptr ctx(ggml_init(ip));
+    ggml_tensor * dst = ggml_new_tensor(ctx.get(), type, ggml_n_dims(src), src->ne);
+    ggml_set_name(dst, src->name);
+    ggml_backend_buffer_ptr buf(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_buffer_get_type(src->buffer)));
+    if (!buf) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::vector<uint8_t> data_src(ggml_nbytes(src));
+    std::vector<uint8_t> data_dst(ggml_nbytes(dst));
+    ggml_backend_tensor_get(src, data_src.data(), 0, data_src.size());
+
+    const size_t row_src = ggml_row_size(src->type, n_per_row);
+    const size_t row_dst = ggml_row_size(type,      n_per_row);
+    ggml_quantize_init(type);
+
+    const int     n_threads = std::max(1, std::min(16, (int) std::thread::hardware_concurrency()));
+    const int64_t rows_per  = (n_rows + n_threads - 1) / n_threads;
+    std::vector<std::thread> workers;
+    for (int t = 0; t < n_threads; ++t) {
+        const int64_t r0 = t * rows_per;
+        const int64_t r1 = std::min(n_rows, r0 + rows_per);
+        if (r0 >= r1) {
+            break;
+        }
+        workers.emplace_back([&, r0, r1] {
+            constexpr int64_t rows_blk = 16;
+            std::vector<float> f32(rows_blk * n_per_row);
+            for (int64_t r = r0; r < r1; r += rows_blk) {
+                const int64_t nr = std::min(rows_blk, r1 - r);
+                for (int64_t i = 0; i < nr; ++i) {
+                    traits_src->to_float(data_src.data() + (r + i) * row_src, f32.data() + i * n_per_row, n_per_row);
+                }
+                ggml_quantize_chunk(type, f32.data(), data_dst.data() + r * row_dst, 0, nr, n_per_row, nullptr);
+            }
+        });
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+    ggml_backend_tensor_set(dst, data_dst.data(), 0, data_dst.size());
+
+    out.emplace_back(std::move(ctx), std::move(buf));
+    return dst;
+}
+
+bool llama_model::requant_mtp(ggml_type head_type, ggml_type layer_type) {
+    if (hparams.n_layer_nextn == 0) {
+        return false;
+    }
+    for (ggml_type type : { head_type, layer_type }) {
+        if (type == GGML_TYPE_COUNT) {
+            continue;
+        }
+        if (type < 0 || type > GGML_TYPE_COUNT || !ggml_is_quantized(type) ||
+                ggml_get_type_traits(type)->from_float_ref == nullptr || ggml_quantize_requires_imatrix(type)) {
+            LLAMA_LOG_ERROR("%s: unsupported MTP weight type %d\n", __func__, (int) type);
+            return false;
+        }
+    }
+
+    // (slot, type, its scale tensor: scaled weights are not converted)
+    std::vector<std::tuple<ggml_tensor **, ggml_type, ggml_tensor *>> slots;
+    if (head_type != GGML_TYPE_COUNT) {
+        if (draft_head == nullptr) {
+            LLAMA_LOG_ERROR("%s: no reduced draft head to convert, set the draft vocabulary first\n", __func__);
+            return false;
+        }
+        slots.emplace_back(&draft_head, head_type, nullptr);
+    }
+    if (layer_type != GGML_TYPE_COUNT) {
+        for (uint32_t il = hparams.n_layer(); il < hparams.n_layer() + hparams.n_layer_nextn; ++il) {
+            auto & l = layers[il];
+            slots.emplace_back(&l.wq,            layer_type, l.wq_s);
+            slots.emplace_back(&l.wk,            layer_type, l.wk_s);
+            slots.emplace_back(&l.wv,            layer_type, l.wv_s);
+            slots.emplace_back(&l.wqkv,          layer_type, l.wqkv_s);
+            slots.emplace_back(&l.wo,            layer_type, l.wo_s);
+            slots.emplace_back(&l.ffn_gate,      layer_type, l.ffn_gate_s);
+            slots.emplace_back(&l.ffn_up,        layer_type, l.ffn_up_s);
+            slots.emplace_back(&l.ffn_down,      layer_type, l.ffn_down_s);
+            slots.emplace_back(&l.nextn.eh_proj, layer_type, l.nextn.eh_proj_s);
+        }
+    }
+
+    size_t size_old = 0;
+    size_t size_new = 0;
+    for (auto & [slot, type, scale] : slots) {
+        ggml_tensor * src = *slot;
+        if (src == nullptr || scale != nullptr || src->buffer == nullptr || src->type == type || ggml_n_dims(src) != 2) {
+            continue;
+        }
+        ggml_tensor * dst = llama_requant_tensor(src, type, pimpl->mtp_requant);
+        if (dst == nullptr) {
+            LLAMA_LOG_WARN("%s: could not convert %s (%s) to %s, kept\n", __func__, src->name, ggml_type_name(src->type), ggml_type_name(type));
+            continue;
+        }
+        LLAMA_LOG_DEBUG("%s: %s %s -> %s\n", __func__, src->name, ggml_type_name(src->type), ggml_type_name(type));
+        size_old += ggml_nbytes(src);
+        size_new += ggml_nbytes(dst);
+        *slot = dst;
+    }
+    LLAMA_LOG_INFO("%s: MTP draft weights re-quantized (head %s, block %s): %.1f MiB -> %.1f MiB\n", __func__,
+            head_type  == GGML_TYPE_COUNT ? "kept" : ggml_type_name(head_type),
+            layer_type == GGML_TYPE_COUNT ? "kept" : ggml_type_name(layer_type),
+            size_old / 1024.0 / 1024.0, size_new / 1024.0 / 1024.0);
+    return true;
+}
+
+bool llama_model_requant_mtp(llama_model * model, ggml_type head_type, ggml_type layer_type) {
+    return model->requant_mtp(head_type, layer_type);
+}
