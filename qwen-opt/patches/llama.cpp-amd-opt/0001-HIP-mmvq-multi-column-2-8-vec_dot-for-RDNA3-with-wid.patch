+                    vec_dot_q_multi<type, ncols_dst, rows_per_cuda_block>(
+                        vgate, &y[kby], stride_col_y, kbx_offset + kbx, stride_row_x, kqs, last_row, tmp_gate);
+                }
+            }
+        } else {
 #pragma unroll
         for (int j = 0; j < ncols_dst; ++j) {
 #pragma unroll
@@ -758,6 +1066,7 @@ static __global__ void mul_mat_vec_q(
                 }
             }
         }
+        }
     }
 
     __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][ncols_dst][rows_per_cuda_block][warp_size];
