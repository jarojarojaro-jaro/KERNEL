+// Dot the unpacked weight slices xs of nrows rows with ncols columns of y. yc: block-uniform source of each column,
+// yoff: byte offset of the q8_1 block aligned with the x block (shared by all columns).
+template <ggml_type type, int ncols, int nrows>
+static __device__ __forceinline__ void vec_dot_q_multi_xs(
+        const mmvq_xs<type> (&xs)[nrows], const mmvq_src (&yc)[ncols], const uint32_t yoff, const int iqs,
+        float (&acc)[ncols][nrows]) {
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        const mmvq_ys<type> u = mmvq_load_y<type>(yc[j], yoff, iqs);
+#pragma unroll
+        for (int r = 0; r < nrows; ++r) {
+            acc[j][r] += mmvq_dot<type>(xs[r], u);
+        }
+    }
