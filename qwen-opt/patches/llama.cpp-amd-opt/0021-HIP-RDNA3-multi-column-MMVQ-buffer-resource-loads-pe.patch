+// Byte-offset loads for the multi path: a block-uniform source (row of x / column of y) plus a 32-bit per-thread
+// byte offset. On RDNA3 the sources are raw buffer resources in SGPRs, so every load is `buffer_load voffset, srsrc,
+// soffset` and the loop only advances the shared 32-bit offsets; with plain pointers the compiler hoists one 64-bit
+// VGPR base per (row, field) and spends a 64-bit add per load. `align` is what the caller can guarantee (RDNA does
+// unaligned loads natively, the pointer fallback honors it).
+#if defined(GGML_USE_HIP) && defined(RDNA3)
+#define MMVQ_BUFFER_LOADS
+#endif
+
+struct mmvq_src {
+    const char * p; // p + soff = base; used by the pointer path and the types without a byte-offset loader
+#ifdef MMVQ_BUFFER_LOADS
+    __amdgpu_buffer_rsrc_t rsrc;
+    uint32_t soff;
+#endif
+};
+
+static __device__ __forceinline__ mmvq_src mmvq_make_src(const void * base, const uint32_t soff = 0) {
+    mmvq_src s;
+    s.p = (const char *) base + soff;
+#ifdef MMVQ_BUFFER_LOADS
+    // raw buffer (stride 0), no effective range limit, RDNA3 dword3 (as in composable_kernel for gfx11)
+    s.rsrc = __builtin_amdgcn_make_buffer_rsrc(const_cast<void *>(base), 0, -1, 0x31004000);
+    s.soff = soff;
+#endif
+    return s;
+}
+
+template <typename T, int align>
+static __device__ __forceinline__ T mmvq_ld(const mmvq_src & s, const uint32_t off) {
+    T v;
+#ifdef MMVQ_BUFFER_LOADS
+    static_assert(sizeof(T) == 2 || sizeof(T) == 4 || sizeof(T) == 8 || sizeof(T) == 16, "mmvq_ld: unsupported size");
+    if constexpr (sizeof(T) == 2) {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b16(s.rsrc, off, s.soff, 0);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    } else if constexpr (sizeof(T) == 4) {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b32(s.rsrc, off, s.soff, 0);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    } else if constexpr (sizeof(T) == 8) {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b64(s.rsrc, off, s.soff, 0);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    } else {
+        const auto r = __builtin_amdgcn_raw_buffer_load_b128(s.rsrc, off, s.soff, 0);
+        __builtin_memcpy(&v, &r, sizeof(T));
+    }
+#else
+    __builtin_memcpy(&v, __builtin_assume_aligned(s.p + off, align), sizeof(T));
+#endif
+    return v;
+}
+
+template <int n, int align>
+static __device__ __forceinline__ void mmvq_ld_ints(const mmvq_src & s, const uint32_t off, int (&v)[n]) {
+#pragma unroll
+    for (int i = 0; i < n; i += 4) {
+        if (n - i >= 4) {
+            const int4 t = mmvq_ld<int4, align>(s, off + 4*i);
+            v[i + 0] = t.x; v[i + 1] = t.y; v[i + 2] = t.z; v[i + 3] = t.w;
+        } else if (n - i == 2) {
+            const int2 t = mmvq_ld<int2, align>(s, off + 4*i);
+            v[i + 0] = t.x; v[i + 1] = t.y;
+        } else {
+#pragma unroll
+            for (int k = i; k < n; ++k) {
+                v[k] = mmvq_ld<int, align>(s, off + 4*k);
+            }
+        }
+    }
+}
 
