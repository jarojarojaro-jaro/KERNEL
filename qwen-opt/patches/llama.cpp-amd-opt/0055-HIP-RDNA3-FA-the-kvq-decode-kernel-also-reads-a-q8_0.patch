+// q8_0: the lanes load whole 32 bit words from the 4 byte aligned word that holds their first byte (the second half of
+// a row starts 2 bytes into a word if a half row is an odd number of blocks), so the rows must be 4 byte aligned.
 template <int D, ggml_type type>
 static constexpr __host__ __device__ int fattn_kvq_lane_align() {
     constexpr int n = fattn_kvq_lane_bytes<D, type>();
+    if (type == GGML_TYPE_Q8_0) {
+        return 4;
+    }
     return n % 16 == 0 ? 16 : (n % 8 == 0 ? 8 : (n % 4 == 0 ? 4 : 2));
