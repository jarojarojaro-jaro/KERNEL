+// As above at byte offset o + (sh ? 2 : 0), sh is per lane (q8_0 half rows that start 2 bytes into a word).
+static __device__ __forceinline__ uint32_t fattn_kvq_get_u32(const uint32_t * w, const int o, const bool sh) {
+    return sh ? fattn_kvq_get_u32(w, o + 2) : fattn_kvq_get_u32(w, o);
+}
