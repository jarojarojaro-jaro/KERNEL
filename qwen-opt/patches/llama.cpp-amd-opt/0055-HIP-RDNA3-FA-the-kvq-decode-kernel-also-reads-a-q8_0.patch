     }
 }
 
+// Packed f16 values of 2 bytes of xu selected by sel, xu holds q8_0 values with the sign bit flipped (128 + q):
+// the magic number 0x6400 turns them into 1024 + 128 + q, the offset 1152 is subtracted exactly.
+static __device__ __forceinline__ uint32_t fattn_kvq_q8_0_h2(const uint32_t xu, const uint32_t sel, const fattn_kvq_h2 d) {
+    const fattn_kvq_h2 h = __builtin_bit_cast(fattn_kvq_h2, __builtin_amdgcn_perm(0x64646464u, xu, sel));
+    return __builtin_bit_cast(uint32_t, (h - (fattn_kvq_h2){1152.0f16, 1152.0f16}) * d);
+}
+
+// Dequantize the q8_0 block at byte offset o (+ 2 if sh) into the WMMA A fragments for its first and second 16 values.
+static __device__ __forceinline__ void fattn_kvq_dequant_q8_0(const uint32_t * w, const int o, const bool sh, fattn_kvq_u8 & lo, fattn_kvq_u8 & hi) {
+    const _Float16 d = __builtin_bit_cast(_Float16, (uint16_t) fattn_kvq_get_u16(w, o, sh));
+    const fattn_kvq_h2 d2 = {d, d};
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const uint32_t xl = fattn_kvq_get_u32(w, o +  2 + 4*j, sh) ^ 0x80808080u;
+        const uint32_t xh = fattn_kvq_get_u32(w, o + 18 + 4*j, sh) ^ 0x80808080u;
+        lo[2*j + 0] = fattn_kvq_q8_0_h2(xl, 0x04010400u, d2);
+        lo[2*j + 1] = fattn_kvq_q8_0_h2(xl, 0x04030402u, d2);
+        hi[2*j + 0] = fattn_kvq_q8_0_h2(xh, 0x04010400u, d2);
+        hi[2*j + 1] = fattn_kvq_q8_0_h2(xh, 0x04030402u, d2);
+    }
+}
