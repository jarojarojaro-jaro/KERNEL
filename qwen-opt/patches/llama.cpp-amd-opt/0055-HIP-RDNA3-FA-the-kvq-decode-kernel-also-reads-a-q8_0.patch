+// 32 bit words of K or V per row and lane held in registers.
+template <int D, ggml_type type>
+static constexpr __host__ __device__ int fattn_kvq_lane_words() {
+    constexpr int n = fattn_kvq_lane_bytes<D, type>();
+    // q8_0 with a half row that is not a multiple of 4 bytes: the bytes [sh, sh + n) of the loaded words, sh = 0 or 2
+    return type == GGML_TYPE_Q8_0 && n % 4 != 0 ? (n + 2 + 3)/4 : (n + 3)/4;
+}
