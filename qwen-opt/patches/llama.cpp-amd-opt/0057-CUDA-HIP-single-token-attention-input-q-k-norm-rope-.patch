+template <int block_size, bool has_ff, typename D, int fwht_n = 0>
+static __global__ void rms_norm_mul_rope_f32(
+        const float * x, D * dst, const int ncols, const int nchannels, const int nsamples,
+        const int64_t s01, const int64_t s02, const int64_t s03,
+        const int64_t s1, const int64_t s2, const int64_t s3,
+        const float eps,
+        const float * mul,
+        const int64_t mul_s01, const int64_t mul_s02, const int64_t mul_s03,
+        const uint3 mul_ncols_packed, const uint3 mul_nrows_packed,
+        const uint3 mul_nchannels_packed, const uint3 mul_nsamples_packed,
+        const int n_dims, const int32_t * pos,
+        const float freq_scale, const float ext_factor, const float attn_factor,
+        const rope_corr_dims corr_dims, const float theta_scale,
+        const float * freq_factors,
+        const int64_t * row_indices, const int set_rows_stride,
+        const bool is_neox, const int multi, const mrope_sections sections,
+        const float fwht_scale) {
+    ggml_cuda_pdl_lc();
+    extern __shared__ float s_sum[];
+    __shared__ float s_row[fwht_n > 0 ? fwht_n : 1];
+
+    ggml_cuda_pdl_sync();
+
+    // grid.y and grid.z are clamped to the CUDA limit, iterate over the excess channels/samples
+    rms_norm_mul_rope_f32_rows<block_size, has_ff, D, fwht_n>(blockIdx.x, blockIdx.z, gridDim.z, blockIdx.y, gridDim.y,
+        s_sum, s_row, x, dst, ncols, nchannels, nsamples, s01, s02, s03, s1, s2, s3, eps, mul, mul_s01, mul_s02, mul_s03,
+        mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed, n_dims, pos, freq_scale, ext_factor,
+        attn_factor, corr_dims, theta_scale, freq_factors, row_indices, set_rows_stride, is_neox, multi, sections, fwht_scale);
+}
+
+// [GGML_HIP_ATTN_PREP] the arguments of one rms_norm_mul_rope_f32 launch with the FWHT epilogue (one token)
+struct attn_prep_rope_args {
+    const float *   x;
+    float *         dst;
+    int             ncols;
+    int             nrows;
+    int             nchannels;
+    int             nsamples;
+    int64_t         s01, s02, s03, s1, s2, s3;
+    float           eps;
+    const float *   mul;
+    int64_t         mul_s01, mul_s02, mul_s03;
+    uint3           mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed;
+    int             n_dims;
+    const int32_t * pos;
+    float           freq_scale, ext_factor, attn_factor;
+    rope_corr_dims  corr_dims;
+    float           theta_scale;
+    const float *   freq_factors;
+    bool            is_neox;
+    int             multi;
+    mrope_sections  sections;
+    float           fwht_scale;
+};
+
+// [GGML_HIP_ATTN_PREP] a q8_0 SET_ROWS of one token row into the KV cache: dst row idx[0] (row stride nb1 bytes)
+struct attn_prep_set_rows_args {
+    char *          dst;
+    const int64_t * idx;
+    int64_t         nb1;
+};
+
+// The quantized blocks of values [N*head, N*(head + 1)) of the token row src into the cache row, one thread per block
+// as k_set_rows_quant does.
+template <int N>
+static __device__ __forceinline__ void attn_prep_set_rows_q8_0(const float * src, const attn_prep_set_rows_args & a, const int head) {
+    const int t = threadIdx.x;
+    if (t < N/QK8_0) {
+        block_q8_0 * dst_row = (block_q8_0 *) (a.dst + a.idx[0]*a.nb1);
+        quantize_f32_q8_0_block(src + N*head + QK8_0*t, dst_row + (N/QK8_0)*head + t);
+    }
+}
+
+// [GGML_HIP_ATTN_PREP] Single-token attention input preparation in one launch, block b:
+//   b <  q.nrows:                  q head b:  rms_norm*mul, rope and normalized FWHT (rms_norm_mul_rope_f32 with the FWHT
+//                                  epilogue, same code),
+//   b <  q.nrows + k.nrows:        k head:    the same, then the q8_0 SET_ROWS of the head's values into the K cache,
+//   else:                          v head:    the normalized FWHT of the row (fwht_row_warp by the first warp as
+//                                  fwht_cuda), then the q8_0 SET_ROWS into the V cache.
+// Every value is formed by the code of the kernels it replaces (rms_norm_mul_rope_f32 x2, fwht_cuda, k_set_rows_quant x2).
+template <bool has_ff, int N>
+__launch_bounds__(256, 1)
+static __global__ void attn_prep_f32(const attn_prep_rope_args q, const attn_prep_rope_args k,
+        const float * v_src, float * v_dst, const float v_scale,
+        const attn_prep_set_rows_args k_set, const attn_prep_set_rows_args v_set) {
+    extern __shared__ float s_sum[];
+    __shared__ float s_row[N];
+
+    int b = blockIdx.x;
+    if (b < q.nrows + k.nrows) {
+        const bool is_k = b >= q.nrows;
+        const attn_prep_rope_args & a = is_k ? k : q;
+        b -= is_k ? q.nrows : 0;
+        rms_norm_mul_rope_f32_rows<256, has_ff, float, N>(b, 0, 1, 0, 1, s_sum, s_row,
+            a.x, a.dst, a.ncols, a.nchannels, a.nsamples, a.s01, a.s02, a.s03, a.s1, a.s2, a.s3, a.eps, a.mul,
+            a.mul_s01, a.mul_s02, a.mul_s03, a.mul_ncols_packed, a.mul_nrows_packed, a.mul_nchannels_packed,
+            a.mul_nsamples_packed, a.n_dims, a.pos, a.freq_scale, a.ext_factor, a.attn_factor, a.corr_dims,
+            a.theta_scale, a.freq_factors, nullptr, 0, a.is_neox, a.multi, a.sections, a.fwht_scale);
+        if (is_k) {
+            // the FWHT output of the head was written by the first warp, the rows function ends with a barrier
+            attn_prep_set_rows_q8_0<N>(a.dst, k_set, b);
+        }
+        return;
+    }
+    b -= q.nrows + k.nrows;
+    if (threadIdx.x < WARP_SIZE) {
+        fwht_row_warp<N>(v_src + b*N, v_dst + b*N, v_scale, threadIdx.x);
+    }
+    __syncthreads();
+    attn_prep_set_rows_q8_0<N>(v_dst, v_set, b);
+}
