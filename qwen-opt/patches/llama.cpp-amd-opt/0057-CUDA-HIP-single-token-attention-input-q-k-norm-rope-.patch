diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 78699432f..e2757745a 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4476,6 +4476,139 @@ static int ggml_cuda_try_inproj_conv(ggml_backend_cuda_context * cuda_ctx, const
     return plan.mul_out_idx - i;
 }
 
+// RMS_NORM, MUL, ROPE, RESHAPE and the Hadamard MUL_MAT of a rotated KV cache (q/k rotation, see
+// llama_mul_mat_hadamard) at node i that ggml_cuda_op_rms_norm_mul_rope_fused runs as one launch (with fwht = nodes[i + 4])
+static bool ggml_cuda_match_rms_norm_mul_rope_fwht(const ggml_cgraph * cgraph, int i) {
+    if (i + 4 >= cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_RMS_NORM) {
+        return false;
+    }
+    const std::initializer_list<enum ggml_op> ops = {
+        GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ROPE, GGML_OP_RESHAPE, GGML_OP_MUL_MAT };
+    const ggml_tensor * node    = cgraph->nodes[i];
+    const ggml_tensor * mul     = cgraph->nodes[i + 1];
+    const ggml_tensor * rope    = cgraph->nodes[i + 2];
+    const ggml_tensor * reshape = cgraph->nodes[i + 3];
+    const ggml_tensor * mm      = cgraph->nodes[i + 4];
+    const int64_t n             = rope->ne[0];
+    if (ggml_can_fuse_subgraph(cgraph, i, ops, { i + 4 }) &&
+            (mul->src[0] == node || mul->src[1] == node) && reshape->src[0] == rope && mm->src[1] == reshape &&
+            ggml_cuda_should_fuse_rms_norm_mul_rope(node, mul, rope) && ggml_is_contiguous(rope) &&
+            ggml_cuda_op_mul_mat_use_fwht(mm) && mm->src[0]->ne[0] == n &&
+            (n == 64 || n == 128 || n == 256 || n == 512)) {
+        const int out_nodes[] = { i + 4 };
+        // the kernel reads a row of x completely before it writes that row of the output
+        return ggml_cuda_check_fusion_memory_ranges(cgraph, i, (int) ops.size(), out_nodes, 1, false, node->src[0]);
+    }
+    return false;
+}
+
+// [GGML_HIP_ATTN_PREP] single-token attention input of a rotated q8_0 KV cache: at the q norm+rope+FWHT group (node i)
+// the graph continues (views aside) with the V MUL_MAT, its Hadamard MUL_MAT (FWHT), the K MUL_MAT, the k
+// norm+rope+FWHT group and the SET_ROWS of k and v into the cache. The V and K MUL_MATs run first (as at their own
+// position), then one launch does both rope groups, the v FWHT and the two SET_ROWS (ggml_cuda_op_attn_prep); every
+// node after the q group is marked as computed ahead. Returns the nodes to skip, 0: no.
+static int ggml_cuda_try_attn_prep(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_ATTN_PREP");
+    if (!enabled || cuda_ctx->curr_stream_no != 0 || !cuda_ctx->stream_context().concurrent_events.empty() ||
+            !ggml_cuda_match_rms_norm_mul_rope_fwht(cgraph, i)) {
+        return 0;
+    }
+    // the compute nodes after the q group, in this order
+    int idx[6];
+    int n_found = 0;
+    int j = i + 5;
+    for (; j < cgraph->n_nodes && n_found < 6; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n) || !(n->flags & GGML_TENSOR_FLAG_COMPUTE)) {
+            continue;
+        }
+        idx[n_found++] = j;
+        if (n_found == 4) {
+            // the k group: 5 nodes, the last one is the k FWHT
+            if (!ggml_cuda_match_rms_norm_mul_rope_fwht(cgraph, j)) {
+                return 0;
+            }
+            j += 4;
+        }
+    }
+    if (n_found != 6) {
+        return 0;
+    }
+    ggml_tensor * q_fwht = cgraph->nodes[i + 4];
+    ggml_tensor * v_mm   = cgraph->nodes[idx[0]];
+    ggml_tensor * v_fwht = cgraph->nodes[idx[1]];
+    ggml_tensor * k_mm   = cgraph->nodes[idx[2]];
+    const int     kn     = idx[3];
+    ggml_tensor * k_fwht = cgraph->nodes[kn + 4];
+    ggml_tensor * k_set  = cgraph->nodes[idx[4]];
+    ggml_tensor * v_set  = cgraph->nodes[idx[5]];
+    const ggml_tensor * k_rope = cgraph->nodes[kn + 2];
+    const ggml_tensor * v_src  = v_fwht->src[1];
+    const auto is_view_of = [](const ggml_tensor * t, const ggml_tensor * of) {
+        for (; t != nullptr; t = t->view_src != nullptr ? t->view_src : (ggml_cuda_is_view_or_noop(t) ? t->src[0] : nullptr)) {
+            if (t == of) {
+                return true;
+            }
+        }
+        return false;
+    };
+    // V and K: single-token MMVQ matvecs of the input norm; v FWHT of V; the k group reads K; SET_ROWS of the FWHTs
+    if (v_mm->op != GGML_OP_MUL_MAT || k_mm->op != GGML_OP_MUL_MAT || v_fwht->op != GGML_OP_MUL_MAT ||
+            !ggml_cuda_op_mul_mat_use_fwht(v_fwht) || ggml_cuda_op_mul_mat_use_fwht(v_mm) || ggml_cuda_op_mul_mat_use_fwht(k_mm) ||
+            !is_view_of(v_src, v_mm) || v_src->data != v_mm->data || !is_view_of(cgraph->nodes[kn]->src[0], k_mm) ||
+            k_set->op != GGML_OP_SET_ROWS || v_set->op != GGML_OP_SET_ROWS ||
+            !is_view_of(k_set->src[0], k_fwht) || !is_view_of(v_set->src[0], v_fwht) ||
+            !ggml_cuda_attn_prep_supported(cgraph->nodes[i + 2], k_rope, v_src, k_set, v_set)) {
+        return 0;
+    }
+    // The V/K matvecs now run before the q group and all groups in one launch, while the allocator may have given a
+    // tensor of this region the memory of one that is dead by its position (e.g. K that of V, the k FWHT that of the
+    // q input). So V, K and the k/v FWHT outputs - read only by nodes of this region - go to scratch memory instead of
+    // their graph tensors; the q input and the q FWHT output are read/written row by row by the same block as in the
+    // rope launch. Every other reader of those four tensors (through views) rules the fusion out.
+    const ggml_tensor * internal[4] = { v_mm, k_mm, v_fwht, k_fwht };
+    const int region[] = { idx[1], kn, kn + 1, kn + 2, kn + 4, idx[4], idx[5] };
+    for (const ggml_tensor * t : internal) {
+        if (t->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return 0;
+        }
+    }
+    for (int n = i; n < cgraph->n_nodes; ++n) {
+        const ggml_tensor * node = cgraph->nodes[n];
+        if (ggml_cuda_is_view_or_noop(node) || std::find(std::begin(region), std::end(region), n) != std::end(region)) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC && node->src[s] != nullptr; ++s) {
+            const ggml_tensor * base = node->src[s]->view_src != nullptr ? node->src[s]->view_src : node->src[s];
+            if (std::find(std::begin(internal), std::end(internal), base) != std::end(internal)) {
+                return 0;
+            }
+        }
+    }
+    ggml_cuda_pool_alloc<float> scratch(cuda_ctx->pool(), ggml_nelements(v_mm) + ggml_nelements(k_mm) +
+                                        ggml_nelements(v_fwht) + ggml_nelements(k_fwht));
+    float * v_mm_d   = scratch.get();
+    float * k_mm_d   = v_mm_d + ggml_nelements(v_mm);
+    float * v_fwht_d = k_mm_d + ggml_nelements(k_mm);
+    float * k_fwht_d = v_fwht_d + ggml_nelements(v_fwht);
+    for (auto [mm, d] : { std::pair<ggml_tensor *, float *>{ v_mm, v_mm_d }, { k_mm, k_mm_d } }) {
+        ggml_tensor tmp = *mm;
+        tmp.data = d;
+        if (!ggml_cuda_compute_forward(*cuda_ctx, &tmp)) {
+            GGML_ABORT("%s: op not supported %s (%s)", __func__, mm->name, ggml_op_name(mm->op));
+        }
+        cuda_ctx->nodes_done_ahead.push_back(mm);
+    }
+    ggml_cuda_op_attn_prep(*cuda_ctx, cgraph->nodes[i], cgraph->nodes[i + 1], cgraph->nodes[i + 2], q_fwht,
+                           cgraph->nodes[kn], cgraph->nodes[kn + 1], k_rope, k_fwht, v_src, v_fwht, k_set, v_set,
+                           k_mm_d, k_fwht_d, v_mm_d, v_fwht_d);
+    // (the RESHAPE of the k group is a view, the evaluation loop passes over it)
+    for (ggml_tensor * t : { v_fwht, cgraph->nodes[kn], cgraph->nodes[kn + 1], cgraph->nodes[kn + 2], k_fwht, k_set, v_set }) {
+        cuda_ctx->nodes_done_ahead.push_back(t);
+    }
+    return 4;
+}
+
 // try and fuse nodes and return the number of nodes to skip; -1: this node is done and no other node is skipped
 // (it is elided because its result is never read, or a fusion computed it alone)
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
@@ -5265,25 +5398,15 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     // RMS_NORM + MUL + ROPE + the Hadamard MUL_MAT of a rotated KV cache (q/k rotation, see llama_mul_mat_hadamard):
     // one launch writes the transformed rows
-    if (node->op == GGML_OP_RMS_NORM && i + 4 < cgraph->n_nodes) {
-        const std::initializer_list<enum ggml_op> ops = {
-            GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ROPE, GGML_OP_RESHAPE, GGML_OP_MUL_MAT };
-        ggml_tensor * mul     = cgraph->nodes[i + 1];
-        ggml_tensor * rope    = cgraph->nodes[i + 2];
-        ggml_tensor * reshape = cgraph->nodes[i + 3];
-        ggml_tensor * mm      = cgraph->nodes[i + 4];
-        const int64_t n       = rope->ne[0];
-        if (ggml_can_fuse_subgraph(cgraph, i, ops, { i + 4 }) &&
-                (mul->src[0] == node || mul->src[1] == node) && reshape->src[0] == rope && mm->src[1] == reshape &&
-                ggml_cuda_should_fuse_rms_norm_mul_rope(node, mul, rope) && ggml_is_contiguous(rope) &&
-                ggml_cuda_op_mul_mat_use_fwht(mm) && mm->src[0]->ne[0] == n &&
-                (n == 64 || n == 128 || n == 256 || n == 512)) {
-            const int out_nodes[] = { i + 4 };
-            // the kernel reads a row of x completely before it writes that row of the output
-            if (ggml_cuda_check_fusion_memory_ranges(cgraph, i, (int) ops.size(), out_nodes, 1, false, node->src[0])) {
-                ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, mul, rope, nullptr, mm);
-                return (int) ops.size() - 1;
-            }
+    if (node->op == GGML_OP_RMS_NORM) {
+        const int nodes_to_skip = ggml_cuda_try_attn_prep(cuda_ctx, cgraph, i);
+        if (nodes_to_skip > 0) {
+            return nodes_to_skip;
+        }
+        if (ggml_cuda_match_rms_norm_mul_rope_fwht(cgraph, i)) {
+            ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2], nullptr,
+                                                 cgraph->nodes[i + 4]);
+            return 4;
         }
     }
 
diff --git a/ggml/src/ggml-cuda/rope.cu b/ggml/src/ggml-cuda/rope.cu
