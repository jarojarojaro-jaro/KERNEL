+
+// [GGML_HIP_ATTN_PREP] the arguments ggml_cuda_op_rms_norm_mul_rope_fused derives for its FWHT launch
+static attn_prep_rope_args attn_prep_fill_rope_args(const ggml_tensor * rms_norm, const ggml_tensor * mul,
+                                                    const ggml_tensor * rope, ggml_tensor * fwht) {
+    const ggml_tensor * x       = rms_norm->src[0];
+    const ggml_tensor * mul_src = mul->src[0] == rms_norm ? mul->src[1] : mul->src[0];
+
+    attn_prep_rope_args a;
+    memcpy(&a.eps, rms_norm->op_params, sizeof(float));
+    GGML_ASSERT(a.eps >= 0.0f);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && mul_src->type == GGML_TYPE_F32 && rope->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(rope) && ggml_is_contiguous(fwht) && fwht->type == GGML_TYPE_F32 &&
+                ggml_nelements(fwht) == ggml_nelements(rope));
+
+    const int n_dims     = ((const int32_t *) rope->op_params)[1];
+    const int mode       = ((const int32_t *) rope->op_params)[2];
+    const int n_ctx_orig = ((const int32_t *) rope->op_params)[4];
+    float freq_base;
+    float beta_fast;
+    float beta_slow;
+    memcpy(&freq_base,     (const int32_t *) rope->op_params +  5, sizeof(float));
+    memcpy(&a.freq_scale,  (const int32_t *) rope->op_params +  6, sizeof(float));
+    memcpy(&a.ext_factor,  (const int32_t *) rope->op_params +  7, sizeof(float));
+    memcpy(&a.attn_factor, (const int32_t *) rope->op_params +  8, sizeof(float));
+    memcpy(&beta_fast,     (const int32_t *) rope->op_params +  9, sizeof(float));
+    memcpy(&beta_slow,     (const int32_t *) rope->op_params + 10, sizeof(float));
+    a.multi   = mode == GGML_ROPE_TYPE_IMROPE ? 2 : mode == GGML_ROPE_TYPE_MROPE ? 1 : 0;
+    a.is_neox = (mode & GGML_ROPE_TYPE_NEOX) || a.multi != 0;
+    memcpy(&a.sections.v, (const int32_t *) rope->op_params + 11, sizeof(int)*4);
+    a.n_dims       = n_dims;
+    a.pos          = (const int32_t *) rope->src[1]->data;
+    a.freq_factors = rope->src[2] != nullptr ? (const float *) rope->src[2]->data : nullptr;
+    ggml_rope_yarn_corr_dims(n_dims, n_ctx_orig, freq_base, beta_fast, beta_slow, a.corr_dims.v);
+    a.theta_scale = powf(freq_base, -2.0f/n_dims);
+
+    const size_t ts0 = ggml_type_size(x->type);
+    GGML_ASSERT(x->nb[0] == ts0);
+    a.x         = (const float *) x->data;
+    a.ncols     = x->ne[0];
+    a.nrows     = x->ne[1];
+    a.nchannels = x->ne[2];
+    a.nsamples  = x->ne[3];
+    a.s01 = x->nb[1] / ts0;
+    a.s02 = x->nb[2] / ts0;
+    a.s03 = x->nb[3] / ts0;
+
+    const size_t ts_mul = ggml_type_size(mul_src->type);
+    GGML_ASSERT(mul_src->nb[0] == ts_mul);
+    a.mul     = (const float *) mul_src->data;
+    a.mul_s01 = mul_src->nb[1] / ts_mul;
+    a.mul_s02 = mul_src->nb[2] / ts_mul;
+    a.mul_s03 = mul_src->nb[3] / ts_mul;
+    a.mul_ncols_packed     = init_fastdiv_values(mul_src->ne[0]);
+    a.mul_nrows_packed     = init_fastdiv_values(mul_src->ne[1]);
+    a.mul_nchannels_packed = init_fastdiv_values(mul_src->ne[2]);
+    a.mul_nsamples_packed  = init_fastdiv_values(mul_src->ne[3]);
+
+    const size_t ts_dst = ggml_type_size(rope->type);
+    a.s1 = rope->nb[1] / ts_dst;
+    a.s2 = rope->nb[2] / ts_dst;
+    a.s3 = rope->nb[3] / ts_dst;
+
+    a.dst        = (float *) fwht->data;
+    a.fwht_scale = 1 / sqrtf(rope->ne[0]); // as ggml_cuda_op_fwht
+    return a;
+}
+
+bool ggml_cuda_attn_prep_supported(const ggml_tensor * q_rope, const ggml_tensor * k_rope, const ggml_tensor * v_src,
+                                   const ggml_tensor * k_set_rows, const ggml_tensor * v_set_rows) {
+    const int64_t n = q_rope->ne[0];
+    // one token (one channel/sample), heads of 64 values, contiguous rows, q8_0 caches with I64 row indices
+    const auto one_token = [&](const ggml_tensor * t) {
+        return t->ne[0] == n && t->ne[2] == 1 && t->ne[3] == 1 && ggml_is_contiguous(t);
+    };
+    return n == 64 && one_token(q_rope) && one_token(k_rope) && one_token(v_src) && v_src->type == GGML_TYPE_F32 &&
+           q_rope->ne[1] + k_rope->ne[1] + v_src->ne[1] <= 1024 &&
+           k_set_rows->type == GGML_TYPE_Q8_0 && v_set_rows->type == GGML_TYPE_Q8_0 &&
+           k_set_rows->src[1]->type == GGML_TYPE_I64 && v_set_rows->src[1]->type == GGML_TYPE_I64 &&
+           ggml_nelements(k_set_rows->src[1]) == 1 && ggml_nelements(v_set_rows->src[1]) == 1 &&
+           k_set_rows->ne[0] == k_rope->ne[0]*k_rope->ne[1] && v_set_rows->ne[0] == v_src->ne[0]*v_src->ne[1] &&
+           ggml_nelements(k_set_rows->src[0]) == k_set_rows->ne[0] && ggml_nelements(v_set_rows->src[0]) == v_set_rows->ne[0];
+}
+
+void ggml_cuda_op_attn_prep(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * q_norm, const ggml_tensor * q_mul, const ggml_tensor * q_rope, ggml_tensor * q_fwht,
+        const ggml_tensor * k_norm, const ggml_tensor * k_mul, const ggml_tensor * k_rope, ggml_tensor * k_fwht,
+        const ggml_tensor * v_src, ggml_tensor * v_fwht, ggml_tensor * k_set_rows, ggml_tensor * v_set_rows,
+        const float * k_x, float * k_out, const float * v_x, float * v_out) {
+    GGML_ASSERT(ggml_cuda_attn_prep_supported(q_rope, k_rope, v_src, k_set_rows, v_set_rows));
+    GGML_ASSERT(v_fwht->type == GGML_TYPE_F32 && ggml_is_contiguous(v_fwht) && ggml_nelements(v_fwht) == ggml_nelements(v_src));
+    const attn_prep_rope_args q = attn_prep_fill_rope_args(q_norm, q_mul, q_rope, q_fwht);
+    attn_prep_rope_args k = attn_prep_fill_rope_args(k_norm, k_mul, k_rope, k_fwht);
+    GGML_ASSERT(q.ncols == 64 && k.ncols == 64 && k.s1 == 64 && q.freq_factors == k.freq_factors);
+    // the SET_ROWS sources are the k / v FWHT outputs (views at offset 0)
+    GGML_ASSERT(k_set_rows->src[0]->data == k_fwht->data && v_set_rows->src[0]->data == v_fwht->data);
+    k.x   = k_x;
+    k.dst = k_out;
+
+    const attn_prep_set_rows_args k_set = { (char *) k_set_rows->data, (const int64_t *) k_set_rows->src[1]->data, (int64_t) k_set_rows->nb[1] };
+    const attn_prep_set_rows_args v_set = { (char *) v_set_rows->data, (const int64_t *) v_set_rows->src[1]->data, (int64_t) v_set_rows->nb[1] };
+
+    const int nblocks = q.nrows + k.nrows + (int) v_src->ne[1];
+    const ggml_cuda_kernel_launch_params launch_params = {dim3(nblocks, 1, 1), dim3(256, 1, 1), 32*sizeof(float), ctx.stream()};
+    const float v_scale = 1 / sqrtf(v_src->ne[0]); // as ggml_cuda_op_fwht
+    if (q.freq_factors == nullptr) {
+        ggml_cuda_kernel_launch(attn_prep_f32<false, 64>, launch_params, q, k, v_x, v_out, v_scale, k_set, v_set);
+    } else {
+        ggml_cuda_kernel_launch(attn_prep_f32<true, 64>, launch_params, q, k, v_x, v_out, v_scale, k_set, v_set);
+    }
+}
