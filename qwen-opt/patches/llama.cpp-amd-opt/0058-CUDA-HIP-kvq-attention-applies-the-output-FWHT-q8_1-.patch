+// [GGML_HIP_KVQ_FWHT] FLASH_ATTN_EXT followed (views aside) by the Hadamard MUL_MAT of its output (rotated V cache)
+// that only it reads: the kvq attention applies the FWHT (and writes the q8_1 copy for the next matvec) in its combine
+// launch. Returns the nodes to skip, 0: no.
+static int ggml_cuda_try_fa_fwht(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_KVQ_FWHT");
+    ggml_tensor * fa = cgraph->nodes[i];
+    if (!enabled || fa->op != GGML_OP_FLASH_ATTN_EXT || cuda_ctx->curr_stream_no != 0 ||
+            !cuda_ctx->stream_context().concurrent_events.empty() || (fa->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            !ggml_cuda_flash_attn_ext_fwht_supported(cuda_ctx->device, fa)) {
+        return 0;
+    }
+    int j = i + 1;
+    while (j < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[j])) {
+        ++j;
+    }
+    if (j >= cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * fwht = cgraph->nodes[j];
+    if (!ggml_cuda_op_mul_mat_use_fwht(fwht) || fwht->src[1]->data != fa->data || fwht->src[0]->ne[0] != fa->ne[0] ||
+            ggml_nelements(fwht) != ggml_nelements(fa) || fwht->src[1]->type != GGML_TYPE_F32 ||
+            (fwht->src[1]->view_src != nullptr && fwht->src[1]->view_src != fa) ||
+            (fwht->src[1]->view_src == nullptr && fwht->src[1] != fa) || (fwht->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    // the attention output and the FWHT output may not overlap (the combine reads the former while writing the latter)
