 // FlashAttention for RDNA3 (gfx110x) that reads a q4_0 or q8_0 KV cache directly, intended for small batches (decode and
 // speculative verify). The Q columns of a K/V head - tokens x GQA heads, flattened into one column index - are
@@ -580,8 +581,63 @@ static __global__ void flash_attn_ext_kvq(
 #endif // FATTN_KVQ_AVAILABLE
 }
 
+// [GGML_HIP_KVQ_FWHT] combine launch that also applies the normalized FWHT to each output row (the Hadamard MUL_MAT of
+// a rotated V cache that follows the attention, see ggml_cuda_op_mul_mat_use_fwht) and writes its q8_1 copy (q8 may
+// be nullptr): the row as flash_attn_combine_results, its FWHT as fwht_cuda (fwht_row_warp by the first warp), the
+// q8_1 blocks as the quantize_q8_1 kernel (quantize_q8_1_group).
+template <int D>
+__launch_bounds__(D, 1)
+static __global__ void flash_attn_kvq_combine_fwht(
+        const float * __restrict__ VKQ_parts, const float2 * __restrict__ VKQ_meta, float * __restrict__ dst,
+        const int parallel_blocks, float * __restrict__ fwht_dst, block_q8_1 * __restrict__ q8, const float fwht_scale) {
+    static_assert(D % WARP_SIZE == 0 && D % QK8_1 == 0, "bad D");
+    const int j   = (blockIdx.z*gridDim.x + blockIdx.x)*gridDim.y + blockIdx.y; // as flash_attn_combine_results
+    const int tid = threadIdx.x;
+
+    extern __shared__ float2 meta[]; // parallel_blocks float2, then the D values of the row
+    float * row = (float *) (meta + parallel_blocks);
+    const float v = flash_attn_combine_results_value<D>(VKQ_parts, VKQ_meta, meta, parallel_blocks, j, tid);
+    dst[j*D + tid] = v;
+    row[tid] = v;
+    __syncthreads();
+    if (tid < WARP_SIZE) {
+        fwht_row_warp<D>(row, fwht_dst + j*D, fwht_scale, tid);
+        if (q8 != nullptr) {
+#pragma unroll
+            for (int i = 0; i < D/WARP_SIZE; ++i) {
+                // the value this lane just wrote
+                quantize_q8_1_group(fwht_dst[j*D + i*WARP_SIZE + tid], q8 + (j*D + i*WARP_SIZE)/QK8_1, tid);
+            }
+        }
+    }
+}
+
+// The number of KV splits (blocks along y) and the KV units (nwarps*16 rows) per split.
+template <int nwarps>
+static int ggml_cuda_fattn_kvq_nsplit(const ggml_tensor * dst, const int nsm, int & units_per_split) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const int gqa_ratio   = Q->ne[2] / K->ne[2];
+    const int ncols_total = Q->ne[1] * gqa_ratio;
+    const int ntiles_x    = (ncols_total + fattn_kvq_ncols - 1) / fattn_kvq_ncols;
+    const int nblocks_z   = K->ne[2] * Q->ne[3];
+
+    // Split the KV sequence so that there are 2 blocks per SM (WGP), fewer longer blocks reduce the overhead of
+    // combining the results. q8_0: 1 block per WGP, the twice as large K/V rows saturate the memory with fewer streams
+    // (LFM2 decode, D 64, 8 KV heads, in the model: 129 us at 98k context with 1 block per WGP, 147 us with 2 or 3,
+    // 162 us with 8 splits = unbalanced; 32k: 47 vs 53 us).
+    const int kv_unit = nwarps*fattn_kvq_nkv;
+    const int nunits  = K->ne[1] / kv_unit;
+    const int blocks_per_sm = K->type == GGML_TYPE_Q8_0 ? 1 : 2;
+    int nsplit = std::max(1, blocks_per_sm*nsm / (ntiles_x*nblocks_z));
+    nsplit = std::min(nsplit, nunits);
+    units_per_split = (nunits + nsplit - 1) / nsplit;
+    return (nunits + units_per_split - 1) / units_per_split;
+}
