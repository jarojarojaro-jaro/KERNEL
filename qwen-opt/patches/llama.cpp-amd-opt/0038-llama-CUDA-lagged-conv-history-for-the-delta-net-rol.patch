+ggml_tensor * llm_build_delta_net_base::build_conv_state_lag(
+        llm_graph_input_rs * inp,
+        ggml_tensor *        conv_states_all,
+        ggml_tensor *        qkv_mixed,
+        int64_t              conv_kernel_size,
+        int64_t              conv_channels,
+        int                  il) {
+    const auto * mctx_cur = inp->mctx;
+
+    const int64_t n_st   = conv_kernel_size - 1;
+    const int64_t n_t    = qkv_mixed->ne[1];
+    const int64_t K      = (int64_t) cparams.n_rs_seq + 1;
+    const size_t  el     = ggml_element_size(conv_states_all);
+    const size_t  row0   = (size_t) mctx_cur->get_head() * conv_states_all->nb[1];
+
+    // one sequence in one cell (rs_lag), whose row holds K + n_st time steps of conv_channels values
+    GGML_ASSERT(ubatch.n_seqs == 1 && inp->s_lag != nullptr);
+    GGML_ASSERT(conv_states_all->ne[0] == (K + n_st) * conv_channels);
+
+    // a new sequence starts from a zero history, read at row 0 (its kept pending row count is 0, see set_input_lag)
+    const int32_t rs_zero = mctx_cur->get_rs_z();
+    ggml_tensor * hist_zero = ggml_view_1d(ctx0, conv_states_all, n_st*conv_channels*(rs_zero >= 0),
+            (size_t) rs_zero*conv_states_all->nb[1]*(rs_zero >= 0));
+    ggml_build_forward_expand(gf, ggml_scale_inplace(ctx0, hist_zero, 0));
+
+    // the history after the n_keep kept pending rows of the previous ubatch: time steps n_keep .. n_keep + n_st - 1
+    // of the row (llm_graph_input_rs::s_conv_idx, from the GATED_DELTA_NET_LAG lag info)
+    if (inp->s_conv_idx == nullptr) {
+        inp->s_conv_idx = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_st);
+        ggml_set_input(inp->s_conv_idx);
+        ggml_set_name(inp->s_conv_idx, "rs_conv_idx");
+    }
+    GGML_ASSERT(inp->s_conv_idx->ne[0] == n_st);
+    ggml_tensor * steps = ggml_view_2d(ctx0, conv_states_all, conv_channels, K + n_st, conv_channels*el, row0);
+    ggml_tensor * conv_states = ggml_get_rows(ctx0, steps, inp->s_conv_idx); // [conv_channels, n_st]
+    conv_states = ggml_transpose(ctx0, ggml_reshape_3d(ctx0, conv_states, conv_channels, n_st, 1));
+    cb(conv_states, "conv_states", il);
+
+    qkv_mixed = ggml_transpose(ctx0, qkv_mixed);
+    cb(qkv_mixed, "qkv_mixed_transposed", il);
+
+    ggml_tensor * conv_input = ggml_concat(ctx0, conv_states, qkv_mixed, 0);
+    cb(conv_input, "conv_input", il);
+
+    // new row: the history before this ubatch's P pending rows, then those rows ([TAG_RECURRENT_ROLLBACK_SPLITS]:
+    // they are the last P tokens of the sequence in the batch)
+    const int64_t P   = std::min(n_t, K);
+    const int64_t n_w = P + n_st;
+    ggml_tensor * hist_new = ggml_view_2d(ctx0, conv_input, n_w, conv_channels, conv_input->nb[1],
+            ggml_row_size(conv_input->type, n_t - P));
+    ggml_tensor * row_new = ggml_view_2d(ctx0, conv_states_all, conv_channels, n_w, conv_channels*el, row0);
+    ggml_build_forward_expand(gf, ggml_cpy(ctx0, ggml_transpose(ctx0, hist_new), row_new));
+
+    return conv_input;
+}
