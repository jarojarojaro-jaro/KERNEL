 ggml/src/ggml-cuda/ssm-conv.cu  | 100 ++++++++++++-
 ggml/src/ggml-cuda/ssm-conv.cuh |  21 ++-
 tests/test-backend-ops.cpp      |  80 +++++++++++
 4 files changed, 437 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index c15f66532..27412afb1 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3588,6 +3588,19 @@ static bool ggml_cuda_collect_readers(const ggml_cgraph * cgraph, int ti, int wi
     return found == ggml_node_get_use_count(cgraph, ti);
 }
 
+static bool ggml_cuda_tensors_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    const char * a0 = (const char *) a->data;
+    const char * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+// the GET_ROWS of a single recurrent-state row: (states [n, rows], s_copy[1]) with the gathered row read in place
+static bool ggml_cuda_is_state_row_gather(const ggml_tensor * rows) {
+    return rows->op == GGML_OP_GET_ROWS && rows->type == GGML_TYPE_F32 && rows->src[0]->type == GGML_TYPE_F32 &&
+           rows->src[1]->type == GGML_TYPE_I32 && ggml_nelements(rows->src[1]) == 1 && ggml_is_contiguous(rows->src[0]) &&
+           ggml_is_contiguous(rows) && rows->ne[1] == 1 && rows->ne[2] == 1 && rows->ne[3] == 1;
+}
+
 // the GET_ROWS gather of the initial recurrent state, when every reader is a GDN that reads the row in place
 static bool ggml_cuda_gdn_state_gather_elided(const ggml_cgraph * cgraph, int i) {
     const ggml_tensor * node = cgraph->nodes[i];
@@ -3606,10 +3619,203 @@ static bool ggml_cuda_gdn_state_gather_elided(const ggml_cgraph * cgraph, int i)
     return true;
 }
 
+// SSM_CONV over CONCAT(conv_state, transpose(x)) whose conv-state windows are also CPYd into the recurrent cache
+// (build_conv_state): one fused kernel reads the CONCAT sources directly (the conv state through the gather index
+// when it is a single gathered row) and writes the snapshot windows, so the CONCAT, the CPYs and the gather need
+// not run (see ggml_cuda_ssm_conv_fused_src).
+struct ggml_cuda_ssm_conv_plan {
+    int                          concat_idx;
+    int                          n_fused;  // nodes after the SSM_CONV fused into it (SILU, or ADD + SILU)
+    ggml_tensor *                bias_add;
+    ggml_tensor *                silu;
+    const ggml_tensor *          gather;   // GET_ROWS read through its index, or nullptr
+    std::array<int, SSM_CONV_FUSED_MAX_SNAPSHOTS> cpy_idx;
+    ggml_cuda_ssm_conv_fused_src src;
+};
+
+static bool ggml_cuda_ssm_conv_cache_plan(const ggml_cgraph * cgraph, int conv_idx, ggml_cuda_ssm_conv_plan & plan) {
+    const ggml_tensor * conv = cgraph->nodes[conv_idx];
+    if (conv->op != GGML_OP_SSM_CONV || conv->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * C = conv->src[0];
+    const ggml_tensor * W = conv->src[1];
+    if (C->op != GGML_OP_CONCAT || ggml_get_op_params_i32(C, 0) != 0 || C->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(C) || C->ne[2] != 1 || C->ne[3] != 1) {
+        return false;
+    }
+    const int64_t d_conv = W->ne[0];
+    const int64_t n_st   = d_conv - 1;
+    const int64_t nr     = C->ne[1];
+    const int64_t n_t    = C->ne[0] - n_st;
+    if (!ggml_cuda_ssm_conv_fused_supported(d_conv, nr, n_t) || n_t < 1 || conv->ne[1] != n_t) {
+        return false;
+    }
+
+    plan.bias_add = nullptr;
+    plan.silu     = nullptr;
+    plan.n_fused  = 0;
+    if (ggml_cuda_can_fuse(cgraph, conv_idx, { GGML_OP_SSM_CONV, GGML_OP_ADD, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU })) {
+        plan.bias_add = cgraph->nodes[conv_idx + 1];
+        plan.silu     = cgraph->nodes[conv_idx + 2];
+        plan.n_fused  = 2;
+    } else if (ggml_cuda_can_fuse(cgraph, conv_idx, { GGML_OP_SSM_CONV, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU })) {
+        plan.silu    = cgraph->nodes[conv_idx + 1];
+        plan.n_fused = 1;
+    }
+    const ggml_tensor * out = plan.silu ? plan.silu : conv;
+
+    // sources: the conv state [n_st, nr] and the new inputs, element (t, channel) at x + t*nb0 + channel*nb1
+    const ggml_tensor * S = C->src[0];
+    const ggml_tensor * X = C->src[1];
+    if (S->type != GGML_TYPE_F32 || S->ne[0] != n_st || S->ne[1] != nr || S->ne[2] != 1 || !ggml_is_contiguous(S) ||
+            X->type != GGML_TYPE_F32 || X->ne[0] != n_t || X->ne[1] != nr || X->ne[2] != 1 ||
+            X->nb[1] != sizeof(float) || X->nb[0] % sizeof(float) != 0) {
+        return false;
+    }
+
+    plan.concat_idx = -1;
+    for (int j = conv_idx - 1; j >= std::max(0, conv_idx - 64); --j) {
+        if (cgraph->nodes[j] == C) {
+            plan.concat_idx = j;
+            break;
+        }
+    }
+    if (plan.concat_idx < 0) {
+        return false;
+    }
+
+    // every reader of the CONCAT: this SSM_CONV, and CPYs of [n_st, nr] windows into contiguous cache rows
+    std::vector<ggml_cuda_reader> readers;
+    if (!ggml_cuda_collect_readers(cgraph, plan.concat_idx, conv_idx - plan.concat_idx, readers)) {
+        return false;
+    }
+    ggml_cuda_ssm_conv_fused_src & src = plan.src;
+    src.n_snap = 0;
+    bool conv_found = false;
+    for (const ggml_cuda_reader & r : readers) {
+        const ggml_tensor * n = cgraph->nodes[r.idx];
+        if (r.idx == conv_idx) {
+            conv_found = r.src == 0 && r.via == C;
+            if (!conv_found) {
+                return false;
+            }
+            continue;
+        }
+        const ggml_tensor * v   = r.via;
+        const ggml_tensor * dst = n->src[1];
+        // (readers of the CPY result before the SSM_CONV are rejected by the cache-row check below)
+        if (n->op != GGML_OP_CPY || r.src != 0 || v->op != GGML_OP_VIEW || v->view_src != C ||
+                v->ne[0] != n_st || v->ne[1] != nr || v->ne[2] != 1 || v->ne[3] != 1 || v->nb[1] != C->nb[1] ||
+                v->view_offs % sizeof(float) != 0 || v->view_offs / sizeof(float) + n_st > (size_t) C->ne[0] ||
+                dst->type != GGML_TYPE_F32 || !ggml_is_contiguous(dst) || ggml_nelements(dst) != n_st*nr ||
+                src.n_snap == SSM_CONV_FUSED_MAX_SNAPSHOTS) {
+            return false;
+        }
+        plan.cpy_idx[src.n_snap]  = r.idx;
+        src.snap_t0[src.n_snap]  = (int) (v->view_offs / sizeof(float));
+        src.snap_dst[src.n_snap] = (float *) dst->data;
+        src.n_snap++;
+    }
+    if (!conv_found) {
+        return false;
+    }
+
+    // the conv state is read in place when it is a single gathered row
+    plan.gather = nullptr;
+    if (S->view_src && S->view_offs == 0 && ggml_cuda_is_state_row_gather(S->view_src) &&
+            ggml_nelements(S) == S->view_src->ne[0]) {
+        plan.gather          = S->view_src;
+        src.state            = (const float *) plan.gather->src[0]->data;
+        src.state_idx        = (const int32_t *) plan.gather->src[1]->data;
+        src.state_row_stride = plan.gather->src[0]->nb[1] / sizeof(float);
+    } else {
+        src.state            = (const float *) S->data;
+        src.state_idx        = nullptr;
+        src.state_row_stride = 0;
+    }
+    src.x        = (const float *) X->data;
+    src.x_stride = X->nb[0] / sizeof(float);
+
+    // The sources are now read when the SSM_CONV runs instead of when the CONCAT runs: nothing in between may have
+    // written them (their buffers may have been reused once the CONCAT was done), and nothing in between may read
+    // the cache rows the CPYs would have written already.
+    // The output may take over the buffer of x once the CONCAT is done. That is fine when element (t, channel) of
+    // both is at the same address, since each thread reads its channel's inputs before writing any output.
+    const bool out_aliases_x = out->data == X->data && out->nb[0] == X->nb[1] && out->nb[1] == X->nb[0];
+    if ((!out_aliases_x && ggml_cuda_tensors_overlap(out, X)) || (!plan.gather && ggml_cuda_tensors_overlap(out, S))) {
+        return false;
+    }
+    for (int k = plan.concat_idx + 1; k < conv_idx; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(n) || std::find(plan.cpy_idx.begin(), plan.cpy_idx.begin() + src.n_snap, k) !=
+                plan.cpy_idx.begin() + src.n_snap) {
+            continue;
+        }
+        if (!ggml_cuda_gdn_state_gather_elided(cgraph, k) &&
+                (ggml_cuda_tensors_overlap(n, X) || (!plan.gather && ggml_cuda_tensors_overlap(n, S)))) {
+            return false;
+        }
+        for (int s = 0; s < GGML_MAX_SRC && n->src[s]; ++s) {
+            for (int c = 0; c < src.n_snap; ++c) {
+                const ggml_tensor * dst = cgraph->nodes[plan.cpy_idx[c]]->src[1];
+                const ggml_tensor * root_n = n->src[s]->view_src ? n->src[s]->view_src : n->src[s];
+                const ggml_tensor * root_d = dst->view_src ? dst->view_src : dst;
+                if (root_n == root_d) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+// the SSM_CONV consumer of a CONCAT among the next nodes, if its cache plan folds the CONCAT
+static bool ggml_cuda_ssm_conv_plan_for_concat(const ggml_cgraph * cgraph, int concat_idx, ggml_cuda_ssm_conv_plan & plan) {
+    const ggml_tensor * C = cgraph->nodes[concat_idx];
+    for (int j = concat_idx + 1; j < std::min(cgraph->n_nodes, concat_idx + 65); ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_SSM_CONV && n->src[0] == C) {
+            return ggml_cuda_ssm_conv_cache_plan(cgraph, j, plan) && plan.concat_idx == concat_idx;
+        }
+    }
+    return false;
+}
+
+// a GET_ROWS of one recurrent-state row whose readers (GDN initial state, CONCAT of a fused SSM_CONV) all read
+// the row from the cache themselves
+static bool ggml_cuda_state_gather_elided(const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (!ggml_cuda_is_state_row_gather(node)) {
+        return false;
+    }
+    std::vector<ggml_cuda_reader> readers;
+    if (!ggml_cuda_collect_readers(cgraph, i, 64, readers) || readers.empty()) {
+        return false;
+    }
+    for (const ggml_cuda_reader & r : readers) {
+        const ggml_tensor * n = cgraph->nodes[r.idx];
+        if (n->op == GGML_OP_GATED_DELTA_NET) {
+            if (r.src != 5 || ggml_cuda_gdn_state_gather(n) != node) {
+                return false;
+            }
+        } else if (n->op == GGML_OP_CONCAT) {
+            ggml_cuda_ssm_conv_plan plan;
+            if (r.src != 0 || !ggml_cuda_ssm_conv_plan_for_concat(cgraph, r.idx, plan) || plan.gather != node) {
+                return false;
+            }
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
