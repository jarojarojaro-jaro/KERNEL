 //  - the RMS_NORM and SCALE of build_gdn_l2_norm(q/k) when their only consumer is such a GDN;
 //  - the GET_ROWS gather of the initial recurrent state when only that GDN reads it.
+//  - the CONCAT, conv-state CPYs and conv-state gather of build_conv_state that a fused SSM_CONV takes over.
 static bool ggml_cuda_gdn_prologue_elided(const ggml_cgraph * cgraph, int i) {
     const ggml_tensor * node = cgraph->nodes[i];
 
@@ -3640,7 +3846,26 @@ static bool ggml_cuda_gdn_prologue_elided(const ggml_cgraph * cgraph, int i) {
     }
 
     if (node->op == GGML_OP_GET_ROWS) {
-        return ggml_cuda_gdn_state_gather_elided(cgraph, i);
+        return ggml_cuda_state_gather_elided(cgraph, i);
+    }
+
+    if (node->op == GGML_OP_CONCAT) {
+        ggml_cuda_ssm_conv_plan plan;
+        return ggml_cuda_ssm_conv_plan_for_concat(cgraph, i, plan);
+    }
+
+    if (node->op == GGML_OP_CPY && node->src[0]->op == GGML_OP_VIEW && node->src[0]->view_src &&
+            node->src[0]->view_src->op == GGML_OP_CONCAT) {
+        // the plan accounts for every reader of the CONCAT, this CPY included
+        const ggml_tensor * C = node->src[0]->view_src;
+        for (int j = i + 1; j < std::min(cgraph->n_nodes, i + 65); ++j) {
+            const ggml_tensor * n = cgraph->nodes[j];
+            if (n->op == GGML_OP_SSM_CONV && n->src[0] == C) {
