+// Single-sequence SSM_CONV that reads its input straight from the two CONCAT sources (conv state, possibly through
+// the gather index, and the new inputs) and also writes the conv-state snapshot windows the replaced CPYs would
+// copy. Each thread owns one channel and reads all of its inputs before writing anything, so a snapshot may
+// overwrite the cache row the state is read from and dst may alias x element for element (hence no __restrict__
+// on dst). The convolution arithmetic is that of ssm_conv_f32.
+template <bool apply_silu, size_t split_d_inner, size_t d_conv>
+static __global__ void ssm_conv_fused_f32(const ggml_cuda_ssm_conv_fused_src src, const float * __restrict__ w_ptr,
+                                          const float * __restrict__ bias, const int w_nb1, float * dst,
+                                          const int dst_nb1, const int n_t) {
+    constexpr int n_state = d_conv - 1;
+    constexpr int L       = n_state + SSM_CONV_FUSED_MAX_TOKENS;
+
+    const int c = blockIdx.y * split_d_inner + threadIdx.x;
+
+    const float * w_row = (const float *) ((const char *) w_ptr + c * w_nb1);
+    float w[d_conv];
+#pragma unroll
+    for (int j = 0; j < (int) d_conv; j++) {
+        w[j] = w_row[j];
+    }
+    const float b = bias != nullptr ? bias[c] : 0.0f;
+
+    const float * s_row = src.state_idx ? src.state + src.state_idx[0] * src.state_row_stride : src.state;
+    float xs[L];
+#pragma unroll
+    for (int k = 0; k < n_state; k++) {
+        xs[k] = s_row[c * n_state + k];
+    }
+#pragma unroll
+    for (int t = 0; t < SSM_CONV_FUSED_MAX_TOKENS; t++) {
+        xs[n_state + t] = t < n_t ? src.x[t * src.x_stride + c] : 0.0f;
+    }
+
+    for (int s = 0; s < src.n_snap; s++) {
+        const int t0 = src.snap_t0[s];
+        float *   d  = src.snap_dst[s] + c * n_state;
+#pragma unroll
+        for (int k = 0; k < n_state; k++) {
+            // register select instead of a dynamic index into xs (which would spill to scratch)
+            float v = 0.0f;
+#pragma unroll
+            for (int tau = 0; tau < L; tau++) {
+                v = tau == t0 + k ? xs[tau] : v;
+            }
+            d[k] = v;
+        }
+    }
+
+    const int stride_y = dst_nb1 / sizeof(float);
+#pragma unroll
+    for (int t = 0; t < SSM_CONV_FUSED_MAX_TOKENS; t++) {
+        if (t < n_t) {
+            float sumf = 0.0f;
+#pragma unroll
+            for (int j = 0; j < (int) d_conv; j++) {
+                sumf += xs[t + j] * w[j];
+            }
+            sumf += b;
+            dst[t * stride_y + c] = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+        }
+    }
+}
+
+template <bool apply_silu>
+static void ssm_conv_fused_f32_cuda(const ggml_cuda_ssm_conv_fused_src & src, const float * w, const float * bias,
+                                    const int w_nb1, float * dst, const int dst_nb0, const int dst_nb1,
+                                    const int64_t nc, const int64_t nr, const int64_t n_t, cudaStream_t stream) {
+    const int threads = 128;
+    GGML_ASSERT(nr % threads == 0);
+    GGML_ASSERT(dst_nb0 == sizeof(float));
+    GGML_ASSERT(n_t <= SSM_CONV_FUSED_MAX_TOKENS && src.n_snap <= SSM_CONV_FUSED_MAX_SNAPSHOTS);
+    const dim3 blocks(1, nr / threads, 1);
+    auto launch_kernel = [&](auto NC) {
+        constexpr int kNC = decltype(NC)::value;
+        ssm_conv_fused_f32<apply_silu, threads, kNC><<<blocks, threads, 0, stream>>>(src, w, bias, w_nb1, dst, dst_nb1, (int) n_t);
+    };
+    switch (nc) {
+        case 3:  launch_kernel(std::integral_constant<int, 3 >{}); break;
+        case 4:  launch_kernel(std::integral_constant<int, 4 >{}); break;
+        case 5:  launch_kernel(std::integral_constant<int, 5 >{}); break;
+        default: GGML_ABORT("fused ssm_conv supports kernel sizes 3, 4, 5");
+    }
+}
+
+bool ggml_cuda_ssm_conv_fused_supported(const int64_t d_conv, const int64_t nr, const int64_t n_t) {
+    return d_conv >= 3 && d_conv <= 5 && nr % 128 == 0 && n_t <= SSM_CONV_FUSED_MAX_TOKENS;
+}
