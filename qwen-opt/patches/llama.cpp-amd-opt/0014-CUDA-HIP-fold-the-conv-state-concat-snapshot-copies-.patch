index 1463169cf..79cd82831 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -123,6 +123,94 @@ static __global__ void ssm_conv_long_token_f32(const float * __restrict__ src0,
