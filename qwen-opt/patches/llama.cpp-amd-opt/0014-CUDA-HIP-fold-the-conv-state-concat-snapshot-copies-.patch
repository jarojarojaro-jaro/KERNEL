+        GGML_UNUSED(t);
+        return "SSM_CONV_CACHE_FUSION";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    test_ssm_conv_cache_fusion(int64_t d_conv = 4, int64_t d_inner = 256, int64_t n_t = 5, int64_t K = 5)
+        : d_conv(d_conv), d_inner(d_inner), n_t(n_t), K(K) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t n_st     = d_conv - 1;
+        const int64_t mem_size = 2;
+        const int64_t head     = 1;
+        const int64_t row      = n_st * d_inner;
+
+        ggml_tensor * cache = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, row, mem_size * K);
+        ggml_tensor * idx   = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+        ggml_set_name(idx, "idx");
+        ggml_tensor * rows        = ggml_get_rows(ctx, cache, idx);
+        ggml_tensor * conv_states = ggml_reshape_3d(ctx, rows, n_st, d_inner, 1);
+
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_inner, n_t);
+        ggml_tensor * conv_input = ggml_concat(ctx, conv_states, ggml_transpose(ctx, x), 0);
+
+        ggml_tensor * w    = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, d_inner);
+        ggml_tensor * conv = ggml_silu(ctx, ggml_ssm_conv(ctx, conv_input, w));
+
+        // snapshot windows, as in build_conv_state (slot K - t gets the window ending t tokens before the end).
+        // out = concat(cpy_K, concat(..., concat(cpy_1, conv))) puts every CPY before the SSM_CONV and every reader
+        // of the CPYd rows after it, as in the model graph.
+        ggml_tensor * out = ggml_reshape_1d(ctx, conv, ggml_nelements(conv));
+        for (int64_t t = 1; t <= K; ++t) {
+            const int64_t s_idx  = std::max<int64_t>(0, conv_input->ne[0] - n_st - K + t);
+            const int64_t s_slot = K - t;
+            ggml_tensor * src = ggml_view_3d(ctx, conv_input, n_st, d_inner, 1, conv_input->nb[1], conv_input->nb[2],
+                                             ggml_row_size(conv_input->type, s_idx));
+            ggml_tensor * dst = ggml_view_2d(ctx, cache, row, 1, cache->nb[1], (s_slot * mem_size + head) * cache->nb[1]);
+            ggml_tensor * cpy = ggml_reshape_1d(ctx, ggml_cpy(ctx, src, dst), row);
+            out = ggml_concat(ctx, cpy, out, 0);
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (strcmp(t->name, "idx") == 0) {
