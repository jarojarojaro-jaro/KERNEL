+    // n_max greedy draft tokens in one decode of the MTP draft chain graph: same tokens and draft KV as n_max
+    // single-token passes that each take the argmax of the previous one (p_min <= 0 never stops a greedy draft early)
+    void draft_greedy_chain(llama_seq_id seq_id, common_speculative_draft_params & dp) {
+        auto * ctx_dft = params.ctx_dft;
+
+        batch.clear();
+        for (int32_t j = 0; j < params.n_max; ++j) {
+            // rows j > 0 only carry their position: the graph feeds pass j from pass j-1
+            const int32_t idx = batch.add(dp.id_last, dp.pos0 + j, seq_id, false);
+            batch.set_embd(idx, { pending_h[seq_id].data(), 1, (size_t) n_embd });
+        }
+
+        llama_set_mtp_draft_chain(ctx_dft, true);
+        const int32_t ret = llama_process(ctx_dft, LLAMA_PROCESS_TYPE_DECODE, batch.get());
+        llama_set_mtp_draft_chain(ctx_dft, false);
+
+        if (ret != 0) {
+            SPC_ERR("llama_process (draft chain) returned %d\n", ret);
+            return;
+        }
+
+        int32_t n_out = 0;
+        const llama_token * ids = llama_get_mtp_draft_tokens(ctx_dft, &n_out);
+        GGML_ASSERT(n_out == params.n_max);
+
+        dp.result->insert(dp.result->end(), ids, ids + n_out);
+    }
+
     void accept(llama_seq_id seq_id, uint16_t n_accepted, bool /*is_other*/) override {
