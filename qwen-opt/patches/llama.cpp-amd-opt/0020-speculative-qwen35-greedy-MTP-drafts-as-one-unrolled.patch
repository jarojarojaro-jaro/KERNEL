+// inputs are normally host tensors that are written in place; a device-resident input (e.g. the MTP draft chain, which
+// slices the rows of its inputs per pass) is written to a staging buffer and uploaded
+template <typename T>
+static T * input_data(ggml_tensor * dst, std::vector<T> & staging) {
+    if (ggml_backend_buffer_is_host(dst->buffer)) {
+        return (T *) dst->data;
+    }
+    staging.resize(ggml_nbytes(dst)/sizeof(T));
+    return staging.data();
+}
+
+template <typename T>
+static void input_upload(ggml_tensor * dst, const std::vector<T> & staging) {
+    if (!staging.empty()) {
+        ggml_backend_tensor_set(dst, staging.data(), 0, ggml_nbytes(dst));
+    }
+}
