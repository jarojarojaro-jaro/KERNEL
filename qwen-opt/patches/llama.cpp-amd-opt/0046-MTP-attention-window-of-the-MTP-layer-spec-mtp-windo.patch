+    // the start of the first block of blk cells among the first n cells that holds a cell at a position > thr
+    // (thr >= -1, so empty cells never count); n if there is none
+    uint32_t first_block_pos_gt(llama_pos thr, uint32_t blk, uint32_t n) const {
+        assert(thr >= -1);
+        n = std::min(n, (uint32_t) pos.size());
+
+        for (uint32_t i0 = 0; i0 < n; i0 += blk) {
+            const uint32_t i1 = std::min(n, i0 + blk);
+
+            llama_pos m = -1;
+            for (uint32_t i = i0; i < i1; ++i) {
+                m = std::max(m, pos[i]);
+            }
+            if (m > thr) {
+                return i0;
+            }
+        }
+
+        return n;
+    }
+
     const llama_kv_cell_ext & ext_get(uint32_t i) const {
