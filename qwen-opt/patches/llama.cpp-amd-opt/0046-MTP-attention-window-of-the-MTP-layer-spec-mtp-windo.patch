+uint32_t llama_kv_cache::get_attn_window() const {
+    return n_win;
+}
+
+uint32_t llama_kv_cache::get_kv_beg(const slot_info & sinfo, const llama_ubatch & ubatch, uint32_t n_kv) const {
+    if (n_win == 0 || swa_type != LLAMA_SWA_TYPE_NONE || sinfo.n_stream() != 1 || ubatch.n_tokens == 0) {
+        return 0;
+    }
+
+    llama_pos p_min = ubatch.pos[0];
+    for (uint32_t i = 1; i < ubatch.n_tokens; ++i) {
+        p_min = std::min(p_min, ubatch.pos[i]);
+    }
+
+    // a cell at p0 <= thr is outside the window of every token of the ubatch (empty cells hold -1)
+    const llama_pos thr = p_min - (llama_pos) n_win;
+    if (thr < 0) {
+        return 0;
+    }
+
+    // views stay aligned to the 256-cell padding of n_kv, so the graph changes only when a block is crossed
+    const uint32_t blk = 256;
+    const uint32_t res = v_cells[sinfo.strm[0]].first_block_pos_gt(thr, blk, n_kv);
+
+    return res < n_kv ? res : 0;
+}
