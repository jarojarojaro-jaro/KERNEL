From c36fd2c87bca9b3bc0fe60557f6b79142c666dbd Mon Sep 17 00:00:00 2001
From: jarojarojaro-jaro <miki.jaroszek@gmail.com>
Date: Thu, 15 Oct 2026 00:26:45 +0000
Subject: [PATCH 65/65] server: LLAMA_SERVER_REASONING_CONTROL=0 ignores the
 client reasoning_control flag (the web UI always sends true, which forces the
 full-vocabulary sampling path); LFM UI-style request 255 -> 291 t/s

---
 tools/server/server-context.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 7f26d27aa..1fbbcc117 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -4841,6 +4841,18 @@ std::unique_ptr<server_res_generator> server_routes::handle_completions_impl(
 
             task.params.message_spans = task.tokens.find_message_spans(delimiters);
 
+            // [LLAMA_SERVER_REASONING_CONTROL=0] ignore the client's reasoning_control: the web UI always sends true,
+            // which arms the reasoning-budget sampler (and with it the full-vocabulary sampling path) on every request
+            {
+                static const bool allow_reasoning_control = [] {
+                    const char * env = getenv("LLAMA_SERVER_REASONING_CONTROL");
+                    return !env || atoi(env) != 0;
+                }();
+                if (!allow_reasoning_control) {
+                    task.params.sampling.reasoning_control = false;
+                }
+            }
+
             task.id_slot = json_value(data, "id_slot", -1);
             sse_ping_interval = task.params.sse_ping_interval;
 
-- 
