@@ -2540,13 +2551,103 @@ static void ggml_backend_cuda_free(ggml_backend_t backend) {
     delete backend;
 }
 
+// [GGML_HIP_INPUT_BATCH] the segments of one batch flush: segment s copies size[s] bytes from the device staging
+// buffer at off[s] to dst[s]
+struct ggml_cuda_h2d_scatter_args {
+    char *   dst[ggml_backend_cuda_context::h2d_batch_t::max_segs];
+    uint32_t off[ggml_backend_cuda_context::h2d_batch_t::max_segs];
+    uint32_t size[ggml_backend_cuda_context::h2d_batch_t::max_segs];
+};
+
+// block (s, c) copies chunk c (h2d_scatter_chunk bytes) of segment s
+static constexpr uint32_t ggml_cuda_h2d_scatter_chunk = 8192;
+
+static __global__ void ggml_cuda_h2d_scatter(const char * __restrict__ src, const ggml_cuda_h2d_scatter_args a) {
+    const uint32_t c0  = blockIdx.y*ggml_cuda_h2d_scatter_chunk;
+    const uint32_t n   = a.size[blockIdx.x];
+    if (c0 >= n) {
+        return;
+    }
+    const uint32_t c1  = min(n, c0 + ggml_cuda_h2d_scatter_chunk);
+    char *         dst = a.dst[blockIdx.x];
+    const char *   s   = src + a.off[blockIdx.x];
+    if ((((uintptr_t) dst) | n) % 16 == 0) { // s is 16-byte aligned
+        for (uint32_t i = c0 + 16*threadIdx.x; i < c1; i += 16*blockDim.x) {
+            *(int4 *) (dst + i) = *(const int4 *) (s + i);
+        }
+    } else {
+        for (uint32_t i = c0 + threadIdx.x; i < c1; i += blockDim.x) {
+            dst[i] = s[i];
+        }
+    }
+}
+
+// [GGML_HIP_INPUT_BATCH] issue the staged uploads: one H2D copy of the staging half, one scatter launch
+static void ggml_cuda_h2d_batch_flush(ggml_backend_cuda_context * ctx) {
+    auto & b = ctx->h2d_batch;
+    if (b.n == 0) {
+        return;
+    }
+    using batch_t = ggml_backend_cuda_context::h2d_batch_t;
+    ggml_cuda_set_device(ctx->device);
+    cudaStream_t stream = b.stream;
+    char * host = b.host + b.half*batch_t::half_size;
+    char * dev  = b.dev  + b.half*batch_t::half_size;
+    CUDA_CHECK(cudaMemcpyAsync(dev, host, b.used, cudaMemcpyHostToDevice, stream));
+    CUDA_CHECK(cudaEventRecord(b.done[b.half], stream));
+    ggml_cuda_h2d_scatter_args args;
+    uint32_t max_size = 0;
+    for (int s = 0; s < b.n; ++s) {
+        args.dst[s]  = b.dst[s];
+        args.off[s]  = b.off[s];
+        args.size[s] = b.size[s];
+        max_size     = std::max(max_size, b.size[s]);
+    }
+    const uint32_t nchunks = std::max(1u, (max_size + ggml_cuda_h2d_scatter_chunk - 1) / ggml_cuda_h2d_scatter_chunk);
+    ggml_cuda_h2d_scatter<<<dim3(b.n, nchunks, 1), 256, 0, stream>>>(dev, args);
+    CUDA_CHECK(cudaGetLastError());
+    b.half ^= 1;
+    b.used  = 0;
+    b.n     = 0;
+}
+
 static void ggml_backend_cuda_set_tensor_async(ggml_backend_t backend, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
 
-    CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
+    // [GGML_HIP_INPUT_BATCH] stage small uploads (the host data is copied now, as an async copy would read it later)
+    static const bool input_batch = ggml_cuda_env_switch("GGML_HIP_INPUT_BATCH");
+    using batch_t = ggml_backend_cuda_context::h2d_batch_t;
+    auto & b = cuda_ctx->h2d_batch;
+    cudaStream_t stream = cuda_ctx->stream();
+    if (input_batch && size > 0 && size <= batch_t::max_seg_size) {
+        if (b.n > 0 && (b.stream != stream || b.n == batch_t::max_segs || b.used + size > batch_t::half_size)) {
+            ggml_cuda_h2d_batch_flush(cuda_ctx);
+        }
+        if (b.host == nullptr) {
+            CUDA_CHECK(cudaMallocHost((void **) &b.host, 2*batch_t::half_size));
+            CUDA_CHECK(cudaMalloc((void **) &b.dev, 2*batch_t::half_size));
+            for (cudaEvent_t & e : b.done) {
+                CUDA_CHECK(cudaEventCreateWithFlags(&e, cudaEventDisableTiming));
+            }
+        }
+        if (b.n == 0) {
+            // the previous copy out of this half of the host staging buffer must be done
+            CUDA_CHECK(cudaEventSynchronize(b.done[b.half]));
+            b.stream = stream;
+        }
+        memcpy(b.host + b.half*batch_t::half_size + b.used, data, size);
+        b.dst[b.n]  = (char *) tensor->data + offset;
+        b.off[b.n]  = (uint32_t) b.used;
+        b.size[b.n] = (uint32_t) size;
+        b.n++;
+        b.used = GGML_PAD(b.used + size, 16);
+        return;
+    }
+    ggml_cuda_h2d_batch_flush(cuda_ctx);
+    CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, stream));
 }
 
