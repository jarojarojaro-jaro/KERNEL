     GGML_UNUSED(backend);
@@ -5826,6 +5933,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
