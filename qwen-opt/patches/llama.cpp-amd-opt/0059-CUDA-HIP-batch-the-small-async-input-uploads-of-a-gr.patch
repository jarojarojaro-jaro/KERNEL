--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1540,6 +1540,25 @@ struct ggml_backend_cuda_context {
     std::string name;
     cudaEvent_t copy_event = nullptr;
 
+    // [GGML_HIP_INPUT_BATCH] small set_tensor_async uploads (the graph inputs of a decode step) are staged in pinned host
+    // memory and written by one H2D copy plus one scatter kernel when the next other stream operation is issued
+    // (ggml_cuda_h2d_batch_flush). Two halves, each reused after the event of its last copy.
+    struct h2d_batch_t {
+        static constexpr int    max_segs     = 64;
+        static constexpr size_t max_seg_size = 256*1024;
+        static constexpr size_t half_size    = 2*1024*1024;
+        char *      host     = nullptr; // pinned, 2*half_size
+        char *      dev      = nullptr; // device, 2*half_size
+        cudaEvent_t done[2]  = { nullptr, nullptr };
+        int         half     = 0;
+        cudaStream_t stream  = nullptr; // of the staged uploads
+        size_t      used     = 0;
+        int         n        = 0;
+        char *      dst[max_segs];
+        uint32_t    off[max_segs];
+        uint32_t    size[max_segs];
+    } h2d_batch;
+
     cudaStream_t streams[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = { { nullptr } };
     cublasHandle_t cublas_handles[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {nullptr};
     void * cublas_workspaces[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {nullptr};
