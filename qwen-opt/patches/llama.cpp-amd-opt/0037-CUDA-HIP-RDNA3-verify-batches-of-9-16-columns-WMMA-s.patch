+// RDNA3 (gfx110x) WMMA kernel for dense MUL_MAT with few src1 columns (speculative-decoding verify batches).
+//
+// A wave computes a 16 (weight rows) x 16 (src1 columns, zero-padded) tile with v_wmma_i32_16x16x16_iu8 on the q8_1
+// activations of the MMVQ path, so the int8 dot products of all columns cost one WMMA per 16x16x16 instead of one
+// dp4a per 4 values and column. A = activations (row m = column of src1), B = dequantized weights (column n = weight
+// row). gfx11 executes it as two independent halves (see fattn-kvq.cu): lanes 0-15 produce the even rows of D from
+// the A rows of the even lanes 0-14 and their own copy of B, lanes 16-31 the odd rows from the A rows of the odd lanes
+// 17-31 and theirs. Within each half A and B only have to agree on the order of the 16 reduction values. So every
+// lane loads the 16 values of one half (h = lane/16) of a 32-value sub-block of its own row/column (lane%16): the first
+// WMMA of a sub-block takes them as they are (lower half: values 0-15, upper half: 16-31), the second one after a
+// v_permlanex16 swap of the halves. No lane holds a duplicate.
+//
+// D (int32, per sub-block): lane l holds weight row l%16 for src1 columns 2i + l/16 (i = 0..7). It is scaled in
+// float with the per-row sub-block scale/min (lane constants) and the q8_1 scale/sum of the column, which each lane
+// loads for its own column and gets for the 8 columns of its D values with ds_bpermute.
+// The K range of a 16-row tile is split over the waves of a block (super-block interleaved), reduced in shared memory.
+#if defined(GGML_USE_HIP) && defined(RDNA3_0)
+#define MMVQ_WMMA_AVAILABLE
+#endif
+
+static bool mmvq_wmma_use(const ggml_type type, const int cc, const int64_t ncols_dst) {
+    return GGML_CUDA_CC_IS_RDNA3_0(cc) && mmvq_wmma_has_type(type) &&
+           ncols_dst >= mmvq_wmma_min_ncols(type) && ncols_dst <= MMVQ_MAX_BATCH_SIZE_WIDE;
+}
+
+#if defined(GGML_USE_HIP)
+#define MMVQ_WMMA_LAUNCH_BOUNDS(nthreads) \
+    __attribute__((amdgpu_flat_work_group_size(1, nthreads), amdgpu_waves_per_eu(MMVQ_WMMA_MIN_WAVES)))
+#else
+#define MMVQ_WMMA_LAUNCH_BOUNDS(nthreads) __launch_bounds__(nthreads, 1)
+#endif
+
+#ifdef MMVQ_WMMA_AVAILABLE
+typedef int mmvq_wmma_i4 __attribute__((ext_vector_type(4)));
+typedef int mmvq_wmma_i8 __attribute__((ext_vector_type(8)));
+
+static __device__ __forceinline__ int mmvq_wmma_swap_halves(const int x) {
+    return __builtin_amdgcn_permlanex16(x, x, 0x76543210u, 0xFEDCBA98u, false, false);
+}
+
+// D = A_y * B_x over one 32-value sub-block: a/b are this lane's halves, the second WMMA uses the other lane half's.
+static __device__ __forceinline__ mmvq_wmma_i8 mmvq_wmma_sub_block(const mmvq_wmma_i4 a, const mmvq_wmma_i4 b) {
+    mmvq_wmma_i8 d = {0, 0, 0, 0, 0, 0, 0, 0};
+    d = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(true, a, true, b, d, false);
+    mmvq_wmma_i4 as;
+    mmvq_wmma_i4 bs;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        as[k] = mmvq_wmma_swap_halves(a[k]);
+        bs[k] = mmvq_wmma_swap_halves(b[k]);
+    }
+    return __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(true, as, true, bs, d, false);
+}
+
+// IQ4_NL/IQ4_XS: the 16 values of lane half h of a 32-value block from its 16 qs bytes (low nibbles: values 0-15,
+// high nibbles: 16-31), looked up in kvalues_iq4nl
+static __device__ __forceinline__ mmvq_wmma_i4 mmvq_wmma_iq4_lut(const int4 q4, const int h) {
+    const uint32_t * tab = (const uint32_t *) kvalues_iq4nl;
+    const int q4v[4] = {q4.x, q4.y, q4.z, q4.w};
+    mmvq_wmma_i4 b;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const uint32_t qn  = (uint32_t) q4v[k] >> 4*h;
+        const uint32_t idx = qn & 0x07070707;
+        const uint32_t vlo = __builtin_amdgcn_perm(tab[1], tab[0], idx);
+        const uint32_t vhi = __builtin_amdgcn_perm(tab[3], tab[2], idx);
+        b[k] = __builtin_amdgcn_perm(vhi, vlo, 0x03020100 | ((qn & 0x08080808) >> 1));
+    }
+    return b;
+}
+
+// As mmvq_wmma_sub_block, but the two halves of the sub-block in separate results (Q6_K: one scale per 16 values):
+// d1 = this lane half's values, d2 = the other half's.
+static __device__ __forceinline__ void mmvq_wmma_sub_block2(const mmvq_wmma_i4 a, const mmvq_wmma_i4 b,
+                                                            mmvq_wmma_i8 & d1, mmvq_wmma_i8 & d2) {
+    const mmvq_wmma_i8 z = {0, 0, 0, 0, 0, 0, 0, 0};
+    d1 = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(true, a, true, b, z, false);
+    mmvq_wmma_i4 as;
+    mmvq_wmma_i4 bs;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        as[k] = mmvq_wmma_swap_halves(a[k]);
+        bs[k] = mmvq_wmma_swap_halves(b[k]);
+    }
+    d2 = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(true, as, true, bs, z, false);
+}
+#endif // MMVQ_WMMA_AVAILABLE
+
+// grid: (16-row tiles of the matrix [+ of the pair matrix], channels of dst, samples of dst), block: (32, nwaves)
+template <ggml_type type, int nwaves>
+MMVQ_WMMA_LAUNCH_BOUNDS(nwaves*32)
+static __global__ void mul_mat_vec_q_wmma(
+        const void * __restrict__ vx, const void * __restrict__ vy, const float * __restrict__ bias, float * __restrict__ dst,
+        const ggml_cuda_mm_fusion_args_device fusion, const int ncols_x, const int nrows_x, const int stride_row_x,
+        const int stride_col_y, const int stride_col_dst, const int ncols_dst,
+        const int channel_ratio, const int stride_channel_x, const int stride_channel_y, const int stride_channel_dst,
+        const int sample_ratio, const int stride_sample_x, const int stride_sample_y, const int stride_sample_dst) {
+#ifdef MMVQ_WMMA_AVAILABLE
+    const int lane = threadIdx.x;
+    const int w    = threadIdx.y;
+    const int r    = lane % 16;
+    const int h    = lane / 16;
+
+    // pair launch: the blocks past the first matrix compute the second one (same type, K and src1)
+    int block_x    = blockIdx.x;
+    int nrows      = nrows_x;
+    int stride_dst = stride_col_dst;
+    if (fusion.pair_x != nullptr && uint32_t(block_x) >= fusion.pair_block0) {
+        block_x   -= fusion.pair_block0;
+        vx         = fusion.pair_x;
+        dst        = fusion.pair_dst;
+        nrows      = fusion.pair_nrows;
+        stride_dst = fusion.pair_nrows;
+    }
+    const int row0 = 16*block_x;
+
+    constexpr int      bs  = ggml_cuda_type_traits<type>::bs;
+    constexpr uint32_t qbs = sizeof(block_q8_1);
+
+    const int channel = blockIdx.y;
+    const int sample  = blockIdx.z;
+    const size_t dst_off = size_t(sample)*stride_sample_dst + size_t(channel)*stride_channel_dst;
+    dst += dst_off;
+    if (bias != nullptr) {
+        bias += dst_off;
+    }
+
+    const mmvq_src xs = mmvq_make_src((const char *) vx +
+        (size_t(sample/sample_ratio)*stride_sample_x + size_t(channel/channel_ratio)*stride_channel_x + size_t(row0)*stride_row_x)*bs);
+    const uint32_t xoff = uint32_t((min(row0 + r, nrows - 1) - row0)*stride_row_x*bs); // rows past the end re-read the last one
+
+    // q8_1 activations: this lane's column (columns past ncols_dst re-read the last one, their results are not stored)
+    const mmvq_src ys = mmvq_make_src((const char *) vy + (size_t(sample)*stride_sample_y + size_t(channel)*stride_channel_y)*qbs);
+    const uint32_t ycol = uint32_t(min(r, ncols_dst - 1)*stride_col_y)*qbs;
+
+    float acc[8] = {0.0f};
+
+    // ds_bpermute byte address of the lane that loaded the q8_1 scale of column 2i + h of the sub-block of parity j
+    const auto ysrc = [h](const int i, const int j) { return 4*(2*i + h + 16*j); };
+
