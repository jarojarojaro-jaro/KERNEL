-static constexpr __host__ __device__ int calc_rows_per_block(int ncols_dst, int table_id, bool small_k = false, int nwarps = 1, ggml_type type = GGML_TYPE_COUNT) {
+// [GGML_HIP_MMVQ_N1_ROWS] RDNA3 one-column launches of the K-quants: 2 rows per block (one wave computes two rows, each
+// with the lanes and partial-sum order of the one-row kernel, so the results are bitwise the same): more weight loads
+// in flight per wave and the activation loads shared by the two rows. Measured faster than one row per block on every
+// LFM2.5-24B-A2B launch size in sum (512-row k/v up to the 128000-row head), and than 2 rows only for >= 4096 blocks.
+// GGML_HIP_MMVQ_N1_ROWS=0: one row per block; =1|2|4: that many (for measurements).
+static constexpr bool mmvq_n1_rows_type(ggml_type type) {
+    return type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K;
+}
+static int mmvq_n1_rows(const int64_t nrows_x) {
+    static const int rows = [] {
+        const char * env = getenv("GGML_HIP_MMVQ_N1_ROWS");
+        const int forced = env ? atoi(env) : 2;
+        return forced == 2 || forced == 4 ? forced : 1;
+    }();
+    return nrows_x % rows == 0 ? rows : 1;
+}
+
+// n1_rows: rows per block of an RDNA3 ncols_dst == 1 launch when > 0 (GGML_HIP_MMVQ_N1_ROWS, see mmvq_n1_rows)
+static constexpr __host__ __device__ int calc_rows_per_block(int ncols_dst, int table_id, bool small_k = false, int nwarps = 1, ggml_type type = GGML_TYPE_COUNT, int n1_rows = 0) {
+    if (ncols_dst == 1 && n1_rows > 0) {
+        return n1_rows;
+    }
     if (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_GCN || table_id == MMVQ_PARAMETERS_TURING || table_id == MMVQ_PARAMETERS_GB10) {
         switch (ncols_dst) {
             case 1:
@@ -1445,7 +1466,9 @@ static constexpr __host__ __device__ bool mmvq_r3_pipeline(ggml_type type, int n
 
 // bias_only: the fused epilogue only adds x_bias (no gate/GLU, no scales), so multi-column launches don't pay for the
 // gate accumulators. This is what lets ncols_dst > 1 take a residual/bias ADD without the register pressure of gate fusion.
-template <ggml_type type, int ncols_dst, bool has_fusion, bool small_k = false, bool halve_iters = false, bool bias_only = false>
+// n1_rows: rows per block of an ncols_dst == 1 launch (0: the table's), each row with the same lanes and order of partial
