+    // swiglu that also writes the q8_1 activations of the MUL_MAT consuming it
+    if (node->op == GGML_OP_GLU && ggml_get_glu_op(node) == GGML_GLU_OP_SWIGLU && node->type == GGML_TYPE_F32) {
+        if (block_q8_1 * q8 = ggml_cuda_q8_1_producer_target(cuda_ctx, cgraph, i)) {
+            ggml_cuda_op_swiglu(*cuda_ctx, node, q8);
+            return -1;
+        }
+    }
+
     return 0;
 }
 
