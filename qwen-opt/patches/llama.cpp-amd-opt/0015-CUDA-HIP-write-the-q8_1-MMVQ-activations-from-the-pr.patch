     return (int) ops.size() - 1;
 }
 
+// For a producer whose F32 output is node out_idx (an RMS_NORM*MUL, GLU or UNARY*MUL kernel): when a MUL_MAT among
+// the next nodes reads that output (directly or through a contiguous view at offset 0) as src1 and will run MMVQ on
+// it, returns the q8_1 cache buffer for the producer to also write the quantized activations into, and records the
+// cache entry this creates (committed by the graph loop once the producer's own writes are accounted for).
+// The consumer then skips its quantize_q8_1 launch. Returns nullptr when the producer should only write F32.
+static block_q8_1 * ggml_cuda_q8_1_producer_target(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int out_idx) {
+    const ggml_tensor * out = cgraph->nodes[out_idx];
+    auto & qc = ctx->mmvq_q8_cache;
+    if (qc.buf == nullptr || ctx->curr_stream_no != 0 || !ctx->stream_context().concurrent_events.empty() ||
+            out->type != GGML_TYPE_F32 || !ggml_is_contiguous(out) || ggml_nelements(out) % QK8_1 != 0) {
+        return nullptr;
+    }
+    const ggml_tensor * mm = nullptr;
+    for (int j = out_idx + 1; j < std::min(cgraph->n_nodes, out_idx + 33) && mm == nullptr; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_MUL_MAT && (n->src[1] == out || n->src[1]->view_src == out)) {
+            mm = n;
+        }
+    }
+    if (mm == nullptr) {
+        return nullptr;
+    }
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    const int cc = ggml_cuda_info().devices[ctx->device].cc;
+    const bool bad_padding_clear = ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+                                   ggml_nbytes(src0) != ggml_backend_buffer_get_alloc_size(src0->buffer, src0) && src0->view_src;
+    // the q8_1 rows of src1 must be the flat q8_1 blocks of out: no row padding, same data
+    if (src1->data != out->data || !ggml_is_contiguous(src1) || ggml_nelements(src1) != ggml_nelements(out) ||
+            src1->ne[0] % MATRIX_ROW_PADDING != 0 || !ggml_is_quantized(src0->type) || bad_padding_clear ||
+            mm->type != GGML_TYPE_F32 || ggml_cuda_op_mul_mat_use_fwht(mm) ||
+            !ggml_cuda_should_use_mmvq(src0->type, cc, src1->ne[1]) ||
+            ggml_nelements(src1) / QK8_1 * sizeof(block_q8_1) > qc.buf_size) {
+        return nullptr;
+    }
+
+    qc.src = nullptr; // the producer overwrites the buffer
+    auto & p = ctx->mmvq_q8_pending;
+    p.valid     = true;
+    p.src       = src1->data;
+    p.src_bytes = ggml_nbytes(src1);
+    for (int k = 0; k < 4; ++k) {
+        p.ne[k] = src1->ne[k];
+        p.nb[k] = src1->nb[k];
+    }
+    return (block_q8_1 *) qc.buf;
+}
