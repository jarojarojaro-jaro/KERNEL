-    void mmvq_q8_cache_invalidate() { mmvq_q8_cache.src = nullptr; }
+    // Entry for q8_1 data a producer kernel (norm, GLU, unary*mul) wrote into buf alongside its F32 output for the
+    // MUL_MAT that consumes it. It becomes the cache entry once the producer's own writes have been accounted for
+    // by mmvq_q8_cache_invalidate_if_written (see the graph evaluation loop).
+    struct {
+        bool         valid = false;
+        const void * src = nullptr;
+        int64_t      ne[4] = {0, 0, 0, 0};
+        size_t       nb[4] = {0, 0, 0, 0};
+        size_t       src_bytes = 0;
+    } mmvq_q8_pending;
+
+    void mmvq_q8_cache_invalidate() {
+        mmvq_q8_cache.src = nullptr;
+        mmvq_q8_pending.valid = false;
+    }
+
+    void mmvq_q8_cache_commit_pending() {
+        if (!mmvq_q8_pending.valid) {
+            return;
+        }
+        mmvq_q8_cache.src       = mmvq_q8_pending.src;
+        mmvq_q8_cache.src_bytes = mmvq_q8_pending.src_bytes;
+        for (int k = 0; k < 4; ++k) {
+            mmvq_q8_cache.ne[k] = mmvq_q8_pending.ne[k];
+            mmvq_q8_cache.nb[k] = mmvq_q8_pending.nb[k];
+        }
+        mmvq_q8_pending.valid = false;
+    }
 
     void mmvq_q8_cache_invalidate_if_written(const ggml_tensor * t) {
         if (mmvq_q8_cache.src == nullptr || t->data == nullptr) {
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 27412afb1..aba90c508 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
