diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 195e4458f..c5f79af29 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -533,6 +533,25 @@ static __device__ __forceinline__ float warp_reduce_max(float x) {
     return x;
 }
 
+// Quantizes a block_q8_1 from 32 consecutive lanes holding its 32 values in order (lane % 32 == iqs), exactly as
+// the quantize_q8_1 kernel does. Lets an elementwise producer write the q8_1 copy of its output for MMVQ.
+// All 32 lanes of the group must be active.
+static __device__ __forceinline__ void quantize_q8_1_group(const float xi, block_q8_1 * y, const int iqs) {
+    float amax = fabsf(xi);
+    float sum  = xi;
+
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+
+    y->qs[iqs] = q;
+    if (iqs == 0) {
+        y->ds = make_half2(d, sum);
+    }
+}
+
 template<typename T, int width = WARP_SIZE>
 static __device__ __forceinline__ T warp_prefix_inclusive_sum(T x) {
     const int lane_id = threadIdx.x % width;
@@ -1526,7 +1545,34 @@ struct ggml_backend_cuda_context {
         size_t       buf_size = 0;
