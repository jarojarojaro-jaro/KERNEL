+// [GGML_HIP_INPROJ_CONV] LFM2 shortconv, one token: the in_proj MUL_MAT and the fused SSM_CONV of its output (with
+// both MULs folded, GGML_HIP_CONV_MUL, writing the q8_1 copy for out_proj) in one launch (ggml_cuda_mmvq_conv): the
+// conv of each 32-channel group runs as the tail of the in_proj block that completes the group. Every node between
+// the MUL_MAT and the folded output MUL runs no kernel. Returns the nodes to skip, 0: no.
+static int ggml_cuda_try_inproj_conv(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_INPROJ_CONV");
+    ggml_tensor * mm = cgraph->nodes[i];
+    if (!enabled || mm->op != GGML_OP_MUL_MAT || cuda_ctx->curr_stream_no != 0 ||
+            !cuda_ctx->stream_context().concurrent_events.empty()) {
+        return 0;
+    }
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    if (!ggml_is_quantized(src0->type) || src0->ne[2] != 1 || src0->ne[3] != 1 || src1->type != GGML_TYPE_F32 ||
+            ggml_nrows(src1) != 1 || src1->nb[0] != sizeof(float) || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm)) {
+        return 0;
+    }
+    // the MUL_MAT as the unfused graph runs it: plain MMVQ, one column (see ggml_cuda_mul_mat)
+    const int  cc = ggml_cuda_info().devices[cuda_ctx->device].cc;
+    const bool bad_padding_clear = ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+        ggml_nbytes(src0) != ggml_backend_buffer_get_alloc_size(src0->buffer, src0) && src0->view_src;
+    if (bad_padding_clear || ggml_cuda_op_mul_mat_use_fwht(mm) || !ggml_cuda_should_use_mmvq(src0->type, cc, 1)) {
+        return 0;
+    }
+    int conv_idx = -1;
+    for (int j = i + 1; j < std::min(cgraph->n_nodes, i + 33); ++j) {
+        if (cgraph->nodes[j]->op == GGML_OP_SSM_CONV) {
+            conv_idx = j;
+            break;
+        }
+    }
+    ggml_cuda_ssm_conv_plan plan;
+    if (conv_idx < 0 || !ggml_cuda_ssm_conv_cache_plan(cgraph, conv_idx, plan) || plan.mul_out == nullptr ||
+            plan.silu != nullptr || plan.bias_add != nullptr) {
+        return 0;
+    }
+    const ggml_tensor * conv   = cgraph->nodes[conv_idx];
+    const ggml_tensor * conv_w = conv->src[1];
+    const int64_t       d_conv = conv_w->ne[0];
+    const int64_t       nr     = conv->src[0]->ne[1];
+    const int64_t       n_t    = conv->src[0]->ne[0] - (d_conv - 1);
+    if (n_t != 1 || mm->ne[0] != 3*nr || plan.mul_out->nb[1] != nr*(int64_t) sizeof(float) ||
+            !ggml_cuda_mmvq_conv_supported(src0->type, src0->ne[0], src0->ne[1], nr, d_conv)) {
+        return 0;
+    }
+    // x, x2 and gate of the conv are the three nr-row sections of the MUL_MAT output
+    bool section_used[3] = { false, false, false };
+    for (const float * p : { plan.src.x, plan.src.x2, plan.src.gate }) {
+        const ptrdiff_t off = p - (const float *) mm->data;
+        if (p == nullptr || off < 0 || off % nr != 0 || off / nr >= 3 || section_used[off / nr]) {
+            return 0;
+        }
+        section_used[off / nr] = true;
+    }
+    for (int k = i + 1; k < plan.mul_out_idx; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (k != conv_idx && !ggml_cuda_is_view_or_noop(n) && (n->flags & GGML_TENSOR_FLAG_COMPUTE) &&
+                !ggml_cuda_gdn_prologue_elided(cgraph, k)) {
+            return 0;
+        }
+    }
+    unsigned int * tickets = ggml_cuda_tickets(cuda_ctx);
+    if (tickets == nullptr) {
+        return 0;
+    }
+    plan.src.q8 = ggml_cuda_q8_1_producer_target(cuda_ctx, cgraph, plan.mul_out_idx);
+    ggml_cuda_mmvq_conv(*cuda_ctx, src0, src1, mm, plan.src, (const float *) conv_w->data, (int) conv_w->nb[1], d_conv,
+                        (float *) plan.mul_out->data, (int) plan.mul_out->nb[1], tickets);
+    return plan.mul_out_idx - i;
+}
