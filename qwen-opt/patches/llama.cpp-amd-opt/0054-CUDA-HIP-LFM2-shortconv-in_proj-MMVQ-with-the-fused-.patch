+// LFM2 shortconv block, one token: in_proj MUL_MAT -> b, c, x views -> b*x -> transpose -> concat with the conv state
+// -> SSM_CONV -> c*conv -> out_proj MUL_MAT (in_proj and the fused conv in one launch by the HIP backend,
+// GGML_HIP_INPROJ_CONV)
+struct test_shortconv : public test_case {
+    const ggml_type type;
+    const int64_t   n_embd;
+    const int64_t   nr;
+    const int64_t   d_conv;
+
+    std::string vars() override { return VARS_TO_STR4(type, n_embd, nr, d_conv); }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "SHORTCONV";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    // two chained matmuls on q8_1 activations (random data reaches ~5e-4 with or without the fusion)
+    double max_nmse_err() override {
+        return 1e-3;
+    }
+
+    test_shortconv(ggml_type type = GGML_TYPE_Q5_K, int64_t n_embd = 2048, int64_t nr = 2048, int64_t d_conv = 3)
+        : type(type), n_embd(n_embd), nr(nr), d_conv(d_conv) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, 1);
+        ggml_set_name(x, "x");
+        ggml_tensor * in_proj = ggml_new_tensor_2d(ctx, type, n_embd, 3*nr);
+        ggml_set_name(in_proj, "in_proj");
+        ggml_tensor * bcx = ggml_mul_mat(ctx, in_proj, x); // [3*nr, 1]
+        ggml_set_name(bcx, "bcx");
+        ggml_tensor * b  = ggml_view_2d(ctx, bcx, nr, 1, bcx->nb[1], 0);
+        ggml_tensor * c  = ggml_view_2d(ctx, bcx, nr, 1, bcx->nb[1], nr*sizeof(float));
+        ggml_tensor * xv = ggml_view_2d(ctx, bcx, nr, 1, bcx->nb[1], 2*nr*sizeof(float));
+        ggml_tensor * bx = ggml_mul(ctx, b, xv);
+        ggml_set_name(bx, "bx");
+        ggml_tensor * state = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv - 1, nr);
+        ggml_set_name(state, "conv_state");
+        ggml_tensor * conv_in = ggml_concat(ctx, state, ggml_transpose(ctx, bx), 0); // [d_conv, nr]
+        ggml_set_name(conv_in, "conv_in");
+        ggml_tensor * conv_w = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, nr);
+        ggml_set_name(conv_w, "conv_w");
+        ggml_tensor * conv = ggml_ssm_conv(ctx, conv_in, conv_w); // [nr, 1, 1]
+        ggml_set_name(conv, "conv");
+        ggml_tensor * y = ggml_mul(ctx, ggml_reshape_3d(ctx, c, nr, 1, 1), conv);
+        ggml_set_name(y, "y");
+        ggml_tensor * out_proj = ggml_new_tensor_2d(ctx, type, nr, n_embd);
+        ggml_set_name(out_proj, "out_proj");
+        ggml_tensor * out = ggml_mul_mat(ctx, out_proj, ggml_reshape_2d(ctx, y, nr, 1));
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
