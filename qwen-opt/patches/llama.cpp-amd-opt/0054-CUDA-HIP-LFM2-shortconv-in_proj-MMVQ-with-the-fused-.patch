+// [GGML_HIP_INPROJ_CONV] LFM2 shortconv, one token: the in_proj MMVQ (dst = 3 sections of nr rows, read by the conv as
+// x, x2 and gate) and the fused SSM_CONV of its output (ssm_conv_fused_f32_block, epi: x*x2, the conv, gate*conv and
+// the q8_1 copy for out_proj) in one launch. A block computes rows_per_block rows exactly as the plain ncols_dst == 1
+// kernel does (same lanes, blocks per lane, warp combine and butterfly; rows_per_block as GGML_HIP_MMVQ_N1_ROWS picks
+// it), then counts its rows into the ticket of their 32-channel group; the block that completes the 3*32 rows of a
+// group runs the conv of those 32 channels with its first warp (per channel and per q8_1 group of 32 channels the same
+// code as the 128-thread conv kernel) and resets the ticket.
+template <ggml_type type, int rows_per_block, int d_conv>
+MMVQ_LAUNCH_BOUNDS(calc_nwarps(type, 1, get_device_table_id())*ggml_cuda_get_physical_warp_size(), 16)
+static __global__ void mul_mat_vec_q_conv(
+        const void * __restrict__ vx, const block_q8_1 * __restrict__ vy, float * dst,
+        const uint32_t ncols_x, const uint32_t stride_row_x, const uint32_t nr,
+        const ggml_cuda_ssm_conv_fused_src conv_src, const float * __restrict__ conv_w, const int conv_w_nb1,
+        float * conv_dst, const int conv_dst_nb1, unsigned int * tickets) {
+    constexpr int qk        = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi        = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr       = get_vdr_mmvq(type);
+    constexpr int nwarps    = calc_nwarps(type, 1, get_device_table_id());
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    static_assert(warp_size % rows_per_block == 0, "a block's rows must lie in one 32-channel group");
+
+    const int tid              = warp_size*threadIdx.y + threadIdx.x;
+    const int row0             = rows_per_block*blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    const int kbx_offset = row0*stride_row_x;
+    float tmp[rows_per_block] = {0.0f};
+    const int kqs = vdr * (tid % (qi/vdr));
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            tmp[i] += vec_dot_q_cuda(vx, &vy[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][rows_per_block][warp_size];
+    __shared__ bool  s_last;
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            tmp_shared[threadIdx.y-1][i][threadIdx.x] = tmp[i];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y == 0) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[i] += tmp_shared[l][i][threadIdx.x];
+            }
+            tmp[i] = warp_reduce_sum<warp_size>(tmp[i]);
+            if (threadIdx.x == i) {
+                dst[row0 + i] = tmp[i];
+            }
+        }
+    }
+
+    const int group = (row0 % nr) / warp_size;
+    __threadfence();
+    __syncthreads();
+    if (tid == 0) {
+        s_last = atomicAdd(tickets + group, (unsigned int) rows_per_block) == 3*warp_size - rows_per_block;
+        if (s_last) {
+            tickets[group] = 0;
+        }
+    }
+    __syncthreads();
+    if (!s_last || threadIdx.y != 0) {
+        return;
+    }
+    __threadfence();
+    ssm_conv_fused_f32_block<false, warp_size, d_conv, true>(group, conv_src, conv_w, nullptr, conv_w_nb1, conv_dst,
+                                                             conv_dst_nb1, 1);
+}
+
+bool ggml_cuda_mmvq_conv_supported(const ggml_type type, const int64_t ncols, const int64_t nrows, const int64_t nr,
+                                   const int64_t d_conv) {
+    switch (type) {
+        case GGML_TYPE_Q4_0: case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K:
+            break;
+        default:
+            return false;
+    }
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    // the plain ncols_dst == 1 kernel is the only n = 1 variant there (no small-K or halved-iteration blocks)
+    return GGML_CUDA_CC_IS_RDNA(cc) && get_device_table_id(cc) != MMVQ_PARAMETERS_GB10 &&
+           ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size == 32 &&
+           d_conv >= 3 && d_conv <= 5 && nr % 32 == 0 && nrows == 3*nr && ncols % ggml_blck_size(type) == 0 &&
+           nr/32 <= ggml_backend_cuda_context::n_tickets;
+}
+
+void ggml_cuda_mmvq_conv(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst,
+        const ggml_cuda_ssm_conv_fused_src & conv_src, const float * conv_w, const int conv_w_nb1, const int64_t d_conv,
+        float * conv_dst, const int conv_dst_nb1, unsigned int * tickets) {
+    const int64_t nrows = src0->ne[1];
+    const int64_t nr    = nrows / 3;
+    GGML_ASSERT(ggml_cuda_mmvq_conv_supported(src0->type, src0->ne[0], nrows, nr, d_conv));
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && ggml_nrows(src1) == 1 && src1->nb[0] == sizeof(float));
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst) && ggml_nelements(dst) == nrows);
+    GGML_ASSERT(src0->nb[0] == ggml_type_size(src0->type));
+
+    // the q8_1 input as the plain MUL_MAT path gets it (quantized, or from the cache a producer wrote)
+    ggml_cuda_pool_alloc<char> src1_q8_1_pool(ctx.pool());
+    const block_q8_1 * y = (const block_q8_1 *) mmvq_src1_q8_1(ctx, src1, src0->type, /*allow_cache =*/ true, src1_q8_1_pool);
+
+    const uint32_t stride_row_x = src0->nb[1] / ggml_type_size(src0->type);
+    const int      warp_size    = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(ggml_cuda_info().devices[ggml_cuda_get_device()].cc);
+    cudaStream_t stream = ctx.stream();
+
+    const auto launch = [&](auto type_tag, auto rows_tag, auto nc_tag) {
+        constexpr ggml_type t    = decltype(type_tag)::value;
+        constexpr int       rpb  = decltype(rows_tag)::value;
+        constexpr int       c_nc = decltype(nc_tag)::value;
+        const dim3 block_nums(nrows / rpb, 1, 1);
+        const dim3 block_dims(warp_size, calc_nwarps(t, 1, table_id), 1);
+        mul_mat_vec_q_conv<t, rpb, c_nc><<<block_nums, block_dims, 0, stream>>>(
+            src0->data, y, (float *) dst->data, src0->ne[0], stride_row_x, nr, conv_src, conv_w, conv_w_nb1, conv_dst,
+            conv_dst_nb1, tickets);
+    };
+    // the rows per block of the plain launch (GGML_HIP_MMVQ_N1_ROWS on RDNA3, else 1)
+    const auto launch_rows = [&](auto type_tag, auto nc_tag) {
+        constexpr ggml_type t = decltype(type_tag)::value;
+        const int rows = mmvq_n1_rows_type(t) && table_id == MMVQ_PARAMETERS_RDNA3_0 ? mmvq_n1_rows(nrows) : 1;
+        switch (rows) {
+            case 2:  launch(type_tag, std::integral_constant<int, 2>{}, nc_tag); break;
+            case 4:  launch(type_tag, std::integral_constant<int, 4>{}, nc_tag); break;
+            default: launch(type_tag, std::integral_constant<int, 1>{}, nc_tag); break;
+        }
+    };
+    const auto launch_nc = [&](auto type_tag) {
+        switch (d_conv) {
+            case 3:  launch_rows(type_tag, std::integral_constant<int, 3>{}); break;
+            case 4:  launch_rows(type_tag, std::integral_constant<int, 4>{}); break;
+            case 5:  launch_rows(type_tag, std::integral_constant<int, 5>{}); break;
+            default: GGML_ABORT("fatal error");
+        }
+    };
+    switch (src0->type) {
+#define MMVQ_CONV_CASE(T) case T: launch_nc(std::integral_constant<ggml_type, T>{}); break
+        MMVQ_CONV_CASE(GGML_TYPE_Q4_0);
+        MMVQ_CONV_CASE(GGML_TYPE_Q8_0);
+        MMVQ_CONV_CASE(GGML_TYPE_Q4_K);
+        MMVQ_CONV_CASE(GGML_TYPE_Q5_K);
+        MMVQ_CONV_CASE(GGML_TYPE_Q6_K);
+#undef MMVQ_CONV_CASE
+        default: GGML_ABORT("fatal error");
+    }
+}
