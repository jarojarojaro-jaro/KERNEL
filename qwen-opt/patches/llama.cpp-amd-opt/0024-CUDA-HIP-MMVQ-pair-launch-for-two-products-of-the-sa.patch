diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index cd6d6954f..81f3ca6cf 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -7633,6 +7633,44 @@ struct test_mul_mat_add : public test_case {
     }
 };
 
+// two mat-muls of the same src1 with different weights (and row counts), which backends may run as one launch
+struct test_mul_mat_pair : public test_case {
+    const ggml_type type_a;
+    const int64_t m0;
+    const int64_t m1;
+    const int64_t n;
+    const int64_t k;
+
+    test_mul_mat_pair(ggml_type type_a, int64_t m0, int64_t m1, int64_t n, int64_t k)
+        : type_a(type_a), m0(m0), m1(m1), n(n), k(k) {}
+
+    std::string vars() override {
+        return VARS_TO_STR5(type_a, m0, m1, n, k);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "MUL_MAT_PAIR";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a0  = ggml_new_tensor_2d(ctx, type_a,        k, m0);
+        ggml_tensor * a1  = ggml_new_tensor_2d(ctx, type_a,        k, m1);
+        ggml_tensor * b   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * mm0 = ggml_mul_mat(ctx, a0, b);
+        ggml_tensor * mm1 = ggml_mul_mat(ctx, a1, b);
+        ggml_tensor * out = ggml_concat(ctx, mm0, mm1, 0);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
+
 struct test_mul_mat_vec_fusion : public test_case {
     const ggml_type type;
     const ggml_glu_op glu_op;
@@ -10852,6 +10890,10 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
             }
             test_cases.emplace_back(new test_mul_mat_add(type_a, 2048, n, 2048, MUL_MAT_ADD_B_INPLACE));
         }
+        for (ggml_type type_a : {GGML_TYPE_Q4_0, GGML_TYPE_Q8_0, GGML_TYPE_Q4_K, GGML_TYPE_Q5_K, GGML_TYPE_Q6_K, GGML_TYPE_IQ4_XS, GGML_TYPE_IQ4_NL}) {
