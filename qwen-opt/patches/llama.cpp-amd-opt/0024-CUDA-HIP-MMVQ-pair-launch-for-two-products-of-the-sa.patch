 ggml/src/ggml-cuda/ggml-cuda.cu | 32 ++++++++++++++++++++
 ggml/src/ggml-cuda/mmvq.cu      | 53 +++++++++++++++++++++++++++------
 src/models/qwen35.cpp           |  7 +++--
 tests/test-backend-ops.cpp      | 42 ++++++++++++++++++++++++++
 5 files changed, 136 insertions(+), 11 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index ff1955761..1758ee35b 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1645,6 +1645,12 @@ struct ggml_backend_cuda_context {
     }
 };
 
+// Default-on speed switch, read from the environment by the caller once (static): GGML_HIP_<NAME>=0 turns it off for A/B.
+static inline bool ggml_cuda_env_switch(const char * name) {
+    const char * env = getenv(name);
+    return env == nullptr || atoi(env) != 0;
+}
+
 struct ggml_cuda_mm_fusion_args_host {
     const ggml_tensor * x_bias = nullptr;
     const ggml_tensor * gate = nullptr;
@@ -1656,6 +1662,9 @@ struct ggml_cuda_mm_fusion_args_host {
     const ggml_tensor * shared_up = nullptr;
     const ggml_tensor * shared_gate = nullptr;
     ggml_tensor * shared_dst = nullptr;
+    // pair launch: a second matrix of the same type and K multiplied with the same src1 (grid-concatenated blocks)
+    const ggml_tensor * pair_src0 = nullptr;
+    ggml_tensor * pair_dst = nullptr;
 };
 struct ggml_cuda_mm_fusion_args_device {
     const void * x_bias = nullptr;
@@ -1669,6 +1678,10 @@ struct ggml_cuda_mm_fusion_args_device {
     const void * shared_gate = nullptr;
     float * shared_dst = nullptr;
     uint32_t shared_stride_col_dst = 0;
+    const void * pair_x = nullptr;   // blocks >= pair_block0 compute pair_x * src1 into pair_dst (pair_nrows rows)
+    float * pair_dst = nullptr;
+    uint32_t pair_nrows = 0;
+    uint32_t pair_block0 = 0;
 };
 
 struct ggml_cuda_kernel_launch_params {
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index b42a60a85..d9526c8fb 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4677,6 +4677,38 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         return fused_node_count - 1;
     }
 
+    // Pair launch: two consecutive MUL_MATs of the same weight type and K on the same src1 (ffn up/gate, GDN qkv/z) run
+    // as one multi-column MMVQ grid whose blocks past the first matrix compute the second. Same per-block code and order
+    // as two launches (bitwise), one kernel boundary fewer, no extra registers.
+    static const bool mmvq_pair = ggml_cuda_env_switch("GGML_HIP_MMVQ_PAIR");
+    if (mmvq_pair && node->op == GGML_OP_MUL_MAT && i + 1 < cgraph->n_nodes) {
+        ggml_tensor * n1 = cgraph->nodes[i + 1];
+        const ggml_tensor * w0 = node->src[0];
+        const ggml_tensor * w1 = n1->op == GGML_OP_MUL_MAT ? n1->src[0] : nullptr;
+        const ggml_tensor * y  = node->src[1];
+        // a following op that fuses with the second product (bias/scale epilogues) keeps the two launches
+        bool n1_epilogue = false;
+        for (int k = i + 2; k < std::min(i + 4, cgraph->n_nodes); ++k) {
+            const ggml_tensor * c = cgraph->nodes[k];
+            if ((c->op == GGML_OP_ADD || c->op == GGML_OP_MUL || c->op == GGML_OP_RESHAPE) && (c->src[0] == n1 || c->src[1] == n1)) {
+                n1_epilogue = true;
+            }
+        }
+        if (w1 && !n1_epilogue && (n1->flags & GGML_TENSOR_FLAG_COMPUTE) && n1->src[1] == y && n1->src[2] == nullptr &&
+                w0->type == w1->type && ggml_is_quantized(w0->type) && w0->ne[0] == w1->ne[0] && w0->nb[1] == w1->nb[1] &&
+                ggml_is_matrix(w0) && ggml_is_matrix(w1) && ggml_is_contiguous(w0) && ggml_is_contiguous(w1) &&
+                y->type == GGML_TYPE_F32 && ggml_is_contiguous(y) && y->ne[1] >= 2 && y->ne[2] == 1 && y->ne[3] == 1 &&
+                node->type == GGML_TYPE_F32 && n1->type == GGML_TYPE_F32 && ggml_is_contiguous(node) && ggml_is_contiguous(n1) &&
+                ggml_cuda_should_fuse_mul_mat_vec_q(node, /*bias_only =*/ true) &&
+                ggml_cuda_should_fuse_mul_mat_vec_q(n1, /*bias_only =*/ true)) {
+            ggml_cuda_mm_fusion_args_host fusion_data{};
+            fusion_data.pair_src0 = w1;
+            fusion_data.pair_dst  = n1;
+            ggml_cuda_mul_mat_vec_q(*cuda_ctx, w0, y, nullptr, node, &fusion_data);
+            return 1;
+        }
+    }
+
     // mul_mat + add
     for (ggml_op op : { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT_ID }) {
         const ggml_op bias_op = op == GGML_OP_MUL_MAT ? GGML_OP_ADD : GGML_OP_ADD_ID;
