+    const     int row0 = rows_per_cuda_block*block_x;
     const     int blocks_per_row_x = ncols_x / qk;
     constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
 
@@ -1977,9 +1987,10 @@ static void mul_mat_vec_q_switch_fusion(
         const uint32_t ids_stride, cudaStream_t stream) {
 
     const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr ||
-                            fusion.x_scale != nullptr || fusion.gate_scale != nullptr;
+                            fusion.x_scale != nullptr || fusion.gate_scale != nullptr || fusion.pair_x != nullptr;
     if constexpr (c_ncols_dst == 1) {
         if (has_fusion) {
+            GGML_ASSERT(fusion.pair_x == nullptr && "pair launches are only supported for ncols_dst > 1");
             const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, nbytes_shared, stream);
             ggml_cuda_kernel_launch(mul_mat_vec_q<type, c_ncols_dst, true, small_k, halve_iters>, launch_params,
                  vx, vy, ids, fusion, dst, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
@@ -1992,9 +2003,20 @@ static void mul_mat_vec_q_switch_fusion(
             GGML_ASSERT(fusion.gate == nullptr && fusion.gate_bias == nullptr && fusion.x_scale == nullptr &&
                         fusion.gate_scale == nullptr && fusion.shared_up == nullptr &&
                         "only bias fusion is supported for ncols_dst > 1");
-            const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, nbytes_shared, stream);
+            dim3 block_nums_fused = block_nums;
+            ggml_cuda_mm_fusion_args_device fusion_launch = fusion;
+            if (fusion.pair_x != nullptr) {
+                // the second matrix's blocks follow the first matrix's block_nums.x blocks
+                const mmvq_parameter_table_id table_id = get_device_table_id(ggml_cuda_info().devices[ggml_cuda_get_device()].cc);
+                const int rpb = calc_rows_per_block(c_ncols_dst, table_id, small_k,
+                                                    calc_nwarps(type, c_ncols_dst, table_id, small_k, halve_iters), type);
+                GGML_ASSERT(fusion.x_bias == nullptr && block_nums.y == 1 && block_nums.z == 1);
+                fusion_launch.pair_block0 = block_nums.x;
+                block_nums_fused.x += (fusion.pair_nrows + rpb - 1) / rpb;
+            }
+            const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums_fused, block_dims, nbytes_shared, stream);
             ggml_cuda_kernel_launch(mul_mat_vec_q<type, c_ncols_dst, true, small_k, halve_iters, true>, launch_params,
-                 vx, vy, ids, fusion, dst, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
+                 vx, vy, ids, fusion_launch, dst, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
                  channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
                  sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride);
             return;
@@ -2625,11 +2647,11 @@ void ggml_cuda_mul_mat_vec_q(
     if (fusion) {
         const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
         GGML_ASSERT( !ids || dst->ne[2] <= get_mmvq_mmid_max_batch(src0->type, cc));
-        // ncols_dst > 1 (plain MUL_MAT) only supports the bias epilogue; the bias must be laid out like dst.
-        GGML_ASSERT(ids || dst->ne[1] == 1 || (!fusion->gate && !fusion->gate_bias && !fusion->x_scale &&
-                                               !fusion->gate_scale && !fusion->shared_up && fusion->x_bias &&
-                                               ggml_are_same_shape(fusion->x_bias, dst) &&
-                                               ggml_are_same_stride(fusion->x_bias, dst)));
+        // ncols_dst > 1 (plain MUL_MAT) only supports the bias epilogue (the bias must be laid out like dst) or a pair launch.
+        const bool multi_ok = !fusion->gate && !fusion->gate_bias && !fusion->x_scale && !fusion->gate_scale && !fusion->shared_up &&
+            ((fusion->x_bias && ggml_are_same_shape(fusion->x_bias, dst) && ggml_are_same_stride(fusion->x_bias, dst)) ||
+             (fusion->pair_src0 && !fusion->x_bias));
+        GGML_ASSERT(ids || dst->ne[1] == 1 || multi_ok);
         // Scale fusion is only allowed for NVFP4 currently as the cost of checking this at run-time in the prologue is
         // non-negligible for some models such as gpt-oss-20b
         GGML_ASSERT((fusion->x_scale == nullptr && fusion->gate_scale == nullptr) || src0->type == GGML_TYPE_NVFP4);
@@ -2651,6 +2673,19 @@ void ggml_cuda_mul_mat_vec_q(
             fusion_local.shared_stride_col_dst = fusion->shared_dst->nb[1] / ts_dst;
         }
 
+        if (fusion->pair_src0) {
+            const ggml_tensor * p0 = fusion->pair_src0;
+            const ggml_tensor * pd = fusion->pair_dst;
+            GGML_ASSERT(!ids && ne11 > 1 && ne12 == 1 && ne13 == 1 && ne02 == 1 && ne03 == 1);
+            GGML_ASSERT(p0->type == src0->type && p0->ne[0] == ne00 && p0->nb[1] == nb01 && ggml_is_matrix(p0) && ggml_is_contiguous(p0));
