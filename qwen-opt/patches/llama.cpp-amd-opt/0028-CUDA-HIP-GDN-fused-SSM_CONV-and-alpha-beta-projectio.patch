 template <ggml_type type>
 static void gdn_ab_mmvq_launch(const void * w_alpha, const void * w_beta, const block_q8_1 * y, const float * dt,
         const float * ssm_a, float * gate, float * beta, int ncols_x, int stride_row_x, int stride_col_y,
-        int n_heads, int n_tokens, cudaStream_t stream) {
+        int n_heads, int n_tokens, const ggml_cuda_gdn_conv_args * conv, cudaStream_t stream) {
+    static_assert(MMVQ_MAX_BATCH_SIZE == 8, "update the n_tokens dispatch");
+    if (conv != nullptr) {
+        constexpr bool has_conv_ab = type == GGML_TYPE_Q8_0 || type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K;
+        if constexpr (has_conv_ab) {
+            GGML_ASSERT(conv->nr % 128 == 0);
+            const int n_conv_blocks = (int) (conv->nr / 128);
+            const dim3 block_nums(n_conv_blocks + 2*n_heads, 1, 1);
+#define GDN_CONV_AB_LAUNCH(n) gdn_conv_ab<type, n><<<block_nums, 128, 0, stream>>>(                                  \
+        conv->src, conv->w, conv->bias, conv->w_nb1, conv->dst, conv->dst_nb1, conv->n_t, n_conv_blocks,                \
+        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols_x, stride_row_x, stride_col_y, n_heads)
+            switch (n_tokens) {
+                case 1: GDN_CONV_AB_LAUNCH(1); break;
+                case 2: GDN_CONV_AB_LAUNCH(2); break;
+                case 3: GDN_CONV_AB_LAUNCH(3); break;
+                case 4: GDN_CONV_AB_LAUNCH(4); break;
+                case 5: GDN_CONV_AB_LAUNCH(5); break;
+                case 6: GDN_CONV_AB_LAUNCH(6); break;
+                case 7: GDN_CONV_AB_LAUNCH(7); break;
+                case 8: GDN_CONV_AB_LAUNCH(8); break;
+                default: GGML_ABORT("unsupported GDN token count");
+            }
+#undef GDN_CONV_AB_LAUNCH
+            return;
+        } else {
+            GGML_ABORT("conv + alpha/beta launch not instantiated for this type");
+        }
+    }
     const dim3 block_nums(n_heads, 2, 1);
     const dim3 block_dims(ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size, 4, 1);
-    static_assert(MMVQ_MAX_BATCH_SIZE == 8, "update the n_tokens dispatch");
 #define GDN_AB_LAUNCH(n) mul_mat_vec_q_gdn_ab<type, n><<<block_nums, block_dims, 0, stream>>>( \
         w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols_x, stride_row_x, stride_col_y, n_heads)
     switch (n_tokens) {
@@ -2550,7 +2615,8 @@ static void gdn_ab_mmvq_launch(const void * w_alpha, const void * w_beta, const
 }
 
