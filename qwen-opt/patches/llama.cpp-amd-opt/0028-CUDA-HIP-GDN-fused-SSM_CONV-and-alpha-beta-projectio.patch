+ggml_cuda_gdn_conv_args ggml_cuda_ssm_conv_fused_args(const ggml_tensor * dst, const ggml_tensor * bias_add_node,
+                                                      const ggml_tensor * silu_dst, const ggml_cuda_ssm_conv_fused_src & fused) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * bias = bias_add_node ? (bias_add_node->src[0] == dst ? bias_add_node->src[1] : bias_add_node->src[0]) : nullptr;
+    const ggml_tensor * out  = silu_dst;
+    GGML_ASSERT(silu_dst != nullptr && out->type == GGML_TYPE_F32 && out->nb[0] == sizeof(float) && out->ne[2] == 1);
+    GGML_ASSERT(src1->nb[0] == sizeof(float) && out->ne[0] == src0->ne[1]);
+    GGML_ASSERT(ggml_cuda_ssm_conv_fused_supported(src1->ne[0], src0->ne[1], out->ne[1]));
+    GGML_ASSERT(bias == nullptr || (bias->type == GGML_TYPE_F32 && ggml_is_contiguous(bias) && ggml_nelements(bias) == src0->ne[1]));
+
+    ggml_cuda_gdn_conv_args args;
+    args.src     = fused;
+    args.w       = (const float *) src1->data;
+    args.bias    = bias ? (const float *) bias->data : nullptr;
+    args.w_nb1   = (int) src1->nb[1];
+    args.dst     = (float *) out->data;
+    args.dst_nb1 = (int) out->nb[1];
+    args.n_t     = (int) out->ne[1];
+    args.nr      = src0->ne[1];
+    args.d_conv  = src1->ne[0];
+    return args;
