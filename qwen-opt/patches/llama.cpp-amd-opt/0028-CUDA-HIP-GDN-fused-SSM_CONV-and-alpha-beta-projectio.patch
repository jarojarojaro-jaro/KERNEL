 bool ggml_cuda_ssm_conv_fused_supported(int64_t d_conv, int64_t nr, int64_t n_t);
 
 void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * bias_add_node = nullptr,
                            ggml_tensor * silu_dst = nullptr, const ggml_cuda_ssm_conv_fused_src * fused = nullptr);
+
+// Launch arguments of a single-sequence fused SSM_CONV with SILU (ssm_conv_fused_f32_block), for kernels that run it
+// beside other work (the GDN alpha/beta launch in mmvq.cu).
+struct ggml_cuda_gdn_conv_args {
+    ggml_cuda_ssm_conv_fused_src src;
+    const float * w;
+    const float * bias;
+    int           w_nb1;
+    float *       dst;
+    int           dst_nb1;
+    int           n_t;
+    int64_t       nr;     // channels, a multiple of 128
+    int64_t       d_conv;
+};
+
+// The arguments ggml_cuda_op_ssm_conv(ctx, dst, bias_add_node, silu_dst, &fused) would launch the fused kernel with.
+ggml_cuda_gdn_conv_args ggml_cuda_ssm_conv_fused_args(const ggml_tensor * dst, const ggml_tensor * bias_add_node,
+                                                      const ggml_tensor * silu_dst, const ggml_cuda_ssm_conv_fused_src & fused);
