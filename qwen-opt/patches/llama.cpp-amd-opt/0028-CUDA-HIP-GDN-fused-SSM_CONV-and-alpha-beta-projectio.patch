+    if (warp > 0) {
         return;
     }
 
@@ -2491,10 +2490,10 @@ static __global__ void mul_mat_vec_q_gdn_ab(
     for (int j = 0; j < n_tokens; ++j) {
 #pragma unroll
         for (int l = 0; l < nwarps-1; ++l) {
-            tmp[j] += tmp_shared[l][j][threadIdx.x];
+            tmp[j] += tmp_shared[l][j][lane];
         }
         const float sum = warp_reduce_sum<warp_size>(tmp[j]);
-        if (threadIdx.x == 0) {
+        if (lane == 0) {
             const int i = j*n_heads + h;
             if (is_beta) {
                 beta[i] = 1.0f / (1.0f + expf(-sum));
@@ -2506,6 +2505,41 @@ static __global__ void mul_mat_vec_q_gdn_ab(
     }
 }
 
+template <ggml_type type, int n_tokens>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_gdn_ab(
+        const void * __restrict__ w_alpha, const void * __restrict__ w_beta, const block_q8_1 * __restrict__ y,
+        const float * __restrict__ dt, const float * __restrict__ ssm_a, float * __restrict__ gate, float * __restrict__ beta,
+        const int ncols_x, const int stride_row_x, const int stride_col_y, const int n_heads) {
+    mul_mat_vec_q_gdn_ab_block<type, n_tokens>(blockIdx.x, blockIdx.y != 0, threadIdx.x, threadIdx.y,
+        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols_x, stride_row_x, stride_col_y, n_heads);
+}
+
+// The fused SSM_CONV (+SILU, d_conv 4, 128 channels a block) of a GDN layer and its alpha/beta projections in one
+// grid: blocks [0, n_conv_blocks) run ssm_conv_fused_f32's blocks, the rest mul_mat_vec_q_gdn_ab's (head, projection)
+// blocks. The two are independent (conv: qkv product; alpha/beta: the layer input). Same per-block code as the two
+// launches, one kernel boundary fewer.
+template <ggml_type type, int n_tokens>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void gdn_conv_ab(
+        const ggml_cuda_ssm_conv_fused_src conv_src, const float * __restrict__ conv_w, const float * __restrict__ conv_bias,
+        const int conv_w_nb1, float * conv_dst, const int conv_dst_nb1, const int conv_n_t, const int n_conv_blocks,
+        const void * __restrict__ w_alpha, const void * __restrict__ w_beta, const block_q8_1 * __restrict__ y,
+        const float * __restrict__ dt, const float * __restrict__ ssm_a, float * __restrict__ gate, float * __restrict__ beta,
+        const int ncols_x, const int stride_row_x, const int stride_col_y, const int n_heads) {
+    if constexpr (ggml_cuda_get_physical_warp_size() != 32) {
+        NO_DEVICE_CODE; // the host only launches it with 32-wide warps (128-thread conv blocks = 4 warps)
+    } else {
+        if ((int) blockIdx.x < n_conv_blocks) {
+            ssm_conv_fused_f32_block<true, 128, 4>(blockIdx.x, conv_src, conv_w, conv_bias, conv_w_nb1, conv_dst, conv_dst_nb1, conv_n_t);
+            return;
+        }
+        const int b = blockIdx.x - n_conv_blocks;
+        mul_mat_vec_q_gdn_ab_block<type, n_tokens>(b % n_heads, b >= n_heads, threadIdx.x % 32, threadIdx.x / 32,
+            w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols_x, stride_row_x, stride_col_y, n_heads);
+    }
+}
+
 bool ggml_cuda_gdn_ab_mmvq_supported(const ggml_type type) {
     switch (type) {
         case GGML_TYPE_Q4_0:
@@ -2526,13 +2560,44 @@ bool ggml_cuda_gdn_ab_mmvq_supported(const ggml_type type) {
     }
 }
 
+bool ggml_cuda_gdn_conv_ab_supported(const ggml_type type, const int64_t d_conv, const int warp_size) {
+    return warp_size == 32 && d_conv == 4 &&
+           (type == GGML_TYPE_Q8_0 || type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K);
+}
