diff --git a/ggml/src/ggml-cuda/ssm-conv.cuh b/ggml/src/ggml-cuda/ssm-conv.cuh
index e659cdb2c..d0856a8be 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cuh
+++ b/ggml/src/ggml-cuda/ssm-conv.cuh
@@ -1,4 +1,7 @@
+#pragma once
+
 #include "common.cuh"
+#include "unary.cuh"
 
 #define SSM_CONV_FUSED_MAX_SNAPSHOTS 8  // max. conv-state snapshot windows written by the fused kernel
 #define SSM_CONV_FUSED_MAX_TOKENS    16 // max. tokens per sequence of the fused kernel
@@ -16,7 +19,89 @@ struct ggml_cuda_ssm_conv_fused_src {
     float *         snap_dst[SSM_CONV_FUSED_MAX_SNAPSHOTS]; // contiguous [d_conv - 1, nr] destination
 };
 
+// One block (split_d_inner channels, block index block_y) of the single-sequence SSM_CONV that reads its input
+// straight from the two CONCAT sources (conv state, possibly through the gather index, and the new inputs) and also
+// writes the conv-state snapshot windows the replaced CPYs would copy. Each thread owns one channel and reads all of
+// its inputs before writing anything, so a snapshot may overwrite the cache row the state is read from and dst may
+// alias x element for element (hence no __restrict__ on dst). The convolution arithmetic is that of ssm_conv_f32.
+// Shared by ssm_conv_fused_f32 and the conv + GDN alpha/beta launch (mmvq.cu).
+template <bool apply_silu, size_t split_d_inner, size_t d_conv>
+static __device__ __forceinline__ void ssm_conv_fused_f32_block(const int block_y, const ggml_cuda_ssm_conv_fused_src & src,
+                                                                const float * __restrict__ w_ptr, const float * __restrict__ bias,
+                                                                const int w_nb1, float * dst, const int dst_nb1, const int n_t) {
+    constexpr int n_state = d_conv - 1;
+    constexpr int L       = n_state + SSM_CONV_FUSED_MAX_TOKENS;
+
+    const int c = block_y * split_d_inner + threadIdx.x;
+
+    const float * w_row = (const float *) ((const char *) w_ptr + c * w_nb1);
+    float w[d_conv];
+#pragma unroll
+    for (int j = 0; j < (int) d_conv; j++) {
+        w[j] = w_row[j];
+    }
+    const float b = bias != nullptr ? bias[c] : 0.0f;
+
+    const float * s_row = src.state_idx ? src.state + src.state_idx[0] * src.state_row_stride : src.state;
+    float xs[L];
+#pragma unroll
+    for (int k = 0; k < n_state; k++) {
+        xs[k] = s_row[c * n_state + k];
+    }
+#pragma unroll
+    for (int t = 0; t < SSM_CONV_FUSED_MAX_TOKENS; t++) {
+        xs[n_state + t] = t < n_t ? src.x[t * src.x_stride + c] : 0.0f;
+    }
+
+    for (int s = 0; s < src.n_snap; s++) {
+        const int t0 = src.snap_t0[s];
+        float *   d  = src.snap_dst[s] + c * n_state;
+#pragma unroll
+        for (int k = 0; k < n_state; k++) {
+            // register select instead of a dynamic index into xs (which would spill to scratch)
+            float v = 0.0f;
+#pragma unroll
+            for (int tau = 0; tau < L; tau++) {
+                v = tau == t0 + k ? xs[tau] : v;
+            }
+            d[k] = v;
+        }
+    }
+
+    const int stride_y = dst_nb1 / sizeof(float);
+#pragma unroll
+    for (int t = 0; t < SSM_CONV_FUSED_MAX_TOKENS; t++) {
+        if (t < n_t) {
+            float sumf = 0.0f;
+#pragma unroll
+            for (int j = 0; j < (int) d_conv; j++) {
+                sumf += xs[t + j] * w[j];
+            }
+            sumf += b;
+            dst[t * stride_y + c] = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+        }
+    }
+}
