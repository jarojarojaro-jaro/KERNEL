 ggml/src/ggml-cuda/mmvq.cuh     |   9 ++-
 ggml/src/ggml-cuda/ssm-conv.cu  |  82 +++++++---------------
 ggml/src/ggml-cuda/ssm-conv.cuh |  85 +++++++++++++++++++++++
 5 files changed, 251 insertions(+), 85 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 9c83f8708..c0fd9ef4d 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3883,7 +3883,10 @@ static bool ggml_cuda_gdn_prologue_elided(const ggml_cgraph * cgraph, int i) {
 //   alpha: mul_mat -> reshape -> add(dt) -> softplus -> mul(ssm_a) -> reshape
 //   beta:  mul_mat -> reshape -> sigmoid
 // all done by one MMVQ launch (ggml_cuda_gdn_ab_mmvq). Returns the number of nodes to skip.
-static int ggml_cuda_try_gdn_ab_fusion(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+// conv: when not null, the fused SSM_CONV of the same layer runs in the same launch; 0 is returned when that is not
+// possible (unsupported type, or the alpha/beta outputs share memory with what the conv reads or writes).
+static int ggml_cuda_try_gdn_ab_fusion(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i,
+                                       const ggml_cuda_gdn_conv_args * conv = nullptr) {
     const std::initializer_list<enum ggml_op> ops = {
         GGML_OP_MUL_MAT, GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_RESHAPE,
         GGML_OP_MUL_MAT, GGML_OP_RESHAPE, GGML_OP_UNARY,
@@ -3949,7 +3952,25 @@ static int ggml_cuda_try_gdn_ab_fusion(ggml_backend_cuda_context * cuda_ctx, con
         return 0;
     }
 
-    ggml_cuda_gdn_ab_mmvq(*cuda_ctx, w_alpha, w_beta, x, dt, ssm_a, gate_out, beta_out);
+    if (conv != nullptr) {
+        if (!ggml_cuda_gdn_conv_ab_supported(w_alpha->type, conv->d_conv, ggml_cuda_info().devices[cuda_ctx->device].warp_size)) {
+            return 0;
+        }
+        const auto overlaps = [](const ggml_tensor * t, const void * p, size_t n) {
+            const char * a = (const char *) t->data;
+            const char * b = (const char *) p;
+            return a < b + n && b < a + ggml_nbytes(t);
+        };
+        const size_t x_bytes   = ((conv->n_t - 1)*conv->src.x_stride + conv->nr)*sizeof(float);
+        const size_t dst_bytes = (size_t) (conv->n_t - 1)*conv->dst_nb1 + conv->nr*sizeof(float);
+        for (const ggml_tensor * t : { (const ggml_tensor *) gate_out, (const ggml_tensor *) beta_out }) {
+            if (overlaps(t, conv->src.x, x_bytes) || overlaps(t, conv->dst, dst_bytes)) {
+                return 0;
+            }
+        }
+    }
+
+    ggml_cuda_gdn_ab_mmvq(*cuda_ctx, w_alpha, w_beta, x, dt, ssm_a, gate_out, beta_out, conv);
     return (int) ops.size() - 1;
 }
 
@@ -4876,6 +4897,23 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
     if (node->op == GGML_OP_SSM_CONV) {
         ggml_cuda_ssm_conv_plan plan;
         if (ggml_cuda_ssm_conv_cache_plan(cgraph, i, plan)) {
+            // GDN layer: the alpha/beta projections follow after views and nodes the GDN prologue elides; they are
+            // independent of the conv, so both run in one grid (GGML_HIP_GDN_CONV_AB=0: two launches)
+            static const bool conv_ab = ggml_cuda_env_switch("GGML_HIP_GDN_CONV_AB");
+            if (conv_ab && plan.silu != nullptr) {
+                int j = i + 1 + plan.n_fused;
+                while (j < cgraph->n_nodes && j < i + 16 &&
+                       (ggml_cuda_is_view_or_noop(cgraph->nodes[j]) || ggml_cuda_gdn_prologue_elided(cgraph, j))) {
+                    ++j;
+                }
+                if (j < cgraph->n_nodes && cgraph->nodes[j]->op == GGML_OP_MUL_MAT) {
+                    const ggml_cuda_gdn_conv_args conv = ggml_cuda_ssm_conv_fused_args(node, plan.bias_add, plan.silu, plan.src);
+                    const int ab_skip = ggml_cuda_try_gdn_ab_fusion(cuda_ctx, cgraph, j, &conv);
+                    if (ab_skip > 0) {
+                        return j + ab_skip - i;
+                    }
+                }
+            }
             ggml_cuda_op_ssm_conv(*cuda_ctx, node, plan.bias_add, plan.silu, &plan.src);
             return plan.n_fused > 0 ? plan.n_fused : -1;
         }
