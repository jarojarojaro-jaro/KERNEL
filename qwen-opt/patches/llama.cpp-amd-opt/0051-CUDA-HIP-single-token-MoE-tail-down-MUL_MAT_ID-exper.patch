+// [GGML_HIP_MOE_DOWN_REDUCE] single-token MoE tail: down MUL_MAT_ID -> weighted reduction (MUL, VIEWs, ADDs) -> the
+// residual ADD (after only views or elided nodes, e.g. the next layer's state gather) in one launch
+// (ggml_cuda_mmvq_moe_down_reduce), which writes the ADD node ahead of its position. Returns the nodes to skip, 0: no.
+static int ggml_cuda_try_moe_down_reduce(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_MOE_DOWN_REDUCE");
+    const ggml_tensor * mm = cgraph->nodes[i];
+    if (!enabled || mm->op != GGML_OP_MUL_MAT_ID || i + 1 >= cgraph->n_nodes || cuda_ctx->curr_stream_no != 0 ||
+            !cuda_ctx->stream_context().concurrent_events.empty()) {
+        return 0;
+    }
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    const ggml_tensor * ids  = mm->src[2];
+    if (!ggml_is_quantized(src0->type) || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) || mm->ne[2] != 1 ||
+            mm->ne[3] != 1 || ids->ne[1] != 1 || src1->type != GGML_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1 ||
+            src1->nb[0] != sizeof(float) || (src1->ne[1] != 1 && src1->ne[1] != mm->ne[1]) ||
+            !ggml_cuda_mmvq_moe_down_reduce_supported(src0->type, mm->ne[1], src0->ne[1]) ||
+            !ggml_node_has_n_uses(cgraph, i, 1)) {
+        return 0;
+    }
+    ggml_cuda_moe_weighted_reduction_match match;
+    if (!ggml_cuda_match_moe_weighted_reduction(cgraph, i + 1, match) || match.experts != mm || match.expert_scale != nullptr) {
+        return 0;
+    }
+    const int red_out = i + match.node_count;
+    if (!ggml_node_has_n_uses(cgraph, red_out, 1) || (match.dst->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    int add_idx = -1;
+    for (int j = red_out + 1; j < std::min(cgraph->n_nodes, red_out + 33); ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_ADD && (n->src[0] == match.dst || n->src[1] == match.dst)) {
+            add_idx = j;
+            break;
+        }
+        // no kernel may run in between: the ADD's output is written ahead of them
+        if (!ggml_cuda_is_view_or_noop(n) && (n->flags & GGML_TENSOR_FLAG_COMPUTE) && !ggml_cuda_gdn_prologue_elided(cgraph, j)) {
+            return 0;
+        }
+    }
+    if (add_idx < 0) {
+        return 0;
+    }
+    ggml_tensor *       add = cgraph->nodes[add_idx];
+    const ggml_tensor * res = add->src[0] == match.dst ? add->src[1] : add->src[0];
+    if (res == match.dst || add->type != GGML_TYPE_F32 || res->type != GGML_TYPE_F32 || !ggml_is_contiguous(add) ||
+            !ggml_is_contiguous(res) || !ggml_are_same_shape(add, match.dst) || !ggml_are_same_shape(res, add) ||
+            ggml_nelements(add) != src0->ne[1] || (add->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    // the residual must be computed already
+    for (int j = i + 1; j < add_idx; ++j) {
+        if (cgraph->nodes[j] == res || cgraph->nodes[j] == res->view_src) {
+            return 0;
+        }
+    }
+    // the ADD's output must not overlap the other inputs (a row of the residual is read before the same thread writes
+    // that row, so the residual may be the output itself)
+    if ((add->data != res->data && ggml_cuda_tensors_overlap(add, res)) || ggml_cuda_tensors_overlap(add, ids) ||
+            ggml_cuda_tensors_overlap(add, match.weights) || ggml_cuda_tensors_overlap(add, src1) ||
+            ggml_cuda_tensors_overlap(add, src0)) {
+        return 0;
+    }
+    ggml_cuda_mmvq_moe_down_reduce(*cuda_ctx, src0, src1, ids, match.weights, res, add);
+    cuda_ctx->mmvq_q8_cache_invalidate_if_written(add);
+    cuda_ctx->nodes_done_ahead.push_back(add);
+    return match.node_count;
+}
