@@ -4204,10 +4273,25 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     ggml_tensor * node = cgraph->nodes[i];
 
+    if (!cuda_ctx->nodes_done_ahead.empty()) {
+        auto it = std::find(cuda_ctx->nodes_done_ahead.begin(), cuda_ctx->nodes_done_ahead.end(), node);
+        if (it != cuda_ctx->nodes_done_ahead.end()) {
+            cuda_ctx->nodes_done_ahead.erase(it);
+            return -1;
+        }
+    }
+
     if (ggml_cuda_gdn_prologue_elided(cgraph, i)) {
         return -1;
     }
 
+    if (node->op == GGML_OP_MUL_MAT_ID) {
+        const int nodes_to_skip = ggml_cuda_try_moe_down_reduce(cuda_ctx, cgraph, i);
+        if (nodes_to_skip > 0) {
+            return nodes_to_skip;
+        }
+    }
+
     if (node->op == GGML_OP_MUL_MAT) {
         const int nodes_to_skip = ggml_cuda_try_gdn_ab_fusion(cuda_ctx, cgraph, i);
         if (nodes_to_skip > 0) {
@@ -5178,6 +5262,7 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
 
             // inputs may have been rewritten by the host since the previous evaluation
             cuda_ctx->mmvq_q8_cache_invalidate();
+            cuda_ctx->nodes_done_ahead.clear();
 
             if (should_launch_concurrent_events) {
                 // Restore original node order within each concurrent region to enable fusion within streams
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 3e1de5604..f00980773 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -3179,6 +3179,169 @@ void ggml_cuda_gdn_ab_mmvq(ggml_backend_cuda_context & ctx, const ggml_tensor *
 #undef GDN_AB
 }
 
+// [GGML_HIP_MOE_DOWN_REDUCE] Single-token MoE down projection, expert weighting and residual ADD in one launch:
+//   dst[r] = residual[r] + sum_e w[e] * (W_down[ids[e]] . y_e)[r]
+// One block computes rows_per_block rows of every used expert. Each expert row is the dot product of the plain
+// ncols_dst == 1 MMVQ kernel (same lanes, blocks per lane, warp combine and butterfly), the weighting is that of
+// moe_weighted_reduction_f32 (x0*w0, then fma per expert; expert_scale 1) and the ADD is one rounded add, so the
+// result is bitwise that of the MUL_MAT_ID, the weighted reduction and the ADD kernels.
+template <ggml_type type, int n_used, int rows_per_block>
+MMVQ_LAUNCH_BOUNDS(calc_nwarps(type, 1, get_device_table_id())*ggml_cuda_get_physical_warp_size(), 16)
+static __global__ void mul_mat_vec_q_moe_down_reduce(
+        const void * __restrict__ vx, const block_q8_1 * __restrict__ vy, const int32_t * __restrict__ ids,
+        const float * __restrict__ weights, const float * residual, float * dst,
+        const uint32_t ncols_x, const uint32_t stride_row_x, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t nchannels_y) {
+    constexpr int qk        = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi        = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr       = get_vdr_mmvq(type);
+    constexpr int nwarps    = calc_nwarps(type, 1, get_device_table_id());
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int tid              = warp_size*threadIdx.y + threadIdx.x;
+    const int row0             = rows_per_block*blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    int kbx_offset[n_used];
+    const block_q8_1 * y[n_used];
+#pragma unroll
+    for (int e = 0; e < n_used; ++e) {
+        kbx_offset[e] = ids[e]*stride_channel_x + row0*stride_row_x;
+        y[e]          = vy + (e % nchannels_y)*stride_channel_y;
+    }
+
+    float tmp[n_used][rows_per_block] = {{0.0f}};
+    const int kqs = vdr * (tid % (qi/vdr));
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+#pragma unroll
+        for (int e = 0; e < n_used; ++e) {
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp[e][i] += vec_dot_q_cuda(vx, &y[e][kby], kbx_offset[e] + i*stride_row_x + kbx, kqs);
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][n_used][rows_per_block][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int e = 0; e < n_used; ++e) {
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp_shared[threadIdx.y-1][e][i][threadIdx.x] = tmp[e][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+#pragma unroll
+    for (int e = 0; e < n_used; ++e) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[e][i] += tmp_shared[l][e][i][threadIdx.x];
+            }
+            tmp[e][i] = warp_reduce_sum<warp_size>(tmp[e][i]);
+        }
+    }
+
+#pragma unroll
+    for (int i = 0; i < rows_per_block; ++i) {
+        if (threadIdx.x == i) {
+            float sum = __fmul_rn(tmp[0][i], weights[0]);
+#pragma unroll
+            for (int e = 1; e < n_used; ++e) {
+                sum = __fmaf_rn(tmp[e][i], weights[e], sum);
+            }
+            dst[row0 + i] = __fadd_rn(residual[row0 + i], sum);
+        }
+    }
+}
+
+#ifndef MMVQ_MOE_DOWN_RPB
+#define MMVQ_MOE_DOWN_RPB 1
+#endif
+
+bool ggml_cuda_mmvq_moe_down_reduce_supported(const ggml_type type, const int64_t n_used, const int64_t nrows) {
+    switch (type) {
+        case GGML_TYPE_Q4_0: case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ4_XS: case GGML_TYPE_IQ4_NL:
+            break;
+        default:
+            return false;
+    }
+    return (n_used == 2 || n_used == 4 || n_used == 6 || n_used == 8) && nrows % MMVQ_MOE_DOWN_RPB == 0;
+}
+
+void ggml_cuda_mmvq_moe_down_reduce(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+        const ggml_tensor * ids, const ggml_tensor * weights, const ggml_tensor * residual, ggml_tensor * dst) {
+    const int64_t n_used = ids->ne[0];
+    GGML_ASSERT(ggml_cuda_mmvq_moe_down_reduce_supported(src0->type, n_used, src0->ne[1]));
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && src1->ne[2] == 1 && src1->ne[3] == 1 && src1->nb[0] == sizeof(float));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[1] == 1 && ggml_is_contiguous(ids));
+    GGML_ASSERT(src1->ne[1] == 1 || src1->ne[1] == n_used);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32 && ggml_is_contiguous(weights) && ggml_nelements(weights) == n_used);
+    GGML_ASSERT(residual->type == GGML_TYPE_F32 && ggml_is_contiguous(residual) && ggml_nelements(residual) == src0->ne[1]);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst) && ggml_nelements(dst) == src0->ne[1]);
+    GGML_ASSERT(src0->nb[0] == ggml_type_size(src0->type));
+
+    // the q8_1 input as the MMVQ ids path quantizes (and caches) it
+    static const bool q8_ids = ggml_cuda_env_switch("GGML_HIP_Q8_IDS");
+    ggml_cuda_pool_alloc<char> src1_q8_1_pool(ctx.pool());
+    const block_q8_1 * y = (const block_q8_1 *) mmvq_src1_q8_1(ctx, src1, src0->type, q8_ids, src1_q8_1_pool);
+
+    const int64_t ts_src0          = ggml_type_size(src0->type);
+    const uint32_t stride_row_x     = src0->nb[1] / ts_src0;
+    const uint32_t stride_channel_x = src0->nb[2] / ts_src0;
+    const uint32_t stride_channel_y = GGML_PAD(src1->ne[0], MATRIX_ROW_PADDING) / QK8_1;
+    const uint32_t nchannels_y      = src1->ne[1];
+    const int      nrows            = src0->ne[1];
+
+    const int device    = ggml_cuda_get_device();
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(ggml_cuda_info().devices[device].cc);
+    cudaStream_t stream = ctx.stream();
+
+    const auto launch = [&](auto type_tag, auto n_tag) {
+        constexpr ggml_type type = decltype(type_tag)::value;
+        constexpr int       ne   = decltype(n_tag)::value;
+        const dim3 block_nums(nrows / MMVQ_MOE_DOWN_RPB, 1, 1);
+        const dim3 block_dims(warp_size, calc_nwarps(type, 1, table_id), 1);
+        mul_mat_vec_q_moe_down_reduce<type, ne, MMVQ_MOE_DOWN_RPB><<<block_nums, block_dims, 0, stream>>>(
+            src0->data, y, (const int32_t *) ids->data, (const float *) weights->data, (const float *) residual->data,
+            (float *) dst->data, src0->ne[0], stride_row_x, stride_channel_x, stride_channel_y, nchannels_y);
+    };
+    const auto launch_n = [&](auto type_tag) {
+        switch (n_used) {
+            case 2: launch(type_tag, std::integral_constant<int, 2>{}); break;
+            case 4: launch(type_tag, std::integral_constant<int, 4>{}); break;
+            case 6: launch(type_tag, std::integral_constant<int, 6>{}); break;
+            case 8: launch(type_tag, std::integral_constant<int, 8>{}); break;
+            default: GGML_ABORT("fatal error");
+        }
+    };
+    switch (src0->type) {
+#define MOE_DOWN_CASE(T) case T: launch_n(std::integral_constant<ggml_type, T>{}); break
+        MOE_DOWN_CASE(GGML_TYPE_Q4_0);
+        MOE_DOWN_CASE(GGML_TYPE_Q8_0);
+        MOE_DOWN_CASE(GGML_TYPE_Q4_K);
+        MOE_DOWN_CASE(GGML_TYPE_Q5_K);
+        MOE_DOWN_CASE(GGML_TYPE_Q6_K);
+        MOE_DOWN_CASE(GGML_TYPE_IQ4_XS);
+        MOE_DOWN_CASE(GGML_TYPE_IQ4_NL);
+#undef MOE_DOWN_CASE
+        default: GGML_ABORT("fatal error");
+    }
+}
