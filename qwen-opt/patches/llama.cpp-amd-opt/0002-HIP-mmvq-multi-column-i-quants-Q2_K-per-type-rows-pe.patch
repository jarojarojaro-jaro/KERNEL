+    } else if constexpr (type == GGML_TYPE_IQ1_S) {
+        int sumi = 0;
+#pragma unroll
+        for (int l = 0; l < 8; ++l) {
+            sumi = ggml_cuda_dp4a(x.v[l], u.u[l], sumi);
+        }
+        return x.s * u.ds.x * sumi + x.a * u.ds.y;
+    } else if constexpr (type == GGML_TYPE_IQ1_M) {
