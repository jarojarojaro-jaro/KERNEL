From 3a05006a0c667b1008ec36fde32b51ca331dbef8 Mon Sep 17 00:00:00 2001
From: jaro <jaro@localhost>
Date: Fri, 9 Oct 2026 17:34:47 +0000
Subject: [PATCH 3/5] CUDA/HIP mmvq: reuse q8_1 activations across consecutive
 MUL_MATs with the same src1

---
 ggml/src/ggml-cuda/common.cuh    | 27 +++++++++++++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu  | 10 ++++++++
 ggml/src/ggml-cuda/mmvq.cu       | 41 ++++++++++++++++++++++++++++----
 ggml/src/ggml-cuda/vendors/hip.h |  3 +++
 4 files changed, 77 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 928607c41..195e4458f 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1514,6 +1514,33 @@ struct ggml_backend_cuda_context {
 
     ggml_cuda_stream_context concurrent_stream_context;
 
+    // MMVQ: q8_1 copy of the last quantized src1, so that consecutive MUL_MATs on the same activations
+    // (e.g. Q/K/V, or the DeltaNet qkv/z/alpha/beta projections) quantize it only once per graph evaluation.
+    // Invalidated at the start of every graph evaluation and whenever a node writes over the cached input.
+    struct mmvq_q8_cache_t {
+        const void * src = nullptr;   // src1->data of the cached activations, nullptr = empty
+        int64_t      ne[4] = {0, 0, 0, 0};
+        size_t       nb[4] = {0, 0, 0, 0};
+        size_t       src_bytes = 0;
+        void *       buf = nullptr;    // device buffer holding the q8_1 data
+        size_t       buf_size = 0;
+    } mmvq_q8_cache;
+
+    void mmvq_q8_cache_invalidate() { mmvq_q8_cache.src = nullptr; }
+
+    void mmvq_q8_cache_invalidate_if_written(const ggml_tensor * t) {
+        if (mmvq_q8_cache.src == nullptr || t->data == nullptr) {
+            return;
+        }
+        const char * w0 = (const char *) t->data;
+        const char * w1 = w0 + ggml_nbytes(t);
+        const char * c0 = (const char *) mmvq_q8_cache.src;
+        const char * c1 = c0 + mmvq_q8_cache.src_bytes;
+        if (w0 < c1 && c0 < w1) {
+            mmvq_q8_cache.src = nullptr;
+        }
+    }
+
     ~ggml_backend_cuda_context();
 
     cudaStream_t stream(int device, int stream) {
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 8e0c7658e..d23ea9ab7 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -700,6 +700,9 @@ ggml_backend_cuda_context::~ggml_backend_cuda_context() {
     if (copy_event != nullptr) {
         CUDA_CHECK(cudaEventDestroy(copy_event));
     }
+    if (mmvq_q8_cache.buf != nullptr) {
+        CUDA_CHECK(cudaFree(mmvq_q8_cache.buf));
+    }
     for (int i = 0; i < GGML_CUDA_MAX_DEVICES; ++i) {
         for (int j = 0; j < GGML_CUDA_MAX_STREAMS; ++j) {
             if (streams[i][j] != nullptr) {
@@ -4352,6 +4355,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 }
             }
 
+            // inputs may have been rewritten by the host since the previous evaluation
+            cuda_ctx->mmvq_q8_cache_invalidate();
+
             if (should_launch_concurrent_events) {
                 // Restore original node order within each concurrent region to enable fusion within streams
 
@@ -4458,6 +4464,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                             nodes_to_skip + 1, ggml_op_name(node->op), node->name,
                             ggml_op_name(cgraph->nodes[last_fused]->op), cgraph->nodes[last_fused]->name);
 #endif
+                    for (int j = i; j <= i + nodes_to_skip; ++j) {
+                        cuda_ctx->mmvq_q8_cache_invalidate_if_written(cgraph->nodes[j]);
+                    }
                     i += nodes_to_skip;
                     continue;
                 }
@@ -4483,6 +4492,7 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     GGML_LOG_ERROR("%s: op not supported %s (%s)\n", __func__, node->name, ggml_op_name(node->op));
                 }
                 GGML_ASSERT(ok);
+                cuda_ctx->mmvq_q8_cache_invalidate_if_written(node);
 
                 if (!is_concurrent_event_active) {
                     try_launch_concurrent_event(node);
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 4575e3469..b9aadf374 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -2079,12 +2079,45 @@ void ggml_cuda_mul_mat_vec_q(
     }
 
     const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
-    ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), ne13*ne12 * ne11*ne10_padded * sizeof(block_q8_1)/QK8_1);
-    {
+    const size_t  q8_size     = ne13*ne12 * ne11*ne10_padded * sizeof(block_q8_1)/QK8_1;
+
+    // Reuse the q8_1 activations of the previous MUL_MAT if it had the same src1 (see mmvq_q8_cache_t).
+    // The cache buffer is allocated once, outside of graph capture, and never reallocated, so captured
+    // CUDA graphs can keep pointing at it.
+    constexpr size_t q8_cache_capacity = 4u << 20;
+    auto & qc = ctx.mmvq_q8_cache;
+    const bool cache_usable = !ids && ctx.curr_stream_no == 0 && ctx.stream_context().concurrent_events.empty() &&
+                              q8_size <= q8_cache_capacity;
+    if (cache_usable && qc.buf == nullptr) {
+        cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(stream, &capture_status));
+        if (capture_status == cudaStreamCaptureStatusNone) {
+            CUDA_CHECK(cudaMalloc(&qc.buf, q8_cache_capacity));
+            qc.buf_size = q8_cache_capacity;
+        }
+    }
+    const bool use_cache = cache_usable && qc.buf != nullptr;
+    const bool cache_hit = use_cache && qc.src == src1->data &&
+        qc.ne[0] == ne10 && qc.ne[1] == ne11 && qc.ne[2] == ne12 && qc.ne[3] == ne13 &&
+        qc.nb[1] == src1->nb[1] && qc.nb[2] == src1->nb[2] && qc.nb[3] == src1->nb[3];
+
+    ggml_cuda_pool_alloc<char> src1_q8_1_pool(ctx.pool());
+    char * src1_q8_1 = use_cache ? (char *) qc.buf : src1_q8_1_pool.alloc(q8_size);
+    if (!cache_hit) {
         const int64_t s11 = src1->nb[1] / ts_src1;
         const int64_t s12 = src1->nb[2] / ts_src1;
         const int64_t s13 = src1->nb[3] / ts_src1;
-        quantize_row_q8_1_cuda(src1_d, nullptr, src1_q8_1.get(), src0->type, ne10, s11, s12, s13, ne10_padded, ne11, ne12, ne13, stream);
+        quantize_row_q8_1_cuda(src1_d, nullptr, src1_q8_1, src0->type, ne10, s11, s12, s13, ne10_padded, ne11, ne12, ne13, stream);
+        if (use_cache) {
+            qc.src       = src1->data;
+            qc.src_bytes = ggml_nbytes(src1);
+            for (int k = 0; k < 4; ++k) {
+                qc.ne[k] = src1->ne[k];
+                qc.nb[k] = src1->nb[k];
+            }
+        } else {
+            qc.src = nullptr;
+        }
     }
 
     const int64_t s01 = src0->nb[1] / ts_src0;
@@ -2110,7 +2143,7 @@ void ggml_cuda_mul_mat_vec_q(
     const int64_t ids_stride = ids ? ids->nb[1] / ggml_type_size(ids->type) : 0;
 
     mul_mat_vec_q_switch_type(
-        src0->data, src0->type, src1_q8_1.get(), ids_d, fusion_local, dst_d, ne00,
+        src0->data, src0->type, src1_q8_1, ids_d, fusion_local, dst_d, ne00,
         ne01,              ncols_dst,     s01, stride_col_y,     stride_col_dst,
         ne02, nchannels_y, nchannels_dst, s02, stride_channel_y, stride_channel_dst,
         ne03,              ne3,           s03, s13,              s3,               ids_stride, stream);
diff --git a/ggml/src/ggml-cuda/vendors/hip.h b/ggml/src/ggml-cuda/vendors/hip.h
index da7e3da0b..dabda9cd2 100644
--- a/ggml/src/ggml-cuda/vendors/hip.h
+++ b/ggml/src/ggml-cuda/vendors/hip.h
@@ -143,6 +143,9 @@
 #define cudaGraphExecUpdate hipGraphExecUpdate
 #define cudaStreamCaptureModeRelaxed hipStreamCaptureModeRelaxed
 #define cudaStreamBeginCapture hipStreamBeginCapture
+#define cudaStreamIsCapturing hipStreamIsCapturing
+#define cudaStreamCaptureStatus hipStreamCaptureStatus
+#define cudaStreamCaptureStatusNone hipStreamCaptureStatusNone
 #define cudaGraph_t hipGraph_t
 #define cudaStream_t hipStream_t
 #define cudaSuccess hipSuccess
-- 
