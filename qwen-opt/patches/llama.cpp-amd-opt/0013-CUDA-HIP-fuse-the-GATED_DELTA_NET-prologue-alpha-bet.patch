+// q8_1 activations of an MMVQ src1. Reuses the previous MUL_MAT's activations if it had the same src1
+// (see mmvq_q8_cache_t), else quantizes into the cache (allow_cache) or into storage taken from pool.
+// The cache buffer is allocated once, outside of graph capture, and never reallocated, so captured
+// CUDA graphs can keep pointing at it.
+static const char * mmvq_src1_q8_1(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const ggml_type type_src0,
+        const bool allow_cache, ggml_cuda_pool_alloc<char> & pool) {
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && src1->nb[0] == sizeof(float));
+    cudaStream_t stream = ctx.stream();
+
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne12 = src1->ne[2];
+    const int64_t ne13 = src1->ne[3];
+
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const size_t  q8_size     = ne13*ne12 * ne11*ne10_padded * sizeof(block_q8_1)/QK8_1;
+
+    constexpr size_t q8_cache_capacity = 4u << 20;
+    auto & qc = ctx.mmvq_q8_cache;
+    const bool cache_usable = allow_cache && ctx.curr_stream_no == 0 && ctx.stream_context().concurrent_events.empty() &&
+                              q8_size <= q8_cache_capacity;
+    if (cache_usable && qc.buf == nullptr) {
+        cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(stream, &capture_status));
+        if (capture_status == cudaStreamCaptureStatusNone) {
+            CUDA_CHECK(cudaMalloc(&qc.buf, q8_cache_capacity));
+            qc.buf_size = q8_cache_capacity;
+        }
+    }
+    const bool use_cache = cache_usable && qc.buf != nullptr;
+    const bool cache_hit = use_cache && qc.src == src1->data &&
+        qc.ne[0] == ne10 && qc.ne[1] == ne11 && qc.ne[2] == ne12 && qc.ne[3] == ne13 &&
+        qc.nb[1] == src1->nb[1] && qc.nb[2] == src1->nb[2] && qc.nb[3] == src1->nb[3];
+
+    char * src1_q8_1 = use_cache ? (char *) qc.buf : pool.alloc(q8_size);
+    if (!cache_hit) {
+        const int64_t s11 = src1->nb[1] / sizeof(float);
+        const int64_t s12 = src1->nb[2] / sizeof(float);
+        const int64_t s13 = src1->nb[3] / sizeof(float);
+        quantize_row_q8_1_cuda((const float *) src1->data, nullptr, src1_q8_1, type_src0, ne10, s11, s12, s13,
+                               ne10_padded, ne11, ne12, ne13, stream);
+        if (use_cache) {
+            qc.src       = src1->data;
+            qc.src_bytes = ggml_nbytes(src1);
+            for (int k = 0; k < 4; ++k) {
+                qc.ne[k] = src1->ne[k];
+                qc.nb[k] = src1->nb[k];
+            }
+        } else {
+            qc.src = nullptr;
+        }
+    }
+    return src1_q8_1;
+}
+
+// GATED_DELTA_NET alpha/beta projections plus their activation tails in one launch:
+//   gate[t][h] = softplus(W_alpha[h] . x[t] + dt[h]) * ssm_a[h]
+//   beta[t][h] = sigmoid(W_beta[h] . x[t])
+// One block per (head, projection) does the MMVQ dot product of one weight row against all tokens.
+// The per-element math matches the unfused ADD/SOFTPLUS/MUL/SIGMOID kernels; only the order of the
+// partial sums of the dot product differs from the MMVQ kernel.
+template <ggml_type type>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_gdn_ab(
+        const void * __restrict__ w_alpha, const void * __restrict__ w_beta, const block_q8_1 * __restrict__ y,
+        const float * __restrict__ dt, const float * __restrict__ ssm_a, float * __restrict__ gate, float * __restrict__ beta,
+        const int ncols_x, const int stride_row_x, const int stride_col_y, const int n_heads, const int n_tokens) {
+    constexpr int qk        = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi        = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr       = get_vdr_mmvq(type);
+    constexpr int nwarps    = 4;
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int  h       = blockIdx.x;
+    const bool is_beta = blockIdx.y != 0;
+    const void * vx    = is_beta ? w_beta : w_alpha;
+
+    const int tid = warp_size*threadIdx.y + threadIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    float tmp[MMVQ_MAX_BATCH_SIZE] = {0.0f};
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+        for (int j = 0; j < MMVQ_MAX_BATCH_SIZE; ++j) {
+            if (j < n_tokens) {
+                tmp[j] += vec_dot_q_cuda(vx, &y[j*stride_col_y + kby], h*stride_row_x + kbx, kqs);
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1][MMVQ_MAX_BATCH_SIZE][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < MMVQ_MAX_BATCH_SIZE; ++j) {
+            tmp_shared[threadIdx.y-1][j][threadIdx.x] = tmp[j];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+#pragma unroll
+    for (int j = 0; j < MMVQ_MAX_BATCH_SIZE; ++j) {
+        if (j >= n_tokens) {
+            break;
+        }
+#pragma unroll
+        for (int l = 0; l < nwarps-1; ++l) {
+            tmp[j] += tmp_shared[l][j][threadIdx.x];
+        }
+        const float sum = warp_reduce_sum<warp_size>(tmp[j]);
+        if (threadIdx.x == 0) {
+            const int i = j*n_heads + h;
+            if (is_beta) {
+                beta[i] = 1.0f / (1.0f + expf(-sum));
+            } else {
+                const float a = sum + dt[h];
+                gate[i] = ((a > 20.0f) ? a : logf(1.0f + expf(a))) * ssm_a[h];
+            }
+        }
+    }
+}
+
+bool ggml_cuda_gdn_ab_mmvq_supported(const ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+            return true;
+        default:
+            return false;
+    }
+}
+
+template <ggml_type type>
+static void gdn_ab_mmvq_launch(const void * w_alpha, const void * w_beta, const block_q8_1 * y, const float * dt,
+        const float * ssm_a, float * gate, float * beta, int ncols_x, int stride_row_x, int stride_col_y,
+        int n_heads, int n_tokens, cudaStream_t stream) {
+    const dim3 block_nums(n_heads, 2, 1);
+    const dim3 block_dims(ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size, 4, 1);
+    mul_mat_vec_q_gdn_ab<type><<<block_nums, block_dims, 0, stream>>>(
+        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens);
+}
+
+void ggml_cuda_gdn_ab_mmvq(ggml_backend_cuda_context & ctx, const ggml_tensor * w_alpha, const ggml_tensor * w_beta,
+        const ggml_tensor * x, const ggml_tensor * dt, const ggml_tensor * ssm_a, ggml_tensor * gate, ggml_tensor * beta) {
+    const ggml_type type = w_alpha->type;
+    GGML_ASSERT(w_beta->type == type && ggml_cuda_gdn_ab_mmvq_supported(type));
+    GGML_ASSERT(ggml_are_same_shape(w_alpha, w_beta) && w_alpha->nb[1] == w_beta->nb[1]);
+    GGML_ASSERT(x->ne[0] == w_alpha->ne[0] && x->ne[1] <= MMVQ_MAX_BATCH_SIZE && x->ne[2] == 1 && x->ne[3] == 1);
+
+    ggml_cuda_pool_alloc<char> pool(ctx.pool());
+    const block_q8_1 * y = (const block_q8_1 *) mmvq_src1_q8_1(ctx, x, type, /*allow_cache =*/ true, pool);
+
+    const int ncols_x      = (int) w_alpha->ne[0];
+    const int n_heads      = (int) w_alpha->ne[1];
+    const int n_tokens     = (int) x->ne[1];
+    const int stride_row_x = (int) (w_alpha->nb[1] / ggml_type_size(type));
+    const int stride_col_y = (int) (GGML_PAD(x->ne[0], MATRIX_ROW_PADDING) / QK8_1);
+
+    const void *  wa = w_alpha->data;
+    const void *  wb = w_beta->data;
+    const float * dd = (const float *) dt->data;
+    const float * ad = (const float *) ssm_a->data;
+    float *       gd = (float *) gate->data;
+    float *       bd = (float *) beta->data;
+    cudaStream_t  stream = ctx.stream();
+
+    switch (type) {
+        case GGML_TYPE_Q4_0:   gdn_ab_mmvq_launch<GGML_TYPE_Q4_0>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q4_1:   gdn_ab_mmvq_launch<GGML_TYPE_Q4_1>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q5_0:   gdn_ab_mmvq_launch<GGML_TYPE_Q5_0>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q5_1:   gdn_ab_mmvq_launch<GGML_TYPE_Q5_1>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q8_0:   gdn_ab_mmvq_launch<GGML_TYPE_Q8_0>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q2_K:   gdn_ab_mmvq_launch<GGML_TYPE_Q2_K>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q3_K:   gdn_ab_mmvq_launch<GGML_TYPE_Q3_K>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q4_K:   gdn_ab_mmvq_launch<GGML_TYPE_Q4_K>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q5_K:   gdn_ab_mmvq_launch<GGML_TYPE_Q5_K>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_Q6_K:   gdn_ab_mmvq_launch<GGML_TYPE_Q6_K>  (wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_IQ4_NL: gdn_ab_mmvq_launch<GGML_TYPE_IQ4_NL>(wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        case GGML_TYPE_IQ4_XS: gdn_ab_mmvq_launch<GGML_TYPE_IQ4_XS>(wa, wb, y, dd, ad, gd, bd, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens, stream); break;
+        default: GGML_ABORT("unsupported GDN projection type");
+    }
