+// GATED_DELTA_NET with the qwen35 prologue: alpha/beta projections + activations, l2-normalized q/k
+// (scale(rms_norm)), and the initial state gathered from a recurrent cache (get_rows). The CUDA backend
+// fuses the projections, normalizes q/k in the GDN kernel and reads the state row from the cache.
+struct test_gated_delta_net_prologue_fusion : public test_case {
+    const ggml_type w_type;
+    const int64_t   head_count;
+    const int64_t   head_size;
+    const int64_t   n_tokens;
+    const int64_t   n_embd;
+    const int       K;
+
+    std::string vars() override {
+        return VARS_TO_STR6(w_type, head_count, head_size, n_tokens, n_embd, K);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "GATED_DELTA_NET_PROLOGUE";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override { return 5e-4; }
+
+    test_gated_delta_net_prologue_fusion(ggml_type w_type, int64_t head_count, int64_t head_size, int64_t n_tokens,
+            int64_t n_embd, int K = 1)
+        : w_type(w_type), head_count(head_count), head_size(head_size), n_tokens(n_tokens), n_embd(n_embd), K(K) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t H = head_count;
+        const int64_t S = head_size;
+        const int64_t N = n_tokens;
+
+        ggml_tensor * q_in = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H, N, 1);
+        ggml_tensor * k_in = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H, N, 1);
+        const float eps = 1e-6f;
+        ggml_tensor * q = ggml_scale(ctx, ggml_rms_norm(ctx, q_in, eps/S), 1.0f/sqrtf((float) S));
+        ggml_tensor * k = ggml_scale(ctx, ggml_rms_norm(ctx, k_in, eps/S), 1.0f/sqrtf((float) S));
+        ggml_tensor * v = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H, N, 1);
+        ggml_set_name(v, "v");
+
+        ggml_tensor * x     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, N);
+        ggml_tensor * wa    = ggml_new_tensor_2d(ctx, w_type, n_embd, H);
+        ggml_tensor * wb    = ggml_new_tensor_2d(ctx, w_type, n_embd, H);
+        ggml_tensor * dt    = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, H);
+        ggml_tensor * ssm_a = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, H);
+        ggml_set_name(dt,    "dt");
+        ggml_set_name(ssm_a, "ssm_a");
+
+        ggml_tensor * alpha = ggml_mul_mat(ctx, wa, x);
+        alpha = ggml_reshape_3d(ctx, alpha, H, N, 1);
+        alpha = ggml_add(ctx, alpha, dt);
+        alpha = ggml_softplus(ctx, alpha);
+        alpha = ggml_mul(ctx, alpha, ssm_a);
+        ggml_tensor * g = ggml_reshape_4d(ctx, alpha, 1, H, N, 1);
+
+        ggml_tensor * beta = ggml_mul_mat(ctx, wb, x);
+        beta = ggml_reshape_4d(ctx, beta, 1, H, N, 1);
+        beta = ggml_sigmoid(ctx, beta);
+
+        ggml_tensor * states = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, S*S*H, 3);
+        ggml_tensor * idx    = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+        ggml_set_name(idx, "idx");
+        ggml_tensor * rows  = ggml_get_rows(ctx, states, idx);
+        ggml_tensor * state = ggml_reshape_4d(ctx, rows, S, S, H, 1);
+
+        ggml_tensor * out = ggml_gated_delta_net(ctx, q, k, v, g, beta, state, K);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (strcmp(t->name, "idx") == 0) {
+                const int32_t row = 2;
+                ggml_backend_tensor_set(t, &row, 0, sizeof(row));
+            } else if (strcmp(t->name, "ssm_a") == 0) {
+                init_tensor_uniform(t, -4.0f, -0.5f);
+            } else if (strcmp(t->name, "dt") == 0) {
+                init_tensor_uniform(t, -2.0f, 2.0f);
+            } else if (strcmp(t->name, "v") == 0) {
+                init_tensor_uniform(t, -0.3f, 5.0f);
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
