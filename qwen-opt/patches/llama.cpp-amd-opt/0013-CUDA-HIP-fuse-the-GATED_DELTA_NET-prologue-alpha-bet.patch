+
+bool ggml_cuda_gdn_l2_norm_src(const ggml_tensor * t, ggml_cuda_gdn_l2_norm & l2) {
+    // build_gdn_l2_norm: scale(rms_norm(x, eps), s)
+    if (t->op != GGML_OP_SCALE || t->type != GGML_TYPE_F32 || ggml_get_op_params_f32(t, 1) != 0.0f) {
+        return false;
+    }
+    const ggml_tensor * rms = t->src[0];
+    if (rms->op != GGML_OP_RMS_NORM || rms->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * x = rms->src[0];
+    if (x->type != GGML_TYPE_F32 || !ggml_are_same_shape(x, t) || !ggml_is_contiguous_rows(x)) {
+        return false;
+    }
+    l2.x     = x;
+    l2.eps   = ggml_get_op_params_f32(rms, 0);
+    l2.scale = ggml_get_op_params_f32(t, 0);
+    return true;
+}
+
+bool ggml_cuda_gdn_fuse_l2_norm(const ggml_tensor * gdn, ggml_cuda_gdn_l2_norm & l2_q, ggml_cuda_gdn_l2_norm & l2_k) {
+    if (gdn->op != GGML_OP_GATED_DELTA_NET ||
+            !ggml_cuda_gdn_l2_norm_src(gdn->src[0], l2_q) || !ggml_cuda_gdn_l2_norm_src(gdn->src[1], l2_k)) {
+        return false;
+    }
+    // one eps/scale pair for both, q and k share their strides, and every (head, token) row is one segment of S_v
+    return l2_q.eps == l2_k.eps && l2_q.scale == l2_k.scale && ggml_are_same_stride(l2_q.x, l2_k.x) &&
+           l2_q.x->ne[0] == gdn->src[2]->ne[0];
+}
+
+const ggml_tensor * ggml_cuda_gdn_state_gather(const ggml_tensor * gdn) {
+    // build_rs: state = reshape(view(get_rows(states, s_copy))) for a single sequence without extra states;
+    // nothing between the gather and the GDN writes to the gathered rows in that case
+    if (gdn->op != GGML_OP_GATED_DELTA_NET) {
+        return nullptr;
+    }
+    const ggml_tensor * state = gdn->src[5];
+    const ggml_tensor * rows  = state->view_src;
+    if (rows == nullptr || rows->op != GGML_OP_GET_ROWS || state->view_offs != 0 || !ggml_is_contiguous(state)) {
+        return nullptr;
+    }
+    const ggml_tensor * states = rows->src[0];
+    const ggml_tensor * idx    = rows->src[1];
+    if (states->type != GGML_TYPE_F32 || rows->type != GGML_TYPE_F32 || idx->type != GGML_TYPE_I32 ||
+            !ggml_is_contiguous(states) || !ggml_is_contiguous(rows) || ggml_nelements(idx) != 1 ||
+            rows->ne[1] != 1 || rows->ne[2] != 1 || rows->ne[3] != 1 || states->ne[2] != 1 || states->ne[3] != 1 ||
+            state->ne[3] != 1 || ggml_nelements(state) != rows->ne[0]) {
+        return nullptr;
+    }
+    return rows;
 }
 
