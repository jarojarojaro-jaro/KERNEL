diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index f79753f80..c15f66532 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3536,7 +3536,191 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
     return false;
 }
 
-// try and fuse nodes and return the number of nodes to skip
+// index of the first of the next 64 nodes after node_idx that reads t, or -1
+static int ggml_cuda_find_consumer(const ggml_cgraph * cgraph, int node_idx, const ggml_tensor * t) {
+    for (int j = node_idx + 1; j < std::min(cgraph->n_nodes, node_idx + 65); ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] == t) {
+                return j;
+            }
+        }
+    }
+    return -1;
+}
+
+// a node that reads tensor t (directly, or through a chain of views of t)
+struct ggml_cuda_reader {
+    int                 idx; // node index
+    int                 src; // src slot of the node
+    const ggml_tensor * via; // t or the view of t the node reads
+};
+
+// Collects the computing readers of node ti among the next `window` nodes, following view chains. Empty readers
+// (they compute nothing) are dropped. Returns false when the readers found do not account for every use of the
+// node (or of one of its views) or when the node is a graph output, i.e. when some reader may be elsewhere.
+static bool ggml_cuda_collect_readers(const ggml_cgraph * cgraph, int ti, int window, std::vector<ggml_cuda_reader> & readers) {
+    const ggml_tensor * t = cgraph->nodes[ti];
+    if (t->flags & GGML_TENSOR_FLAG_OUTPUT) {
+        return false;
+    }
+    const int end = std::min(cgraph->n_nodes, ti + 1 + window);
+    int found = 0;
+    for (int j = ti + 1; j < end; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] != t) {
+                continue;
+            }
+            ++found;
+            if (ggml_is_empty(n)) {
+                continue;
+            }
+            if (n->op == GGML_OP_VIEW || n->op == GGML_OP_RESHAPE || n->op == GGML_OP_PERMUTE || n->op == GGML_OP_TRANSPOSE) {
+                if (!ggml_cuda_collect_readers(cgraph, j, end - 1 - j, readers)) {
+                    return false;
+                }
+                continue;
+            }
+            readers.push_back({ j, s, t });
+        }
+    }
+    return found == ggml_node_get_use_count(cgraph, ti);
+}
+
+// the GET_ROWS gather of the initial recurrent state, when every reader is a GDN that reads the row in place
+static bool ggml_cuda_gdn_state_gather_elided(const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (node->op != GGML_OP_GET_ROWS || node->ne[1] != 1) {
+        return false;
+    }
+    std::vector<ggml_cuda_reader> readers;
+    if (!ggml_cuda_collect_readers(cgraph, i, 64, readers) || readers.empty()) {
+        return false;
+    }
+    for (const ggml_cuda_reader & r : readers) {
+        if (r.src != 5 || ggml_cuda_gdn_state_gather(cgraph->nodes[r.idx]) != node) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Nodes of the GATED_DELTA_NET prologue whose results the GDN kernel computes or reads itself
+// (see ggml_cuda_gdn_fuse_l2_norm, ggml_cuda_gdn_state_gather), so they need not run at all:
+//  - the RMS_NORM and SCALE of build_gdn_l2_norm(q/k) when their only consumer is such a GDN;
+//  - the GET_ROWS gather of the initial recurrent state when only that GDN reads it.
+static bool ggml_cuda_gdn_prologue_elided(const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * node = cgraph->nodes[i];
+
+    if (node->op == GGML_OP_RMS_NORM || node->op == GGML_OP_SCALE) {
+        const ggml_tensor * scale = node;
+        int scale_idx = i;
+        if (node->op == GGML_OP_RMS_NORM) {
+            if (i + 1 >= cgraph->n_nodes || cgraph->nodes[i + 1]->op != GGML_OP_SCALE || cgraph->nodes[i + 1]->src[0] != node ||
+                    !ggml_node_has_n_uses(cgraph, i, 1)) {
+                return false;
+            }
+            scale     = cgraph->nodes[i + 1];
+            scale_idx = i + 1;
+        } else if (i == 0 || cgraph->nodes[i - 1] != node->src[0] || !ggml_node_has_n_uses(cgraph, i - 1, 1)) {
+            return false;
+        }
+        if (!ggml_node_has_n_uses(cgraph, scale_idx, 1)) {
+            return false;
+        }
+        const int j = ggml_cuda_find_consumer(cgraph, scale_idx, scale);
+        if (j < 0) {
+            return false;
+        }
+        const ggml_tensor * gdn = cgraph->nodes[j];
+        ggml_cuda_gdn_l2_norm l2_q;
+        ggml_cuda_gdn_l2_norm l2_k;
+        return (gdn->src[0] == scale || gdn->src[1] == scale) && ggml_cuda_gdn_fuse_l2_norm(gdn, l2_q, l2_k);
+    }
+
+    if (node->op == GGML_OP_GET_ROWS) {
+        return ggml_cuda_gdn_state_gather_elided(cgraph, i);
+    }
+
+    return false;
+}
+
+// GATED_DELTA_NET alpha/beta projections and their activation tails:
+//   alpha: mul_mat -> reshape -> add(dt) -> softplus -> mul(ssm_a) -> reshape
+//   beta:  mul_mat -> reshape -> sigmoid
+// all done by one MMVQ launch (ggml_cuda_gdn_ab_mmvq). Returns the number of nodes to skip.
+static int ggml_cuda_try_gdn_ab_fusion(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    const std::initializer_list<enum ggml_op> ops = {
+        GGML_OP_MUL_MAT, GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_RESHAPE,
+        GGML_OP_MUL_MAT, GGML_OP_RESHAPE, GGML_OP_UNARY,
+    };
+    if (cuda_ctx->curr_stream_no != 0 || !cuda_ctx->stream_context().concurrent_events.empty() ||
+            !ggml_can_fuse_subgraph(cgraph, i, ops, { i + 5, i + 8 }) ||
+            !ggml_check_edges(cgraph, i, {{1, 0, 0}, {3, 0, 2}, {5, 0, 4}, {7, 0, 6}, {8, 0, 7}})) {
+        return 0;
+    }
+
+    const ggml_tensor * alpha_mm      = cgraph->nodes[i + 0];
+    const ggml_tensor * alpha_reshape = cgraph->nodes[i + 1];
+    const ggml_tensor * alpha_add     = cgraph->nodes[i + 2];
+    const ggml_tensor * alpha_sp      = cgraph->nodes[i + 3];
+    const ggml_tensor * alpha_mul     = cgraph->nodes[i + 4];
+    ggml_tensor *       gate_out      = cgraph->nodes[i + 5];
+    const ggml_tensor * beta_mm       = cgraph->nodes[i + 6];
+    ggml_tensor *       beta_out      = cgraph->nodes[i + 8];
+
+    if (ggml_get_unary_op(alpha_sp) != GGML_UNARY_OP_SOFTPLUS || ggml_get_unary_op(beta_out) != GGML_UNARY_OP_SIGMOID) {
+        return 0;
+    }
+    if ((alpha_add->src[0] != alpha_reshape && alpha_add->src[1] != alpha_reshape) ||
+            (alpha_mul->src[0] != alpha_sp && alpha_mul->src[1] != alpha_sp)) {
+        return 0;
+    }
+    const ggml_tensor * dt    = alpha_add->src[0] == alpha_reshape ? alpha_add->src[1] : alpha_add->src[0];
+    const ggml_tensor * ssm_a = alpha_mul->src[0] == alpha_sp      ? alpha_mul->src[1] : alpha_mul->src[0];
+
+    const ggml_tensor * w_alpha = alpha_mm->src[0];
+    const ggml_tensor * w_beta  = beta_mm->src[0];
+    const ggml_tensor * x       = alpha_mm->src[1];
+
+    const int64_t M = w_alpha->ne[1];
+    const int64_t N = x->ne[1];
+    const int cc = ggml_cuda_info().devices[cuda_ctx->device].cc;
+
+    if (beta_mm->src[1] != x || w_alpha->type != w_beta->type || !ggml_cuda_gdn_ab_mmvq_supported(w_alpha->type) ||
+            !ggml_are_same_shape(w_alpha, w_beta) || w_alpha->nb[1] != w_beta->nb[1] ||
+            !ggml_is_contiguous(w_alpha) || !ggml_is_contiguous(w_beta) || !ggml_is_matrix(w_alpha) ||
+            !ggml_cuda_should_use_mmvq(w_alpha->type, cc, N)) {
+        return 0;
+    }
+    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous_rows(x) || x->ne[2] != 1 || x->ne[3] != 1 ||
+            N > MMVQ_MAX_BATCH_SIZE) {
+        return 0;
+    }
+    // outputs: [M, N] contiguous, head values of a token next to each other
+    if (gate_out->type != GGML_TYPE_F32 || beta_out->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(gate_out) || !ggml_is_contiguous(beta_out) || !ggml_is_contiguous(alpha_mul) ||
+            ggml_nelements(gate_out) != M*N || ggml_nelements(beta_out) != M*N ||
+            alpha_mm->ne[0] != M || alpha_mm->ne[1] != N || beta_mm->ne[0] != M || beta_mm->ne[1] != N ||
+            !ggml_are_same_shape(alpha_reshape, alpha_mul)) {
+        return 0;
+    }
+    // dt and ssm_a broadcast over the tokens: one value per head
+    if (dt->type != GGML_TYPE_F32 || ssm_a->type != GGML_TYPE_F32 || !ggml_is_contiguous(dt) || !ggml_is_contiguous(ssm_a) ||
+            dt->ne[0] != M || ggml_nelements(dt) != M || ssm_a->ne[0] != M || ggml_nelements(ssm_a) != M) {
+        return 0;
+    }
+    const int out_nodes[] = { i + 5, i + 8 };
+    if (!ggml_cuda_check_fusion_memory_ranges(cgraph, i, (int) ops.size(), out_nodes, 2)) {
+        return 0;
+    }
+
+    ggml_cuda_gdn_ab_mmvq(*cuda_ctx, w_alpha, w_beta, x, dt, ssm_a, gate_out, beta_out);
+    return (int) ops.size() - 1;
+}
