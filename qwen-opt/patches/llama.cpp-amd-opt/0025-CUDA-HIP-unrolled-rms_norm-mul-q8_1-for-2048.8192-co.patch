diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index bb29d3d6e..28fe988c7 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -185,6 +185,108 @@ static __global__ void rms_norm_f32(const float * x,
     }
 }
 
+// rms_norm*mul (+ the q8_1 copy) of rows of exactly NV*1024 columns. Thread t owns the columns t + 1024*k and every sum
+// is formed in the same order and pairing as rms_norm_f32<1024, true> (bitwise identical), but the NV loads of x and
+// mul are issued up front, the reductions use DPP exchanges instead of LDS round trips and the NV q8_1 groups of a
+// thread are unrolled so that their exchanges overlap.
+template <int NV>
+__launch_bounds__(1024, 1)
+static __global__ void rms_norm_mul_f32_unrolled(const float * x,
+                                                 float *       dst,
+                                                 const int     ncols,
+                                                 const int     nchannels,
+                                                 const int     nsamples,
+                                                 const int64_t stride_row,
+                                                 const int64_t stride_channel,
+                                                 const int64_t stride_sample,
+                                                 const float   eps,
+                                                 const float * mul,
+                                                 const int64_t mul_stride_row,
+                                                 const int64_t mul_stride_channel,
+                                                 const int64_t mul_stride_sample,
+                                                 const uint3   mul_ncols_packed,
+                                                 const uint3   mul_nrows_packed,
+                                                 const uint3   mul_nchannels_packed,
+                                                 const uint3   mul_nsamples_packed,
+                                                 block_q8_1  * q8) {
+    constexpr int block_size = 1024;
+    ggml_cuda_pdl_lc();
+    const int nrows   = gridDim.x;
+    const int row     = blockIdx.x;
+    const int tid     = threadIdx.x;
+    const int lane_id = tid % WARP_SIZE;
+    const int warp_id = tid / WARP_SIZE;
+
+    __shared__ float s_sum[block_size/WARP_SIZE];
+
+    ggml_cuda_pdl_sync();
+
+    for (int sample = blockIdx.z; sample < nsamples; sample += gridDim.z) {
+        for (int channel = blockIdx.y; channel < nchannels; channel += gridDim.y) {
+            const float * xc   = x   + sample*stride_sample + channel*stride_channel + row*stride_row;
+            float       * dstc = dst + ((sample*nchannels + channel)*nrows + row)*ncols;
+            const float * mulc = mul + fastmodulo(sample,  mul_nsamples_packed)  * mul_stride_sample
+                                     + fastmodulo(channel, mul_nchannels_packed) * mul_stride_channel
+                                     + fastmodulo(row,     mul_nrows_packed)     * mul_stride_row;
+
+            float xv[NV];
+            float mv[NV];
+#pragma unroll
+            for (int k = 0; k < NV; ++k) {
+                xv[k] = xc[tid + k*block_size];
+            }
+#pragma unroll
+            for (int k = 0; k < NV; ++k) {
+                mv[k] = mulc[fastmodulo(tid + k*block_size, mul_ncols_packed)];
+            }
+
+            // explicit fmas: the loop of rms_norm_f32 contracts tmp += xi*xi into one fma per column, in column order;
+            // unrolled, the backend would be free to fuse the first product into the second add instead
+            float tmp = 0.0f;
+#pragma unroll
+            for (int k = 0; k < NV; ++k) {
+                tmp = fmaf(xv[k], xv[k], tmp);
+            }
+
+            // block_reduce<SUM, 1024>: warp sums, then every lane of every warp sums the 32 warp sums
+            tmp = warp_reduce_sum_dpp(tmp);
+            if (lane_id == 0) {
+                s_sum[warp_id] = tmp;
+            }
+            __syncthreads();
+            tmp = warp_reduce_sum_dpp(s_sum[lane_id]);
+
+            const float mean  = tmp / ncols;
+            const float scale = rsqrtf(mean + eps);
+
+            float v[NV];
+#pragma unroll
+            for (int k = 0; k < NV; ++k) {
+                v[k] = scale * xv[k] * mv[k];
+                dstc[tid + k*block_size] = v[k];
+            }
+            if (q8 != nullptr) {
+                const int64_t i0 = (dstc - dst) + tid;
+#pragma unroll
+                for (int k = 0; k < NV; ++k) {
+                    const int64_t i = i0 + k*block_size;
+                    quantize_q8_1_group<true>(v[k], q8 + i/QK8_1, i % QK8_1);
+                }
+            }
+
+            if (gridDim.y < nchannels || gridDim.z < nsamples) {
+                __syncthreads(); // s_sum is reused by the next row
+            }
+        }
+    }
+}
+
+// GGML_HIP_NORM_FAST=0: rms_norm*mul rows of 2048..8192 columns take rms_norm_f32<1024, true> instead
+static bool rms_norm_mul_unrolled_enabled() {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_NORM_FAST");
+    return enabled;
+}
+
 template <int block_size>
 static __global__ void rms_norm_back_f32(
         const float * grad, const float * xf, float * dst, const int ncols, const float eps) {
@@ -410,6 +512,24 @@ static void rms_norm_mul_f32_cuda(const float *  x,
                 mul_stride_sample, mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed, mul_nsamples_packed,
                 // underlying cudaLaunchKernelEx does not support default params
             nullptr, 0, 0, 0, make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), 1.0f, q8);
+        } else if (rms_norm_mul_unrolled_enabled() && ncols % 1024 == 0 && ncols/1024 >= 2 && ncols/1024 <= 8) {
+            const auto launch = [&](auto nv_tag) {
+                constexpr int NV = decltype(nv_tag)::value;
+                const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{blocks_num, dim3(1024, 1, 1), 0, stream};
+                ggml_cuda_kernel_launch(rms_norm_mul_f32_unrolled<NV>, launch_params,
+                    x, dst, ncols, nchannels, nsamples, stride_row, stride_channel, stride_sample, eps, mul, mul_stride_row,
+                    mul_stride_channel, mul_stride_sample, mul_ncols_packed, mul_nrows_packed, mul_nchannels_packed,
+                    mul_nsamples_packed, q8);
+            };
+            switch (ncols/1024) {
+                case 2: launch(std::integral_constant<int, 2>{}); break;
+                case 3: launch(std::integral_constant<int, 3>{}); break;
+                case 4: launch(std::integral_constant<int, 4>{}); break;
+                case 5: launch(std::integral_constant<int, 5>{}); break;
+                case 6: launch(std::integral_constant<int, 6>{}); break;
+                case 7: launch(std::integral_constant<int, 7>{}); break;
+                case 8: launch(std::integral_constant<int, 8>{}); break;
+            }
         } else {
             const dim3 block_dims(1024, 1, 1);
             const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float): 0, stream};
