 ggml/src/ggml-cuda/common.cuh |  59 ++++++++++++++++-
 ggml/src/ggml-cuda/mmvq.cu    |  35 ++--------
 ggml/src/ggml-cuda/norm.cu    | 120 ++++++++++++++++++++++++++++++++++
 3 files changed, 180 insertions(+), 34 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 1758ee35b..cb17cf202 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -533,6 +533,53 @@ static __device__ __forceinline__ float warp_reduce_max(float x) {
     return x;
 }
 
+#if defined(GGML_USE_HIP) && defined(RDNA)
+#define GGML_CUDA_DPP_REDUCE
+// x of lane ^ o within a wave32: permlanex16 for o = 16, DPP row_xmask for o < 16 (no LDS round trip; hipcc does not
+// turn an xor shuffle into these by itself)
+template <int o>
+static __device__ __forceinline__ float ggml_cuda_xor_dpp(const float x) {
+    static_assert(o == 16 || o == 8 || o == 4 || o == 2 || o == 1, "ggml_cuda_xor_dpp: bad offset");
+    if constexpr (o == 16) {
+        return __int_as_float(__builtin_amdgcn_permlanex16(__float_as_int(x), __float_as_int(x), 0x76543210, 0xfedcba98, false, false));
+    } else {
+        return __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(x), 0x160 + o, 0xf, 0xf, false));
+    }
+}
+#endif // defined(GGML_USE_HIP) && defined(RDNA)
+
+// warp_reduce_sum / warp_reduce_max with the same xor width/2, ..., 1 pairing (and operand order), hence bitwise
+// identical, but on RDNA wave32 via permlanex16 + DPP row_xmask instead of ds_bpermute round trips through LDS.
+template<int width = WARP_SIZE>
+static __device__ __forceinline__ float warp_reduce_sum_dpp(float x) {
+#ifdef GGML_CUDA_DPP_REDUCE
+    if constexpr (width <= 32) {
+        if constexpr (width >= 32) { x += ggml_cuda_xor_dpp<16>(x); }
+        if constexpr (width >= 16) { x += ggml_cuda_xor_dpp< 8>(x); }
+        if constexpr (width >=  8) { x += ggml_cuda_xor_dpp< 4>(x); }
+        if constexpr (width >=  4) { x += ggml_cuda_xor_dpp< 2>(x); }
+        if constexpr (width >=  2) { x += ggml_cuda_xor_dpp< 1>(x); }
+        return x;
+    }
+#endif // GGML_CUDA_DPP_REDUCE
+    return warp_reduce_sum<width>(x);
+}
+
+template<int width = WARP_SIZE>
+static __device__ __forceinline__ float warp_reduce_max_dpp(float x) {
+#ifdef GGML_CUDA_DPP_REDUCE
+    if constexpr (width <= 32) {
+        if constexpr (width >= 32) { x = fmaxf(x, ggml_cuda_xor_dpp<16>(x)); }
+        if constexpr (width >= 16) { x = fmaxf(x, ggml_cuda_xor_dpp< 8>(x)); }
+        if constexpr (width >=  8) { x = fmaxf(x, ggml_cuda_xor_dpp< 4>(x)); }
+        if constexpr (width >=  4) { x = fmaxf(x, ggml_cuda_xor_dpp< 2>(x)); }
+        if constexpr (width >=  2) { x = fmaxf(x, ggml_cuda_xor_dpp< 1>(x)); }
+        return x;
+    }
+#endif // GGML_CUDA_DPP_REDUCE
+    return warp_reduce_max<width>(x);
+}
+
 // The half2 (d, sum) of a q8_1 block, each clamped to the finite fp16 range. One large activation can push the block
 // sum (or amax/127) past 65504, the fp16 store becomes inf and inf*0 in the dot products turns into NaN (same defect as
 // ggml-org/llama.cpp#23606). Bitwise no-op for every value that already converts to a finite half (|v| < 65520 rounds
@@ -544,13 +591,19 @@ static __device__ __forceinline__ half2 make_q8_1_ds(const float d, const float
 
 // Quantizes a block_q8_1 from 32 consecutive lanes holding its 32 values in order (lane % 32 == iqs), exactly as
 // the quantize_q8_1 kernel does. Lets an elementwise producer write the q8_1 copy of its output for MMVQ.
-// All 32 lanes of the group must be active.
+// All 32 lanes of the group must be active. dpp: the exchanges via warp_reduce_*_dpp (same bits).
+template <bool dpp = false>
 static __device__ __forceinline__ void quantize_q8_1_group(const float xi, block_q8_1 * y, const int iqs) {
     float amax = fabsf(xi);
     float sum  = xi;
 
-    amax = warp_reduce_max<QK8_1>(amax);
-    sum  = warp_reduce_sum<QK8_1>(sum);
+    if constexpr (dpp) {
+        amax = warp_reduce_max_dpp<QK8_1>(amax);
+        sum  = warp_reduce_sum_dpp<QK8_1>(sum);
+    } else {
+        amax = warp_reduce_max<QK8_1>(amax);
+        sum  = warp_reduce_sum<QK8_1>(sum);
+    }
 
     const float  d = amax / 127.0f;
     const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
