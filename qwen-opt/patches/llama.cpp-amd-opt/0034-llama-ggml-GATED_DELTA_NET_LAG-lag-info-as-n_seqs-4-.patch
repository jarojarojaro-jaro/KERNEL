@@ -88,10 +88,9 @@ public:
     std::vector<uint32_t> rs_pend_n;     // per cell row
     std::vector<uint8_t>  rs_pend_plane; // per cell row
 
-    // fills the GATED_DELTA_NET_LAG inputs of a ubatch placed at head: the state gather index without rollback
-    // planes (s_copy_s, n_rs entries) and the per-sequence lag info (lag, 4 x n_seqs), then records the ubatch's
-    // rows as the new pending rows
-    void set_input_lag(int32_t * s_copy_s, int32_t * lag, uint32_t n_rs, const llama_ubatch & ubatch);
+    // fills the GATED_DELTA_NET_LAG lag info [n_seqs, 4] of a ubatch placed at head (its first row, the source rows,
+    // is also the state gather index without rollback planes), then records the ubatch's rows as the new pending rows
+    void set_input_lag(int32_t * lag, uint32_t n_rs, const llama_ubatch & ubatch);
 
     // computed before each graph build
     uint32_t n = 0;
@@ -203,7 +202,7 @@ public:
 
     int32_t s_copy(int i) const;
 
-    void set_input_lag(int32_t * s_copy_s, int32_t * lag) const;
+    void set_input_lag(int32_t * lag) const;
 
 private:
     const llama_memory_status status;
