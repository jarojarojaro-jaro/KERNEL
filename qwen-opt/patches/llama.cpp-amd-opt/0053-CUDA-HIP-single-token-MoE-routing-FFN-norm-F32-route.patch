+// The nodes of one fused topk_moe launch (all variants but the delayed softmax) starting at the gating node i, as the
+// topk-moe fusion of ggml_cuda_try_fuse matches them: n_ops nodes from i, ids and weights at ids_idx / weights_idx.
+struct ggml_cuda_topk_moe_gating_match {
+    int                     n_ops       = 0;
+    int                     ids_idx     = -1;
+    int                     weights_idx = -1;
+    ggml_cuda_topk_moe_args args;
+    const ggml_tensor *     logits  = nullptr;
+    ggml_tensor *           weights = nullptr;
+    ggml_tensor *           ids     = nullptr;
+    const ggml_tensor *     bias    = nullptr;
+    const ggml_tensor *     clamp   = nullptr;
+    const ggml_tensor *     scale   = nullptr;
+};
+
+static bool ggml_cuda_topk_moe_match_gating(const ggml_cgraph * cgraph, int i, ggml_cuda_topk_moe_gating_match & m) {
+    m = {};
+    if (!ggml_cuda_topk_moe_fusion(cgraph, i, m.args) || m.args.delayed_softmax) {
+        return false;
+    }
+    const ggml_tensor * node = cgraph->nodes[i];
+    std::vector<ggml_op> ops;
+    ops.reserve(13);  // max ops; avoids gcc -Wstringop-overflow false positive
+    int out_nodes[2];  // nodes which can't be elided
+
+    m.logits = node->src[0];
+    if (m.args.sigmoid) {
+        ops.insert(ops.end(), { GGML_OP_UNARY });
+    } else if (m.args.sqrt_softplus) {
+        ops.insert(ops.end(), { GGML_OP_UNARY, GGML_OP_SQRT });
+    } else {
+        ops.insert(ops.end(), { GGML_OP_SOFT_MAX });
+    }
+    const int i_probs = i + (int) ops.size() - 1;  // last node of the gating activation
+
+    if (m.args.prob_bias) {
+        m.bias = cgraph->nodes[i_probs + 2]->src[1];
+        ops.insert(ops.end(), { GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_ARGSORT, GGML_OP_VIEW,
+                                GGML_OP_GET_ROWS });
+        out_nodes[0] = i_probs + 4;
+    } else {
+        ops.insert(ops.end(), { GGML_OP_RESHAPE, GGML_OP_ARGSORT, GGML_OP_VIEW, GGML_OP_GET_ROWS });
+        out_nodes[0] = i_probs + 3;
+    }
+    m.ids = cgraph->nodes[out_nodes[0]];
+
+    if (m.args.norm) {
+        ops.insert(ops.end(),
+                   { GGML_OP_RESHAPE, GGML_OP_SUM_ROWS, GGML_OP_CLAMP, GGML_OP_DIV, GGML_OP_RESHAPE });
+        m.clamp = cgraph->nodes[i + ops.size() - 3];
+    }
+    if (m.args.scale) {
+        ops.insert(ops.end(), { GGML_OP_SCALE });
+        m.scale = cgraph->nodes[i + ops.size() - 1];
+    }
+
+    m.weights    = cgraph->nodes[i + ops.size() - 1];
+    out_nodes[1] = i + ops.size() - 1;
+
+    if (ggml_can_fuse_subgraph(cgraph, i, ops.size(), ops.data(), out_nodes, 2) &&
+            ggml_cuda_should_use_topk_moe(node, m.logits, m.weights, m.ids) &&
+            ggml_cuda_check_fusion_memory_ranges(cgraph, i, ops.size(), out_nodes, 2, /*is_topk_moe=*/true)) {
+        m.n_ops       = (int) ops.size();
+        m.ids_idx     = out_nodes[0];
+        m.weights_idx = out_nodes[1];
+        return true;
+    }
+    return false;
+}
+
+// The device counters of ggml_backend_cuda_context::tickets, allocated (and zeroed) on first use outside of stream
+// capture; nullptr while capturing before that.
+static unsigned int * ggml_cuda_tickets(ggml_backend_cuda_context * ctx) {
+    if (ctx->tickets == nullptr) {
+        cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(ctx->stream(), &capture_status));
+        if (capture_status == cudaStreamCaptureStatusNone) {
+            CUDA_CHECK(cudaMalloc(&ctx->tickets, ctx->n_tickets*sizeof(unsigned int)));
+            CUDA_CHECK(cudaMemsetAsync(ctx->tickets, 0, ctx->n_tickets*sizeof(unsigned int), ctx->stream()));
+        }
+    }
+    return ctx->tickets;
+}
+
+// [GGML_HIP_NORM_ROUTER] single-token MoE routing: RMS_NORM, MUL (the FFN norm, which also writes the q8_1 copy for
+// the gate/up MUL_MAT_ID), the F32 router MUL_MAT and the topk_moe nodes in one launch (ggml_cuda_op_norm_router_topk):
+// every router block forms the norm itself, the last one to finish does the top-k. Bitwise as the three launches
+// (rms_norm*mul, mul_mat_vec_f, topk_moe). Returns the nodes to skip, 0: no.
+static int ggml_cuda_try_norm_router_topk(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool enabled = ggml_cuda_env_switch("GGML_HIP_NORM_ROUTER");
+    if (!enabled || cuda_ctx->curr_stream_no != 0 || !cuda_ctx->stream_context().concurrent_events.empty() ||
+            i + 3 >= cgraph->n_nodes || !ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return 0;
+    }
+    const ggml_tensor * norm   = cgraph->nodes[i];
+    ggml_tensor *       mul    = cgraph->nodes[i + 1];
+    ggml_tensor *       router = cgraph->nodes[i + 2];
+    const ggml_tensor * x      = norm->src[0];
+    const ggml_tensor * norm_w = mul->src[0] == norm ? mul->src[1] : mul->src[0];
+    if (router->op != GGML_OP_MUL_MAT || router->src[1] != mul || (router->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    const ggml_tensor * router_w = router->src[0];
+    // the router as the unfused graph runs it: mul_mat_vec_f (see ggml_cuda_mul_mat)
+    const int  cc        = ggml_cuda_info().devices[cuda_ctx->device].cc;
+    const int  warp_size = ggml_cuda_info().devices[cuda_ctx->device].warp_size;
+    const bool bad_padding_clear = ggml_backend_buffer_get_usage(router_w->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+        ggml_nbytes(router_w) != ggml_backend_buffer_get_alloc_size(router_w->buffer, router_w) && router_w->view_src;
+    if (warp_size != WARP_SIZE || bad_padding_clear || ggml_cuda_op_mul_mat_use_fwht(router) ||
+            !ggml_cuda_should_use_mmvf(router_w->type, cc, warp_size, router_w->ne, router_w->nb, 1) ||
+            !ggml_cuda_norm_router_topk_supported(x, norm_w, mul, router_w, router)) {
+        return 0;
+    }
+    ggml_cuda_topk_moe_gating_match m;
+    if (!ggml_cuda_topk_moe_match_gating(cgraph, i + 3, m) || m.logits != router) {
+        return 0;
+    }
+    // the norm output goes on to the gate/up MUL_MAT_ID, the router output only to the top-k
+    std::vector<ggml_op> ops = { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_MUL_MAT };
+    for (int j = i + 3; j < i + 3 + m.n_ops; ++j) {
+        ops.push_back(cgraph->nodes[j]->op);
+    }
+    const int outs[4] = { i + 1, m.ids_idx, m.weights_idx, i + 2 };
+    if (!ggml_can_fuse_subgraph(cgraph, i, (int) ops.size(), ops.data(), outs, 3) ||
+            !ggml_cuda_check_fusion_memory_ranges(cgraph, i, (int) ops.size(), outs, 4)) {
+        return 0;
+    }
+    unsigned int * tickets = ggml_cuda_tickets(cuda_ctx);
+    if (tickets == nullptr) {
+        return 0;
+    }
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    block_q8_1 * q8 = ggml_cuda_q8_1_producer_target(cuda_ctx, cgraph, i + 1);
+    ggml_cuda_op_norm_router_topk(*cuda_ctx, x, norm_w, eps, mul, q8, router_w, router, m.weights, m.ids, m.clamp, m.scale,
+                                  m.bias, m.args, tickets);
+    return (int) ops.size() - 1;
+}
