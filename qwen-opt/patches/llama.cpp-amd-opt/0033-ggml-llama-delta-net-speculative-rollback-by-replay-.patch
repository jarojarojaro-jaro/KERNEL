+// GGML_OP_GATED_DELTA_NET_LAG, two calls chained as in consecutive speculative verifies: the first replays p1 rows
+// of a pending buffer, runs n1 rows and writes its pending rows, whose first p2 the second replays before its n2
+// rows. Call 1 is shaped like the model graph (l2-normalized q/k from scale(rms_norm), the state gathered from a
+// cache, the state CPYd into a cache); call 2 reads that CPYd state and takes plain q/k.
+struct test_gated_delta_net_lag : public test_case {
+    const int64_t head_count;
+    const int64_t head_size;
+    const int     v_repeat;
+    const int64_t n1;
+    const int64_t n2;
+    const int64_t K;
+    const int32_t p1;
+    const int32_t p2;
+
+    std::string vars() override {
+        return VARS_TO_STR8(head_count, head_size, v_repeat, n1, n2, K, p1, p2);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "GATED_DELTA_NET_LAG";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    test_gated_delta_net_lag(int64_t head_count = 4, int64_t head_size = 32, int v_repeat = 1, int64_t n1 = 5,
+            int64_t n2 = 5, int64_t K = 5, int32_t p1 = 2, int32_t p2 = 3)
+        : head_count(head_count), head_size(head_size), v_repeat(v_repeat), n1(n1), n2(n2), K(K), p1(p1), p2(p2) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t S   = head_size;
+        const int64_t H_k = head_count;
+        const int64_t H   = head_count * v_repeat;
+        const int64_t D   = S * S * H;
+        const int64_t R   = H * (2 * S + 2);
+
+        ggml_tensor * pend = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2 * K * R, 2);
+        ggml_set_name(pend, "pend");
+
+        // call 1
+        const float eps = 1e-6f;
+        ggml_tensor * q1 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H_k, n1, 1);
+        ggml_tensor * k1 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H_k, n1, 1);
+        q1 = ggml_scale(ctx, ggml_rms_norm(ctx, q1, eps/S), 1.0f/sqrtf((float) S));
+        k1 = ggml_scale(ctx, ggml_rms_norm(ctx, k1, eps/S), 1.0f/sqrtf((float) S));
+        ggml_tensor * v1 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H, n1, 1);
+        ggml_tensor * g1 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, H, n1, 1);
+        ggml_tensor * b1 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, H, n1, 1);
+        ggml_set_name(v1, "v");
+        ggml_set_name(g1, "g");
+        ggml_set_name(b1, "beta");
+
+        ggml_tensor * states = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, D, 2);
+        ggml_tensor * idx    = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+        ggml_set_name(idx, "idx");
+        ggml_tensor * state1 = ggml_reshape_4d(ctx, ggml_get_rows(ctx, states, idx), S, S, H, 1);
+
+        ggml_tensor * lag1 = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 4, 1);
+        ggml_set_name(lag1, "lag1");
+
+        ggml_tensor * out1 = ggml_gated_delta_net_lag(ctx, q1, k1, v1, g1, b1, state1, pend, lag1, K);
+
+        ggml_tensor * cache = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, D, 1);
+        ggml_set_name(cache, "cache");
+        ggml_tensor * tail1 = ggml_view_2d(ctx, out1, D, 1, ggml_row_size(GGML_TYPE_F32, D),
+                                           ggml_row_size(GGML_TYPE_F32, S * H * n1));
+        ggml_tensor * cpy1  = ggml_cpy(ctx, tail1, ggml_view_2d(ctx, cache, D, 1, cache->nb[1], 0));
+
+        // call 2
+        ggml_tensor * q2 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H_k, n2, 1);
+        ggml_tensor * k2 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H_k, n2, 1);
+        ggml_tensor * v2 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S, H, n2, 1);
+        ggml_tensor * g2 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, H, n2, 1);
+        ggml_tensor * b2 = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, H, n2, 1);
+        ggml_set_name(q2, "qk2");
+        ggml_set_name(k2, "qk2");
+        ggml_set_name(v2, "v");
+        ggml_set_name(g2, "g");
+        ggml_set_name(b2, "beta");
+        ggml_tensor * lag2 = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 4, 1);
+        ggml_set_name(lag2, "lag2");
+
+        ggml_tensor * state2 = ggml_reshape_4d(ctx, cpy1, S, S, H, 1);
+        ggml_tensor * out2 = ggml_gated_delta_net_lag(ctx, q2, k2, v2, g2, b2, state2, pend, lag2, K);
+
+        ggml_tensor * attn1 = ggml_view_1d(ctx, out1, S * H * n1, 0);
+        ggml_tensor * out   = ggml_concat(ctx, attn1, ggml_reshape_1d(ctx, out2, ggml_nelements(out2)), 0);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (strcmp(t->name, "idx") == 0) {
+                const int32_t row = 1;
+                ggml_backend_tensor_set(t, &row, 0, sizeof(row));
+            } else if (strcmp(t->name, "lag1") == 0) {
+                // src row 1, dst row 0, read plane 0, write plane 1
+                const int32_t info[4] = { 1, 0, p1, 0 | (1 << 1) };
+                ggml_backend_tensor_set(t, info, 0, sizeof(info));
+            } else if (strcmp(t->name, "lag2") == 0) {
+                // the rows call 1 wrote: src row 0, read plane 1; dst row 1, write plane 0
+                const int32_t info[4] = { 0, 1, p2, 1 | (0 << 1) };
+                ggml_backend_tensor_set(t, info, 0, sizeof(info));
+            } else if (strcmp(t->name, "pend") == 0) {
+                init_tensor_uniform(t, -0.1f, 0.1f);
+            } else if (strcmp(t->name, "qk2") == 0) {
+                init_tensor_uniform(t, -0.2f, 0.2f);
+            } else if (strcmp(t->name, "g") == 0) {
+                init_tensor_uniform(t, -20.0f, -1e-4f);
+            } else if (strcmp(t->name, "beta") == 0) {
+                init_tensor_uniform(t, 0.0f, 1.0f);
+            } else if (strcmp(t->name, "v") == 0) {
+                init_tensor_uniform(t, -0.3f, 5.0f);
+            } else if (strcmp(t->name, "cache") == 0) {
+                init_tensor_uniform(t, 0.0f, 0.0f);
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
