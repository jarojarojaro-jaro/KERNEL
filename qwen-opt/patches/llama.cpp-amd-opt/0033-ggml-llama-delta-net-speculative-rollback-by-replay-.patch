+    // GATED_DELTA_NET with a lagged state for speculative rollback by replay.
+    //
+    // The recurrent state lags behind the sequence: the rows of the previous call whose state is kept are stored
+    // (their post-norm k, v, g and beta) in a pending buffer and replayed into the state at the start of the next
+    // call, with the arithmetic of a sequential pass, so no per-token state snapshots are needed. Rolling back r
+    // tokens of the previous call is replaying r fewer rows.
+    //
+    //   q, k, v, g, beta, state : as ggml_gated_delta_net (scalar gate only)
+    //   pend  : F32 [>= 2*K*R, n_rows] -- per recurrent-cache row two planes of K pending rows,
+    //           row layout R = H_v*(S_k + S_v + 2): k [H_v][S_k], v [H_v][S_v], g [H_v], beta [H_v]
+    //   lag   : I32 [4, n_seqs] -- per sequence { src row, dst row, n_pend, read plane | write plane << 1 }
+    //
+    // Sequence s first replays n_pend rows of plane `read` of pend row `src` into its state, then runs its n_tokens
+    // rows; the last P = min(n_tokens, K) of them are written to plane `write` of pend row `dst` (a side effect of
+    // the op on pend). The output packs the attention scores [S_v, H_v, n_tokens, n_seqs] followed by the state
+    // [S_v, S_v, H_v, n_seqs] after the replay and the first n_tokens - P rows (the committed state).
+    GGML_API struct ggml_tensor * ggml_gated_delta_net_lag(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * q,
+            struct ggml_tensor  * k,
+            struct ggml_tensor  * v,
+            struct ggml_tensor  * g,
+            struct ggml_tensor  * beta,
+            struct ggml_tensor  * state,
+            struct ggml_tensor  * pend,
+            struct ggml_tensor  * lag,
+            int64_t               K);
+
     // DSA lightning indexer
     //
     // q:       [n_embd_idx, n_head_idx, n_batch, ne3 ]
