+
+// one recurrence step on the transposed state s (s[j*S_v + i] = S[i][j]): S = g*S + k (x) ((v - S^T k) * beta)
+static inline void ggml_gdn_cpu_update(float * s, float * delta, int64_t S_v, bool kda, const float * g_d,
+        const float * k_d, const float * v_d, float beta_val) {
+    if (kda) {
+        // precompute exp(g) into delta scratch (reused below)
+        for (int64_t i = 0; i < S_v; ++i) {
+            delta[i] = expf(g_d[i]);
+        }
+        // S[i][:] *= exp(g[i]) => for each row j of M: M[j][i] *= exp(g[i])
+        for (int64_t j = 0; j < S_v; ++j) {
+            ggml_vec_mul_f32(S_v, &s[j * S_v], &s[j * S_v], delta);
+        }
+    } else {
+        ggml_vec_scale_f32(S_v * S_v, s, expf(g_d[0]));
+    }
+
+    // delta[j] = sum_i S[i][j] * k[i] = dot(row j of M, k)
+    for (int64_t j = 0; j < S_v; ++j) {
+        float sum = 0.0f;
+        ggml_vec_dot_f32(S_v, &sum, 0, &s[j * S_v], 0, k_d, 0, 1);
+        delta[j] = (v_d[j] - sum) * beta_val;
+    }
+
+    // outer product: S[i][j] += k[i] * delta[j] => M[j][i] += delta[j] * k[i]
+    for (int64_t j = 0; j < S_v; ++j) {
+        ggml_vec_mad_f32(S_v, &s[j * S_v], k_d, delta[j]);
+    }
+}
