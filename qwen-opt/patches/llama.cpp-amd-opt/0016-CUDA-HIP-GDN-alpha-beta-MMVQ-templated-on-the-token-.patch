From ca4cccedb0bd8f488cb60a63bb951529b10168ea Mon Sep 17 00:00:00 2001
From: jarojarojaro-jaro <miki.jaroszek@gmail.com>
Date: Mon, 12 Oct 2026 19:19:18 +0000
Subject: [PATCH 16/59] CUDA/HIP: GDN alpha/beta MMVQ templated on the token
 count

All tokens' loads of an iteration are issued together; partial sums keep their order, results are
bitwise identical (greedy plain/MTP outputs unchanged).
Qwen3.8-27B MTP n=4 verify (rocprofv3): mul_mat_vec_q_gdn_ab 9.05 -> 6.1 us, 425 -> 286 us/verify.
---
 ggml/src/ggml-cuda/mmvq.cu | 39 +++++++++++++++++++++++---------------
 1 file changed, 24 insertions(+), 15 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 56c0c8467..60311f498 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -2055,12 +2055,13 @@ static const char * mmvq_src1_q8_1(ggml_backend_cuda_context & ctx, const ggml_t
 // One block per (head, projection) does the MMVQ dot product of one weight row against all tokens.
 // The per-element math matches the unfused ADD/SOFTPLUS/MUL/SIGMOID kernels; only the order of the
 // partial sums of the dot product differs from the MMVQ kernel.
-template <ggml_type type>
+// n_tokens is a template parameter so that the loads of all tokens of an iteration are issued together.
+template <ggml_type type, int n_tokens>
 __launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
 static __global__ void mul_mat_vec_q_gdn_ab(
         const void * __restrict__ w_alpha, const void * __restrict__ w_beta, const block_q8_1 * __restrict__ y,
         const float * __restrict__ dt, const float * __restrict__ ssm_a, float * __restrict__ gate, float * __restrict__ beta,
-        const int ncols_x, const int stride_row_x, const int stride_col_y, const int n_heads, const int n_tokens) {
+        const int ncols_x, const int stride_row_x, const int stride_col_y, const int n_heads) {
     constexpr int qk        = ggml_cuda_type_traits<type>::qk;
     constexpr int qi        = ggml_cuda_type_traits<type>::qi;
     constexpr int vdr       = get_vdr_mmvq(type);
@@ -2076,22 +2077,20 @@ static __global__ void mul_mat_vec_q_gdn_ab(
     const int blocks_per_row_x = ncols_x / qk;
     constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
 
-    float tmp[MMVQ_MAX_BATCH_SIZE] = {0.0f};
+    float tmp[n_tokens] = {0.0f};
     for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
         const int kby = kbx * (qk/QK8_1);
         const int kqs = vdr * (tid % (qi/vdr));
 #pragma unroll
-        for (int j = 0; j < MMVQ_MAX_BATCH_SIZE; ++j) {
-            if (j < n_tokens) {
-                tmp[j] += vec_dot_q_cuda(vx, &y[j*stride_col_y + kby], h*stride_row_x + kbx, kqs);
-            }
+        for (int j = 0; j < n_tokens; ++j) {
+            tmp[j] += vec_dot_q_cuda(vx, &y[j*stride_col_y + kby], h*stride_row_x + kbx, kqs);
         }
     }
 
-    __shared__ float tmp_shared[nwarps-1][MMVQ_MAX_BATCH_SIZE][warp_size];
+    __shared__ float tmp_shared[nwarps-1][n_tokens][warp_size];
     if (threadIdx.y > 0) {
 #pragma unroll
-        for (int j = 0; j < MMVQ_MAX_BATCH_SIZE; ++j) {
+        for (int j = 0; j < n_tokens; ++j) {
             tmp_shared[threadIdx.y-1][j][threadIdx.x] = tmp[j];
         }
     }
@@ -2101,10 +2100,7 @@ static __global__ void mul_mat_vec_q_gdn_ab(
     }
 
 #pragma unroll
-    for (int j = 0; j < MMVQ_MAX_BATCH_SIZE; ++j) {
-        if (j >= n_tokens) {
-            break;
-        }
+    for (int j = 0; j < n_tokens; ++j) {
 #pragma unroll
         for (int l = 0; l < nwarps-1; ++l) {
             tmp[j] += tmp_shared[l][j][threadIdx.x];
@@ -2148,8 +2144,21 @@ static void gdn_ab_mmvq_launch(const void * w_alpha, const void * w_beta, const
         int n_heads, int n_tokens, cudaStream_t stream) {
     const dim3 block_nums(n_heads, 2, 1);
     const dim3 block_dims(ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size, 4, 1);
-    mul_mat_vec_q_gdn_ab<type><<<block_nums, block_dims, 0, stream>>>(
-        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols_x, stride_row_x, stride_col_y, n_heads, n_tokens);
+    static_assert(MMVQ_MAX_BATCH_SIZE == 8, "update the n_tokens dispatch");
+#define GDN_AB_LAUNCH(n) mul_mat_vec_q_gdn_ab<type, n><<<block_nums, block_dims, 0, stream>>>( \
+        w_alpha, w_beta, y, dt, ssm_a, gate, beta, ncols_x, stride_row_x, stride_col_y, n_heads)
+    switch (n_tokens) {
+        case 1: GDN_AB_LAUNCH(1); break;
+        case 2: GDN_AB_LAUNCH(2); break;
+        case 3: GDN_AB_LAUNCH(3); break;
+        case 4: GDN_AB_LAUNCH(4); break;
+        case 5: GDN_AB_LAUNCH(5); break;
+        case 6: GDN_AB_LAUNCH(6); break;
+        case 7: GDN_AB_LAUNCH(7); break;
+        case 8: GDN_AB_LAUNCH(8); break;
+        default: GGML_ABORT("unsupported GDN token count");
+    }
+#undef GDN_AB_LAUNCH
 }
 
 void ggml_cuda_gdn_ab_mmvq(ggml_backend_cuda_context & ctx, const ggml_tensor * w_alpha, const ggml_tensor * w_beta,
-- 
