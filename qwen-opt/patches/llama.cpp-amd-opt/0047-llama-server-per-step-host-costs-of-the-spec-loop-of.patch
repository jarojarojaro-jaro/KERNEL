+// causal mask of a ubatch of one sequence that owns every used cell of its stream (no SWA, no ALiBi): a cell before
+// the first position of the ubatch is visible to all its tokens and an empty cell to none, so one vectorizable pass
+// over the cell positions gives a base row; each row then only revisits the cells at the ubatch's positions, from the
+// sequence's (pos, cell) index. Same values as set_input_kq_mask_impl.
+template<typename T>
+static void set_input_kq_mask_seq(const args_set_input_kq_mask & args, T * data, llama_seq_id seq_id) {
+    const auto & ubatch = *args.ubatch;
+    const auto & cells  = args.v_cells.at(args.seq_to_stream[seq_id]);
+
+    const int64_t  n_kv     = args.n_kv;
+    const uint32_t kv_beg   = args.kv_beg;
+    const uint32_t n_tokens = ubatch.n_tokens;
+    const bool     is_2d    = ubatch.is_pos_2d();
+
+    const T mask_keep = llama_cast<T>(0.0f);
+    const T mask_drop = llama_cast<T>(-INFINITY);
+
+    llama_pos p_lo = ubatch.pos[0];
+    for (uint32_t i = 1; i < n_tokens; ++i) {
+        p_lo = std::min(p_lo, ubatch.pos[i]);
+    }
+
+    const llama_pos * pos = cells.pos_data() + kv_beg;
+    for (int64_t j = 0; j < n_kv; ++j) {
+        data[j] = pos[j] >= 0 && pos[j] < p_lo ? mask_keep : mask_drop;
+    }
+    for (uint32_t i = 1; i < n_tokens; ++i) {
+        std::memcpy(data + n_kv*i, data, n_kv*sizeof(T));
+    }
+
+    const auto & sp  = cells.seq_pos_get(seq_id);
+    const auto   it0 = sp.lower_bound({ p_lo, 0u });
+
+    for (uint32_t i = 0; i < n_tokens; ++i) {
+        T * row = data + n_kv*i;
+
+        const llama_pos p1 = ubatch.pos[i];
+
+        for (auto it = it0; it != sp.end() && it->first <= p1; ++it) {
+            const uint32_t c = it->second;
+            if (c < kv_beg || c >= kv_beg + n_kv) {
+                continue;
+            }
+
+            bool keep = true;
+
+            // M-RoPE causal mask
+            if (is_2d && it->first == p1) {
+                const llama_pos p1_x = ubatch.pos[i + n_tokens*2];
+                const llama_pos p1_y = ubatch.pos[i + n_tokens];
+
+                keep = !cells.ext_get(c).is_2d_gt(p1_x, p1_y);
+            }
+
+            row[c - kv_beg] = keep ? mask_keep : mask_drop;
+        }
+    }
+}
+
