     const uint32_t n_tokens = ubatch->n_tokens;
 
@@ -1846,13 +1929,45 @@ void llama_kv_cache::set_input_kq_mask(ggml_tensor * dst, const llama_ubatch * u
         /*.n_tps            =*/ n_tps,
