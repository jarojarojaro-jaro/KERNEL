+    // one sequence owning every used cell (a single-slot server): the fast path [LLAMA_KV_MASK_FAST=0: the generic loop]
+    static const bool mask_fast = [] {
+        const char * env = getenv("LLAMA_KV_MASK_FAST");
+        return !env || atoi(env) != 0;
+    }();
+
+    llama_seq_id seq_one = -1;
+    if (mask_fast && causal_attn && !hparams.use_alibi && args.swa_type == LLAMA_SWA_TYPE_NONE && n_stream == 1 && n_tokens > 0) {
+        seq_one = ubatch->seq_id[0][0];
+        for (uint32_t i = 0; i < n_tokens && seq_one >= 0; ++i) {
+            if (ubatch->n_seq_id[i] != 1 || ubatch->seq_id[i][0] != seq_one) {
+                seq_one = -1;
+            }
+        }
+        if (seq_one >= 0) {
+            const auto & cells = v_cells.at(seq_to_stream[seq_one]);
+            if (cells.get_used() != cells.seq_pos_get(seq_one).size()) {
+                seq_one = -1;
+            }
+        }
+    }
+
     if (dst->type == GGML_TYPE_F16) {
         std::vector<ggml_fp16_t> staging;
-        set_input_kq_mask_impl<ggml_fp16_t>(args, input_data(dst, staging), causal_attn);
+        ggml_fp16_t * data = input_data(dst, staging);
+        if (seq_one >= 0) {
+            set_input_kq_mask_seq<ggml_fp16_t>(args, data, seq_one);
+        } else {
+            set_input_kq_mask_impl<ggml_fp16_t>(args, data, causal_attn);
+        }
         input_upload(dst, staging);
     } else {
         std::vector<float> staging;
-        set_input_kq_mask_impl<float>(args, input_data(dst, staging), causal_attn);
+        float * data = input_data(dst, staging);
+        if (seq_one >= 0) {
+            set_input_kq_mask_seq<float>(args, data, seq_one);
+        } else {
+            set_input_kq_mask_impl<float>(args, data, causal_attn);
+        }
         input_upload(dst, staging);
     }
 
