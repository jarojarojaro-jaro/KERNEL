@@ -0,0 +1,26 @@
+#pragma once
+
+// [GGML_HIP_PM4] RDNA3: replay a captured HIP graph as ONE PM4 indirect buffer on an own ROCr queue.
+//
+// A HIP graph launch costs ~2.75 us per kernel boundary on gfx1100 (the CP's AQL front end handles one packet per
+// kernel). The same chain of kernels as DISPATCH_DIRECT packets in one PM4 indirect buffer, separated by
+// CS_PARTIAL_FLUSH + ACQUIRE_MEM (L0/GL1/K$ invalidate), costs ~0.5-0.9 us per boundary. The tape is built once per
+// captured graph from its kernel nodes (kernel descriptors from the HIP-loaded code objects, kernargs incl. the hidden
+// arguments written to VRAM) and submitted as one AMD vendor AQL packet (AMD_AQL_FORMAT_PM4_IB). The kernels and their
+// arguments are exactly those of the graph, so results are bitwise identical. Graphs with non-kernel nodes, more than
+// one stream, scratch or unsupported implicit arguments keep the plain graph launch.
+// GGML_HIP_PM4=0: always launch the HIP graph. GGML_HIP_PM4_DEBUG=1: log tape builds and fallbacks.
+
+#include "common.cuh"
+
+#if defined(GGML_USE_HIP) && defined(USE_CUDA_GRAPH)
+#define GGML_HIP_PM4_AVAILABLE
+
+struct ggml_hip_pm4_tape;
+
+// tape for an instantiated graph, or nullptr (switch off, not RDNA3, unsupported graph)
+ggml_hip_pm4_tape * ggml_hip_pm4_build(int device, cudaGraph_t graph);
+void ggml_hip_pm4_free(ggml_hip_pm4_tape * tape);
+// run the tape ordered after the prior work of stream; the work after it on stream is ordered after the tape
+void ggml_hip_pm4_launch(ggml_hip_pm4_tape * tape, cudaStream_t stream);
+#endif
