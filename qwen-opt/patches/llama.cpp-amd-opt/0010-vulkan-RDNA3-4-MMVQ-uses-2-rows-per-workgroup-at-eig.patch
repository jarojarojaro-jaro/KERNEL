From 6c7801bf62c689545c2185a1e0a1366950164e01 Mon Sep 17 00:00:00 2001
From: jarojarojaro-jaro <miki.jaroszek@gmail.com>
Date: Mon, 12 Oct 2026 13:37:13 +0000
Subject: [PATCH 10/20] vulkan: RDNA3/4 MMVQ uses 2 rows per workgroup at eight
 columns

RX 7900 XTX, n=8 (us, 4 -> 2 rows): q5_K 17408x5120 89.5 -> 96.0, 5120x17408
109.4 -> 101.8; q4_K 10240x5120 53.3 -> 51.8, 5120x10240 54.4 -> 53.5; q6_K
17408x5120 117.5 -> 110.9, 5120x17408 114.9 -> 113.0. Results are unchanged
(rows per workgroup do not affect the per-row arithmetic).
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 58fdfd456..7bf14eb68 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -2891,8 +2891,8 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     }
     // RDNA3/4: above four columns, static 4 rows for all types bench faster than the default
     const bool is_rdna3_or_4 = device->vendor_id == VK_VENDOR_ID_AMD && (device->architecture == AMD_RDNA3 || device->architecture == AMD_RDNA4);
-    // (IQ4_XS: 2 rows bench faster)
-    auto const &rm_int_n = [&](uint32_t rows, uint32_t i, uint32_t rdna_rows = 4) { return (is_rdna3_or_4 && i >= 4) ? rdna_rows : rows; };
+    // (IQ4_XS, and all types at eight columns: 2 rows bench faster)
+    auto const &rm_int_n = [&](uint32_t rows, uint32_t i, uint32_t rdna_rows = 4) { return (is_rdna3_or_4 && i >= 4) ? (i >= 7 ? 2u : rdna_rows) : rows; };
     // RDNA3/4: Static 4 rows for all types bench faster than the default
     auto const &rm_id = [&](uint32_t rows) { return is_rdna3_or_4 ? 4u : rows; };
     uint32_t rm_iq = 2 * rm_kq;
-- 
