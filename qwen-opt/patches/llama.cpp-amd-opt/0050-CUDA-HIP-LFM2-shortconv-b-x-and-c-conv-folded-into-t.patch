 };
 
+// [GGML_HIP_CONV_MUL] LFM2 shortconv: bx = b * x (the MUL in front of the TRANSPOSE that the CONCAT reads) and
+// y = c * conv (the MUL right after the SSM_CONV) folded into the fused conv kernel, which then also writes the q8_1
+// copy of y for the out_proj MMVQ. Same products as the two MUL launches. Both MULs or none.
+static void ggml_cuda_ssm_conv_plan_fold_muls(const ggml_cgraph * cgraph, int conv_idx, ggml_cuda_ssm_conv_plan & plan,
+                                              const ggml_tensor * X, const ggml_tensor * S) {
+    static const bool conv_mul = ggml_cuda_env_switch("GGML_HIP_CONV_MUL");
+    const ggml_tensor * conv = cgraph->nodes[conv_idx];
+    if (!conv_mul || plan.silu || plan.bias_add || X->op != GGML_OP_TRANSPOSE || X->view_src == nullptr ||
+            X->view_offs != 0 || X->view_src->op != GGML_OP_MUL || (conv->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            conv_idx + 1 >= cgraph->n_nodes) {
+        return;
+    }
+    const ggml_tensor * M  = X->view_src;
+    const int64_t       nr = X->ne[1];
+    const int64_t       nt = X->ne[0];
+    const auto plain = [&](const ggml_tensor * t) {
+        return t->type == GGML_TYPE_F32 && t->ne[0] == nr && t->ne[1] == nt && t->ne[2] == 1 && t->ne[3] == 1 &&
+               t->nb[0] == sizeof(float);
+    };
+    if (!plain(M) || !ggml_is_contiguous(M) || !plain(M->src[0]) || !plain(M->src[1]) || X->nb[0] != M->nb[1]) {
+        return;
+    }
+    int mul_idx = -1;
+    for (int j = plan.concat_idx - 1; j >= std::max(0, plan.concat_idx - 64); --j) {
+        if (cgraph->nodes[j] == M) {
+            mul_idx = j;
+            break;
+        }
+    }
+    std::vector<ggml_cuda_reader> readers;
+    if (mul_idx < 0 || !ggml_cuda_collect_readers(cgraph, mul_idx, conv_idx - mul_idx, readers) || readers.size() != 1 ||
+            readers[0].idx != plan.concat_idx) {
+        return;
+    }
+    ggml_tensor * M2 = cgraph->nodes[conv_idx + 1];
+    if (M2->op != GGML_OP_MUL || (M2->src[0] != conv && M2->src[1] != conv) || M2->src[0] == M2->src[1] ||
+            !ggml_node_has_n_uses(cgraph, conv_idx, 1) || !plain(M2) || !ggml_is_contiguous(M2) ||
+            (M2->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return;
+    }
+    const ggml_tensor * A = M->src[0];
+    const ggml_tensor * B = M->src[1];
+    const ggml_tensor * G = M2->src[0] == conv ? M2->src[1] : M2->src[0];
+    if (!plain(G)) {
+        return;
+    }
+    // A and B are read when the SSM_CONV runs instead of when the MUL runs: nothing in between may write them
+    for (int k = mul_idx + 1; k < conv_idx; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(n) || k == plan.concat_idx ||
+                std::find(plan.cpy_idx.begin(), plan.cpy_idx.begin() + plan.src.n_win, k) != plan.cpy_idx.begin() + plan.src.n_win ||
+                ggml_cuda_gdn_state_gather_elided(cgraph, k) || n == plan.gather) {
+            continue;
+        }
+        if (ggml_cuda_tensors_overlap(n, A) || ggml_cuda_tensors_overlap(n, B)) {
+            return;
+        }
+    }
+    // the kernel writes M2 (and the windows) after each thread read its own inputs: M2 must not overlap any input
+    if (ggml_cuda_tensors_overlap(M2, A) || ggml_cuda_tensors_overlap(M2, B) || ggml_cuda_tensors_overlap(M2, G) ||
+            (!plan.gather && ggml_cuda_tensors_overlap(M2, S))) {
+        return;
+    }
+    for (int c = 0; c < plan.src.n_win; ++c) {
+        if (ggml_cuda_tensors_overlap(M2, cgraph->nodes[plan.cpy_idx[c]]->src[1])) {
+            return;
+        }
+    }
+    plan.mul_in_idx       = mul_idx;
+    plan.mul_out_idx      = conv_idx + 1;
+    plan.mul_out          = M2;
+    plan.src.x            = (const float *) A->data;
+    plan.src.x_stride     = A->nb[1] / sizeof(float);
+    plan.src.x2           = (const float *) B->data;
+    plan.src.x2_stride    = B->nb[1] / sizeof(float);
+    plan.src.gate         = (const float *) G->data;
+    plan.src.gate_stride  = G->nb[1] / sizeof(float);
+}
