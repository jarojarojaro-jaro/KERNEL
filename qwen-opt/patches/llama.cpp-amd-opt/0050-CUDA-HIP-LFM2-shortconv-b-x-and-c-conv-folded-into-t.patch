 ggml/src/ggml-cuda/ggml-cuda.cu | 126 ++++++++++++++++++++++++++++++--
 ggml/src/ggml-cuda/ssm-conv.cu  |  18 +++--
 ggml/src/ggml-cuda/ssm-conv.cuh |  42 ++++++++++-
