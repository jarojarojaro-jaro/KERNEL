@@ -3654,8 +3654,92 @@ struct ggml_cuda_ssm_conv_plan {
     const ggml_tensor *          gather;   // GET_ROWS read through its index, or nullptr
     std::array<int, SSM_CONV_FUSED_MAX_WINDOWS> cpy_idx;
     ggml_cuda_ssm_conv_fused_src src;
+    // [GGML_HIP_CONV_MUL] folded MULs (ggml_cuda_ssm_conv_plan_fold_muls): the MUL producing the inputs (elided where
+    // it stands) and the MUL of the output, which the kernel writes instead of the SSM_CONV; -1 / nullptr: none
+    int                          mul_in_idx;
+    int                          mul_out_idx;
