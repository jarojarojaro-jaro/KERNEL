         plan.silu     = cgraph->nodes[conv_idx + 2];
@@ -3791,8 +3878,13 @@ static bool ggml_cuda_ssm_conv_cache_plan(const ggml_cgraph * cgraph, int conv_i
         src.state_cs         = (int) n_st;
         src.state_ts         = 1;
     }
-    src.x        = (const float *) X->data;
-    src.x_stride = X->nb[0] / sizeof(float);
+    src.x           = (const float *) X->data;
+    src.x_stride    = X->nb[0] / sizeof(float);
+    src.x2          = nullptr;
+    src.x2_stride   = 0;
+    src.gate        = nullptr;
+    src.gate_stride = 0;
+    src.q8          = nullptr;
 
     // The sources are now read when the SSM_CONV runs instead of when the CONCAT runs: nothing in between may have
     // written them (their buffers may have been reused once the CONCAT was done), and nothing in between may read
@@ -3824,6 +3916,7 @@ static bool ggml_cuda_ssm_conv_cache_plan(const ggml_cgraph * cgraph, int conv_i
             }
         }
     }
+    ggml_cuda_ssm_conv_plan_fold_muls(cgraph, conv_idx, plan, X, S);
     return true;
 }
 
@@ -3839,6 +3932,20 @@ static bool ggml_cuda_ssm_conv_plan_for_concat(const ggml_cgraph * cgraph, int c
     return false;
 }
 
+// [GGML_HIP_CONV_MUL] the input MUL of a fused SSM_CONV that folds it (ggml_cuda_ssm_conv_plan_fold_muls)
+static bool ggml_cuda_ssm_conv_mul_in_elided(const ggml_cgraph * cgraph, int i) {
+    if (cgraph->nodes[i]->op != GGML_OP_MUL) {
+        return false;
+    }
+    std::vector<ggml_cuda_reader> readers;
+    if (!ggml_cuda_collect_readers(cgraph, i, 64, readers) || readers.size() != 1 ||
+            cgraph->nodes[readers[0].idx]->op != GGML_OP_CONCAT) {
+        return false;
+    }
+    ggml_cuda_ssm_conv_plan plan;
+    return ggml_cuda_ssm_conv_plan_for_concat(cgraph, readers[0].idx, plan) && plan.mul_in_idx == i;
+}
+
 // a GET_ROWS of one recurrent-state row whose readers (GDN initial state, CONCAT of a fused SSM_CONV) all read
 // the row from the cache themselves
 static bool ggml_cuda_state_gather_elided(const ggml_cgraph * cgraph, int i) {
@@ -3911,6 +4018,10 @@ static bool ggml_cuda_gdn_prologue_elided(const ggml_cgraph * cgraph, int i) {
         return ggml_cuda_ssm_conv_plan_for_concat(cgraph, i, plan);
     }
 
+    if (node->op == GGML_OP_MUL) {
+        return ggml_cuda_ssm_conv_mul_in_elided(cgraph, i);
+    }
+
     if (node->op == GGML_OP_CPY && node->src[0]->view_src && node->src[0]->view_src->op == GGML_OP_CONCAT &&
             (node->src[0]->op == GGML_OP_VIEW || node->src[0]->op == GGML_OP_TRANSPOSE)) {
         // the plan accounts for every reader of the CONCAT, this CPY included
@@ -4974,6 +5085,11 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
                     }
                 }
             }
+            if (plan.mul_out != nullptr) {
+                plan.src.q8 = ggml_cuda_q8_1_producer_target(cuda_ctx, cgraph, plan.mul_out_idx);
+                ggml_cuda_op_ssm_conv(*cuda_ctx, node, nullptr, nullptr, &plan.src, plan.mul_out);
+                return plan.mul_out_idx - i;
+            }
             ggml_cuda_op_ssm_conv(*cuda_ctx, node, plan.bias_add, plan.silu, &plan.src);
             return plan.n_fused > 0 ? plan.n_fused : -1;
         }
