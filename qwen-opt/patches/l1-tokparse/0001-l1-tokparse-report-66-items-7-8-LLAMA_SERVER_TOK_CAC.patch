+int main(int argc, char ** argv) {
+    std::vector<std::string> pos;
+    std::string tmpl_src;
+    size_t n_threads = 2, from = 0, to = SIZE_MAX;
+    for (int i = 1; i < argc; i++) {
+        const auto next = [&]() { return std::string(argv[++i]); };
+        if (strcmp(argv[i], "--template") == 0 && i + 1 < argc) {
+            tmpl_src = read_file(next());
+        } else if (strcmp(argv[i], "--threads") == 0 && i + 1 < argc) {
+            n_threads = std::stoul(next());
+        } else if (strcmp(argv[i], "--from") == 0 && i + 1 < argc) {
+            from = std::stoul(next());
+        } else if (strcmp(argv[i], "--to") == 0 && i + 1 < argc) {
+            to = std::stoul(next());
+        } else {
+            pos.push_back(argv[i]);
+        }
+    }
+    if (pos.empty()) {
+        fprintf(stderr, "usage: %s VOCAB.gguf [CONVS.json] [--template FILE.jinja] [--threads N] [--from T --to T]\n", argv[0]);
+        return 1;
+    }
+    setenv("LLAMA_SERVER_SAFE_SPECIAL", "1", 1);
+    setenv("LLAMA_SERVER_TOK_CACHE", "1", 1);
+    common_log_set_verbosity_thold(-1);
+    llama_log_set([](ggml_log_level, const char *, void *) {}, nullptr);
+    llama_backend_init();
+
+    auto mparams = llama_model_default_params();
+    mparams.vocab_only = true;
+    llama_model * model = llama_model_load_from_file(pos[0].c_str(), mparams);
+    if (!model) {
+        fprintf(stderr, "failed to load %s\n", pos[0].c_str());
+        return 1;
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    server_chat_params opt;
+    opt.use_jinja         = true;
+    opt.prefill_assistant = true;
+    opt.reasoning_format  = COMMON_REASONING_FORMAT_DEEPSEEK;
+    opt.tmpls             = common_chat_templates_init(model, tmpl_src);
+    opt.allow_image       = false;
+    opt.allow_audio       = false;
+    opt.allow_video       = false;
+    opt.enable_thinking   = common_chat_templates_support_enable_thinking(opt.tmpls.get());
+
+    json convs = pos.size() > 1 ? json::parse(read_file(pos[1])) : builtin_convs();
+    // the same session can sit in two directories
+    {
+        json uniq = json::array();
+        std::vector<std::string> names;
+        for (auto & c : convs) {
+            const std::string n = c.at("name").get<std::string>();
+            if (std::find(names.begin(), names.end(), n) == names.end()) {
+                names.push_back(n);
+                uniq.push_back(c);
+            }
+        }
+        convs = uniq;
+    }
+    if (pos.size() == 1) {
+        n_threads = convs.size();
+    }
+    n_threads = std::min(n_threads, convs.size());
+
+    // the requests of each thread: every prefix that ends before an assistant message, plus (built-in) one that
+    // drops the last two messages again
+    std::vector<std::vector<request>> threads(n_threads);
+    for (size_t t = 0; t < n_threads; t++) {
+        const json & c = convs[t];
+        const json & msgs = c.at("messages");
+        const auto prefix = [&](size_t k) {
+            json m = json::array();
+            for (size_t i = 0; i < k; i++) {
+                m.push_back(msgs[i]);
+            }
+            return json { { "messages", m }, { "tools", c.at("tools") } };
+        };
+        for (size_t k = 1; k < msgs.size(); k++) {
+            if (msgs[k].at("role") == "assistant" && msgs[k - 1].at("role") != "assistant") {
+                threads[t].push_back({ c.at("name").get<std::string>() + " #" + std::to_string(k), prefix(k) });
+            }
+        }
+        if (pos.size() == 1 && msgs.size() > 4) {
+            threads[t].push_back({ c.at("name").get<std::string>() + " (shorter)", prefix(msgs.size() - 2) });
+        }
+    }
+
+    size_t n_req = 0, n_timed = 0, n_mismatch = 0, n_no_ranges = 0;
+    double ms_full = 0, ms_cached = 0, ms_render = 0;
+    std::vector<double> full_ms, cached_ms;
+    for (size_t r = 0;; r++) {
+        bool any = false;
+        for (size_t t = 0; t < n_threads; t++) {
+            if (r >= threads[t].size()) {
+                continue;
+            }
+            any = true;
+            const request & q = threads[t][r];
+            std::vector<raw_buffer> files;
+            auto t0 = std::chrono::steady_clock::now();
+            json body = q.body;
+            json parsed = oaicompat_chat_params_parse(body, opt, files);
+            ms_render += ms_since(t0);
+            std::vector<std::pair<size_t, size_t>> ranges;
+            if (!server_prompt_plain_ranges(parsed, ranges)) {
+                n_no_ranges++;
+            }
+            const std::string prompt = parsed.at("prompt").get<std::string>();
+
+            t0 = std::chrono::steady_clock::now();
+            const llama_tokens full = common_tokenize_plain_ranges(vocab, prompt, ranges, true);
+            const double f_ms = ms_since(t0);
+            t0 = std::chrono::steady_clock::now();
+            const llama_tokens cached = server_tokenize_cached(vocab, prompt, true, &ranges);
+            const double c_ms = ms_since(t0);
+
+            n_req++;
+            if (cached != full) {
+                n_mismatch++;
+                CHECK(false, "%s: cached tokenization differs (%zu vs %zu tokens)", q.name.c_str(), cached.size(), full.size());
+            }
+            if (full.size() >= from && full.size() <= to) {
+                n_timed++;
+                ms_full += f_ms;
+                ms_cached += c_ms;
+                full_ms.push_back(f_ms);
+                cached_ms.push_back(c_ms);
+                printf("  %-60s %7zu tokens %4zu ranges  full %7.2f ms  cached %7.2f ms\n", q.name.c_str(), full.size(),
+                       ranges.size(), f_ms, c_ms);
+            }
+        }
+        if (!any) {
+            break;
+        }
+    }
+    const auto median = [](std::vector<double> v) {
+        if (v.empty()) {
+            return 0.0;
+        }
+        std::sort(v.begin(), v.end());
+        return v[v.size() / 2];
+    };
+    printf("requests %zu (%zu without plain ranges), mismatches %zu; timed %zu in [%zu, %zu] tokens: full %.1f ms (median %.2f), cached %.1f ms (median %.2f); render %.1f ms\n",
+           n_req, n_no_ranges, n_mismatch, n_timed, from, to == SIZE_MAX ? (size_t) 0 : to, ms_full, median(full_ms), ms_cached,
+           median(cached_ms), ms_render);
+    CHECK(n_no_ranges < n_req, "no request had plain ranges (LLAMA_SERVER_SAFE_SPECIAL inactive?)");
+
+    llama_model_free(model);
+    if (n_fail == 0) {
+        printf("OK\n");
+    } else {
+        printf("%d FAILED\n", n_fail);
+    }
+    return n_fail == 0 ? 0 : 1;
+}
