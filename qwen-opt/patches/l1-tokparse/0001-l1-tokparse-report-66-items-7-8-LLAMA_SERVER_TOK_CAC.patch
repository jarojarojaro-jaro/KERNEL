diff --git a/tests/test-chat-stream-inc.cpp b/tests/test-chat-stream-inc.cpp
new file mode 100644
index 000000000..9d9d3934b
--- /dev/null
+++ b/tests/test-chat-stream-inc.cpp
@@ -0,0 +1,486 @@
+// LLAMA_SERVER_PARSE_INC / LLAMA_SERVER_STREAM_STEP: the streamed chat output parsed incrementally (common_chat_parse_inc)
+// and once per decode step gives the same message and tool calls as the full re-parse per token it replaces (CPU,
+// vocab-only model).
+//
+//   test-chat-stream-inc VOCAB.gguf [MSGS.jsonl [TOOLS.json]] [--template FILE.jinja] [--bench KIB]
+//
+// Model outputs: every recorded assistant message of MSGS.jsonl (one JSON object per line: reasoning, content,
+// tool_calls [{name, arguments}]; e.g. omp sessions run on the local Qwen3.8), rendered by the chat template (the
+// model's own, or --template)
+// after one user message (the bytes after the generation prompt, up to the end-of-turn token) and tokenized with
+// special tokens as the model writes them; without MSGS.jsonl a few built-in outputs. TOOLS.json: OpenAI "tools"
+// array the requests carry (default: one permissive tool per name seen in the outputs). Parsed as the server parses
+// with LLAMA_SERVER_SAFE_TOOLS=1, for every output:
+//   - reference: the old algorithm, one full common_chat_parse of the whole output per token (task_result_state
+//     parse_mode 0);
+//   - incremental, token by token (parse_mode 2): every update must equal the full parse of the same prefix (the
+//     oracle inside task_result_state counts any difference) and every update's deltas must equal the reference's;
+//   - incremental in decode-step chunks of 1..5 tokens (MTP n4, fixed seed), parse_mode 1: the final message and tool
+//     calls must equal the reference's, and the streamed deltas must add up to the same reasoning, content and tool
+//     call arguments as the reference's.
+// --bench KIB: one long output (~KIB KiB of recorded reasoning + content + a write tool call) streamed old per token
+// vs incremental per step (3.3 tokens): CPU time of the parsing, total and per token over the last 2k tokens.
+#include "chat.h"
+#include "common.h"
+#include "llama.h"
+#include "server-common.h"
+#include "server-task.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <random>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static int n_fail = 0;
+
+#define CHECK(cond, ...)                                    \
+    do {                                                    \
+        if (!(cond)) {                                      \
+            fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+            fprintf(stderr, __VA_ARGS__);                   \
+            fprintf(stderr, "\n");                          \
+            n_fail++;                                       \
+        }                                                   \
+    } while (0)
+
+using pieces_t = std::vector<std::pair<std::string, llama_token>>;
+
+static std::string read_file(const std::string & path) {
+    std::ifstream f(path);
+    if (!f) {
+        throw std::runtime_error("cannot read " + path);
+    }
+    std::stringstream ss;
+    ss << f.rdbuf();
+    return ss.str();
+}
+
+// the streamed message rebuilt from the deltas, and the deltas of every update
+struct streamed {
+    common_chat_msg final_msg;
+    std::string     reasoning;
+    std::string     content;
+    std::vector<common_chat_tool_call> calls;
+    std::vector<std::string> updates; // the deltas of every update, serialized
+    size_t          n_oracle_mismatch = 0;
+    bool            ok = true;
+    std::string     error;
+    double          ms_total = 0;     // parsing CPU time
+    double          ms_tail  = 0;     // of the updates in the last 2k tokens
+    size_t          n_tail   = 0;     // tokens in the last 2k
+};
+
+static std::string dump_diffs(const std::vector<common_chat_msg_diff> & diffs) {
+    std::string s;
+    for (const auto & d : diffs) {
+        s += json({ { "r", d.reasoning_content_delta }, { "c", d.content_delta }, { "i", (long long) d.tool_call_index },
+                    { "n", d.tool_call_delta.name }, { "a", d.tool_call_delta.arguments } }).dump();
+    }
+    return s;
+}
+
+// streams toks through a task_result_state in the given chunks (sizes, cycled), as the server's HTTP thread does
+static streamed stream(const pieces_t & toks, const std::vector<size_t> & chunks, int parse_mode,
+                       const common_chat_parser_params & pp) {
+    streamed r;
+    task_result_state state(pp);
+    state.parse_mode = parse_mode;
+    const auto add = [&](const std::vector<common_chat_msg_diff> & diffs) {
+        for (const auto & d : diffs) {
+            r.reasoning += d.reasoning_content_delta;
+            r.content += d.content_delta;
+            if (d.tool_call_index != std::string::npos) {
+                if (r.calls.size() <= d.tool_call_index) {
+                    r.calls.resize(d.tool_call_index + 1);
+                }
+                r.calls[d.tool_call_index].name += d.tool_call_delta.name;
+                r.calls[d.tool_call_index].arguments += d.tool_call_delta.arguments;
+            }
+        }
+        r.updates.push_back(dump_diffs(diffs));
+    };
+    const size_t tail_from = toks.size() > 2048 ? toks.size() - 2048 : 0;
+    try {
+        size_t c = 0;
+        for (size_t i = 0; i < toks.size(); c++) {
+            const size_t n = std::min(chunks[c % chunks.size()], toks.size() - i);
+            common_chat_input in;
+            for (size_t j = i; j < i + n; j++) {
+                in.append(toks[j].first, toks[j].second);
+            }
+            std::vector<common_chat_msg_diff> diffs;
+            const auto t0 = std::chrono::steady_clock::now();
+            state.update_chat_msg(in, true, diffs);
+            const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+            r.ms_total += ms;
+            if (i >= tail_from) {
+                r.ms_tail += ms;
+                r.n_tail  += n;
+            }
+            add(diffs);
+            if (getenv("TEST_STREAM_INC_DUMP") != nullptr && parse_mode == 0) {
+                printf("  +%s -> calls %zu, updates %s\n", json(in.text).dump().c_str(), state.chat_msg.tool_calls.size(),
+                       r.updates.back().c_str());
+            }
+            i += n;
+        }
+        std::vector<common_chat_msg_diff> diffs;
+        const auto t0 = std::chrono::steady_clock::now();
+        r.final_msg = state.update_chat_msg(common_chat_input(), false, diffs);
+        r.ms_total += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        for (auto & tc : r.final_msg.tool_calls) {
+            tc.id.clear(); // random per state
+        }
+        add(diffs);
+    } catch (const std::exception & e) {
+        r.ok    = false;
+        r.error = e.what();
+    }
+    r.n_oracle_mismatch = state.n_oracle_mismatch;
+    return r;
+}
+
+struct setup {
+    llama_model *             model = nullptr;
+    const llama_vocab *       vocab = nullptr;
+    common_chat_templates_ptr tmpls;
+    json                      tools;
+    common_chat_parser_params pp;
+    std::string               gp; // generation prompt text
+};
+
+static common_chat_msg msg_of(const json & rec) {
+    common_chat_msg m;
+    m.role              = "assistant";
+    m.reasoning_content = rec.value("reasoning", "");
+    m.content           = rec.value("content", "");
+    for (const auto & tc : rec.value("tool_calls", json::array())) {
+        common_chat_tool_call c;
+        c.name      = tc.at("name").get<std::string>();
+        c.arguments = tc.at("arguments").is_string() ? tc.at("arguments").get<std::string>() : tc.at("arguments").dump();
+        m.tool_calls.push_back(c);
+    }
+    return m;
+}
+
+static common_chat_msg user_msg() {
+    common_chat_msg u;
+    u.role    = "user";
+    u.content = "Do the task.";
+    return u;
+}
+
+// the bytes the model writes for message m: the render of [user, m] after the generation prompt, up to <|im_end|>
+static bool render_output(const setup & s, const common_chat_msg & m, std::string & out) {
+    common_chat_templates_inputs in;
+    in.messages              = { user_msg(), m };
+    in.tools                 = common_chat_tools_parse_oaicompat(s.tools);
+    in.add_generation_prompt = false;
+    in.reasoning_format      = COMMON_REASONING_FORMAT_DEEPSEEK;
+    in.enable_thinking       = true;
+    std::string full;
+    try {
+        full = common_chat_templates_apply(s.tmpls.get(), in).prompt;
+    } catch (const std::exception &) {
+        return false;
+    }
+    in.messages              = { user_msg() };
+    in.add_generation_prompt = true;
+    const std::string head   = common_chat_templates_apply(s.tmpls.get(), in).prompt;
+    if (full.compare(0, head.size(), head) != 0) {
+        return false;
+    }
+    out = full.substr(head.size());
+    const size_t e = out.rfind("<|im_end|>");
+    if (e != std::string::npos) {
+        out.resize(e);
+    }
+    return true;
+}
+
+static pieces_t tokenize(const setup & s, const std::string & text) {
+    pieces_t out;
+    for (llama_token t : common_tokenize(s.vocab, text, false, true)) {
+        out.emplace_back(common_token_to_piece(s.vocab, t, true), t);
+    }
+    return out;
+}
+
+static bool same_calls(const std::vector<common_chat_tool_call> & a, const std::vector<common_chat_tool_call> & b) {
+    if (a.size() != b.size()) {
+        return false;
+    }
+    for (size_t i = 0; i < a.size(); i++) {
+        if (a[i].name != b[i].name || a[i].arguments != b[i].arguments) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static std::vector<size_t> mtp_chunks(uint32_t seed, size_t n) {
+    // accepted tokens per verification step with MTP n4: 1 + accepted drafts (0..4), ~3.3 on average
+    std::mt19937 rng(seed);
+    std::discrete_distribution<int> d({ 8, 10, 14, 20, 48 });
+    std::vector<size_t> c(n);
+    for (auto & x : c) {
+        x = 1 + d(rng);
+    }
+    return c;
+}
+
+struct counts {
+    size_t outputs = 0, skipped = 0, tokens = 0, with_calls = 0, calls_match_record = 0, ref_failed = 0;
+    size_t ref_inconsistent = 0; // the reference's per-token deltas do not add up to its final message
+    size_t step_ok_ref_failed = 0; // the reference stream threw (a transient state it diffed against), per step did not
+    double ms_old = 0, ms_inc_tok = 0, ms_inc_step = 0;
+};
+
+static void check_output(const setup & s, const std::string & name, const pieces_t & toks, const common_chat_msg * record,
+                         counts & cnt) {
+    const std::vector<size_t> one = { 1 };
+    const streamed ref  = stream(toks, one, 0, s.pp);
+    const streamed inc1 = stream(toks, one, 2, s.pp);
+    const streamed incs = stream(toks, mtp_chunks((uint32_t) toks.size(), 4096), 1, s.pp);
+    cnt.outputs++;
+    cnt.tokens += toks.size();
+    cnt.ms_old += ref.ms_total;
+    cnt.ms_inc_tok += inc1.ms_total;
+    cnt.ms_inc_step += incs.ms_total;
+
+    // token by token: the same result as the old algorithm, failures included
+    CHECK(inc1.ok == ref.ok && inc1.error == ref.error, "%s: ok %d / inc %d (%s | %s)", name.c_str(), ref.ok, inc1.ok,
+          ref.error.c_str(), inc1.error.c_str());
+    CHECK(inc1.n_oracle_mismatch == 0, "%s: %zu incremental parses differ from the full parse", name.c_str(), inc1.n_oracle_mismatch);
+    CHECK(inc1.updates == ref.updates, "%s: per-token deltas differ", name.c_str());
+    if (!ref.ok) {
+        // the stream sees fewer intermediate states per step, so it can miss the one the reference failed on, or
+        // fail on the same check with other states in the message
+        const auto kind = [](const std::string & e) { return e.substr(0, e.find('\n')); };
+        cnt.ref_failed++;
+        cnt.step_ok_ref_failed += incs.ok;
+        CHECK(incs.ok || kind(incs.error) == kind(ref.error), "%s: per step fails differently (%s | %s)", name.c_str(),
+              ref.error.c_str(), incs.error.c_str());
+        return;
+    }
+    CHECK(incs.ok, "%s: per step failed (%s)", name.c_str(), incs.error.c_str());
+    CHECK(inc1.final_msg == ref.final_msg, "%s: incremental final message differs", name.c_str());
+    CHECK(incs.final_msg == ref.final_msg, "%s: per-step final message differs", name.c_str());
+    CHECK(same_calls(incs.final_msg.tool_calls, ref.final_msg.tool_calls), "%s: per-step tool calls differ", name.c_str());
+    CHECK(incs.reasoning == ref.reasoning && incs.content == ref.content, "%s: per-step streamed text differs", name.c_str());
+    CHECK(same_calls(incs.calls, ref.calls), "%s: per-step streamed tool calls differ", name.c_str());
+    if (!(ref.reasoning == ref.final_msg.reasoning_content && ref.content == ref.final_msg.content &&
+          same_calls(ref.calls, ref.final_msg.tool_calls))) {
+        cnt.ref_inconsistent++;
+    }
+    if (record != nullptr && !record->tool_calls.empty()) {
+        cnt.with_calls++;
+        bool match = record->tool_calls.size() == ref.final_msg.tool_calls.size();
+        for (size_t i = 0; match && i < record->tool_calls.size(); i++) {
+            match = record->tool_calls[i].name == ref.final_msg.tool_calls[i].name &&
+                    json::parse(record->tool_calls[i].arguments) == json::parse(ref.final_msg.tool_calls[i].arguments);
+        }
+        cnt.calls_match_record += match;
+    }
+}
+
+static void bench(const setup & s, const std::vector<common_chat_msg> & recs, size_t kib) {
+    // reasoning and content from the recorded messages, then one write tool call with recorded content as its body
+    common_chat_msg m;
+    m.role = "assistant";
+    std::string body;
+    for (const auto & r : recs) {
+        if (m.reasoning_content.size() < kib * 1024 / 3) {
+            m.reasoning_content += r.reasoning_content + "\n";
+        } else if (m.content.size() < kib * 1024 / 3) {
+            m.content += r.content + "\n";
+        } else if (body.size() < kib * 1024 / 3) {
+            body += r.content + r.reasoning_content + "\n";
+        }
+    }
+    common_chat_tool_call c;
+    c.name      = "write";
+    c.arguments = json({ { "path", "notes.md" }, { "content", body } }).dump();
+    m.tool_calls.push_back(c);
+    std::string out;
+    if (!render_output(s, m, out)) {
+        fprintf(stderr, "bench: render failed\n");
+        n_fail++;
+        return;
+    }
+    const pieces_t toks = tokenize(s, out);
+    const std::vector<size_t> one = { 1 };
+    const streamed ref  = stream(toks, one, 0, s.pp);
+    const streamed inc1 = stream(toks, one, 1, s.pp);
+    const streamed incs = stream(toks, mtp_chunks(1, 8192), 1, s.pp);
+    const streamed olds = stream(toks, mtp_chunks(1, 8192), 0, s.pp);
+    printf("bench: %zu tokens, %zu KiB, final: reasoning %zu B, content %zu B, %zu tool calls\n", toks.size(), out.size() / 1024,
+           ref.final_msg.reasoning_content.size(), ref.final_msg.content.size(), ref.final_msg.tool_calls.size());
+    const auto row = [&](const char * name, const streamed & r) {
+        printf("  %-28s total %9.1f ms   last 2k tokens: %7.1f us/token   %s\n", name, r.ms_total,
+               r.n_tail ? 1000.0 * r.ms_tail / r.n_tail : 0.0, r.ok ? "" : r.error.c_str());
+    };
+    row("old, per token (today)", ref);
+    row("old, per step", olds);
+    row("incremental, per token", inc1);
+    row("incremental, per step", incs);
+    CHECK(ref.ok && incs.ok && inc1.ok, "bench: stream failed");
+    CHECK(incs.final_msg == ref.final_msg && inc1.final_msg == ref.final_msg, "bench: final message differs");
+    CHECK(inc1.updates == ref.updates, "bench: per-token deltas differ");
+    CHECK(incs.reasoning == ref.reasoning && incs.content == ref.content && same_calls(incs.calls, ref.calls),
+          "bench: per-step streamed output differs");
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2) {
+        fprintf(stderr, "usage: %s VOCAB.gguf [MSGS.jsonl [TOOLS.json]] [--template FILE.jinja] [--bench KIB]\n", argv[0]);
+        return 1;
+    }
+    std::vector<std::string> pos;
+    size_t bench_kib = 0;
+    std::string tmpl_src;
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--bench") == 0 && i + 1 < argc) {
+            bench_kib = std::stoul(argv[++i]);
+        } else if (strcmp(argv[i], "--template") == 0 && i + 1 < argc) {
+            tmpl_src = read_file(argv[++i]);
+        } else {
+            pos.push_back(argv[i]);
+        }
+    }
+    setenv("LLAMA_SERVER_SAFE_TOOLS", "1", 1);
+    common_log_set_verbosity_thold(-1);
+    llama_log_set([](ggml_log_level, const char *, void *) {}, nullptr);
+    llama_backend_init();
+
+    setup s;
+    auto mparams = llama_model_default_params();
+    mparams.vocab_only = true;
+    s.model = llama_model_load_from_file(pos[0].c_str(), mparams);
+    if (!s.model) {
+        fprintf(stderr, "failed to load %s\n", pos[0].c_str());
+        return 1;
+    }
+    s.vocab = llama_model_get_vocab(s.model);
+    s.tmpls = common_chat_templates_init(s.model, tmpl_src);
+
+    // recorded outputs
+    std::vector<json> recs;
+    if (pos.size() > 1) {
+        std::ifstream f(pos[1]);
+        for (std::string line; std::getline(f, line);) {
+            if (!line.empty()) {
+                recs.push_back(json::parse(line));
+            }
+        }
+    } else {
+        recs.push_back({ { "reasoning", "The user wants the build cleaned.\nI will run make clean." }, { "content", "" },
+                         { "tool_calls", json::array({ { { "name", "bash" }, { "arguments", { { "command", "make clean" } } } } }) } });
+        recs.push_back({ { "reasoning", "Short." }, { "content", "Done: the build directory is clean.\n\n- a\n- b" },
+                         { "tool_calls", json::array() } });
+        recs.push_back({ { "reasoning", "Two edits.\n" }, { "content", "Editing both files." },
+                         { "tool_calls", json::array({
+                             { { "name", "write" }, { "arguments", { { "path", "a.txt" }, { "content", "line 1\n<tag>\n</think> as text\n" } } } },
+                             { { "name", "bash" }, { "arguments", { { "command", "cat a.txt | wc -l" } } } } }) } });
+    }
+
+    if (pos.size() > 2) {
+        s.tools = json::parse(read_file(pos[2]));
+    } else {
+        // one tool per name seen, with every argument seen as a property of the JSON type it had
+        std::vector<std::string> names;
+        std::vector<json>        props;
+        for (const auto & r : recs) {
+            for (const auto & tc : r.value("tool_calls", json::array())) {
+                const std::string n = tc.at("name").get<std::string>();
+                size_t k = std::find(names.begin(), names.end(), n) - names.begin();
+                if (k == names.size()) {
+                    names.push_back(n);
+                    props.push_back(json::object());
+                }
+                const json args = tc.at("arguments").is_string() ? json::parse(tc.at("arguments").get<std::string>()) : tc.at("arguments");
+                for (auto it = args.begin(); it != args.end(); ++it) {
+                    const json & v = it.value();
+                    const char * type = v.is_string() ? "string" : v.is_boolean() ? "boolean" : v.is_number_integer() ? "integer" :
+                                        v.is_number() ? "number" : v.is_array() ? "array" : "object";
+                    props[k][it.key()] = { { "type", type } };
+                }
+            }
+        }
+        s.tools = json::array();
+        for (size_t k = 0; k < names.size(); k++) {
+            s.tools.push_back({ { "type", "function" }, { "function", { { "name", names[k] }, { "description", names[k] },
+                                { "parameters", { { "type", "object" }, { "properties", props[k] } } } } } });
+        }
+    }
+
+    // the parser params of a chat request, as the server builds them (LLAMA_SERVER_SAFE_TOOLS=1)
+    server_chat_params opt;
+    opt.use_jinja         = true;
+    opt.prefill_assistant = true;
+    opt.reasoning_format  = COMMON_REASONING_FORMAT_DEEPSEEK;
+    opt.tmpls             = common_chat_templates_init(s.model, tmpl_src);
+    opt.allow_image       = false;
+    opt.allow_audio       = false;
+    opt.allow_video       = false;
+    opt.enable_thinking   = common_chat_templates_support_enable_thinking(opt.tmpls.get());
+    json body = { { "messages", json::array({ { { "role", "user" }, { "content", "Do the task." } } }) }, { "tools", s.tools } };
+    std::vector<raw_buffer> files;
+    const json parsed = oaicompat_chat_params_parse(body, opt, files);
+    s.pp.format           = static_cast<common_chat_format>(parsed.at("chat_format").get<int>());
+    s.pp.reasoning_format = opt.reasoning_format;
+    s.gp                  = parsed.at("generation_prompt").get<std::string>();
+    s.pp.generation_prompt = common_chat_input_tokenize(s.vocab, s.gp);
+    s.pp.parser.load(parsed.at("chat_parser").get<std::string>());
+    s.pp.specials = server_safe_tools_specials(s.vocab);
+    printf("format %s, generation prompt %s, %zu tools, %zu recorded outputs\n", common_chat_format_name(s.pp.format),
+           json(s.gp).dump().c_str(), s.tools.size(), recs.size());
+
+    std::vector<common_chat_msg> msgs;
+    for (const auto & r : recs) {
+        msgs.push_back(msg_of(r));
+    }
+
+    counts cnt;
+    for (size_t i = 0; i < msgs.size(); i++) {
+        std::string out;
+        if (!render_output(s, msgs[i], out)) {
+            cnt.skipped++;
+            continue;
+        }
+        const pieces_t toks = tokenize(s, out);
+        if (getenv("TEST_STREAM_INC_DUMP") != nullptr) {
+            printf("output %zu: %s\n", i, json(out).dump().c_str());
+        }
+        check_output(s, "output " + std::to_string(i), toks, &msgs[i], cnt);
+        // the same output cut short (a stream stopped by max_tokens / the client): partial structures at the end
+        if (toks.size() > 8) {
+            const pieces_t cut(toks.begin(), toks.begin() + toks.size() * 2 / 3);
+            check_output(s, "output " + std::to_string(i) + " (cut)", cut, nullptr, cnt);
+        }
+    }
+    printf("outputs %zu (skipped %zu: template render), tokens %zu, reference stream threw %zu (of those per step did not: %zu), reference deltas not adding up %zu\n",
+           cnt.outputs, cnt.skipped, cnt.tokens, cnt.ref_failed, cnt.step_ok_ref_failed, cnt.ref_inconsistent);
+    printf("tool calls: %zu outputs with calls, %zu parsed back as recorded\n", cnt.with_calls, cnt.calls_match_record);
+    printf("parsing CPU: old per token %.1f ms, incremental per token (with oracle) %.1f ms, incremental per step %.1f ms\n",
+           cnt.ms_old, cnt.ms_inc_tok, cnt.ms_inc_step);
+
+    if (bench_kib > 0) {
+        bench(s, msgs, bench_kib);
+    }
+
+    llama_model_free(s.model);
+    if (n_fail == 0) {
+        printf("OK\n");
+    } else {
+        printf("%d FAILED\n", n_fail);
+    }
+    return n_fail == 0 ? 0 : 1;
+}
