-
-    //LOG_DBG("Parsing PEG input with format %s: %s\n", common_chat_format_name(params.format), effective_input.text.c_str());
-
-    common_peg_parse_flags flags = COMMON_PEG_PARSE_FLAG_LENIENT;
-    if (params.debug) {
-        flags |= COMMON_PEG_PARSE_FLAG_DEBUG;
-    }
+static common_peg_arena chat_peg_parser_content_only() {
+    return build_chat_peg_parser([](common_chat_peg_builder & p) { return p.content(p.rest()) + p.end(); });
+}
 
-    common_peg_parse_context ctx(std::move(effective_input.text), std::move(effective_input.tokens), flags);
-    // token-aware only when the model output carries its token ids; a generation prompt without them is matched by text
-    const auto has_ids = [](auto b, auto e) { return std::any_of(b, e, [](llama_token t) { return t != LLAMA_TOKEN_NULL; }); };
-    if (params.specials && (input.empty() || has_ids(input.tokens.begin(), input.tokens.end()))) {
-        const auto & gp = params.generation_prompt.tokens;
-        ctx.specials      = params.specials.get();
-        ctx.specials_from = has_ids(gp.begin(), gp.end()) ? 0 : params.generation_prompt.size();
-    }
+// the parse of a filled context (input = generation prompt + model output, specials set) into a message
+static common_chat_msg chat_peg_parse_ctx(const common_peg_arena &          parser,
+                                          common_peg_parse_context &        ctx,
+                                          bool                              is_partial,
+                                          const common_chat_parser_params & params) {
     auto result = parser.parse(ctx);
 
     if (result.fail()) {
@@ -1713,6 +1692,84 @@ common_chat_msg common_chat_peg_parse(const common_peg_arena &          src_pars
     return msg;
 }
 
+static bool chat_has_ids(const std::vector<llama_token> & tokens) {
+    return std::any_of(tokens.begin(), tokens.end(), [](llama_token t) { return t != LLAMA_TOKEN_NULL; });
+}
+
+static common_peg_parse_flags chat_peg_flags(const common_chat_parser_params & params) {
+    common_peg_parse_flags flags = COMMON_PEG_PARSE_FLAG_LENIENT;
+    if (params.debug) {
+        flags |= COMMON_PEG_PARSE_FLAG_DEBUG;
+    }
+    return flags;
+}
+
+common_chat_msg common_chat_peg_parse(const common_peg_arena &          src_parser,
+                                      const common_chat_input &         input,
+                                      bool                              is_partial,
+                                      const common_chat_parser_params & params) {
+    const common_peg_arena & parser = src_parser.empty() ? chat_peg_parser_content_only() : src_parser;
+
+    if (src_parser.empty()) {
+        LOG_DBG("No parser definition detected, assuming pure content parser.");
+    }
+
+    common_chat_input effective_input = input;
+    effective_input.prepend(params.generation_prompt);
+
+    //LOG_DBG("Parsing PEG input with format %s: %s\n", common_chat_format_name(params.format), effective_input.text.c_str());
+
+    common_peg_parse_context ctx(std::move(effective_input.text), std::move(effective_input.tokens), chat_peg_flags(params));
+    // token-aware only when the model output carries its token ids; a generation prompt without them is matched by text
+    if (params.specials && (input.empty() || chat_has_ids(input.tokens))) {
+        const auto & gp = params.generation_prompt.tokens;
+        ctx.specials      = params.specials.get();
+        ctx.specials_from = chat_has_ids(gp) ? 0 : params.generation_prompt.size();
+    }
+    return chat_peg_parse_ctx(parser, ctx, is_partial, params);
+}
+
+common_chat_parse_inc::common_chat_parse_inc(const common_chat_parser_params & params)
+    : ctx(params.generation_prompt.text, params.generation_prompt.tokens, chat_peg_flags(params)),
+      n_prompt(params.generation_prompt.size()),
+      prompt_has_ids(chat_has_ids(params.generation_prompt.tokens)) {
+    if (params.parser.empty()) {
+        parser_default = chat_peg_parser_content_only();
+    }
+}
+
+void common_chat_parse_inc::append(const common_chat_input & chunk) {
+    ctx.input += chunk.text;
+    ctx.tokens.insert(ctx.tokens.end(), chunk.tokens.begin(), chunk.tokens.end());
+    output_has_ids = output_has_ids || chat_has_ids(chunk.tokens);
+}
+
+common_chat_msg common_chat_parse_inc::parse(bool is_partial, const common_chat_parser_params & params) {
+    const common_peg_arena & parser = params.parser.empty() ? parser_default : params.parser;
+    if (params.parser.empty()) {
+        LOG_DBG("No parser definition detected, assuming pure content parser.");
+    }
+
+    // as common_chat_peg_parse: token-aware only when the model output carries its token ids
+    const common_peg_special_tokens * specials = nullptr;
+    size_t specials_from = 0;
+    if (params.specials && (ctx.input.size() == n_prompt || output_has_ids)) {
+        specials      = params.specials.get();
+        specials_from = prompt_has_ids ? 0 : n_prompt;
+    }
+    // the memo holds for one arena (its keys are parser addresses) and one way of matching markers
+    if (memo_arena != &parser || specials != ctx.specials || specials_from != ctx.specials_from) {
+        memo.until.clear();
+        memo_arena = &parser;
+    }
+    ctx.specials      = specials;
+    ctx.specials_from = specials_from;
+    ctx.ast.clear();
+    ctx.parse_depth = 0;
+    ctx.memo        = &memo;
+    return chat_peg_parse_ctx(parser, ctx, is_partial, params);
+}
+
 std::map<std::string, bool> common_chat_templates_get_caps(const common_chat_templates * chat_templates) {
     GGML_ASSERT(chat_templates != nullptr);
     GGML_ASSERT(chat_templates->template_default != nullptr);
diff --git a/common/chat.h b/common/chat.h
index 054018283..c8082beae 100644
--- a/common/chat.h
+++ b/common/chat.h
@@ -375,6 +375,28 @@ const char *    common_chat_format_name(common_chat_format format);
 common_chat_msg common_chat_parse(const common_chat_input & input, bool is_partial, const common_chat_parser_params & params);
 common_chat_msg common_chat_peg_parse(const common_peg_arena & src_parser, const common_chat_input & input, bool is_partial, const common_chat_parser_params & params);
 
+// A model output parsed while it grows (the server's stream, LLAMA_SERVER_PARSE_INC): append() each new chunk, parse()
+// returns what common_chat_parse(<everything appended>, is_partial, params) returns, or throws what it throws, for the
+// same params on every call. The input is kept in the parse context with the generation prompt in front instead of
+// being copied for every parse, and the until() scans of free text resume where the previous parse could no longer
+// change (common_peg_parse_memo), so n bytes streamed in k chunks cost O(n) scanning instead of O(n * k).
+class common_chat_parse_inc {
+  public:
+    explicit common_chat_parse_inc(const common_chat_parser_params & params);
+
+    void append(const common_chat_input & chunk);
+    common_chat_msg parse(bool is_partial, const common_chat_parser_params & params);
+
+  private:
+    common_peg_arena         parser_default;      // when params.parser is empty
+    common_peg_parse_context ctx;
+    common_peg_parse_memo    memo;
+    const common_peg_arena * memo_arena = nullptr;
+    size_t                   n_prompt;            // generation prompt bytes in front of the output
+    bool                     prompt_has_ids;
+    bool                     output_has_ids = false;
+};
+
 // used by arg and server
 const char *            common_reasoning_format_name(common_reasoning_format format);
 common_reasoning_format common_reasoning_format_from_name(const std::string & format);
diff --git a/common/peg-parser.cpp b/common/peg-parser.cpp
