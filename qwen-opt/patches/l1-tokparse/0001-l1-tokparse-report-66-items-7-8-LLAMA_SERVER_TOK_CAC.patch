--- a/common/peg-parser.cpp
+++ b/common/peg-parser.cpp
@@ -759,12 +759,47 @@ struct parser_executor {
         size_t last_valid_pos = start_pos;
         std::vector<common_peg_invalid_utf8> invalid_utf8;
 
+        // common_peg_parse_memo: resume the scan of an earlier parse of the shorter input. A check at pos reads at
+        // most reach bytes (a delimiter, a token id under it, a code point), so the outcome at every pos <= final_end
+        // can no longer change by appending; the last such pos reached is saved for the next parse.
+        common_peg_parse_memo::until_scan * memo = nullptr;
+        size_t final_end = 0;
+        size_t memo_pos  = 0;
+        size_t memo_n_invalid = 0;
+        if (ctx.memo != nullptr) {
+            memo = &ctx.memo->until[{ &p, start_pos }];
+            if (memo->pos > start_pos) {
+                pos = last_valid_pos = memo->pos;
+                invalid_utf8 = memo->invalid_utf8;
+            }
+            size_t reach = 4;
+            for (const auto & d : p.delimiters) {
+                reach = std::max(reach, d.size());
+            }
+            final_end = ctx.input.size() >= reach ? ctx.input.size() - reach : 0;
+            memo_pos = pos;
+            memo_n_invalid = invalid_utf8.size();
+        }
+        const auto finish = [&](common_peg_parse_result_type type, size_t end) {
+            if (memo != nullptr && memo_pos > memo->pos) {
+                memo->pos = memo_pos;
+                memo->invalid_utf8.assign(invalid_utf8.begin(), invalid_utf8.begin() + memo_n_invalid);
+            }
+            return common_peg_parse_result(type, start_pos, end, {}, std::move(invalid_utf8));
+        };
+
         while (pos < ctx.input.size()) {
+            // here last_valid_pos == pos and no delimiter starts in [start_pos, pos)
+            if (memo != nullptr && pos <= final_end) {
+                memo_pos = pos;
+                memo_n_invalid = invalid_utf8.size();
+            }
+
             auto utf8_result = common_parse_utf8_codepoint(ctx.input, pos);
 
             if (utf8_result.status == utf8_parse_result::INCOMPLETE && ctx.is_lenient()) {
                 // The rest of the sequence may still arrive, return what we have so far
-                return common_peg_parse_result(COMMON_PEG_PARSE_RESULT_NEED_MORE_INPUT, start_pos, last_valid_pos, {}, std::move(invalid_utf8));
+                return finish(COMMON_PEG_PARSE_RESULT_NEED_MORE_INPUT, last_valid_pos);
             }
 
             if (utf8_result.status != utf8_parse_result::SUCCESS) {
@@ -784,12 +819,12 @@ struct parser_executor {
 
             if (match == common_trie::COMPLETE_MATCH) {
                 // Found a complete delimiter, return everything before it
-                return common_peg_parse_result(COMMON_PEG_PARSE_RESULT_SUCCESS, start_pos, pos, {}, std::move(invalid_utf8));
+                return finish(COMMON_PEG_PARSE_RESULT_SUCCESS, pos);
             }
 
             if (match == common_trie::PARTIAL_MATCH) {
                 // Found a partial match extending to end of input, return everything before it
-                return common_peg_parse_result(COMMON_PEG_PARSE_RESULT_SUCCESS, start_pos, pos, {}, std::move(invalid_utf8));
+                return finish(COMMON_PEG_PARSE_RESULT_SUCCESS, pos);
             }
 
             pos += utf8_result.bytes_consumed;
@@ -798,9 +833,9 @@ struct parser_executor {
 
         if (last_valid_pos == ctx.input.size() && ctx.is_lenient()) {
             // Reached the end of a partial stream, there might still be more input that we need to consume.
-            return common_peg_parse_result(COMMON_PEG_PARSE_RESULT_NEED_MORE_INPUT, start_pos, last_valid_pos, {}, std::move(invalid_utf8));
+            return finish(COMMON_PEG_PARSE_RESULT_NEED_MORE_INPUT, last_valid_pos);
         }
-        return common_peg_parse_result(COMMON_PEG_PARSE_RESULT_SUCCESS, start_pos, last_valid_pos, {}, std::move(invalid_utf8));
+        return finish(COMMON_PEG_PARSE_RESULT_SUCCESS, last_valid_pos);
