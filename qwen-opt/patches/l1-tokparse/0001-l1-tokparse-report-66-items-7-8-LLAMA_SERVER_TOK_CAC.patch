 #include <memory>
 #include <set>
 #include <unordered_map>
@@ -198,6 +199,22 @@ struct common_peg_special_tokens {
     std::vector<std::pair<size_t, llama_token>> find_in(const std::string & text) const;
 };
 
+// Resumable scans for parsing an input that only grows between parses (common_chat_parse_inc, the server's stream):
+// an until() parser that ran from the same start on an earlier, shorter version of the input resumes at the last
+// position its scan had reached with every check there reading only bytes (and token ids) that already existed, so
+// appending cannot change any decision before it: no delimiter starts there, and the invalid UTF-8 runs found are
+// kept. The parse result is the same as without the memo; the scan of a growing free-text region (reasoning,
+// content, a tool argument) costs O(appended bytes) instead of O(region). Valid only while the input before the old
+// end, its token ids, the arena and the context's specials stay the same.
+struct common_peg_parse_memo {
+    struct until_scan {
+        size_t pos = 0; // resume here (a code point boundary, no delimiter before it)
+        std::vector<common_peg_invalid_utf8> invalid_utf8; // found in [start, pos)
+    };
+    // key: the until parser (its address in the arena) and its start position
+    std::map<std::pair<const void *, size_t>, until_scan> until;
+};
+
 struct common_peg_parse_context {
     std::string input;               // [h,   e,  l,  l,  o,  _,  w,  o,  r,  l,  d]
     std::vector<llama_token> tokens; // [id, -1, -1, -1, -1, id, -1, -1, -1, -1, -1]
@@ -211,6 +228,7 @@ struct common_peg_parse_context {
     const common_peg_special_tokens * specials = nullptr;
     size_t specials_from = 0;
     std::unordered_map<const std::string *, std::vector<std::pair<size_t, llama_token>>> specials_in; // per literal
+    common_peg_parse_memo * memo = nullptr; // resumable scans of a growing input, off when null
 
     common_peg_parse_context(common_peg_parse_flags flags = COMMON_PEG_PARSE_FLAG_NONE)
         : flags(flags), parse_depth(0) {}
