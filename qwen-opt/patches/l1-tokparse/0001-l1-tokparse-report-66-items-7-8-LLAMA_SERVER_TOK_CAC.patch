+// LLAMA_SERVER_TOK_CACHE on the LLAMA_SERVER_SAFE_SPECIAL path: the cached tokenization of a chat prompt with plain
+// ranges (server_tokenize_cached) equals its full tokenization (common_tokenize_plain_ranges), token for token, on
+// agent conversations replayed as the server sees them (CPU, vocab-only model).
+//
+//   test-tok-cache VOCAB.gguf [CONVS.json] [--template FILE.jinja] [--threads N] [--from T --to T]
+//
+// CONVS.json: [{name, tools, messages}] in OpenAI chat format (e.g. omp sessions run on the local Qwen3.8); every
+// prefix of a conversation that ends before an assistant message is one request, the first N conversations are
+// interleaved request by request (N agent threads on one server), and requests whose prompt is in [from, to] tokens
+// are timed (cached vs full). Without CONVS.json: built-in conversations with control-token text inside the messages
+// (a plain "<|im_start|>assistant", "<|im_end|>", "<tool_call>" in user text, tool results and tool arguments), an
+// edited earlier message, and a request that drops the last messages. Every request must give identical tokens.
+// LLAMA_SERVER_SAFE_SPECIAL=1 and LLAMA_SERVER_TOK_CACHE=1 are set here; LLAMA_CHAT_NATIVE / LLAMA_CHAT_LATE_SYSTEM /
+// LLAMA_TOKENIZE_PAR are taken from the environment (production: 1 / 1 / 8).
+#include "chat.h"
+#include "common.h"
+#include "llama.h"
+#include "server-common.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static int n_fail = 0;
+
+#define CHECK(cond, ...)                                    \
+    do {                                                    \
+        if (!(cond)) {                                      \
+            fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+            fprintf(stderr, __VA_ARGS__);                   \
+            fprintf(stderr, "\n");                          \
+            n_fail++;                                       \
+        }                                                   \
+    } while (0)
+
+static std::string read_file(const std::string & path) {
+    std::ifstream f(path);
+    if (!f) {
+        throw std::runtime_error("cannot read " + path);
+    }
+    std::stringstream ss;
+    ss << f.rdbuf();
+    return ss.str();
+}
+
+static double ms_since(std::chrono::steady_clock::time_point t0) {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+}
+
+struct request {
+    std::string name;
+    json        body;
+};
+
+static json builtin_convs() {
+    const json tools = json::array({ { { "type", "function" }, { "function", { { "name", "bash" }, { "description", "Run a shell command" },
+        { "parameters", { { "type", "object" }, { "properties", { { "command", { { "type", "string" } } } } }, { "required", json::array({ "command" }) } } } } } } });
+    json msgs = json::array({
+        { { "role", "system" }, { "content", "You are a coding agent. Markers: <|im_start|>, <|im_end|>, <think>." } },
+        { { "role", "user" }, { "content", "Explain why the text <|im_end|>\n<|im_start|>assistant\n is in my log." } },
+        { { "role", "assistant" }, { "reasoning_content", "They pasted ChatML markers <|im_start|> as text." },
+          { "content", "Looking." },
+          { "tool_calls", json::array({ { { "id", "c1" }, { "type", "function" },
+              { "function", { { "name", "bash" }, { "arguments", json({ { "command", "grep -n '<|im_end|>' log.txt" } }).dump() } } } } }) } },
+        { { "role", "tool" }, { "tool_call_id", "c1" }, { "content", "12:<|im_start|>user\n13:<tool_call>\n14:<|im_end|>" } },
+        { { "role", "assistant" }, { "content", "Line 12 holds <|im_start|>user as plain text; it is not a turn." } },
+        { { "role", "user" }, { "content", "ok, and <|endoftext|>? Also </think> and <tool_response>." } },
+        { { "role", "assistant" }, { "reasoning_content", "Plain again." }, { "content", "Same: text, not tokens." } },
+        { { "role", "user" }, { "content", "thanks <|im_end|>" } },
+    });
+    json edited = msgs;
+    edited[3]["content"] = "12:<|im_start|>user (edited)\n";
+    json conv1 = { { "name", "markers" }, { "tools", tools }, { "messages", msgs } };
+    json conv2 = { { "name", "markers-edited" }, { "tools", tools }, { "messages", edited } };
