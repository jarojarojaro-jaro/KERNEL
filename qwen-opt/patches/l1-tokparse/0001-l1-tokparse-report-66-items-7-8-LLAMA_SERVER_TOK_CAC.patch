     // a delimiter starts at pos (whole, or up to the end of the input) and every token text in it is that token
diff --git a/common/peg-parser.h b/common/peg-parser.h
index 34040b383..11ca68c43 100644
--- a/common/peg-parser.h
+++ b/common/peg-parser.h
@@ -4,6 +4,7 @@
 #include "json.h"
