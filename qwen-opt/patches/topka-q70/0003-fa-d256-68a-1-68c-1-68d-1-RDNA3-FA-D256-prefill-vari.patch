+// FATTN_FV_VT: V^T in SRAM, one row of nbatch_fa halves per V column d, split into 16-byte segments of 8 KV rows.
+// The segment index is XOR-swizzled with d so that both the transposing 32-bit stores (lanes: 8 consecutive 8-column
+// chunks x 4 KV row pairs) and the 128-bit A operand reads (lanes: rows 2m / 2m+1) hit distinct banks.
+template <int nbatch_fa>
+static __device__ __forceinline__ int fattn_vt_seg(const int d, const int seg) {
+    return seg ^ ((d ^ (d >> 3)) & (nbatch_fa/8 - 1));
+}
+
+// Load nbatch_fa KV rows x D2 half2 of V and store them transposed into tile_Vt. Each item is one 16-byte chunk
+// (8 columns) of two consecutive KV rows, written as 8 half2 {V[2p][d], V[2p+1][d]}. The values are only moved.
+template<int nwarps, int nbatch_fa, int D2>
+static __device__ __forceinline__ void flash_attn_ext_f16_load_tile_Vt(
+        const half2 * const __restrict__ V, half2 * const __restrict__ tile_Vt, const int stride_V, const int k_VKQ_0) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nchunks   = D2/4;        // 16-byte chunks per V row
+    constexpr int npairs    = nbatch_fa/2; // KV row pairs
+    constexpr int nitems    = nchunks*npairs;
+    static_assert(warp_size == 32, "bad warp_size");
+    static_assert(nchunks % 8 == 0 && npairs % 4 == 0 && nitems % (nwarps*warp_size) == 0, "bad V tile size");
+#pragma unroll
+    for (int it = 0; it < nitems/(nwarps*warp_size); ++it) {
+        // lane -> (chunk % 8, pair % 4), (iteration, warp) -> (chunk / 8, pair / 4)
+        const int combo = it*nwarps + threadIdx.y;
+        const int c = (combo % (nchunks/8))*8 + threadIdx.x % 8;
+        const int p = (combo / (nchunks/8))*4 + threadIdx.x / 8;
+        half2 a[4];
+        half2 b[4];
+        ggml_cuda_memcpy_1<16>(a, V + int64_t(k_VKQ_0 + 2*p + 0)*stride_V + 4*c);
+        ggml_cuda_memcpy_1<16>(b, V + int64_t(k_VKQ_0 + 2*p + 1)*stride_V + 4*c);
+#pragma unroll
+        for (int q = 0; q < 4; ++q) {
+            const int d = 8*c + 2*q;
+            tile_Vt[(d + 0)*(nbatch_fa/2) + 4*fattn_vt_seg<nbatch_fa>(d + 0, p/4) + p%4] = __lows2half2 (a[q], b[q]);
+            tile_Vt[(d + 1)*(nbatch_fa/2) + 4*fattn_vt_seg<nbatch_fa>(d + 1, p/4) + p%4] = __highs2half2(a[q], b[q]);
+        }
+    }
+}
+
+// FATTN_FV_VT + FATTN_FV_KQ4: the transposed V tile written straight from q4_0. Item = 16 columns (one nibble half
+// of a q4_0 block) of two consecutive KV rows; lanes: 8 half-blocks x 4 row pairs.
+template<int nwarps, int nbatch_fa, int D2>
+static __device__ __forceinline__ void flash_attn_ext_f16_load_tile_Vt_q4_0(
+        const char * const __restrict__ V, half2 * const __restrict__ tile_Vt, const int stride_V_bytes, const int k_VKQ_0) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nhalf     = D2/8;        // 16-column halves of q4_0 blocks per row (D2 half2 = 2*D2 columns)
+    constexpr int npairs    = nbatch_fa/2; // KV row pairs
+    constexpr int nitems    = nhalf*npairs;
+    static_assert(warp_size == 32, "bad warp_size");
+    static_assert(nhalf % 8 == 0 && npairs % 4 == 0 && nitems % (nwarps*warp_size) == 0, "bad V tile size");
+#pragma unroll
+    for (int it = 0; it < nitems/(nwarps*warp_size); ++it) {
+        const int combo = it*nwarps + threadIdx.y;
+        const int hb = (combo % (nhalf/8))*8 + threadIdx.x % 8;
+        const int p  = (combo / (nhalf/8))*4 + threadIdx.x / 8;
+        const int b  = hb / 2;
+        const int h  = hb % 2;
+        const block_q4_0 * x0 = (const block_q4_0 *) (V + int64_t(k_VKQ_0 + 2*p + 0)*stride_V_bytes + b*int(sizeof(block_q4_0)));
+        const block_q4_0 * x1 = (const block_q4_0 *) (V + int64_t(k_VKQ_0 + 2*p + 1)*stride_V_bytes + b*int(sizeof(block_q4_0)));
+        const float d0 = __half2float(x0->d);
+        const float d1 = __half2float(x1->d);
+        const uint16_t * q0 = (const uint16_t *) x0->qs;
+        const uint16_t * q1 = (const uint16_t *) x1->qs;
+#pragma unroll
+        for (int j = 0; j < QK4_0/4; ++j) {
+            // nibble half h of qs[2j] | qs[2j+1] << 8: columns 16h + 2j and 16h + 2j + 1 of the block
+            const int a = q0[j] >> (4*h);
