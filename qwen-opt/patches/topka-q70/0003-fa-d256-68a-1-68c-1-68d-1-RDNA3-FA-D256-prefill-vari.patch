-static __host__ fattn_mma_config ggml_cuda_fattn_mma_get_config(const int DKQ, const int DV, const int ncols, const int cc) {
+// GGML_HIP_FA_D256_VAR=<mask> (HIP RDNA3, default 0): variants of the D=256 64-column prompt kernel <256,256,32,2>
+// (Qwen3.5/3.8 GQA 6). Bits:
+//    1  sched_barrier after each V WMMA (report 24v)                       bit-identical
+//    2  sched_barrier after each KQ WMMA (PR #31746)                       bit-identical
+//    4  PR #31746 config: nbatch_fa 32, nbatch_K2/V2 128                   softmax per 32 KV rows: NOT bit-identical
+//    8  exp2f with a log2(e) prescale instead of expf                      NOT bit-identical
+//   16  V tile stored transposed in SRAM at load time, A operand read
+//       with 128-bit loads instead of 16 transposing 32-bit loads          bit-identical
+//   32  nbatch_K2 32, 64  nbatch_V2 32                                     bit-identical
+//  128  K/V read as q4_0 and dequantized into SRAM (no f16 KV copy)       bit-identical
+// Only the masks in GGML_CUDA_FATTN_MMA_D256_VARIANTS are compiled.
+enum {
+    FATTN_FV_FENCE_V  = 1,
+    FATTN_FV_FENCE_KQ = 2,
+    FATTN_FV_PR31746  = 4,
+    FATTN_FV_EXP2     = 8,
+    FATTN_FV_VT       = 16,
+    FATTN_FV_K2_32    = 32,
+    FATTN_FV_V2_32    = 64,
+    FATTN_FV_KQ4      = 128,
+};
+#define GGML_CUDA_FATTN_MMA_D256_VARIANTS(X) X(1) X(2) X(3) X(7) X(11) X(15) X(16) X(19) X(23) X(35) X(51) X(67) X(83) X(131) X(147)
+
+// The sched_barrier keeps the operand loads of later WMMAs from being hoisted above the current one (register pressure).
+#if defined(AMD_WMMA_AVAILABLE)
+#define GGML_FATTN_FV_FENCE(cond) do { if constexpr (cond) { __builtin_amdgcn_sched_barrier(0); } } while (0)
+#else
+#define GGML_FATTN_FV_FENCE(cond) do { } while (0)
+#endif // defined(AMD_WMMA_AVAILABLE)
+
+static constexpr __host__ __device__ fattn_mma_config ggml_cuda_fattn_mma_get_config_rdna(
+        const int DKQ, const int DV, const int ncols, const int fv) {
+    if (fv != 0 && DKQ == 256 && DV == 256 && ncols == 64) {
+        const bool pr = fv & FATTN_FV_PR31746;
+        return fattn_mma_config(256, 2, pr ? 32 : 64,
+            pr ? 128 : (fv & FATTN_FV_K2_32 ? 32 : 64),
+            pr ? 128 : (fv & FATTN_FV_V2_32 ? 32 : 64), 64, 1, false);
+    }
+    return ggml_cuda_fattn_mma_get_config_rdna(DKQ, DV, ncols);
+}
+
+static __host__ fattn_mma_config ggml_cuda_fattn_mma_get_config(const int DKQ, const int DV, const int ncols, const int fv, const int cc) {
     if (ampere_mma_available(cc)) {
         return ggml_cuda_fattn_mma_get_config_ampere(DKQ, DV, ncols);
     }
@@ -244,91 +285,91 @@ static __host__ fattn_mma_config ggml_cuda_fattn_mma_get_config(const int DKQ, c
         return ggml_cuda_fattn_mma_get_config_cdna(DKQ, DV, ncols);
     }
     if (amd_wmma_available(cc)) {
-        return ggml_cuda_fattn_mma_get_config_rdna(DKQ, DV, ncols);
