+// LLAMA_SERVER_CACHE_EVICT=cost (K-020, Marconi-style eviction; default: the oldest entry). Every entry scores
+//   age rank / (N - 1)  +  alpha * (prefill cost / bytes) / max over the cache (prefill cost / bytes)
+// (age rank 0 = oldest) and the lowest score goes first. Prefill cost t(n) = 0.99 ms * n + 4.08 ns * n^2 (XTX topka-q70
+// server prefill: 985 t/s at 6.6k, 493 t/s at 255k), so at the same age a long prompt (minutes to recompute) outlives
+// short ones, which are cheap to recompute per byte of state. LLAMA_SERVER_CACHE_EVICT_ALPHA = alpha (default 1).
+static bool cache_evict_cost() {
+    static const bool v = [] {
+        const char * e = getenv("LLAMA_SERVER_CACHE_EVICT");
+        return e && std::string(e) == "cost";
+    }();
+    return v;
+}
+
+std::list<server_prompt_cache_state>::iterator server_prompt_cache::victim() {
+    if (!cache_evict_cost() || states.size() < 2) {
+        return states.begin();
+    }
+    static const double alpha = [] {
+        const char * e = getenv("LLAMA_SERVER_CACHE_EVICT_ALPHA");
+        return e ? std::max(0.0, atof(e)) : 1.0;
+    }();
+    std::vector<double> eff;
+    eff.reserve(states.size());
+    double eff_max = 0.0;
+    for (const auto & state : states) {
+        const double n = state.prompt.n_tokens();
+        eff.push_back((0.99e-3 * n + 4.08e-9 * n * n) / std::max<double>(1.0, state.size()));
+        eff_max = std::max(eff_max, eff.back());
+    }
+    auto best = states.begin();
+    double best_score = 0.0;
+    size_t i = 0;
+    for (auto it = states.begin(); it != states.end(); ++it, ++i) {
+        const double score = double(i) / (states.size() - 1) + alpha * (eff_max > 0.0 ? eff[i] / eff_max : 0.0);
+        if (it == states.begin() || score < best_score) {
+            best = it;
+            best_score = score;
+        }
+    }
+    return best;
+}
+
+void server_prompt_cache::evict_log(const char * why, const server_prompt_cache_state & state) const {
+    if (cache_evict_cost()) {
+        SRV_WRN(" - %s, removing the entry cheapest to recompute (n_tokens = %d, size = %.3f MiB)\n", why,
+                state.prompt.n_tokens(), state.size() / (1024.0 * 1024.0));
+    } else {
+        SRV_WRN(" - %s, removing oldest entry (size = %.3f MiB)\n", why, state.size() / (1024.0 * 1024.0));
+    }
+}
