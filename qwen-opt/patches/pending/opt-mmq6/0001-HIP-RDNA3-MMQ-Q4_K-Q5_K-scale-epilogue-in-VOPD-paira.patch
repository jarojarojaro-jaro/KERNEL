 }
 
-template <ggml_type type, int J, bool fallback, ggml_prec prec_src1>
+// [GGML_HIP_MMQ_EPI] Kernels that get the RDNA3 epilogue variant of ggml_cuda_mmq_vec_dot_q8_1_q8_1_mma (bitwise the
+// same sums, fewer VALU instructions per WMMA): Q4_K/Q5_K (the types with that MMA vec_dot that Qwen/LFM use) for
+// J >= 48. With fewer y minitiles the widened x scales are reused too rarely (J = 16: more instructions, J = 32: the
+// same); the fallback kernels (nrows % 128 != 0, small matrices) stay as they are (Q5_K J = 128 would spill).
+static constexpr __host__ __device__ bool ggml_cuda_mmq_epi_config(const ggml_type type, const int J, const bool fallback) {
+    return (type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K) && J >= 48 && !fallback;
+}
+
+template <ggml_type type, int J, bool fallback, ggml_prec prec_src1, bool epi = false>
 static constexpr __device__ ggml_cuda_mmq_vec_dot_t ggml_cuda_mmq_get_vec_dot() {
+#if defined(RDNA3)
+    if constexpr (epi) {
+        static_assert(ggml_cuda_mmq_epi_config(type, J, fallback), "epi needs the q8_1_q8_1 MMA vec_dot");
+        return ggml_cuda_mmq_vec_dot_q8_1_q8_1_mma<type, J, fallback, true>;
+    }
+#endif // defined(RDNA3)
     return ggml_cuda_mmq_get_util_funcs<type, J, fallback, prec_src1>().vec_dot;
 }
 
