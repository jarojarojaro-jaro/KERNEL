+// [GGML_HIP_RUNTIME_SWITCH_FILE] see common.cuh
+std::atomic<uint32_t> ggml_cuda_rt_switch_gen{0};
+static std::mutex ggml_cuda_rt_switch_mutex;
+static std::map<std::string, std::string> ggml_cuda_rt_switch_file_values;  // NAME -> VALUE of the last file read
+
+int ggml_cuda_rt_switch_value(const char * name, int def) {
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_rt_switch_mutex);
+        const auto it = ggml_cuda_rt_switch_file_values.find(name);
+        if (it != ggml_cuda_rt_switch_file_values.end()) {
+            return atoi(it->second.c_str());
+        }
+    }
+    const char * env = getenv(name);
+    return env != nullptr ? atoi(env) : def;
+}
+
+void ggml_cuda_rt_switch_poll() {
+    static const char * path = getenv("GGML_HIP_RUNTIME_SWITCH_FILE");
+    if (path == nullptr || path[0] == '\0') {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(ggml_cuda_rt_switch_mutex);  // uncontended: one lock per graph_compute
+    static int64_t t_last = INT64_MIN / 2;
+    static std::filesystem::file_time_type mtime_last;
+    static uintmax_t size_last = UINTMAX_MAX;
+    const int64_t t_now = ggml_time_us();
+    if (t_now - t_last < 20000) {
+        return;
+    }
+    t_last = t_now;
+
+    std::error_code ec;
+    std::filesystem::file_time_type mtime{};
+    uintmax_t size = 0;
+    if (std::filesystem::exists(path, ec)) {
+        mtime = std::filesystem::last_write_time(path, ec);
+        size  = std::filesystem::file_size(path, ec);
+    }
+    if (mtime == mtime_last && size == size_last) {
+        return;
+    }
+    mtime_last = mtime;
+    size_last  = size;
+
+    std::map<std::string, std::string> values;
+    std::ifstream f(path);
+    for (std::string line; std::getline(f, line); ) {
+        const size_t eq = line.find('=');
+        if (line.empty() || line[0] == '#' || eq == std::string::npos || eq == 0) {
+            continue;
+        }
+        std::string value = line.substr(eq + 1);
+        while (!value.empty() && (value.back() == '\r' || value.back() == ' ')) {
+            value.pop_back();
+        }
+        values[line.substr(0, eq)] = value;
+    }
+
+    if (values == ggml_cuda_rt_switch_file_values) {
+        return;
+    }
+    ggml_cuda_rt_switch_file_values = std::move(values);
+    const uint32_t gen = ggml_cuda_rt_switch_gen.fetch_add(1, std::memory_order_acq_rel) + 1;
+    std::string desc;
+    for (const auto & [k, v] : ggml_cuda_rt_switch_file_values) {
+        desc += " " + k + "=" + v;
+    }
+    // stderr, as ggml_hip_pm4 does: the server log filters ggml INFO lines; xtxbench confirms each flip from this line
+    fprintf(stderr, "ggml_cuda_rt_switch: gen %u from %s:%s\n", gen, path, desc.empty() ? " (empty)" : desc.c_str());
+    fflush(stderr);
+}
