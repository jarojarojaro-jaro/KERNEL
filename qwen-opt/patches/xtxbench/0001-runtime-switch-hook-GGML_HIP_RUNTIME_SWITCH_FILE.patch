 // Default-on speed switch, read from the environment by the caller once (static): GGML_HIP_<NAME>=0 turns it off for A/B.
+// Kernel switches read at graph-build time use GGML_CUDA_RT_SWITCH(NAME, 1) below instead (runtime-switchable); this
+// static form stays for the process-level ones (GGML_HIP_PM4, GGML_HIP_INPUT_BATCH).
 static inline bool ggml_cuda_env_switch(const char * name) {
     const char * env = getenv(name);
     return env == nullptr || atoi(env) != 0;
 }
 
+// [GGML_HIP_RUNTIME_SWITCH_FILE] (xtxbench) named switches that can flip between requests without a server restart.
+// Off by default: without the env variable every GGML_CUDA_RT_SWITCH site resolves once, from the environment, to the
+// value its old `static const` read gave (lossless). With GGML_HIP_RUNTIME_SWITCH_FILE=<path>, graph_compute polls the
+// file (stat, at most every 20 ms; lines NAME=VALUE, '#' comments); when its content changes the switch generation is
+// bumped, every converted site re-resolves (file > environment > default) on its next call, and each context waits
+// for its streams and drops its captured graphs and PM4 tapes (the 10 s idle eviction path), so the next graph is
+// captured with the new kernels.
+extern std::atomic<uint32_t> ggml_cuda_rt_switch_gen;
+int  ggml_cuda_rt_switch_value(const char * name, int def);  // file > environment (atoi) > def
+void ggml_cuda_rt_switch_poll();
+
+struct ggml_cuda_rt_switch {
+    const char * name;
+    int def;
+    std::atomic<uint32_t> gen{UINT32_MAX};
+    std::atomic<int> val{0};
+
+    ggml_cuda_rt_switch(const char * name, int def) : name(name), def(def) {}
+
+    int get() {
+        const uint32_t g = ggml_cuda_rt_switch_gen.load(std::memory_order_acquire);
+        if (gen.load(std::memory_order_relaxed) != g) {
+            val.store(ggml_cuda_rt_switch_value(name, def), std::memory_order_relaxed);
+            gen.store(g, std::memory_order_relaxed);
+        }
+        return val.load(std::memory_order_relaxed);
+    }
+};
+
+// int value of switch NAME (def when unset); ggml_cuda_env_switch(NAME) == (GGML_CUDA_RT_SWITCH(NAME, 1) != 0)
+#define GGML_CUDA_RT_SWITCH(name, def) ([]() -> int { static ggml_cuda_rt_switch s_rt_switch_(name, def); return s_rt_switch_.get(); }())
+
