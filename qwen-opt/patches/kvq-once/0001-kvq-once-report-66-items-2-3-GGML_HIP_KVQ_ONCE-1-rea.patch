+// [GGML_HIP_KVQ_ONCE] counters shared by the 2 warps of a pair, ordered with the shared memory accesses only ("local"):
+// a workgroup scope fence on all address spaces would also wait for the K/V loads in flight.
+static __device__ __forceinline__ void fattn_kvq_pair_post(int * counter, const int value) {
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
+    __hip_atomic_store(counter, value, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_WORKGROUP);
+}
+
+static __device__ __forceinline__ void fattn_kvq_pair_wait(const int * counter, const int value) {
+    while (__builtin_amdgcn_readfirstlane(__hip_atomic_load(counter, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_WORKGROUP)) < value) {
+        __builtin_amdgcn_s_sleep(1);
+    }
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
+}
