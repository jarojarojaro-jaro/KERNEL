+// IK2_K_WROUTE: a window's router in one launch - its rows (mv_f16_rows_k_kernel's, a grid row a token), then the
+// last block to finish (a device counter it puts back to 0) takes route_rows' picks a token at a time and
+// group_route's groups: the same values, two launches and their gaps less a visit.  128 threads (E <= 128).
+__device__ unsigned int g_router_win_done = 0;
