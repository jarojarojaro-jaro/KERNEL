+        const float sgs = sg ? sg[slot] : 1.0f, sus = su ? su[slot] : 1.0f;
+        float ag = 0.0f, au = 0.0f;
+#pragma unroll
+        for (int i = 0; i < IT; ++i) {
+            const int un = lane + 32 * i;
+            const float xl[8] = {xv[i][0].x, xv[i][0].y, xv[i][0].z, xv[i][0].w,
+                                 xv[i][1].x, xv[i][1].y, xv[i][1].z, xv[i][1].w};
+            const float xh[8] = {xv[i][2].x, xv[i][2].y, xv[i][2].z, xv[i][2].w,
+                                 xv[i][3].x, xv[i][3].y, xv[i][3].z, xv[i][3].w};
+            const float sl = kq::sum8(xl), sh = kq::sum8(xh);
+            const float tg = q4k_unit_dot(g[i], un, xl, xh, sl, sh, ag);
+            const float tu = q4k_unit_dot(u[i], un, xl, xh, sl, sh, au);
+            const bool in = 32 * (i + 1) <= NU || un < NU;
+            ag = in ? tg : ag;
+            au = in ? tu : au;
