+
+// ---- the exact window with its weights in the registers (IK2_K_WEXP, IK2_K_WMVF16, IK2_K_WROUTE, IK2_K_WCOMB: the
+// host decides; every member's values the one-token kernels' to the bit)
+//
+// The experts: experts_nv_* / experts_q4k_gu / experts_q50_down_kernel's layout (a row - gate / up pair - a wave,
+// four waves a block, a lane's sub-blocks / units lane + 32 i in its registers, all its words asked for at once) for
+// group_route's groups - the row's words read ONCE (non-temporally on AMD where the token kernels do: IK2_HIP_NT
+// bit 1, bit 8 for Q8_0) and kept in the registers while each member's input is read and summed in row_dot /
+// row_dot_2's order and butterfly: each member's h / y the token kernels' (and experts_*_mem's) bits.  Where
+// experts_*_mem reads a group's rows from the caches once a member, each member here costs only its input's loads.
+template <bool NT>
+__device__ __forceinline__ void nvw_load(const uint8_t* w, int sb, uint32_t& sc, uint32_t& q0, uint32_t& q1) {
+    const uint8_t* b = w + (size_t) (sb >> 2) * 36;
+    const int sub = sb & 3;
+    sc = kq_ld32<NT>(b);
+    q0 = kq_ld32<NT>(b + 4 + 8 * sub);
+    q1 = kq_ld32<NT>(b + 8 + 8 * sub);
+}
+__device__ __forceinline__ void wexp_sched() {
+#ifdef MAYA_USE_HIP
+    __builtin_amdgcn_sched_barrier(0);
+#endif
+}
+__device__ __forceinline__ float swiglu_h(float g, float u, float gcap, float ucap) {   // (the token kernels' line)
+    return gcap * tanhf(g / gcap) * (1.0f / (1.0f + expf(-g))) * ucap * tanhf(u / ucap);
+}
+template <int K, bool NT>
+__global__ void __launch_bounds__(128)
+experts_win_nv_gu_kernel(const uint8_t* const* __restrict__ blob, const int* __restrict__ n_g,
+                         const int* __restrict__ tok_g, const int* __restrict__ row_g, size_t eb0,
+                         const float* __restrict__ x, int F, const float* __restrict__ sg,
+                         const float* __restrict__ su, float gcap, float ucap, uint16_t* __restrict__ h) {
+    constexpr int NS = K / 16, IT = (NS + 31) / 32;
+    constexpr size_t RB = (size_t) (K / 64) * 36;
+    const int lane = threadIdx.x & 31, grp = blockIdx.y, n = n_g[grp];
+    const int r = blockIdx.x * 4 + (threadIdx.x >> 5);
+    if (n <= 0 || r >= F || (uintptr_t) blob[grp] <= 1u) return;   // (two GPUs: a group the other GPU runs)
+    const uint8_t* wg = blob[grp] + (size_t) r * RB;
+    const uint8_t* wu = blob[grp] + eb0 + (size_t) r * RB;
+    uint32_t gs[IT], g0[IT], g1[IT], us[IT], u0[IT], u1[IT];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {
+        const int sb = min(lane + 32 * i, NS - 1);
+        nvw_load<NT>(wg, sb, gs[i], g0[i], g1[i]);
+        nvw_load<NT>(wu, sb, us[i], u0[i], u1[i]);
+    }
+    for (int m = 0; m < n; ++m) {
+        const int slot = row_g[grp * kGroupMax + m];
+        const float4* x4 = (const float4*) (x + (size_t) tok_g[grp * kGroupMax + m] * K);
+        float4 xv[IT][4];
+#pragma unroll
+        for (int i = 0; i < IT; ++i) {
+            const int sb = min(lane + 32 * i, NS - 1);
+#pragma unroll
+            for (int k = 0; k < 4; ++k) xv[i][k] = __ldg(x4 + sb * 4 + k);
+        }
+        wexp_sched();
+        const float sgs = sg ? sg[slot] : 1.0f, sus = su ? su[slot] : 1.0f;
+        float ag = 0.0f, au = 0.0f;
+#pragma unroll
+        for (int i = 0; i < IT; ++i) {
+            const int sb = lane + 32 * i, sub = sb & 3;
+            const float dg = ue4m3((uint8_t) (gs[i] >> (8 * sub)));
+            const float tg = ag + dg * nvfp4_sub_dot(g0[i], g1[i], xv[i][0], xv[i][1], xv[i][2], xv[i][3]);
+            const float du = ue4m3((uint8_t) (us[i] >> (8 * sub)));
+            const float tu = au + du * nvfp4_sub_dot(u0[i], u1[i], xv[i][0], xv[i][1], xv[i][2], xv[i][3]);
+            const bool in = 32 * (i + 1) <= NS || sb < NS;
+            ag = in ? tg : ag;
+            au = in ? tu : au;
+        }
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            ag += __shfl_xor_sync(0xffffffffu, ag, o);
+            au += __shfl_xor_sync(0xffffffffu, au, o);
+        }
+        if (lane == 0) h[(size_t) slot * F + r] = f2h(swiglu_h(ag * sgs, au * sus, gcap, ucap));
+    }
+}
+template <int K, bool NT>
+__global__ void __launch_bounds__(128)
+experts_win_nv_down_kernel(const uint8_t* const* __restrict__ blob, const int* __restrict__ n_g,
+                           const int* __restrict__ row_g, size_t off_down, const uint16_t* __restrict__ hin, int C,
+                           float* __restrict__ y) {
+    constexpr int NS = K / 16, IT = (NS + 31) / 32;
+    constexpr size_t RB = (size_t) (K / 64) * 36;
+    const int lane = threadIdx.x & 31, grp = blockIdx.y, n = n_g[grp];
+    const int r = blockIdx.x * 4 + (threadIdx.x >> 5);
+    if (n <= 0 || r >= C || (uintptr_t) blob[grp] <= 1u) return;
+    const uint8_t* w = blob[grp] + off_down + (size_t) r * RB;
+    uint32_t ws[IT], w0[IT], w1[IT];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) nvw_load<NT>(w, min(lane + 32 * i, NS - 1), ws[i], w0[i], w1[i]);
+    for (int m = 0; m < n; ++m) {
+        const int slot = row_g[grp * kGroupMax + m];
+        const uint4* h8 = (const uint4*) (hin + (size_t) slot * K);
+        uint4 hv[IT][2];
+#pragma unroll
+        for (int i = 0; i < IT; ++i) {
+            const int sb = min(lane + 32 * i, NS - 1);
+            hv[i][0] = __ldg(h8 + 2 * sb), hv[i][1] = __ldg(h8 + 2 * sb + 1);
+        }
+        wexp_sched();
+        float acc = 0.0f;
+#pragma unroll
+        for (int i = 0; i < IT; ++i) {
+            const uint32_t u[8] = {hv[i][0].x, hv[i][0].y, hv[i][0].z, hv[i][0].w,
+                                   hv[i][1].x, hv[i][1].y, hv[i][1].z, hv[i][1].w};
+            float4 xv[4];
+#pragma unroll
+            for (int k = 0; k < 4; ++k) {
+                const float2 f0 = u32_to_f2(u[2 * k]), f1 = u32_to_f2(u[2 * k + 1]);
+                xv[k] = make_float4(f0.x, f0.y, f1.x, f1.y);
+            }
+            const int sb = lane + 32 * i, sub = sb & 3;
+            const float d = ue4m3((uint8_t) (ws[i] >> (8 * sub)));
+            const float t = acc + d * nvfp4_sub_dot(w0[i], w1[i], xv[0], xv[1], xv[2], xv[3]);
+            acc = (32 * (i + 1) <= NS || sb < NS) ? t : acc;
+        }
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
+        if (lane == 0) y[(size_t) slot * C + r] = acc;
+    }
+}
+template <int K, bool NT>
+__global__ void __launch_bounds__(128)
+experts_win_q4k_gu_kernel(const uint8_t* const* __restrict__ blob, const int* __restrict__ n_g,
+                          const int* __restrict__ tok_g, const int* __restrict__ row_g, size_t eb0,
+                          const float* __restrict__ x, int F, const float* __restrict__ sg,
+                          const float* __restrict__ su, float gcap, float ucap, uint16_t* __restrict__ h) {
+    constexpr int NU = K / 16, IT = (NU + 31) / 32;
+    constexpr size_t RB = (size_t) (K / 256) * kq::kQ4kBytes;
+    const int lane = threadIdx.x & 31, grp = blockIdx.y, n = n_g[grp];
+    const int r = blockIdx.x * 4 + (threadIdx.x >> 5);
+    if (n <= 0 || r >= F || (uintptr_t) blob[grp] <= 1u) return;
+    const uint8_t* wg = blob[grp] + (size_t) r * RB;
+    const uint8_t* wu = blob[grp] + eb0 + (size_t) r * RB;
+    Q4kW g[IT], u[IT];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {
+        const int un = min(lane + 32 * i, NU - 1);
+        g[i] = q4k_unit_load<NT>(wg, un);
+        u[i] = q4k_unit_load<NT>(wu, un);
+    }
+    for (int m = 0; m < n; ++m) {
+        const int slot = row_g[grp * kGroupMax + m];
+        const float4* x4 = (const float4*) (x + (size_t) tok_g[grp * kGroupMax + m] * K);
+        float4 xv[IT][4];
+#pragma unroll
+        for (int i = 0; i < IT; ++i) {   // (a unit's 8 low inputs from x4 [i0], its 8 high ones 32 values on)
+            const int i0 = kq::q4k_unit_x(min(lane + 32 * i, NU - 1)) >> 2;
+            xv[i][0] = __ldg(x4 + i0), xv[i][1] = __ldg(x4 + i0 + 1), xv[i][2] = __ldg(x4 + i0 + 8);
+            xv[i][3] = __ldg(x4 + i0 + 9);
+        }
