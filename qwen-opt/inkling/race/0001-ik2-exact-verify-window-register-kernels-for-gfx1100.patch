+// Q8_0 (row_dot / row_dot_2's 4-byte aligned order: lane l the block pairs 2 (l + 32 i), 2 (l + 32 i) + 1 - a pair's
+// 17 words in the registers - q8_blk0 then q8_blk1 into the row's sum; K a multiple of 64): a row (gate / up pair) a
+// wave.  The rows 4-byte aligned, as the one-token kernels find them (an expert's blocks start aligned, a row is a
+// multiple of 4 bytes at Inkling-2-Mini's widths).
+template <bool NT>
+__device__ __forceinline__ void q8w_load(const uint8_t* row, int p, uint32_t (&u)[17]) {
+    const uint8_t* b = row + (size_t) p * 68;
+#pragma unroll
+    for (int j = 0; j < 17; ++j) u[j] = kq_ld32<NT>(b + 4 * j);
+}
+__device__ __forceinline__ float q8w_pair(float acc, const uint32_t (&u)[17], const float4 (&f)[16]) {
+    float d1;
+    acc += q8_blk0_w(u[0], u[1], u[2], u[3], u[4], u[5], u[6], u[7], u[8], f[0], f[1], f[2], f[3], f[4], f[5], f[6],
+                     f[7], d1);
+    acc += q8_blk1_w(d1, u[9], u[10], u[11], u[12], u[13], u[14], u[15], u[16], f[8], f[9], f[10], f[11], f[12],
+                     f[13], f[14], f[15]);
+    return acc;
+}
+template <int K, bool NT>
+__global__ void __launch_bounds__(128)
+experts_win_q8_gu_kernel(const uint8_t* const* __restrict__ blob, const int* __restrict__ n_g,
+                         const int* __restrict__ tok_g, const int* __restrict__ row_g, size_t eb0,
+                         const float* __restrict__ x, int F, const float* __restrict__ sg,
+                         const float* __restrict__ su, float gcap, float ucap, uint16_t* __restrict__ h) {
+    constexpr int NP = K / 64, IT = (NP + 31) / 32;
+    constexpr size_t RB = (size_t) (K / 32) * 34;
+    const int lane = threadIdx.x & 31, grp = blockIdx.y, n = n_g[grp];
+    const int r = blockIdx.x * 4 + (threadIdx.x >> 5);
+    if (n <= 0 || r >= F || (uintptr_t) blob[grp] <= 1u) return;
+    const uint8_t* wg = blob[grp] + (size_t) r * RB;
+    const uint8_t* wu = blob[grp] + eb0 + (size_t) r * RB;
+    uint32_t gw[IT][17], uw[IT][17];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {
+        const int p = min(lane + 32 * i, NP - 1);
+        q8w_load<NT>(wg, p, gw[i]);
+        q8w_load<NT>(wu, p, uw[i]);
+    }
+    for (int m = 0; m < n; ++m) {
+        const int slot = row_g[grp * kGroupMax + m];
+        const float4* x4 = (const float4*) (x + (size_t) tok_g[grp * kGroupMax + m] * K);
+        float ag = 0.0f, au = 0.0f;
+#pragma unroll
+        for (int i = 0; i < IT; ++i) {
+            const int p = lane + 32 * i;
+            if (32 * (i + 1) > NP && p >= NP) break;
+            float4 f[16];
+#pragma unroll
+            for (int k = 0; k < 16; ++k) f[k] = __ldg(x4 + p * 16 + k);
+            ag = q8w_pair(ag, gw[i], f);
+            au = q8w_pair(au, uw[i], f);
+        }
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            ag += __shfl_xor_sync(0xffffffffu, ag, o);
+            au += __shfl_xor_sync(0xffffffffu, au, o);
+        }
+        if (lane == 0) {
+            const float sgs = sg ? sg[slot] : 1.0f, sus = su ? su[slot] : 1.0f;
+            h[(size_t) slot * F + r] = f2h(swiglu_h(ag * sgs, au * sus, gcap, ucap));
+        }
+    }
+}
+template <int K, bool NT>
+__global__ void __launch_bounds__(128)
+experts_win_q8_down_kernel(const uint8_t* const* __restrict__ blob, const int* __restrict__ n_g,
+                           const int* __restrict__ row_g, size_t off_down, const uint16_t* __restrict__ hin, int C,
+                           float* __restrict__ y) {
+    constexpr int NP = K / 64, IT = (NP + 31) / 32;
+    constexpr size_t RB = (size_t) (K / 32) * 34;
+    const int lane = threadIdx.x & 31, grp = blockIdx.y, n = n_g[grp];
+    const int r = blockIdx.x * 4 + (threadIdx.x >> 5);
+    if (n <= 0 || r >= C || (uintptr_t) blob[grp] <= 1u) return;
+    const uint8_t* w = blob[grp] + off_down + (size_t) r * RB;
+    uint32_t dw[IT][17];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) q8w_load<NT>(w, min(lane + 32 * i, NP - 1), dw[i]);
+    for (int m = 0; m < n; ++m) {
+        const int slot = row_g[grp * kGroupMax + m];
