+#pragma unroll
+            for (int k = 0; k < 8; ++k) {   // (a pair's 64 inputs: 8 x 8 FP16)
+                const uint4 v = __ldg(h8 + p * 8 + k);
+                const float2 a = u32_to_f2(v.x), b = u32_to_f2(v.y), c = u32_to_f2(v.z), d = u32_to_f2(v.w);
