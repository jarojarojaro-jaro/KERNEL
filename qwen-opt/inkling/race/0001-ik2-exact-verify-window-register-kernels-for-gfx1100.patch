+                    int ty_up, size_t eb0, const float* x, int C, int F, const float* sg, const float* su, float gcap,
+                    float ucap, uint16_t* h, cudaStream_t s) {
+    if (ty_gate != ty_up || C != 2304 || F % 4 || ((uintptr_t) x & 15) || eb0 % 4) return false;
+    if (ty_gate != kNVFP4 && ty_gate != kQ4_K && ty_gate != kQ8_0) return false;
+    if (G <= 0) return true;
+    const dim3 g((unsigned) (F / 4), (unsigned) G);
+#define IK2_WGU(KERN, NT) KERN<2304, NT><<<g, 128, 0, s>>>(blob, n, tok, row, eb0, x, F, sg, su, gcap, ucap, h)
+    if (ty_gate == kNVFP4) {
+        if (wexp_nt(1)) IK2_WGU(experts_win_nv_gu_kernel, true);
+        else IK2_WGU(experts_win_nv_gu_kernel, false);
+    } else if (ty_gate == kQ4_K) {
+        if (wexp_nt(1)) IK2_WGU(experts_win_q4k_gu_kernel, true);
+        else IK2_WGU(experts_win_q4k_gu_kernel, false);
+    } else {
+        if (wexp_nt(8)) IK2_WGU(experts_win_q8_gu_kernel, true);
+        else IK2_WGU(experts_win_q8_gu_kernel, false);
+    }
+#undef IK2_WGU
+    check("experts_win_gu");
+    return true;
