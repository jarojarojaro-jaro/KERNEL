+// K a constant: the window's router, dynamic taps
+template <int WARPS, int K>
+__global__ void __launch_bounds__(WARPS * 32)
+mv_f16_rows_k_kernel(const uint16_t* __restrict__ W, int N, const float* __restrict__ x, int x_ld,
+                     float* __restrict__ y, int y_ld) {
+    const int row = blockIdx.x * WARPS + (threadIdx.x >> 5), lane = threadIdx.x & 31, t = blockIdx.y;
+    if (row >= N) return;
