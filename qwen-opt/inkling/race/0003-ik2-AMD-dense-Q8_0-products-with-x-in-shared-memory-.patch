diff --git a/src/ik2/ik2_kernels.cu b/src/ik2/ik2_kernels.cu
index f6a0fb01..3c3fe076 100644
--- a/src/ik2/ik2_kernels.cu
+++ b/src/ik2/ik2_kernels.cu
@@ -2875,6 +2875,58 @@ __global__ void __launch_bounds__(128) loop_gate_dots_toks_kernel(LoopGateArgs a
     }
 }
 #endif
+// (1) on AMD for a window (IK2_K_DLG=1 with IK2_HIP_LGD on, T 2 .. 8, C 2304): a block a (rank, gate) for every
+// token, its D row's two halves asked for once, non-temporally (a block a (rank, gate, token) read it again for every
+// token), each token's x and m a token ahead of its sums - and the sums loop_gate_dots_kernel<U>'s, the token path's
+// kernel there: its expression in its order from zeros hidden the same way, the warp sums, the four warps added in
+// order.  So the same bits.
+__global__ void __launch_bounds__(128) loop_gate_dots_toks_amd_kernel(LoopGateArgs a, int T, int C, int R, float* sc) {
+    constexpr int kN = 2304 / 128;
+    __shared__ float sh[8][4][4];
+    const int r = blockIdx.x, j = blockIdx.y, tid = threadIdx.x, warp = tid >> 5;
+    const float* dr = a.D[j] + (size_t) r * 2 * C;
+    const float* xr = a.x[j];
+    const float* mr = a.m[j];
+    typedef const float __attribute__((address_space(1))) g_f;
+    float d0[kN], d1[kN], xv[kN], mv[kN];
+#pragma unroll
+    for (int k = 0; k < kN; ++k) {
+        const int c = tid + 128 * k;
+        d0[k] = __builtin_nontemporal_load((const g_f*) (dr + c));
+        d1[k] = __builtin_nontemporal_load((const g_f*) (dr + 2304 + c));
+        xv[k] = xr[c], mv[k] = mr[c];
+    }
+    for (int t = 0; t < T; ++t) {
+        float xn[kN], mn[kN];
+        const size_t tn = (size_t) min(t + 1, T - 1) * C;
+#pragma unroll
+        for (int k = 0; k < kN; ++k) xn[k] = xr[tn + tid + 128 * k], mn[k] = mr[tn + tid + 128 * k];
+        float ax = 0.0f, am = 0.0f, sx = 0.0f, sm = 0.0f;
+#ifdef MAYA_USE_HIP
+        asm volatile("" : "+v"(ax), "+v"(am), "+v"(sx), "+v"(sm));
+#endif
+#pragma unroll
+        for (int k = 0; k < kN; ++k) {
+            ax += d0[k] * xv[k], am += d1[k] * mv[k];
+            sx += xv[k] * xv[k], sm += mv[k] * mv[k];
+        }
+        ax = wsum(ax), am = wsum(am), sx = wsum(sx), sm = wsum(sm);
+        if ((tid & 31) == 0) sh[t][warp][0] = ax, sh[t][warp][1] = am, sh[t][warp][2] = sx, sh[t][warp][3] = sm;
+#pragma unroll
+        for (int k = 0; k < kN; ++k) xv[k] = xn[k], mv[k] = mn[k];
+    }
+    __syncthreads();
+    if (tid < T) {
+        const int t = tid;
+        float* o = sc + ((size_t) j * T + t) * (2 * R + 2);
+        o[2 * r] = sh[t][0][0] + sh[t][1][0] + sh[t][2][0] + sh[t][3][0];
+        o[2 * r + 1] = sh[t][0][1] + sh[t][1][1] + sh[t][2][1] + sh[t][3][1];
+        if (r == 0) {
+            o[2 * R] = sh[t][0][2] + sh[t][1][2] + sh[t][2][2] + sh[t][3][2];
+            o[2 * R + 1] = sh[t][0][3] + sh[t][1][3] + sh[t][2][3] + sh[t][3][3];
+        }
+    }
+}
 // (2) y = (1 - tanh(F g)) x + tanh(G g) m, F and G by rank ([R][C]).  A block is 32 channels of up to 8 tokens: its
 // 8 warps copy the channels' R rows of F and G into shared memory (the rows spread over the warps, a warp's loads all
 // issued at once - one thread a channel walking the rows itself left the loads in a chain on 27 blocks: 35 us a visit
@@ -7671,6 +7723,198 @@ mv_q8p_colsx_kernel(const int8_t* __restrict__ q, const uint16_t* __restrict__ d
 }
 #endif
 
+// ---- IK2_K_DMV / IK2_K_DCOLS (AMD, default off): the dense Q8_0 products in other launch shapes with the same sums.
+// mv_q8p_kernel's AMD rows (K a multiple of 256) and mv_q8p_cols_kernel's: lane l of a row's warp takes the 8 values
+// 256 it + 8 l .. of step it, acc += dv * (their 8 products, the same expression), the steps in order, then wsum - so
+// every row (every token's row) is the one-token kernel's to the bit.  What changes is where the bytes come from:
+// - x through shared memory: a block copies x (a window: a chunk of 3 steps of each token's x) once, laid out so that
+//   a lane's two float4 of a step are consecutive across the lanes; a wave read x from the caches four times a
+//   row's weight bytes (a window: 4 T / R times) and a window's x (T x 9 KB) does not fit the 16 KB L0;
+// - the weights (values and scales) read non-temporally, every step of the warp's rows asked for at once (the one
+//   token) or a chunk ahead (a window), not three steps a loop trip;
+// - K a constant (2304 or 3072: 9 or 12 steps), straight-line code; the sums start from zeros hidden from the compiler
+//   (as loop_gate_dots_kernel's: a folded 0 + p would let it fuse another product than the loop kernels do).
+// The CUDA build compiles them and never launches them (its one-token kernel's lanes take 4 values of each 128).
+__device__ __forceinline__ uint2 kd_ldw(const uint2* p) {
+#ifdef MAYA_USE_HIP
+    typedef unsigned kd_u2v __attribute__((ext_vector_type(2)));
+    const kd_u2v t = __builtin_nontemporal_load((const __attribute__((address_space(1))) kd_u2v*) p);
+    return make_uint2(t.x, t.y);
+#else
+    return __ldg(p);
+#endif
+}
+__device__ __forceinline__ uint16_t kd_ldh(const uint16_t* p) {   // (a scale's bits: made F32 where it is used)
+    return __builtin_nontemporal_load((const __attribute__((address_space(1))) uint16_t*) p);
+}
+__device__ __forceinline__ void kd_hide(float& v) {
+#ifdef MAYA_USE_HIP
+    asm volatile("" : "+v"(v));
+#else
+    (void) v;
+#endif
+}
+
+// one token: y [N] = W . x, a block WARPS x R rows (a warp R rows), x [K] in shared memory; c0 / c1 / a0 / a1 as
+// mv_q8p_kernel's (a0's and a1's ranges whole blocks: the block takes the input of its first row)
+template <int WARPS, int R, int NIT>
+__global__ void __launch_bounds__(WARPS * 32)
+mv_q8p_lds_kernel(const int8_t* __restrict__ q, const uint16_t* __restrict__ d, int N, const float* __restrict__ x0,
+                  float* y, MvConv c0, MvConv c1, MvAlt a0, MvAlt a1) {
+    constexpr int K = NIT * 256, B = WARPS * 32, NF = K / 4, CP = (NF + B - 1) / B;
+    __shared__ __align__(16) float4 xs[NF];   // float4 (2 it + h) 32 + l: lane l's xa (h 0) / xb (h 1) of step it
+    const int tid = threadIdx.x, lane = tid & 31;
+    const int rb0 = blockIdx.x * (WARPS * R), row0 = rb0 + (tid >> 5) * R;
+    const float* x = (unsigned) (rb0 - a0.r0) < (unsigned) a0.n   ? a0.x
+                     : (unsigned) (rb0 - a1.r0) < (unsigned) a1.n ? a1.x
+                                                                  : x0;
+    float4 xr[CP];
+#pragma unroll
+    for (int p = 0; p < CP; ++p) {
+        const int f = tid + p * B;
+        if (f < NF) xr[p] = __ldg((const float4*) x + f);
+    }
+    __builtin_amdgcn_sched_barrier(0);
+    uint2 w[R][NIT];
+    uint16_t dh[R][NIT];
+#pragma unroll
+    for (int i = 0; i < R; ++i) {
+        const int row = min(row0 + i, N - 1);   // (past the last row: the last again, not written)
+        const uint2* q2 = (const uint2*) (q + (size_t) row * K);
+        const uint16_t* dr = d + (size_t) row * (K >> 5);
+#pragma unroll
+        for (int it = 0; it < NIT; ++it) w[i][it] = kd_ldw(q2 + it * 32 + lane), dh[i][it] = kd_ldh(dr + it * 8 + (lane >> 2));
+    }
+    __builtin_amdgcn_sched_barrier(0);   // (x's loads first, then every weight's: x is in shared memory long before)
+#pragma unroll
+    for (int p = 0; p < CP; ++p) {
+        const int f = tid + p * B;   // (x's float4 f: step f / 64, lane (f % 64) / 2, half f % 2)
+        if (f < NF) xs[(((f >> 6) * 2 + (f & 1)) << 5) + ((f & 63) >> 1)] = xr[p];
+    }
+    __syncthreads();
+    if (row0 >= N) return;
+    float acc[R];
+#pragma unroll
+    for (int i = 0; i < R; ++i) acc[i] = 0.0f, kd_hide(acc[i]);
+#pragma unroll
+    for (int it = 0; it < NIT; ++it) {
+        const float4 xa = xs[((it * 2) << 5) + lane], xb = xs[((it * 2 + 1) << 5) + lane];
+#pragma unroll
+        for (int i = 0; i < R; ++i) {
+            const uint2 wv = w[i][it];
+            const float dv = h2f(dh[i][it]);
+            acc[i] += dv * ((float) (int8_t) (wv.x & 0xFFu) * xa.x + (float) (int8_t) ((wv.x >> 8) & 0xFFu) * xa.y +
+                            (float) (int8_t) ((wv.x >> 16) & 0xFFu) * xa.z + (float) (int8_t) (wv.x >> 24) * xa.w +
+                            (float) (int8_t) (wv.y & 0xFFu) * xb.x + (float) (int8_t) ((wv.y >> 8) & 0xFFu) * xb.y +
+                            (float) (int8_t) ((wv.y >> 16) & 0xFFu) * xb.z + (float) (int8_t) (wv.y >> 24) * xb.w);
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < R; ++i) {
+        const float a = wsum(acc[i]);
+        const int row = row0 + i;
+        if (lane == 0 && row < N && !mv_conv_row(c0, row, a) && !mv_conv_row(c1, row, a)) y[row] = a;
+    }
+}
+
+// a window: y [T][N] = W . x [T][K] (rows x_ld apart), a block WARPS x R rows (a warp R rows x T tokens), the steps in
+// chunks of 3: a chunk's x of every token in shared memory (copied by the block, the next chunk's x and weights
+// asked for before this chunk's sums); a0 / a1 as mv_q8p_colsx_kernel's, their ranges whole blocks
+template <int WARPS, int R, int T, int NIT>
+__global__ void __launch_bounds__(WARPS * 32)
+mv_q8p_cols_lds_kernel(const int8_t* __restrict__ q, const uint16_t* __restrict__ d, int N,
+                       const float* __restrict__ x0, int x_ld, float* __restrict__ y, int y_ld, MvAlt a0, MvAlt a1) {
+    constexpr int K = NIT * 256, S = 3, NC = NIT / S, B = WARPS * 32;
+    constexpr int NF = T * S * 64, CP = (NF + B - 1) / B;   // (a chunk's float4: token, step, 64 of a step)
+    static_assert(NIT % S == 0, "chunks of 3 steps");
+    __shared__ __align__(16) float4 xs[NF];   // float4 ((t S + s) 2 + h) 32 + l: token t's lane l's xa / xb of step s
+    const int tid = threadIdx.x, lane = tid & 31;
+    const int rb0 = blockIdx.x * (WARPS * R), row0 = rb0 + (tid >> 5) * R;
+    const float* x = (unsigned) (rb0 - a0.r0) < (unsigned) a0.n   ? a0.x
+                     : (unsigned) (rb0 - a1.r0) < (unsigned) a1.n ? a1.x
+                                                                  : x0;
+    const uint2* q2[R];
+    const uint16_t* dr[R];
+#pragma unroll
+    for (int i = 0; i < R; ++i) {
+        const int row = min(row0 + i, N - 1);   // (past the last row: the last again, not written)
+        q2[i] = (const uint2*) (q + (size_t) row * K), dr[i] = d + (size_t) row * (K >> 5);
+    }
+    float4 xr[CP];
+    uint2 w[R][NIT];
+    uint16_t dh[R][NIT];
+    float acc[R][T];
+#pragma unroll
+    for (int i = 0; i < R; ++i)
+#pragma unroll
+        for (int t = 0; t < T; ++t) acc[i][t] = 0.0f, kd_hide(acc[i][t]);
+#pragma unroll
+    for (int c = 0; c <= NC; ++c) {
+        if (c > 0) {   // chunk c - 1's x into shared memory (once the previous chunk's sums have read theirs)
+            if (c > 1) __syncthreads();
+#pragma unroll
+            for (int p = 0; p < CP; ++p) {
+                const int f = tid + p * B;
+                if (f < NF) {
+                    const int t = f / (S * 64), s = (f >> 6) - t * S, r = f & 63;
+                    xs[(((t * S + s) * 2 + (r & 1)) << 5) + (r >> 1)] = xr[p];
+                }
+            }
+            __syncthreads();
+        }
+        if (c < NC) {   // chunk c's loads: x first (its stores above wait for them, not for the weights)
+#pragma unroll
+            for (int p = 0; p < CP; ++p) {
+                const int f = tid + p * B;
+                if (f < NF) {
+                    const int t = f / (S * 64), s = (f >> 6) - t * S, r = f & 63;
+                    xr[p] = __ldg((const float4*) (x + (size_t) t * x_ld) + (c * S + s) * 64 + r);
+                }
+            }
+            __builtin_amdgcn_sched_barrier(0);
+#pragma unroll
+            for (int i = 0; i < R; ++i)
+#pragma unroll
+                for (int s = 0; s < S; ++s) {
+                    const int it = c * S + s;
+                    w[i][it] = kd_ldw(q2[i] + it * 32 + lane), dh[i][it] = kd_ldh(dr[i] + it * 8 + (lane >> 2));
+                }
+            __builtin_amdgcn_sched_barrier(0);
+        }
+        if (c > 0) {   // chunk c - 1's sums
+#pragma unroll
+            for (int s = 0; s < S; ++s) {
+                const int it = (c - 1) * S + s;
+#pragma unroll
+                for (int t = 0; t < T; ++t) {
+                    const float4 xa = xs[(((t * S + s) * 2) << 5) + lane], xb = xs[(((t * S + s) * 2 + 1) << 5) + lane];
+#pragma unroll
+                    for (int i = 0; i < R; ++i) {
+                        const uint2 wv = w[i][it];
+                        const float dv = h2f(dh[i][it]);
+                        acc[i][t] += dv * ((float) (int8_t) (wv.x & 0xFFu) * xa.x +
+                                           (float) (int8_t) ((wv.x >> 8) & 0xFFu) * xa.y +
+                                           (float) (int8_t) ((wv.x >> 16) & 0xFFu) * xa.z +
+                                           (float) (int8_t) (wv.x >> 24) * xa.w +
+                                           (float) (int8_t) (wv.y & 0xFFu) * xb.x +
+                                           (float) (int8_t) ((wv.y >> 8) & 0xFFu) * xb.y +
+                                           (float) (int8_t) ((wv.y >> 16) & 0xFFu) * xb.z +
+                                           (float) (int8_t) (wv.y >> 24) * xb.w);
+                    }
+                }
+            }
+        }
+    }
+    if (row0 >= N) return;
+#pragma unroll
+    for (int i = 0; i < R; ++i)
+#pragma unroll
+        for (int t = 0; t < T; ++t) {
+            const float a = wsum(acc[i][t]);
+            if (lane == 0 && row0 + i < N) y[(size_t) t * y_ld + row0 + i] = a;
+        }
+}
+
 // experts_gate_up_swiglu_kernel for group_route's groups: a block's rows for each member in turn (its x in shared
 // memory, the rows' weights read again from the cache), with the one-token kernel's row dots - the same h to the bit
 template <int WARPS, int ROWS>
@@ -8343,6 +8587,29 @@ void softcap(float* x, size_t n, float cap, cudaStream_t s) {
     check("softcap");
 }
 
+// IK2_K_DMV, IK2_K_DCOLS, IK2_K_DLG (AMD; default off; on: the same bits as off): the one-token dense product through
+// mv_q8p_lds_kernel, the window's through mv_q8p_cols_lds_kernel (and its rows with inputs of their own in one launch:
+// mv_q8p_cols_alts), the window's loop gates' dots through loop_gate_dots_toks_amd_kernel.  Each switch's value (0
+// off; DMV 1 / 2, DCOLS 1 / 8 / 16 / 32: the launch shapes), kd_force's where it set one.  Never on in the CUDA build
+// (its one-token kernel's lanes take other values: the AMD kernels' sums are not its bits).
+#ifdef MAYA_USE_HIP
+static int g_kd_force[3] = {-1, -1, -1};
+void kd_force(int mv, int cols, int lg) { g_kd_force[0] = mv, g_kd_force[1] = cols, g_kd_force[2] = lg; }
+static int kd_switch(int i) {
+    static const char* const names[3] = {"IK2_K_DMV", "IK2_K_DCOLS", "IK2_K_DLG"};
+    static int env[3] = {-1, -1, -1};
+    if (g_kd_force[i] >= 0) return g_kd_force[i];
+    if (env[i] < 0) env[i] = getenv(names[i]) ? std::max(0, atoi(getenv(names[i]))) : 0;
+    return env[i];
+}
+#else   // (nothing to turn on here)
+void kd_force(int, int, int) {}
+static int kd_switch(int) { return 0; }
+#endif
+static int kd_mv() { return kd_switch(0); }
+static int kd_cols() { return kd_switch(1); }
+static bool kd_lg_on() { return kd_switch(2) != 0; }
+
 static void lg_launch(const LoopGateArgs& a, int n, int T, int C, int R, float eps, float* sc, bool rms,
                       const float* rms_w, float rms_eps, float* rms_y, cudaStream_t s);
 void loop_gates(const LoopGate* gt, int n, int T, int C, int R, float eps, float* sc, cudaStream_t s) {
@@ -8364,13 +8631,19 @@ static void lg_launch(const LoopGateArgs& a, int n, int T, int C, int R, float e
 #ifdef MAYA_USE_HIP
     static const int lgd = getenv("IK2_HIP_LGD") ? atoi(getenv("IK2_HIP_LGD")) : 0;
     static const bool nta = getenv("IK2_HIP_NT") && (atoi(getenv("IK2_HIP_NT")) & 4);
-    if (lgd == 2) loop_gate_dots_kernel<2><<<gd, 128, 0, s>>>(a, T, C, R, sc);
-    else if (lgd) loop_gate_dots_kernel<1><<<gd, 128, 0, s>>>(a, T, C, R, sc);
-    else
 #else
+    const int lgd = 0;
     const bool nta = false;
     static const bool toks = !(getenv("IK2_GATE_TOKS") && !atoi(getenv("IK2_GATE_TOKS")));
-    if (toks && T <= 8 && C == 18 * 128)
+#endif
+    if (kd_lg_on() && lgd && T >= 2 && T <= 8 && C == 2304)   // (IK2_K_DLG: the token path's dots kernel is <lgd>)
+        loop_gate_dots_toks_amd_kernel<<<dim3((unsigned) R, (unsigned) n), 128, 0, s>>>(a, T, C, R, sc);
