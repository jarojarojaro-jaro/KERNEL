+// ---- the decode loop's host round trips (IK2_K_S*; off, the default: every step as before, bit for bit)
+// IK2_K_SOVL=1: the drafter's context rows of a step - work the host does not wait for - queued behind the step's
+//   launches before the host waits, and the host waits on an event after the step's own results instead of the whole
+//   stream: the GPU writes the rows while the host samples and queues the next step.  A window's rows are written for
+//   all its positions where ik2::draft::write_ahead_ok says the kept ones come out the same.  The controller's timing
+//   waits after a step go (a step's time ends where its tokens are the host's; what it left queued is the next one's).
+// IK2_K_SWIN=1: a drafted window queued straight behind its drafts, its embedding rows decoded on the device from the
+//   drafts the drafter left there (a pinned, mapped copy of the table; embd_rows_exact types, no IK2_ABLATE): one host
+//   wait a round instead of two.  The drafts' time from two events around the drafter's launches.
+// IK2_K_SSAMP=1: the host's sampling orders its candidates with nth_element + sort (partial_sort's order: the order
+//   is strict and total) and the Gumbel pick stops where no lower token's noise can reach the best: the same tokens.
+static bool k_env(const char* n) {
+    const char* v = getenv(n);
+    return v && std::atoi(v);
+}
+const bool g_k_sovl = k_env("IK2_K_SOVL"), g_k_swin = k_env("IK2_K_SWIN"), g_k_ssamp = k_env("IK2_K_SSAMP");
+struct KTail {   // (IK2_K_SOVL: the drafter's rows the next fast_token / fast_block queues behind its launches)
+    ik2::draft::Drafter* d = nullptr;
+    int rows = 0, pos0 = 0, f_rnn_row = -1;
+};
+KTail g_k_tail;
+cudaEvent_t g_k_ev = nullptr;
+void k_tail_run() {
+    const KTail t = g_k_tail;
+    g_k_tail = KTail{};
+    if (!t.d) return;
+    ik2::draft::write_context(t.d, g_taps, g_taps_ld, 0, t.rows, t.pos0);
+    if (t.f_rnn_row >= 0) ik2::draft::set_f_rnn(t.d, g_taps, g_taps_ld, t.f_rnn_row);
+}
+// a step's wait for its results: the stream - or, with a tail set, an event after the step's launches, the tail
+// queued behind it
+void k_step_wait() {
+    if (!g_k_tail.d) {
+        CU(cudaStreamSynchronize(g_s));
+        return;
+    }
+    if (!g_k_ev) CU(cudaEventCreateWithFlags(&g_k_ev, cudaEventDisableTiming));
+    CU(cudaEventRecord(g_k_ev, g_s));
+    k_tail_run();
+    CU(cudaEventSynchronize(g_k_ev));
+}
+// A plain token's drafter context row (d: the drafter, null: none) at position pos, from the token's taps: queued
+// behind the token's launches before its wait (IK2_K_SOVL: plain_rows_begin before the forward), else after it.
+void plain_rows_begin(ik2::draft::Drafter* d, int pos) {
+    if (g_k_sovl && d) g_k_tail = KTail{d, 1, pos, 0};
+}
+void plain_rows_end(ik2::draft::Drafter* d, int pos) {
+    if (g_k_tail.d) {   // (the forward took a path without fast_token's wait: queued now)
+        k_tail_run();
+    } else if (d && !g_k_sovl) {
+        ik2::draft::write_context(d, g_taps, g_taps_ld, 0, 1, pos);
+        ik2::draft::set_f_rnn(d, g_taps, g_taps_ld, 0);
+    }
+}
