+// IK2_K_SWIN: the embedding table where the GPU reads it (a pinned, mapped copy of its n_vocab rows: a window's rows
+// decoded on the device from tokens the device holds) and the window's tokens
+struct KEmb {
+    bool tried = false, ok = false;
+    const uint8_t* table_d = nullptr;           // (the copy's device address)
+    size_t rb = 0;                              // (a row's bytes)
+    int *tok_h = nullptr, *tok_d = nullptr;     // pinned [1]: the anchor; device [kBlockMax]: the window's tokens
+    const int* graph_tok = nullptr;             // (the drafts' address g_bgraph_dev was recorded with)
+    cudaEvent_t ev0 = nullptr, ev1 = nullptr;   // (around the drafter's launches: its time)
+};
+KEmb g_kemb;
+FastGraph g_bgraph_dev[kBlockMax + 1][4];   // (IK2_K_SWIN's windows, by size and OutMode)
+bool kemb_ready(Model& M) {
+    if (g_kemb.tried) return g_kemb.ok;
+    g_kemb.tried = true;
+    const Config& c = M.c;
+    const char* why = !M.ablate_e.empty()                 ? "IK2_ABLATE's projection of the embedding rows"
+                      : !k::embd_rows_exact(M.embd_type) ? "the embedding's block type"
+                      : !g_fast || g_two.on             ? "not the resident path on one GPU"
+                                                         : nullptr;
+    void *h = nullptr, *d = nullptr;
+    g_kemb.rb = (size_t) c.C / k::block_values(M.embd_type) * k::block_bytes(M.embd_type);
+    const size_t bytes = g_kemb.rb * (size_t) c.n_vocab;
+    if (!why && cudaHostAlloc(&h, bytes, cudaHostAllocPortable | cudaHostAllocMapped) != cudaSuccess)
+        cudaGetLastError(), why = "the table could not be pinned";
+    if (why) {
+        std::fprintf(stderr, "maya-ik2: IK2_K_SWIN off: %s\n", why);
+        return false;
+    }
+    std::memcpy(h, M.embd, bytes);
+    CU(cudaHostGetDevicePointer(&d, h, 0));
+    g_kemb.table_d = (const uint8_t*) d;
+    CU(cudaHostAlloc(&g_kemb.tok_h, sizeof(int), cudaHostAllocPortable));
+    g_kemb.tok_d = dalloc<int>(kBlockMax);
+    CU(cudaEventCreate(&g_kemb.ev0));
+    CU(cudaEventCreate(&g_kemb.ev1));
+    std::fprintf(stderr, "maya-ik2: IK2_K_SWIN: the windows queued behind their drafts (the embedding's %d rows "
+                 "pinned and mapped, %.2f GiB)\n", c.n_vocab, bytes / 1073741824.0);
+    return g_kemb.ok = true;
+}
