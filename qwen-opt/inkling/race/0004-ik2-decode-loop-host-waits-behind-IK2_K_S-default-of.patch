diff --git a/src/ik2/ik2_kernels.cu b/src/ik2/ik2_kernels.cu
index f6a0fb01..4aa0db55 100644
--- a/src/ik2/ik2_kernels.cu
+++ b/src/ik2/ik2_kernels.cu
@@ -9462,6 +9462,29 @@ void decode_host(int type, const uint8_t* blocks, size_t n, float* out) {
     for (size_t i = 0; i < n; ++i) out[i] = decode_value(type, blocks, i);
 }
 
+// IK2_K_SWIN: a window's embedding rows on the device.  A block a token: the row's bytes (host memory the GPU maps:
+// a PCIe read each) brought into shared memory in words, then decode_value as embd_host takes it.
+__global__ void embd_rows_kernel(int type, const uint8_t* table, size_t row_bytes, const int* tok, int C, float* out) {
+    extern __shared__ uint32_t embd_sm[];
+    const int t = blockIdx.x;
+    const uint8_t* row = table + (size_t) tok[t] * row_bytes;
+    uint8_t* sm = (uint8_t*) embd_sm;
+    if (row_bytes % 4 == 0 && ((uintptr_t) row & 3) == 0)
+        for (size_t i = threadIdx.x; i < row_bytes / 4; i += blockDim.x) embd_sm[i] = ((const uint32_t*) row)[i];
+    else
+        for (size_t i = threadIdx.x; i < row_bytes; i += blockDim.x) sm[i] = row[i];
+    __syncthreads();
+    for (int i = threadIdx.x; i < C; i += blockDim.x) out[(size_t) t * C + i] = decode_value(type, sm, (size_t) i);
+}
+bool embd_rows_exact(int type) {
+    return type == kQ8_0 || type == kQ6_K || type == kNVFP4 || type == kIQ3_XXS || type == kIQ4_XS || type == kQ5_0;
+}
+void embd_rows(int type, const uint8_t* table, size_t row_bytes, const int* tok, int T, int C, float* out,
+               cudaStream_t s) {
+    embd_rows_kernel<<<(unsigned) T, 256, (row_bytes + 3) / 4 * 4, s>>>(type, table, row_bytes, tok, C, out);
+    check("embd_rows");
+}
