+// and a copy
+__global__ void __launch_bounds__(kBlk) emb_norm2_kernel(const float* x, const float* w0, float* h, float* h2,
+                                                         const float* w1, float* y, int D, float eps) {
+    __shared__ float sh[kBlk];
