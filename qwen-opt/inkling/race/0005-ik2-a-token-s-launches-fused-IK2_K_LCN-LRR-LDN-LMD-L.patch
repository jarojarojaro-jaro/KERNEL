+res_router_kernel(ResStates st, int n, const float* q, int C, float res_eps, float rms_eps, const float* nw, uint16_t* x16,
+                  float* x32, const uint16_t* __restrict__ W, int E, float* rlog, const float* __restrict__ bias, int K,
