+__device__ __forceinline__ void store_k_warp(const float* kp, KvQ4* kdst, int, float qk_clip, float) {
+    const float4 xv = q4_src4(kp);
+    const float nrm = sqrtf(wsum(xv.x * xv.x + xv.y * xv.y + xv.z * xv.z + xv.w * xv.w));
+    const float f = fminf(1.0f, qk_clip / (nrm + 1e-6f));
+    q4_store_warp(make_float4(xv.x * f, xv.y * f, xv.z * f, xv.w * f), (uint8_t*) kdst);
+}
+__device__ __forceinline__ void store_v_warp(const float* vp, KvQ4* vdst, int D, float eps, float) {
+    const float4 xv = q4_src4(vp);
+    const float rs = rsqrtf(wsum(xv.x * xv.x + xv.y * xv.y + xv.z * xv.z + xv.w * xv.w) / (float) D + eps);
+    q4_store_warp(make_float4(xv.x * rs, xv.y * rs, xv.z * rs, xv.w * rs), (uint8_t*) vdst);
+}
