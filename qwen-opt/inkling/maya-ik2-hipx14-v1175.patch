+// (q4: kdst / vdst the row's record - kv_row; D is 128)
+__device__ __forceinline__ float4 q4_src4(const float* src) {
+    const int lane = threadIdx.x & 31;
+    if (((uintptr_t) src & 15) == 0) return ((const float4*) src)[lane];
+    return make_float4(src[4 * lane], src[4 * lane + 1], src[4 * lane + 2], src[4 * lane + 3]);
+}
+__device__ __forceinline__ void store_k_warp(const float* kp, KvQ4* kdst, int, float qk_clip, float) {
+    const float4 xv = q4_src4(kp);
+    const float nrm = sqrtf(wsum(xv.x * xv.x + xv.y * xv.y + xv.z * xv.z + xv.w * xv.w));
+    const float f = fminf(1.0f, qk_clip / (nrm + 1e-6f));
+    q4_store_warp(make_float4(xv.x * f, xv.y * f, xv.z * f, xv.w * f), (uint8_t*) kdst);
+}
+__device__ __forceinline__ void store_v_warp(const float* vp, KvQ4* vdst, int D, float eps, float) {
+    const float4 xv = q4_src4(vp);
+    const float rs = rsqrtf(wsum(xv.x * xv.x + xv.y * xv.y + xv.z * xv.z + xv.w * xv.w) / (float) D + eps);
+    q4_store_warp(make_float4(xv.x * rs, xv.y * rs, xv.z * rs, xv.w * rs), (uint8_t*) vdst);
+}
+// a cache's row at element offset e (q4: its record)
+template <class KV>
+__device__ __forceinline__ KV* kv_row(KV* c, size_t e) {
+    return c + e;
+}
+__device__ __forceinline__ KvQ4* kv_row(KvQ4* c, size_t e) {
+    return (KvQ4*) ((uint8_t*) c + (e >> 7) * kQ4Rec);
+}
+
+// a lane's part of a warp's FP16 . F32 dot of K values (lane, lane + 32, ...) in the loop's order, every load asked for
+// first (AMD, IK2_HIP_MVF16=1: the loop waits for each step's loads in turn - 15 us for a row of 2304)
+template <int K>
+__device__ __forceinline__ float f16_dot_lane(const uint16_t* w, const float* x, int lane) {
+    uint16_t wv[K / 32];
+    float xv[K / 32];
+#pragma unroll
+    for (int i = 0; i < K / 32; ++i) wv[i] = w[lane + 32 * i], xv[i] = x[lane + 32 * i];
+    float a = 0.0f;
+#pragma unroll
+    for (int i = 0; i < K / 32; ++i) a += h2f(wv[i]) * xv[i];
+    return a;
+}
 
