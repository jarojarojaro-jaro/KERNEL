+// IK2_KV=q4: the cache in 4 bits, ggml q4_0's numbers (blocks of 32 values along a head's 128 dims: an FP16 scale
+// d = max / -8 of the value of largest magnitude, codes min(15, (int) (x / d + 8.5)), a value (code - 8) d - what
+// quantize_row_q4_0 makes, so the same as llama.cpp's -ctk/-ctv q4_0), laid out for the kernels' loads: a record of
+// 72 bytes a (position, K / V head) - 64 bytes of codes (byte i: dim 2 i in its low nibble, 2 i + 1 in its high), then
+// the four blocks' scales.  An element offset e of the FP16 cache's [kv_cap][KV][128] is record e >> 7, dim e & 127.
+// (KvQ4: the kernels' tag type for it; its pointers are the cache's bytes, never stepped by element.)
+struct KvQ4 {
+    uint8_t b;
+};
+constexpr int kQ4Rec = kKvQ4Rec;
+__device__ __forceinline__ const uint8_t* q4_rec(const KvQ4* base, size_t e) {
+    return (const uint8_t*) base + (e >> 7) * kQ4Rec;
+}
+// the scale of dim's block in both halves (FP16 bits)
+__device__ __forceinline__ uint32_t q4_d2(const uint8_t* rec, int dim) {
+    const uint32_t d = *(const uint16_t*) (rec + 64 + 2 * (dim >> 5));
+    return d | (d << 16);
+}
+// four codes (bits 0, 4, 8, 12 of n: dims 0 .. 3) as FP16 times d2: lo dims 0, 1, hi dims 2, 3.  A code c as FP16 is
+// 1024 + c (0x6400 | c); less 1032, exact, then times the scale (rounded to nearest, as ggml's FP16 dequantization)
+__device__ __forceinline__ void q4x4_h4(uint32_t n, uint32_t d2, uint32_t& lo, uint32_t& hi) {
+    lo = h2_mul(h2_sub((n & 0xFu) | ((n & 0xF0u) << 12) | 0x64006400u, 0x64086408u), d2);
+    hi = h2_mul(h2_sub(((n >> 8) & 0xFu) | ((n & 0xF000u) << 4) | 0x64006400u, 0x64086408u), d2);
+}
+__device__ __forceinline__ uint4 q4x8_h8(uint32_t w, uint32_t d2) {
+    uint4 h;
+    q4x4_h4(w, d2, h.x, h.y);
+    q4x4_h4(w >> 16, d2, h.z, h.w);
+    return h;
+}
+// the 8 values from element offset e (a multiple of 8) as FP16
+__device__ __forceinline__ uint4 q4_ld8(const KvQ4* base, size_t e) {
+    const uint8_t* rec = q4_rec(base, e);
+    const int dim = (int) (e & 127);
+    return q4x8_h8(*(const uint32_t*) (rec + (dim >> 1)), q4_d2(rec, dim));
+}
+// a warp's head row into its record: lane holds dims 4 lane .. + 3 (x); the 8 lanes of a block find its value of
+// largest magnitude (the first of equals, as quantize_row_q4_0's scan)
+__device__ __forceinline__ void q4_store_warp(float4 x, uint8_t* rec) {
+    const int lane = threadIdx.x & 31;
+    float am = fabsf(x.x), mv = x.x;
+    if (fabsf(x.y) > am) am = fabsf(x.y), mv = x.y;
+    if (fabsf(x.z) > am) am = fabsf(x.z), mv = x.z;
+    if (fabsf(x.w) > am) am = fabsf(x.w), mv = x.w;
+    int src = lane;
+#pragma unroll
+    for (int sh = 1; sh < 8; sh <<= 1) {
+        const float oa = __shfl_xor_sync(0xffffffffu, am, sh), ov = __shfl_xor_sync(0xffffffffu, mv, sh);
+        const int os = __shfl_xor_sync(0xffffffffu, src, sh);
+        if (oa > am || (oa == am && os < src)) am = oa, mv = ov, src = os;
+    }
+    const float d = mv / -8.0f, id = d != 0.0f ? 1.0f / d : 0.0f;
+    auto code = [&](float v) { return (uint32_t) min(15, (int) (__fmul_rn(v, id) + 8.5f)); };
+    ((uint16_t*) rec)[lane] = (uint16_t) (code(x.x) | (code(x.y) << 4) | (code(x.z) << 8) | (code(x.w) << 12));
+    if ((lane & 7) == 0) ((uint16_t*) (rec + 64))[lane >> 3] = f2h(d);
+}
+// the decode kernels' fragments (attn_decode_mma_kernel / attn_block_mma_kernel) from a q4 cache: K - the lane's dims
+// 16 kk + 4 tq .. + 3 of the keys at element offsets e0 / e1 (ka[kk][0], [2] / [1], [3], as the FP16 words); V - the
+// 16 dims 16 gr .. of the key at e, FP16 (lo the first 8)
+__device__ __forceinline__ void q4_k_frags(const KvQ4* kc, size_t e0, size_t e1, int tq, uint32_t (&ka)[8][4]) {
+    const uint8_t* r0 = q4_rec(kc, e0);
+    const uint8_t* r1 = q4_rec(kc, e1);
+    const uint2 s0 = *(const uint2*) (r0 + 64), s1 = *(const uint2*) (r1 + 64);
+    uint32_t n0[8], n1[8];
+#pragma unroll
+    for (int kk = 0; kk < 8; ++kk) {
+        n0[kk] = *(const uint16_t*) (r0 + 8 * kk + 2 * tq);
+        n1[kk] = *(const uint16_t*) (r1 + 8 * kk + 2 * tq);
+    }
+#pragma unroll
+    for (int kk = 0; kk < 8; ++kk) {   // (the scale of block kk / 2)
+        const uint32_t w0 = kk < 4 ? s0.x : s0.y, w1 = kk < 4 ? s1.x : s1.y;
+        const uint32_t d0 = (kk & 2) ? (w0 >> 16) : (w0 & 0xFFFFu), d1 = (kk & 2) ? (w1 >> 16) : (w1 & 0xFFFFu);
+        q4x4_h4(n0[kk], d0 | (d0 << 16), ka[kk][0], ka[kk][2]);
+        q4x4_h4(n1[kk], d1 | (d1 << 16), ka[kk][1], ka[kk][3]);
+    }
+}
+__device__ __forceinline__ void q4_v_row16(const KvQ4* vc, size_t e, int gr, uint4& lo, uint4& hi) {
+    const uint8_t* r = q4_rec(vc, e);
+    const uint2 w = *(const uint2*) (r + 8 * gr);
+    const uint32_t d = *(const uint16_t*) (r + 64 + 2 * (gr >> 1));
+    lo = q4x8_h8(w.x, d | (d << 16));
+    hi = q4x8_h8(w.y, d | (d << 16));
+}
