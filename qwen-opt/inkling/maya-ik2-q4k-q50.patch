+// ---- Q4_K / Q5_0: ik2_kq.h's units (lane l the units l, l + 32, ..; every kernel the same sums).  A unit's words:
+// Q4_K the block's first 4 (d | dmin, the scales) and its 2 code words (144-byte blocks: 4-byte loads from a 4-byte
+// aligned row); Q5_0 d, qh's halves and its 4 code bytes (22-byte blocks: 16-bit loads).  NT: non-temporal (AMD).
+#ifdef STRATA_USE_HIP
+typedef const uint32_t __attribute__((address_space(1))) kq_g32;   // (global, not flat: the rows' pointers are generic)
+typedef const uint16_t __attribute__((address_space(1))) kq_g16;
+#endif
+template <bool NT>
+__device__ __forceinline__ uint32_t kq_ld32(const uint8_t* p) {
+#ifdef STRATA_USE_HIP
+    if constexpr (NT) return __builtin_nontemporal_load((kq_g32*) p);
+    return *(kq_g32*) p;
+#else
+    return __ldg((const unsigned int*) p);
+#endif
+}
+template <bool NT>
+__device__ __forceinline__ uint32_t kq_ld16(const uint8_t* p) {
+#ifdef STRATA_USE_HIP
+    if constexpr (NT) return (uint32_t) __builtin_nontemporal_load((kq_g16*) p);
+    return (uint32_t) *(kq_g16*) p;
+#else
+    return (uint32_t) __ldg((const unsigned short*) p);
+#endif
+}
+struct Q4kW {
+    uint32_t dm, s0, s1, s2, w0, w1;
+};
+template <bool NT = false>
+__device__ __forceinline__ Q4kW q4k_unit_load(const uint8_t* row, int u) {
+    const uint8_t* b = row + (size_t) (u >> 4) * kq::kQ4kBytes;
+    const int wo = kq::q4k_unit_w(u);
+    Q4kW r;
+    r.dm = kq_ld32<NT>(b), r.s0 = kq_ld32<NT>(b + 4), r.s1 = kq_ld32<NT>(b + 8), r.s2 = kq_ld32<NT>(b + 12);
+    r.w0 = kq_ld32<NT>(b + 4 * wo), r.w1 = kq_ld32<NT>(b + 4 * wo + 4);
+    return r;
+}
+__device__ __forceinline__ float q4k_unit_dot(const Q4kW& w, int u, const float* xl, const float* xh, float sxl,
+                                              float sxh, float acc) {
+    return kq::q4k_unit(kq::q4k_scales(w.dm, w.s0, w.s1, w.s2, (u >> 2) & 3), w.w0, w.w1, xl, xh, sxl, sxh, acc);
+}
+struct Q50W {
+    uint32_t d, qh, qs;
+};
+template <bool NT = false>
+__device__ __forceinline__ Q50W q50_unit_load(const uint8_t* row, int u) {
+    const uint8_t* b = row + (size_t) (u >> 2) * kq::kQ50Bytes;
+    const int q = u & 3;
+    Q50W r;
+    r.d = kq_ld16<NT>(b);
+    r.qh = kq_ld16<NT>(b + 2) | (kq_ld16<NT>(b + 4) << 16);
+    r.qs = kq_ld16<NT>(b + 6 + 4 * q) | (kq_ld16<NT>(b + 8 + 4 * q) << 16);
+    return r;
+}
+__device__ __forceinline__ float q50_unit_dot(const Q50W& w, int u, const float* xl, const float* xh, float acc) {
+    return kq::q50_unit(w.d, w.qh, w.qs, u & 3, xl, xh, acc);
+}
+// a unit's inputs from the padded shared x (xp): Q4_K 8 + 8 (from i0, i0 + 32), Q5_0 4 + 4 (from i0, i0 + 16)
+__device__ __forceinline__ void kq_xs8(const float* xs, int i0, float* xl, float* xh) {
+    const float4* l = (const float4*) (xs + xp(i0));
+    const float4* h = (const float4*) (xs + xp(i0 + 32));
+    const float4 a = l[0], b = l[1], c = h[0], d = h[1];
+    xl[0] = a.x, xl[1] = a.y, xl[2] = a.z, xl[3] = a.w, xl[4] = b.x, xl[5] = b.y, xl[6] = b.z, xl[7] = b.w;
+    xh[0] = c.x, xh[1] = c.y, xh[2] = c.z, xh[3] = c.w, xh[4] = d.x, xh[5] = d.y, xh[6] = d.z, xh[7] = d.w;
+}
+__device__ __forceinline__ void kq_xs4(const float* xs, int i0, float* xl, float* xh) {
+    const float4 a = *(const float4*) (xs + xp(i0)), c = *(const float4*) (xs + xp(i0 + 16));
+    xl[0] = a.x, xl[1] = a.y, xl[2] = a.z, xl[3] = a.w;
+    xh[0] = c.x, xh[1] = c.y, xh[2] = c.z, xh[3] = c.w;
+}
