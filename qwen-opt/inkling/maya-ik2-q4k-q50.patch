+/// FP16 bits to F32 (exact)
+IK2KQ_HD float h2f(uint32_t h16) {
+#if IK2KQ_DEVICE
+    return __half2float(__ushort_as_half((unsigned short) (h16 & 0xFFFFu)));
+#else
+    const uint32_t h = h16 & 0xFFFFu, sign = (h >> 15) << 31, e = (h >> 10) & 31, m = h & 1023;
+    uint32_t u;
+    if (e == 0) {
+        if (m == 0) {
+            u = sign;
+        } else {   // (subnormal: normalised)
+            int sh = 0;
+            uint32_t mm = m;
+            while (!(mm & 1024)) mm <<= 1, ++sh;
+            u = sign | ((uint32_t) (113 - sh) << 23) | ((mm & 1023) << 13);
+        }
+    } else if (e == 31) {
+        u = sign | 0x7f800000u | (m << 13);
+    } else {
+        u = sign | ((e + 112) << 23) | (m << 13);
+    }
+    float f;
+    std::memcpy(&f, &u, 4);
+    return f;
+#endif
