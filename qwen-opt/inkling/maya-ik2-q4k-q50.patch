+                acc[t] = q4k_unit_dot(q, u, xl, xh, kq::sum8(xl), kq::sum8(xh), acc[t]);
+            }
+        }
+    } else if (type == kQ5_0 && ((uintptr_t) w & 1) == 0) {
+        for (int u = lane; u < K / 8; u += 32) {
+            const Q50W q = q50_unit_load(w, u);
+            const int i0 = kq::q50_unit_x(u);
+#pragma unroll
+            for (int t = 0; t < N_CAP; ++t) {
+                if (t >= n) break;
+                float xl[4], xh[4];
+#pragma unroll
+                for (int k = 0; k < 4; ++k) xl[k] = xval(xs[t], i0 + k), xh[k] = xval(xs[t], i0 + 16 + k);
+                acc[t] = q50_unit_dot(q, u, xl, xh, acc[t]);
+            }
+        }
     } else {
         for (int i = lane; i < K; i += 32) {
             const float wv = decode_value(type, w, (size_t) i);
@@ -4068,6 +4302,21 @@ __device__ void row_dot_pair_multi(int type, const uint8_t* wg, const uint8_t* w
                 }
