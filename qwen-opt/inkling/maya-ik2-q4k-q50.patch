+/// value v of a run of Q4_K blocks
+IK2KQ_HD float q4k_value(const uint8_t* blocks, size_t v) {
+    const uint8_t* b = blocks + (v / 256) * kQ4kBytes;
+    const int i = (int) (v % 256), j = i / 64, hi = (i / 32) & 1, l = i % 32;
+    int sc, m;
+    scale_min(2 * j + hi, b + 4, sc, m);
+    const float d1 = h2f((uint32_t) b[0] | ((uint32_t) b[1] << 8)) * (float) sc;
+    const float m1 = h2f((uint32_t) b[2] | ((uint32_t) b[3] << 8)) * (float) m;
+    const uint8_t q = b[16 + 32 * j + l];
+    return d1 * (float) (hi ? q >> 4 : q & 0xF) - m1;
