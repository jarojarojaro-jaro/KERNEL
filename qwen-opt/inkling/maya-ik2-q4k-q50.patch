+/// ggml's get_scale_min_k4: scale / min pair j (0..7) of a Q4_K / Q5_K block's 12 scale bytes
+IK2KQ_HD void scale_min(int j, const uint8_t* q, int& sc, int& m) {
+    if (j < 4) {
