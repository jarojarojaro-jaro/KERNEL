+IK2KQ_HD Q4kSc q4k_scales(uint32_t dm, uint32_t s0, uint32_t s1, uint32_t s2, int j) {
+    const int sh = 16 * (j & 1);
+    const uint32_t a = s0 >> sh, b = s1 >> sh, c = s2 >> sh;
