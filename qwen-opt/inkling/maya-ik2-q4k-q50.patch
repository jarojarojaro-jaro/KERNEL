+// ggml's dequantize_row_q4_K (with get_scale_min_k4) / dequantize_row_q5_0, transcribed from ggml-quants.c
+void ggml_q4_K(const uint8_t* x, float* y, size_t k) {
+    auto scale_min = [](int j, const uint8_t* q, uint8_t* d, uint8_t* m) {
+        if (j < 4) {
+            *d = q[j] & 63, *m = q[j + 4] & 63;
+        } else {
+            *d = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4), *m = (q[j + 4] >> 4) | ((q[j - 0] >> 6) << 4);
+        }
+    };
+    for (size_t i = 0; i < k / 256; ++i) {
+        const uint8_t* blk = x + i * 144;
+        const uint8_t* q = blk + 16;
+        const float d = h2f_host((uint16_t) (blk[0] | (blk[1] << 8))), min = h2f_host((uint16_t) (blk[2] | (blk[3] << 8)));
+        int is = 0;
+        uint8_t sc, m;
+        for (int j = 0; j < 256; j += 64) {
+            scale_min(is + 0, blk + 4, &sc, &m);
+            const float d1 = d * sc, m1 = min * m;
+            scale_min(is + 1, blk + 4, &sc, &m);
+            const float d2 = d * sc, m2 = min * m;
+            for (int l = 0; l < 32; ++l) *y++ = d1 * (q[l] & 0xF) - m1;
+            for (int l = 0; l < 32; ++l) *y++ = d2 * (q[l] >> 4) - m2;
+            q += 32;
+            is += 2;
+        }
+    }
+}
+void ggml_q5_0(const uint8_t* x, float* y, size_t k) {
