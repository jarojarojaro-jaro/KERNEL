@@ -0,0 +1,249 @@
+// src/ik2/ik2_kq.h - maya-ik2's Q4_K and Q5_0 blocks (AtomicChat's Inkling-2-Mini-Uncensored-AD-Q4_K: the experts'
+// gate_up in Q4_K, down in Q5_0), one arithmetic for the host and the device:
+//   * a value as ggml's dequantize_row_q4_K / dequantize_row_q5_0 make it (Q4_K: d1 q - m1 with d1 = d sc, m1 = dmin m;
+//     Q5_0: (q - 16) d).  Every product there is exact in F32 (an FP16 times a 6-bit scale, times a 4- or 5-bit
+//     code), so a contraction to an FMA cannot change a value: the device's are the host's to the bit;
+//   * a row's dot product in one fixed order - the "unit" a lane takes (Q4_K: 16 values, the same 8 positions of the
+//     two sub-blocks that share a 32-byte run of codes; Q5_0: 8 values, 4 low and the same 4 high nibbles of a block),
+//     lane l the units l, l + 32, .. in turn, then the warp's butterfly (j + j^16, j^8, .. j^1).  Its sums are
+//     explicit FMAs and the plain products in it exact, so no compiler contraction changes a bit either: every kernel
+//     that dots such a row (one token's, the exact window's, the grouped ones, AMD's register kernels) gives the
+//     same sums, and row_dot_host below gives them on the host (tests/ik2_kernels_test.cu holds the GPU to it).
+// Q4_K block (144 bytes): d, dmin (FP16), scales [12] (8 6-bit scale / min pairs, ggml's get_scale_min_k4), qs [128]
+// (32-byte run j: sub-block 2 j in the low nibbles, 2 j + 1 in the high ones).  Q5_0 block (22 bytes): d (FP16),
+// qh [4] (bit i: the 5th bit of value i), qs [16] (value i < 16 the low nibble of byte i, value i + 16 its high one).
+#pragma once
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#if defined(__CUDACC__) || defined(__HIPCC__)
+#include <cuda_fp16.h>
+#define IK2KQ_HD __host__ __device__ __forceinline__
+#else
+#define IK2KQ_HD inline
+#endif
+#if defined(__CUDA_ARCH__) || defined(__HIP_DEVICE_COMPILE__)
+#define IK2KQ_DEVICE 1
+#define IK2KQ_UNROLL _Pragma("unroll")
+#else
+#define IK2KQ_DEVICE 0
+#define IK2KQ_UNROLL
+#endif
+
+namespace ik2::kq {
+
+constexpr int kQ5_0 = 6, kQ4_K = 12;          // (ggml's type ids, ik2_kernels.cuh's)
+constexpr int kQ4kBytes = 144, kQ50Bytes = 22;   // (a block's bytes: 256 / 32 values)
+
+IK2KQ_HD float fma(float a, float b, float c) {
+#if IK2KQ_DEVICE
+    return fmaf(a, b, c);
+#else
+    return std::fma(a, b, c);
+#endif
