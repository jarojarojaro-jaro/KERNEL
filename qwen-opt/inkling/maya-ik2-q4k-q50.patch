+            float xl[4], xh[4];
+            kq_xs4(xs, kq::q50_unit_x(u), xl, xh);
+            const Q50W g = q50_unit_load<NT>(wg, u), v = q50_unit_load<NT>(wu, u);
+            ag = q50_unit_dot(g, u, xl, xh, ag);
+            au = q50_unit_dot(v, u, xl, xh, au);
+        }
     } else {
         for (int i = lane; i < K; i += 32) {
             const float xv = xs[xp(i)];
@@ -3664,6 +3774,104 @@ experts_nv_down_kernel(const uint8_t* const* __restrict__ blob, size_t off_down,
 }
 #endif   // STRATA_USE_HIP
 
+// ---- one token's Q4_K gate / up and Q5_0 down experts with the input in the registers (AMD IK2_HIP_EXPV=1; CUDA
+// IK2_EXPV_KQ=1, tests): experts_nv_*_kernel's layout for ik2_kq.h's units - a row (gate / up pair) a wave, four
+// waves a block; a lane's units (lane + 32 i) and their inputs in its registers, all its words asked for at once,
+// then the sums.  A lane past the row's end reads the last unit and keeps its sum.  The units in row_dot's order and
+// the same butterfly: experts_gate_up_swiglu_kernel's / experts_down_kernel's bits (and so the exact window's).
+// NT: the weights read non-temporally (AMD, IK2_HIP_NT bit 1, as the NVFP4 kernels').
+template <int K, bool NT>
+__global__ void __launch_bounds__(128)
+experts_q4k_gu_kernel(const uint8_t* const* __restrict__ blob, const int* __restrict__ tok, size_t eb0,
+                      const float* __restrict__ x, int F, const float* __restrict__ sg, const float* __restrict__ su,
+                      float gcap, float ucap, uint16_t* __restrict__ h) {
+    constexpr int NU = K / 16, IT = (NU + 31) / 32;
+    constexpr size_t RB = (size_t) (K / 256) * kq::kQ4kBytes;
+    const int lane = threadIdx.x & 31, s = blockIdx.y;
+    const int r = blockIdx.x * 4 + (threadIdx.x >> 5);
+    if (r >= F) return;
+    const float4* x4 = (const float4*) (x + (size_t) tok[s] * K);
+    const uint8_t* wg = blob[s] + (size_t) r * RB;
+    const uint8_t* wu = blob[s] + eb0 + (size_t) r * RB;
+    float4 xv[IT][4];
+    Q4kW g[IT], u[IT];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {   // (a unit's 8 low inputs from x4 [i0], its 8 high ones 32 values on)
+        const int i0 = kq::q4k_unit_x(min(lane + 32 * i, NU - 1)) >> 2;
+        xv[i][0] = __ldg(x4 + i0), xv[i][1] = __ldg(x4 + i0 + 1), xv[i][2] = __ldg(x4 + i0 + 8);
+        xv[i][3] = __ldg(x4 + i0 + 9);
+    }
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {
+        const int un = min(lane + 32 * i, NU - 1);
+        g[i] = q4k_unit_load<NT>(wg, un);
+        u[i] = q4k_unit_load<NT>(wu, un);
+    }
+#ifdef STRATA_USE_HIP
+    __builtin_amdgcn_sched_barrier(0);
+#endif
+    const float sgs = sg ? sg[s] : 1.0f, sus = su ? su[s] : 1.0f;
+    float ag = 0.0f, au = 0.0f;
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {
+        const int un = lane + 32 * i;
+        const float xl[8] = {xv[i][0].x, xv[i][0].y, xv[i][0].z, xv[i][0].w, xv[i][1].x, xv[i][1].y, xv[i][1].z, xv[i][1].w};
+        const float xh[8] = {xv[i][2].x, xv[i][2].y, xv[i][2].z, xv[i][2].w, xv[i][3].x, xv[i][3].y, xv[i][3].z, xv[i][3].w};
+        const float sl = kq::sum8(xl), sh = kq::sum8(xh);
+        const float tg = q4k_unit_dot(g[i], un, xl, xh, sl, sh, ag);
+        const float tu = q4k_unit_dot(u[i], un, xl, xh, sl, sh, au);
+        const bool in = 32 * (i + 1) <= NU || un < NU;
+        ag = in ? tg : ag;
+        au = in ? tu : au;
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        ag += __shfl_xor_sync(0xffffffffu, ag, o);
+        au += __shfl_xor_sync(0xffffffffu, au, o);
+    }
+    if (lane == 0) {
+        const float gv = ag * sgs, uv = au * sus;
+        h[(size_t) s * F + r] = f2h(gcap * tanhf(gv / gcap) * (1.0f / (1.0f + expf(-gv))) * ucap * tanhf(uv / ucap));
+    }
+}
+template <int K, bool NT>
+__global__ void __launch_bounds__(128)
+experts_q50_down_kernel(const uint8_t* const* __restrict__ blob, size_t off_down, const uint16_t* __restrict__ hin,
+                        int C, float* __restrict__ y) {
+    constexpr int NU = K / 8, IT = (NU + 31) / 32;
+    constexpr size_t RB = (size_t) (K / 32) * kq::kQ50Bytes;
+    const int lane = threadIdx.x & 31, s = blockIdx.y;
+    const int r = blockIdx.x * 4 + (threadIdx.x >> 5);
+    if (r >= C) return;
+    const uint2* h4 = (const uint2*) (hin + (size_t) s * K);
+    const uint8_t* w = blob[s] + off_down + (size_t) r * RB;
+    uint2 hv[IT][2];
+    Q50W q[IT];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {   // (a unit's 4 low inputs from h4 [i0], its 4 high ones 16 values on)
+        const int i0 = kq::q50_unit_x(min(lane + 32 * i, NU - 1)) >> 2;
+        hv[i][0] = __ldg(h4 + i0), hv[i][1] = __ldg(h4 + i0 + 4);
+    }
+#pragma unroll
+    for (int i = 0; i < IT; ++i) q[i] = q50_unit_load<NT>(w, min(lane + 32 * i, NU - 1));
+#ifdef STRATA_USE_HIP
+    __builtin_amdgcn_sched_barrier(0);
+#endif
+    float acc = 0.0f;
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {
+        const int un = lane + 32 * i;
+        const float2 a = u32_to_f2(hv[i][0].x), b = u32_to_f2(hv[i][0].y);
+        const float2 c = u32_to_f2(hv[i][1].x), d = u32_to_f2(hv[i][1].y);
+        const float xl[4] = {a.x, a.y, b.x, b.y}, xh[4] = {c.x, c.y, d.x, d.y};
+        const float t = q50_unit_dot(q[i], un, xl, xh, acc);
+        acc = (32 * (i + 1) <= NU || un < NU) ? t : acc;
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
+    if (lane == 0) y[(size_t) s * C + r] = acc;
+}
+
