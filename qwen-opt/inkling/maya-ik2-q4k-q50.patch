diff --git a/tests/ik2_kq_test.cpp b/tests/ik2_kq_test.cpp
new file mode 100644
index 0000000..c7a3aff
--- /dev/null
+++ b/tests/ik2_kq_test.cpp
@@ -0,0 +1,212 @@
+// tests/ik2_kq_test.cpp - maya-ik2's Q4_K and Q5_0 arithmetic (src/ik2/ik2_kq.h, what decode_value / decode_host and
+// every row-dot kernel of ik2_kernels.cu call) on the host, no GPU: on random blocks
+//   * the values = ggml's dequantize_row_q4_K / dequantize_row_q5_0 (transcribed from third_party/ggml's
+//     ggml-quants.c), bit for bit;
+//   * the 64-value runs the AMD prompt kernels make FP16 tiles of = those values;
+//   * the row dots in the kernels' order (row_dot_host: the lanes' units, then the butterfly) = the double sum of
+//     value x input within F32's rounding, over the rows Inkling-2-Mini has (gate_up: 2304 values, down: 1152) and
+//     shorter / longer ones - every value of a row in exactly one unit.
+// Built without contraction (-ffp-contract=off), as the engine's C++ is.
+#include "../src/ik2/ik2_kq.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace kq = ik2::kq;
+
+namespace {
+
+int g_fail = 0;
+std::mt19937 rng(20261123);
+
+float fp16_to_fp32(uint16_t h) {   // (ggml's GGML_FP16_TO_FP32: the IEEE conversion, written independently)
+    const int s = h >> 15, e = (h >> 10) & 31, m = h & 1023;
+    if (e == 0) return (s ? -1.0f : 1.0f) * std::ldexp((float) m, -24);
+    if (e == 31) return m ? NAN : (s ? -INFINITY : INFINITY);
+    return (s ? -1.0f : 1.0f) * std::ldexp(1.0f + (float) m / 1024.0f, e - 15);
+}
+
+// ggml-quants.c, dequantize_row_q4_K (QK_K 256) with get_scale_min_k4, transcribed
+void get_scale_min_k4(int j, const uint8_t* q, uint8_t* d, uint8_t* m) {
+    if (j < 4) {
+        *d = q[j] & 63;
+        *m = q[j + 4] & 63;
+    } else {
+        *d = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4);
+        *m = (q[j + 4] >> 4) | ((q[j - 0] >> 6) << 4);
+    }
+}
+void ggml_dequantize_row_q4_K(const uint8_t* x, float* y, int64_t k) {
+    const int nb = (int) (k / 256);
+    for (int i = 0; i < nb; i++) {
+        const uint8_t* blk = x + (size_t) i * 144;
+        const uint8_t* q = blk + 16;
+        const float d = fp16_to_fp32((uint16_t) (blk[0] | (blk[1] << 8)));
+        const float min = fp16_to_fp32((uint16_t) (blk[2] | (blk[3] << 8)));
+        const uint8_t* scales = blk + 4;
+        int is = 0;
+        uint8_t sc, m;
+        for (int j = 0; j < 256; j += 64) {
+            get_scale_min_k4(is + 0, scales, &sc, &m);
+            const float d1 = d * sc;
+            const float m1 = min * m;
+            get_scale_min_k4(is + 1, scales, &sc, &m);
+            const float d2 = d * sc;
+            const float m2 = min * m;
+            for (int l = 0; l < 32; ++l) *y++ = d1 * (q[l] & 0xF) - m1;
+            for (int l = 0; l < 32; ++l) *y++ = d2 * (q[l] >> 4) - m2;
+            q += 32;
+            is += 2;
+        }
+    }
+}
+// ggml-quants.c, dequantize_row_q5_0 (QK5_0 32), transcribed
+void ggml_dequantize_row_q5_0(const uint8_t* x, float* y, int64_t k) {
+    static const int qk = 32;
+    const int nb = (int) (k / qk);
+    for (int i = 0; i < nb; i++) {
+        const uint8_t* blk = x + (size_t) i * 22;
+        const float d = fp16_to_fp32((uint16_t) (blk[0] | (blk[1] << 8)));
+        uint32_t qh;
+        std::memcpy(&qh, blk + 2, sizeof(qh));
+        const uint8_t* qs = blk + 6;
+        for (int j = 0; j < qk / 2; ++j) {
+            const uint8_t xh_0 = ((qh >> (j + 0)) << 4) & 0x10;
+            const uint8_t xh_1 = ((qh >> (j + 12))) & 0x10;
+            const int32_t x0 = ((qs[j] & 0x0F) | xh_0) - 16;
+            const int32_t x1 = ((qs[j] >> 4) | xh_1) - 16;
+            y[i * qk + j + 0] = x0 * d;
+            y[i * qk + j + qk / 2] = x1 * d;
+        }
+    }
+}
+
+// random blocks whose FP16 scales are finite (any exponent but inf / nan: subnormals and large ones too)
+std::vector<uint8_t> rand_blocks(int type, size_t n_values, bool moderate) {
+    const size_t bb = type == kq::kQ4_K ? 144 : 22, nb = n_values / (type == kq::kQ4_K ? 256 : 32);
+    std::vector<uint8_t> raw(nb * bb);
+    for (auto& b : raw) b = (uint8_t) rng();
+    auto fix = [&](uint8_t* p) {
+        uint16_t h = (uint16_t) (p[0] | (p[1] << 8));
+        if (moderate) h = (uint16_t) ((h & 0x83FF) | ((uint16_t) (8 + (h >> 10) % 8) << 10));
+        else if (((h >> 10) & 31) == 31) h = (uint16_t) (h & ~0x0400);   // (exponent 30: the largest finite)
+        p[0] = (uint8_t) h, p[1] = (uint8_t) (h >> 8);
+    };
+    for (size_t b = 0; b < nb; ++b) {
+        fix(raw.data() + b * bb);
+        if (type == kq::kQ4_K) fix(raw.data() + b * bb + 2);
+    }
+    return raw;
+}
+
+void check(const char* what, bool ok) {
+    if (!ok) ++g_fail;
+    std::printf("%s %s\n", ok ? "ok  " : "FAIL", what);
+}
+
+void test_values(int type, const char* name) {
+    for (bool moderate : {true, false}) {
+        const size_t n = 256 * 4001;
+        auto raw = rand_blocks(type, n, moderate);
+        std::vector<float> want(n), got(n);
+        (type == kq::kQ4_K ? ggml_dequantize_row_q4_K : ggml_dequantize_row_q5_0)(raw.data(), want.data(), (int64_t) n);
+        size_t bad = 0, at = 0;
+        for (size_t v = 0; v < n; ++v) {
+            got[v] = type == kq::kQ4_K ? kq::q4k_value(raw.data(), v) : kq::q50_value(raw.data(), v);
+            if (std::memcmp(&got[v], &want[v], 4) && !bad++) at = v;
+        }
+        char nm[160];
+        std::snprintf(nm, sizeof nm, "%s values = ggml's dequantize_row, bit for bit (%zu values, %s scales)%s", name, n,
+                      moderate ? "moderate" : "any finite", bad ? "" : "");
+        check(nm, bad == 0);
+        if (bad) std::printf("     %zu off, first at %zu: got %a want %a\n", bad, at, got[at], want[at]);
+        // the AMD prompt kernels' 64-value runs
+        bool runs = true;
+        std::vector<float> r(64);
+        if (type == kq::kQ4_K) {
+            for (size_t b = 0; b < n / 256; ++b) {
+                uint32_t w[40];
+                std::memcpy(w, raw.data() + b * 144, 144);
+                for (int j = 0; j < 4; ++j) {
+                    kq::q4k_run_values(w, w + 4 + 8 * j, j, r.data());
+                    runs &= !std::memcmp(r.data(), want.data() + b * 256 + 64 * j, 64 * 4);
+                }
+            }
+        } else {
+            for (size_t p = 0; p < n / 64; ++p) {
+                uint32_t w[11];
+                std::memcpy(w, raw.data() + p * 44, 44);
+                kq::q50_pair_values(w, r.data());
+                runs &= !std::memcmp(r.data(), want.data() + p * 64, 64 * 4);
+            }
+        }
+        std::snprintf(nm, sizeof nm, "%s 64-value runs (AMD prompt tiles) = the values (%s scales)", name,
+                      moderate ? "moderate" : "any finite");
+        check(nm, runs);
+    }
+}
+
+void test_row_dots(int type, const char* name) {
+    for (int K : {256, 512, 1152, 2304, 4608}) {
+        if (type == kq::kQ4_K && K % 256) continue;
+        const int rows = 97;
+        auto raw = rand_blocks(type, (size_t) rows * K, true);
+        const size_t rb = raw.size() / rows;
+        std::vector<float> x(K), vals(K);
+        for (auto& v : x) v = std::uniform_real_distribution<float>(-2.0f, 2.0f)(rng);
+        double worst = 0;
+        int bad = 0;
+        for (int r = 0; r < rows; ++r) {
+            const uint8_t* row = raw.data() + r * rb;
+            double want = 0, mag = 0;
+            for (int i = 0; i < K; ++i) {
+                vals[i] = type == kq::kQ4_K ? kq::q4k_value(row, i) : kq::q50_value(row, i);
+                want += (double) vals[i] * x[i];
+                mag += std::fabs((double) vals[i] * x[i]);
+            }
+            const double got = kq::row_dot_host(type, row, K, x.data());
+            const double lim = 1e-6 * mag + 1e-30;   // (F32 sums of K terms: well within K 2^-24 of the magnitudes)
+            worst = std::max(worst, std::fabs(got - want) / lim);
+            bad += !(std::fabs(got - want) <= lim);
+        }
+        char nm[160];
+        std::snprintf(nm, sizeof nm, "%s row dot in the kernels' order, K %d: %d of %d rows off (worst %.2f of the bound)",
+                      name, K, bad, rows, worst);
+        check(nm, bad == 0);
+    }
+    // a unit's scale pair (the 4 words at once) = get_scale_min_k4, every byte pattern of the scales
+    if (type == kq::kQ4_K) {
+        bool ok = true;
+        for (int it = 0; it < 200000; ++it) {
+            uint8_t s[12];
+            for (auto& b : s) b = (uint8_t) rng();
+            uint32_t w[3];
+            std::memcpy(w, s, 12);
+            const uint16_t dm[2] = {0x3c00, 0x3c00};   // (d = dmin = 1: the scales themselves)
+            uint32_t dmw;
+            std::memcpy(&dmw, dm, 4);
+            for (int j = 0; j < 4; ++j) {
+                const kq::Q4kSc sc = kq::q4k_scales(dmw, w[0], w[1], w[2], j);
+                uint8_t a, m, c, n;
+                get_scale_min_k4(2 * j, s, &a, &m);
+                get_scale_min_k4(2 * j + 1, s, &c, &n);
+                ok &= sc.d0 == a && sc.m0 == m && sc.d1 == c && sc.m1 == n;
+            }
+        }
+        check("Q4_K unit scales (4 words, the pair at once) = get_scale_min_k4", ok);
+    }
+}
+
+}  // namespace
+
+int main() {
+    test_values(kq::kQ4_K, "Q4_K");
+    test_values(kq::kQ5_0, "Q5_0");
+    test_row_dots(kq::kQ4_K, "Q4_K");
+    test_row_dots(kq::kQ5_0, "Q5_0");
+    std::printf(g_fail ? "FAILED: %d check(s)\n" : "all passed\n", g_fail);
+    return g_fail ? 1 : 0;
+}
