+/// value v of a run of Q5_0 blocks
+IK2KQ_HD float q50_value(const uint8_t* blocks, size_t v) {
+    const uint8_t* b = blocks + (v / 32) * kQ50Bytes;
+    const int i = (int) (v % 32);
+    const float d = h2f((uint32_t) b[0] | ((uint32_t) b[1] << 8));
+    const uint32_t qh = ld32(b + 2);
+    const int x = i < 16 ? ((b[6 + i] & 0x0F) | (int) (((qh >> i) << 4) & 0x10)) - 16
