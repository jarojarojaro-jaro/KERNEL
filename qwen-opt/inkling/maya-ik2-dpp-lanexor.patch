index 00000000..7d169c83
--- /dev/null
+++ b/src/ik2/ik2_lane_xor.h
@@ -0,0 +1,31 @@
+// ik2_lane_xor.h - __shfl_xor_sync(0xffffffffu, v, m) with the value moved in registers on RDNA (wave32):
+// DPP quad_perm for 1 and 2, row_xmask for 4 and 8, v_permlanex16 for 16 (mw00/project-maya v1.1.77 #1164,
+// include/maya/kernels/lane_xor.hpp).  The same value arrives, so every sum keeps its order and its bits.  Whole-warp
+// calls only (all lanes active), as the full mask already demands.  IK2_XOR_BPERMUTE (compile-time) keeps the shuffle.
+#pragma once
+template <int M>
+__device__ __forceinline__ int ik2_lane_xor_i(int x) {
+#if defined(STRATA_USE_HIP) && !defined(IK2_XOR_BPERMUTE) && (defined(__GFX10__) || defined(__GFX11__) || defined(__GFX12__))
+    if constexpr (M == 1) return __builtin_amdgcn_update_dpp(0, x, 0xB1, 0xF, 0xF, false);
+    else if constexpr (M == 2) return __builtin_amdgcn_update_dpp(0, x, 0x4E, 0xF, 0xF, false);
+    else if constexpr (M == 4) return __builtin_amdgcn_update_dpp(0, x, 0x164, 0xF, 0xF, false);
+    else if constexpr (M == 8) return __builtin_amdgcn_update_dpp(0, x, 0x168, 0xF, 0xF, false);
+    else {
+        static_assert(M == 16, "ik2_lane_xor: 1, 2, 4, 8 or 16");
+        return (int) __builtin_amdgcn_permlanex16((unsigned) x, (unsigned) x, 0x76543210u, 0xFEDCBA98u, false, false);
+    }
+#else
+    return __shfl_xor_sync(0xffffffffu, x, M);
+#endif
+}
+__device__ __forceinline__ int ik2_xor(int x, int m) {   // (m a constant after unrolling: the switch folds away)
+    switch (m) {
+        case 1: return ik2_lane_xor_i<1>(x);
+        case 2: return ik2_lane_xor_i<2>(x);
+        case 4: return ik2_lane_xor_i<4>(x);
+        case 8: return ik2_lane_xor_i<8>(x);
+        case 16: return ik2_lane_xor_i<16>(x);
+        default: return __shfl_xor_sync(0xffffffffu, x, m);
+    }
+}
+__device__ __forceinline__ float ik2_xor(float v, int m) { return __int_as_float(ik2_xor(__float_as_int(v), m)); }
