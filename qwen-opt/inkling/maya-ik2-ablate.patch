+void proj_conv(float* x, int x_ld, const float* ys, const int* inv, const float* wt, int K, const float* r, int T, int C,
+               float* hist, const float* w, const float* res, int res_ld, float* y, int y_ld, float* rec_old,
+               float* rec_x, cudaStream_t s) {
+    if (T <= 0) return;
+    if (T > kPcMaxT) {
+        std::fprintf(stderr, "ik2::k::proj_conv: %d tokens (at most %d)\n", T, kPcMaxT);
+        std::abort();
+    }
+    if (ys)
+        proj_conv_kernel<<<1, 1024, 0, s>>>(x, x_ld, ys, inv, wt, K, r, T, C, hist, w, res, res_ld, y, y_ld, rec_old,
+                                            rec_x);
+    else
+        proj_conv_kernel<<<(unsigned) ((C + 255) / 256), 256, 0, s>>>(x, x_ld, ys, inv, wt, K, r, T, C, hist, w, res,
+                                                                      res_ld, y, y_ld, rec_old, rec_x);
+    check("proj_conv");
+}
