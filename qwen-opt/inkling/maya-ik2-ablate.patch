+// IK2_ABLATE: a few tokens' (T <= kPcMaxT) short conv as conv_block_kernel's (no dyn), its input x [T][x_ld] with the
+// direction r [C] projected out first (xn = x - r (r . x)): each block takes every token's dot over all C (from L2),
+// then its own channels.  With ys the input is first the MoE's sum (moe_combine_f32's, K picks a token), written to
+// x [T][C] - one block then (the sum is made once, each thread's channels the same in both loops)
+constexpr int kPcMaxT = 8;
+__global__ void __launch_bounds__(1024) proj_conv_kernel(float* x, int x_ld, const float* __restrict__ ys,
+                                                         const int* __restrict__ inv, const float* __restrict__ wt,
+                                                         int K, const float* __restrict__ r, int T, int C, float* hist,
+                                                         const float* __restrict__ w, const float* __restrict__ res,
+                                                         int res_ld, float* y, int y_ld, float* rec_old, float* rec_x) {
+    __shared__ float part[kPcMaxT][32];
+    __shared__ float dt[kPcMaxT];
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    float a[kPcMaxT];
+#pragma unroll
+    for (int t = 0; t < kPcMaxT; ++t) a[t] = 0.0f;
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        const float rc = r[c];
+#pragma unroll
+        for (int t = 0; t < kPcMaxT; ++t) {
+            if (t >= T) break;
+            float v;
+            if (ys) {
+                v = 0.0f;
+                for (int k = 0; k < K; ++k) v += wt[t * K + k] * ys[(size_t) inv[t * K + k] * C + c];
+                x[(size_t) t * x_ld + c] = v;
+            } else {
+                v = x[(size_t) t * x_ld + c];
+            }
+            a[t] += rc * v;
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < kPcMaxT; ++t) {
+        if (t >= T) break;
+        const float v = wsum(a[t]);
+        if (lane == 0) part[t][warp] = v;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        const int nw = (blockDim.x + 31) >> 5;
+        for (int t = 0; t < T; ++t) {
+            const float v = wsum(lane < nw ? part[t][lane] : 0.0f);
+            if (lane == 0) dt[t] = v;
+        }
+    }
+    __syncthreads();
+    for (int c = blockIdx.x * blockDim.x + threadIdx.x; c < C; c += gridDim.x * blockDim.x) {
+        float h0 = hist[c], h1 = hist[(size_t) C + c], h2 = hist[(size_t) 2 * C + c];
+        if (rec_old) rec_old[c] = h0, rec_old[(size_t) C + c] = h1, rec_old[(size_t) 2 * C + c] = h2;
+        const float* wc = w + (size_t) c * 4;
+        const float w0 = wc[0], w1 = wc[1], w2 = wc[2], w3 = wc[3];
+        const float rc = r[c];
+        for (int t = 0; t < T; ++t) {
+            const float xn = x[(size_t) t * x_ld + c] - dt[t] * rc;
+            if (rec_x) rec_x[(size_t) t * C + c] = xn;
+            float v = w0 * h0 + w1 * h1 + w2 * h2 + w3 * xn;
+            if (res) v += res[(size_t) t * res_ld + c];
+            y[(size_t) t * y_ld + c] = v;
+            h0 = h1, h1 = h2, h2 = xn;
+        }
+        hist[c] = h0, hist[(size_t) C + c] = h1, hist[(size_t) 2 * C + c] = h2;
+    }
+}
