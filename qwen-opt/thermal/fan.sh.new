#!/bin/bash
# RX 7900 XTX fan control (RDNA3 overdrive; needs amdgpu.ppfeaturemask=0xfff7ffff).
# Installed root-owned at /usr/local/sbin/xtx-fan by ~/qwen-opt/thermal/INSTALL.sh; the systemd timer xtx-fan.timer
# runs `xtx-fan max quiet` as root every 30 s; that call follows the GPU load for ~28 s:
#   GPU working (busy >= 10%)        -> fan curve 100% at every temperature (~3500 RPM), immediately
#   GPU idle (< 10% for 20 s in a row) -> idle curve: 40% below 50 C, 100% from 50 C
# The curve is re-committed only on a state change, when a GPU reset has wiped it, or when the firmware shows it
# dropped it under load (pwm1 < 230 while the fan spins, 10 s in a row) -> forced re-upload.
# Every commit goes through xtx_apply (/usr/local/lib/xtx-od.sh): all 5 points + `s 1 <current sclk cap>` + ONE `c`,
# so a fan commit never drops the xtx-eco clock cap and a cap commit never drops the curve (report 64 §3.2, §10.1).
# Manual (sudo): xtx-fan max | xtx-fan install | xtx-fan auto (driver defaults incl. stock clock, timer removed)
set -u
. /usr/local/lib/xtx-od.sh || { echo "missing /usr/local/lib/xtx-od.sh (run INSTALL.sh)"; exit 2; }
dev=$XTX_DEV
od=$dev/gpu_od/fan_ctrl
hw=$XTX_HW
busy_f=$dev/gpu_busy_percent
arg=${1:-max}
quiet=${2:-}
BUSY=10         # % GPU busy = "card is working" (idle reads 0–2%)
IDLE_HOLD=20    # s below BUSY before going back to the idle curve
DROP_S=10       # s of "fan spinning but pwm1 < 230 at busy >= 50%" before a forced re-upload
state_f=$XTX_FAN_STATE_F
[ "$(id -u)" = 0 ] || { echo "run with sudo"; exit 1; }
[ -e "$od/fan_curve" ] || { echo "overdrive off: add amdgpu.ppfeaturemask=0xfff7ffff to GRUB and reboot"; exit 2; }

# set_curve <load|idle> [force]. SMU13 fan modes are exclusive (curve / acoustic / target temperature) and the
# last committed one wins, so only the curve is ever written (plus the current sclk cap, in the same commit).
set_curve() {
    xtx_apply "$1" "${2:-}" || return 1
    echo "$1" > "$state_f"
    logger -t xtx-fan "fan curve: $1 (${XTX_FAN}%), sclk cap $(xtx_cap)${2:+ (forced)}"
}
# a GPU reset resets the curve to stock in sysfs too, which this detects (point 0 is 25 C, or 26 C after a forced upload)
ensure() {
    local cur; cur=$(cat "$state_f" 2>/dev/null)
    if [ "$cur" != "$1" ] || ! grep -qE "$(xtx_p0_re "$1")" "$od/fan_curve"; then set_curve "$1"; fi
}

case "$arg" in
auto)
    # full driver defaults (clock AND fan) in one upload; drops any xtx-eco cap
    rm -f "$XTX_CAP_F"
    ( flock -w 20 9 && echo r > "$XTX_OD" ) 9> "$XTX_LOCK"; rm -f "$state_f"
    systemctl disable --now xtx-fan.timer 2>/dev/null
    rm -f /etc/systemd/system/xtx-fan.service /etc/systemd/system/xtx-fan.timer; systemctl daemon-reload
    echo "fan + clock: driver defaults, timer removed"; exit 0 ;;
install)
    cat > /etc/systemd/system/xtx-fan.service <<EOF
[Unit]
Description=RX 7900 XTX fan control (follows GPU load)
[Service]
Type=oneshot
ExecStart=$(readlink -f "$0") max quiet
EOF
    cat > /etc/systemd/system/xtx-fan.timer <<EOF
[Unit]
Description=RX 7900 XTX fan control every 30 s
[Timer]
OnBootSec=20
OnUnitActiveSec=30
AccuracySec=1
[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload && systemctl enable --now xtx-fan.timer && systemctl list-timers xtx-fan.timer --no-pager | head -3
    exit 0 ;;
esac

if [ -z "$quiet" ]; then   # manual call: full fan now
    set_curve load; sleep 3; sed -n 1,6p "$od/fan_curve"; echo "fan now $(cat $hw/fan1_input) RPM"; exit 0
fi

# timer call: follow the load for ~28 s, sampling every second
low=0; drop=0; forced=0
[ "$(cat $state_f 2>/dev/null)" = idle ] && low=$IDLE_HOLD
for _ in $(seq 28); do
    b=$(cat "$busy_f" 2>/dev/null || echo 100)
    if [ "$b" -ge "$BUSY" ]; then low=0; ensure load
    else
        low=$((low + 1))
        if [ "$low" -ge "$IDLE_HOLD" ]; then ensure idle; else ensure "$(cat $state_f 2>/dev/null || echo load)"; fi
    fi
    # firmware dropped the 100% curve although sysfs still shows it (report 64 §3.2): pwm1 is the live duty cycle
    if [ "$(cat $state_f 2>/dev/null)" = load ] && [ "$b" -ge 50 ] && [ "$(cat $hw/fan1_input)" -gt 0 ] && [ "$(cat $hw/pwm1)" -lt 230 ]; then
        drop=$((drop + 1))
    else drop=0; fi
    if [ "$drop" -ge "$DROP_S" ] && [ "$forced" = 0 ]; then   # at most one forced upload per 28 s run
        logger -t xtx-fan "curve dropped by firmware (pwm1 $(cat $hw/pwm1), $(cat $hw/fan1_input) RPM at ${b}% busy): forced re-upload"
        set_curve load force; drop=0; forced=1
    fi
    sleep 1
done
exit 0
